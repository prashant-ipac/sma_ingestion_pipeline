0ba4\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bc1!\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd", "\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0baa\\u0bca\\u0bae\\u0bcd\\u0bae\\u0ba9\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b92\\u0bb0\\u0bc1 \\u0b8a\\u0bae\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0baa\\u0bcb\\u0bb2, \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb5\\u0bc0\\u0bb0\\u0baa\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0b8e\\u0bb8\\u0bcd.\\u0b86\\u0bb1\\u0bc1\\u0bae\\u0bc1\\u0b95\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd. \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb0\\u0bc1 \\u0bb5\\u0ba3\\u0bcd\\u0ba3\\u0b95\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bbf\\u0baf\\u0bc8 \\u0ba4\\u0ba9\\u0ba4\\u0bc1 \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0b95\\u0bcd\\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bbf \\u0b9a\\u0bc7\\u0bb2\\u0bae\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0bae\\u0bcd \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bb3\\u0b95\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0bcd \\u0b86\\u0bb5\\u0bbe\\u0bb0\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 62\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc6\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb4\\u0bbf\\u0baa\\u0b9f\\u0bb0\\u0bbe\\u0ba4 \\u0baa\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0b9f\\u0bc8\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bcd, \\u0b8f\\u0bb4\\u0bc7\\u0bb4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc1\\u0bb1\\u0bc8 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb3\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bae\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0b8e\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bcd \\u0ba4\\u0bc0\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0ba4\\u0bc1.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bcb\\u0bae\\u0bcd.\\n\\n\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0baa\\u0baf\\u0ba3\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bb5\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b95\\u0bc2\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0b95\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bcb\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0ba9; \\u0b87\\u0ba4\\u0baf\\u0bae\\u0bcd \\u0ba8\\u0bc6\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1!\\n\\n#\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd_\\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4_\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1", "\\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0bb2\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0ba9\\u0bbe \\u0bae\\u0bc1\\u0ba4\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb0\\u0bc7\\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bcd \\u0bb0\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u201c\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1\\u201d \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd.", "It was a privilege to address the 67th edition of ictacademyindia Bridge 2025 in Madurai \\u2014 a platform that unites academia, technology, and industry.\\n\\nI congratulated ICT Academy\\u2019s leadership and their dedicated team, for their efforts in building one of India\\u2019s strongest academia\\u2013industry bridges, with 1,700 partner institutions (including 800 in Tamil Nadu) and now international editions, the impact of this model is truly inspiring..", "In my remarks, I stressed that Tamil Nadu \\u2014 home to 20% of India\\u2019s STEM graduates \\u2014 must ensure our abundant talent is job-ready and globally relevant. That is why our government has launched initiatives like Naan Mudhalvan, Vetri Nichayam, while deepening partnerships with industry to upskill youth and expand opportunities.", "Looking ahead, through the Tamil Nadu Artificial Intelligence Mission, startup hubs, and integration of AI/ML into school curricula, we are preparing the next generation for the transformations already reshaping our economy.\\n\\nWith the right investments in education, innovation, and talent development, I believe Tamil Nadu is poised to seize this moment of global change and emerge as a leading talent hub for decades to come.", "\\u0b89\\u0bb4\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b8a\\u0bb0\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0b86\\u0bb2\\u0bcb\\u0b9a\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf, \\u0baa\\u0bbf\\u0bb0\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b89\\u0b9f\\u0ba9\\u0bc7 \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95 \\u201c\\u0b89\\u0bb4\\u0bb5\\u0bb0\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0b9f\\u0bbf \\u0bb5\\u0bc7\\u0bb3\\u0bbe\\u0ba3\\u0bcd\\u0bae\\u0bc8 - \\u0b89\\u0bb4\\u0bb5\\u0bb0\\u0bcd \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u201d \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0bc1\\u0b95\\u0bbe\\u0bae\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc2\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd!\\n\\n\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. M. K. Stalin  \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#DMK4TN", "\\u0b95\\u0ba9\\u0ba4\\u0bcd\\u0ba4 \\u0b87\\u0ba4\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9f\\u0ba9\\u0bcd\\u2026", "\\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb5\\u0bb2\\u0bc8\\u0baf\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0ba9.\\n\\n\\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f \\u0ba8\\u0bc6\\u0bb0\\u0bbf\\u0b9a\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0bae\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0ba9\\u0bc1\\u0bae\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0b89\\u0b9f\\u0ba9\\u0b9f\\u0bbf \\u0b9a\\u0bbf\\u0b95\\u0bbf\\u0b9a\\u0bcd\\u0b9a\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b85\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0b9f\\u0bbf,\\n\\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd v.senthilbalaji \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd ma_subramanian \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd - \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb0\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bc7\\u0ba9\\u0bcd.", "\\u0b85\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb2\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd anbil_mahesh \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0b9f\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb2 \\u0b85\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0b9f\\u0bbf \\u0b89\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0b85\\u0b99\\u0bcd\\u0b95\\u0bc1, \\u0bb5\\u0bbf\\u0bb0\\u0bc8\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc0\\u0bb0\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bc8\\u0bb3\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb
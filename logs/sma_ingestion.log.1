af\\u0bc7 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bc8 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0b95\\u0b9f\\u0bae\\u0bc8 \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95.\\u0bb5\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. S.I.R \\u0baa\\u0b9f\\u0bbf\\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95 \\u0baa\\u0bbe\\u0b95 \\u0bae\\u0bc1\\u0b95\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0ba4\\u0bb5\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd.!\\n\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. M. K. Stalin  \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1_\\u0ba4\\u0bb2\\u0bc8\\u0b95\\u0bc1\\u0ba9\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc1", "\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bcd!", "India\\u2019s superstar state - Tamil Nadu!\\n\\n\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bcb\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95, \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf, \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0bcd, \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bb5\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b95\\u0bb5\\u0ba9\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0bb0\\u0ba3\\u0bae\\u0bbe\\u0b95 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8 \\u0b85\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u2018superstar state\\u2019 \\u0b8e\\u0ba9 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0bbe\\u0bb0\\u0bae\\u0bcd \\u0b9a\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1 The Economist \\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0ba4\\u0bb4\\u0bcd!\\n\\n\\ud83d\\udd17: https://archive.is/20251113115406/https://www.economist.com/asia/2025/11/13/which-is-indias-superstar-state\\n\\n#DMK4TN", "\\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0b95\\u0bb0\\u0bcd \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0bae\\u0bae\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0b9f\\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0bb0\\u0bc2.5.24 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0bae\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bc1\\u0ba4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0ba8\\u0b95\\u0bb0\\u0bcd \\u0ba8\\u0bc2\\u0bb2\\u0b95\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0b9f\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba4\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n#DMK4TN", "The Economist verdict is loud and clear:\\n#TamilNadu is India\\u2019s true #Superstar State, because of it\'s human development!\\n\\nWhile #Gujarat chased megaprojects, Tamil Nadu invested in doctors, schools, colleges and social justice.\\n\\nResult?\\n\\n\\ud83d\\udcda 80% children in school\\n\\ud83c\\udf93 50% GER (national average 28%)\\n\\ud83c\\udfe5 Highest hospital beds\\n\\ud83d\\udc69\\u200d\\ud83c\\udfed 40% of India\\u2019s women in manufacturing\\n\\ud83c\\udfed Electronics exports tripled\\n\\ud83d\\udcc8 11.19% - Fastest-growing state economy", "The Economist Confirms that the Tamil Nadu\\u2019s Dravidian social reforms are the backbone of it\'s growth, ensuring prosperity reaches every home, not just a few corporates.\\n\\nThis is the #DravidianModel, Growth that includes, Progress that uplifts, Development that reaches every family.\\n\\n\\ud83d\\udd17: https://archive.is/20251113115406/https://www.economist.com/asia/2025/11/13/which-is-indias-superstar-state\\n\\n#DMK4TN", "\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0ba3\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0baf\\u0baa\\u0bcd \\u0baa\\u0bc7\\u0bb0\\u0bcd \\u0bb5\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0ba4\\u0ba9\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b87\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0baa\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bb2\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u2018\\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0ba9\\u0bcd\\u2019 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0baa\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0bb5\\u0bbf\\u0b95\\u0bbf\\u0ba4\\u0bae\\u0bcd \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.\\n\\n#\\u0bae\\u0bc1\\u0bb0\\u0b9a\\u0bca\\u0bb2\\u0bbf", "\\u0b89\\u0bb4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bc1\\u0b95\\u0bb0\\u0bcd\\u0bb5\\u0bcb\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0b9f\\u0bc8\\u0baf\\u0b95 \\u0bb5\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0ba9\\u0bc8 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb4\\u0bb5\\u0bb0\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bc8 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc8 \\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bcd (14.11,1999) \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1!\\n\\n#DMKITWINGArivagam", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 111 \\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8: \\u0baa\\u0b95\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0b85\\u0baf\\u0bb2\\u0bcb\\u0bb0\\u0bcd, \\u0ba8\\u0ba3\\u0bcd\\u0baa\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0baa\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b92\\u0bb0\\u0bc1\\u0ba4\\u0bb2\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbe\\u0b95 \\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb2\\u0bc7 \\u0ba8\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0ba4\\u0bb0\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bbf\\u0baf \\u0ba8\\u0b9f\\u0bc1\\u0bb5\\u0bc1\\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0bae\\u0bc8 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bc1\\u0bae\\u
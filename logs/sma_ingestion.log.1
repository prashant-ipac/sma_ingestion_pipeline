5\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb5\\u0bb0\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd TRB \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bcb\\u0b9f\\u0bc1, \\u0ba8\\u0bbf\\u0bb5\\u0bbe\\u0bb0\\u0ba3 \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd.", "\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd, \\u0baa\\u0bc7\\u0bb0\\u0bc2\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.R.R.\\u0bb0\\u0bbe\\u0bae\\u0bcd\\u0bb0\\u0bbe\\u0b9c\\u0bcd, \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd KVK.\\u0b86\\u0ba9\\u0ba8\\u0bcd\\u0ba4\\u0bcd, \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b9a\\u0bcb\\u0bae.\\u0b9a\\u0bc6\\u0ba8\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0ba9\\u0bcd, \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbf\\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bcb\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd.\\n\\n #DeltaRains", "Looking forward to taking part in the final session of the two-day International Convention on \\u201cThe Independence of Judiciary: Comparative Perspectives on Rights, Institutions and Citizens\\u201d, organised by JindalGlobalUNI and the Jindal Global Law School.", "This significant convention brings together a distinguished gathering \\u2014 the Chief Justice of India, the Minister of State for Law & Justice of the Government of India, present and former Judges of the Supreme Court and High Courts, senior advocates, international judges and jurists, parliamentarians, academicians, lawyers and journalists \\u2014 for deep reflection.", "I am honoured to join the concluding conversation titled \\u201cTowards a Constitutional Balance: Relations between Legislature, Executive and Judiciary\\u201d, alongside the distinguished faculty of JGU. \\n\\nI look forward to engaging a meaningful exchange on strengthening our constitutional institutions and sustaining the delicate balance envisioned by the framers of our Republic. As one of the few voices without a formal legal background invited to contribute to this dialogue, I hope I can offer a fresh perspective.", "\\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b86\\u0baf\\u0bbf\\u0bb0\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb3\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bbf\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf 113-\\u0b85 \\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba4.\\u0ba4\\u0bc7\\u0bb5\\u0bb0\\u0bbe\\u0b9c\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0ba
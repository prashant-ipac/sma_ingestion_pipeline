0bb2\\u0bcd 17 \\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bcb\\u0baa\\u0bbe\\u0bb2\\u0bbf\\u0bb2\\u0bcd 18.8 \\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0ba8\\u0b95\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc6\\u0b9f\\u0bcd\\u0bb0\\u0bcb \\u0bb0\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b85\\u0ba9\\u0bc1\\u0bae\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0baf\\u0ba9\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.", "\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bca\\u0ba4\\u0bcd\\u0ba4 \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc1 9.37%, \\u0b86\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0bb5\\u0bb0\\u0bbf \\u0baa\\u0b95\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd 4% \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc7 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0bb5\\u0bb0\\u0bbf, \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u2013 \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe \\u0baa\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0baa\\u0bbe.\\u0b9c.\\u0b95. \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0b9e\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bb5\\u0ba4\\u0bc1 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0b95 \\u0baa\\u0bc1\\u0bb2\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\n\\n\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8 \\u0bae\\u0bb1\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0baf \\u0ba8\\u0bc7\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n- \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\nselvaperunthagai.k", "Important update as Tamil Nadu takes another key step in the #GCC sector ! \\n\\nGuidance Tamil Nadu has today signed a strategic MoU with ANSR, one of the world\\u2019s leading builders of Global Capability Centres, to create 10,000 High value #JobsForTN \\ud83c\\udf8a \\n\\nThe signing happened on the sides of a wonderful round table discussion with some of the top GCC\\u2019s in Bengaluru. Was a pleasure learning from the amazing Leaders, of whom many were from TN ! Especially our women \\u2665\\ufe0f", "ANSR has helped create more than 200 GCCs and fast-growing global firms. Their decision to partner with us shows the strength of Tamil Nadu\\u2019s vision and the trust we have earned under Honourable Chief Minister of Tamil Nadu Thiru. MK Stalin avargal.", "We want Tamil Nadu to be the world\\u2019s most competitive GCC destination. You see the momentum already. Technology, automotive, BFSI, engineering, aerospace, and retail companies have all chosen our State. They come to TN for our talent, our infrastructure, and policy continuity.\\n\\nThrough this partnership, ANSR will help bring in the next wave of global corporations. We will support them with policy enablement, fast approvals, site selection, and strong talent linkages.", "GCCs reshape industries, and Tamil Nadu will reshape the GCC sector in India !\\n\\n#InvestInTN #BullishOnTN #JobsForTN #DravidianModel", "\\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1: 19\\n\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0bb5\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bbf\\u0b9c\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bcd \\u0b9a\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd. \\u0baa\\u0bbf.\\u0b9f\\u0bbf.\\u0b86\\u0bb0\\u0bcd. \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0bb5\\u0bc7\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bb0\\u0bbe\\u0b9c\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0ba8\\u0bc7\\u0bb0\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bb5\\u0bc1 \\u0b95\\u0bbe\\u0ba3 \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bbe\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0
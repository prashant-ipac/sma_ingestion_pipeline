\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1.", "\\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0b92\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0ba9\\u0bcd\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc6\\u0ba9\\u0bbf\\u0bb2\\u0bcd, \\u0b85\\u0ba8\\u0bcd\\u0ba4 \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b93\\u0bb0\\u0bb3\\u0bb5\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0 \\u0bb5\\u0b9a\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0ba9\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba8\\u0bb2\\u0ba9\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0b92\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bca\\u0ba4\\u0bcd\\u0ba4 \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b89\\u0bb4\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0bb5\\u0bb0 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0b85\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bb2 \\u0bb5\\u0b9a\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bb0\\u0bcd, \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0b9a\\u0bc1\\u0baf\\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf, \\u0ba8\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0b9a\\u0bae\\u0bc1\\u0ba4\\u0bbe\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd, \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba8\\u0bc0\\u0ba4\\u0bbf \\u0b95\\u0ba3\\u0bcd\\u0ba3\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bc7 \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf. \\u0b87\\u0bb0\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd", "\\u0b87\\u0bb0\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4 \\u0bb5\\u0bc6\\u0b95\\u0bc1 \\u0b9a\\u0bbf\\u0bb2 \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bbe\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0baa\\u0bcd \\u0baa\\u0baf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf, 1921 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc7 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bc1, \\u0b86\\u0ba3\\u0bcd & \\u0baa\\u0bc6\\u0ba3\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0baf \\u0b86\\u0bb0\\u0bae\\u0bcd\\u0baa\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0bb5\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb5\\u0bbe\\u0bb0\\u0bbf \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbf\\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bb2 \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb0\\u0bae\\u0bbe\\u0ba9 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b92\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bca\\u0ba4\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc7 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0ba4\\u0bbe\\u0bb0\\u0ba3\\u0bae\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b95\\u0bb4\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b85\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb3\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bb0\\u0bcd.", "\\u0b85\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbf \\u0b89\\u0ba3\\u0bb0\\u0bcd\\u0bb5\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0b95\\u0bc2\\u0bb0\\u0bcd\\u0bb5\\u0ba4\\u0bcb\\u0b9f\\u0bc1, \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bc2\\u0bb1\\u0bcd\\u0bb1\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 2016\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0b8e\\u0bb4\\u0bc1\\u0ba4\\u0bbf, \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0bb0\\u0b9a\\u0bca\\u0bb2\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0b95\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.\\n\\nHere is the link to the article I wrote in 2016 on the centenary of the Justice Party, which was published in Murasoli by Muthamizh Arignar Kalaignar: https://drive.google.com/file/d/1i3Rf3RgvCim698vBkMpwPrSAIAKF3P8o/view", "\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95!", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bb5\\u0b9e\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbe.\\u0b9c.\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1!\\n\\n#BJPHatesTamilNadu #Metro", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b95\\u0bbf\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0bae\\u0bc1\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0bae\\u0bcd- 5, \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf-14, \\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0b9f\\u0bc1 - 59\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0b9f\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b9a\\u0bbf\\u0bb5\\u0bbe\\u0ba9\\u0ba8\\u0bcd\\u0ba4\\u0bbe \\u0b9a\\u0bbe\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bb0\\u0bc2\\u0baa\\u0bbe\\u0baf\\u0bcd 4.84 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0bae\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd MRTS \\u0b87\\u0bb0\\u0baf\\u0bbf\\u0bb2\\u0bcd\\u0bb5\\u0bc7 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bc8 \\u0b85\\u0bb4\\u0b95\\u0bc1\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0baf\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bae\\u0baf \\u0b85\\u0bb1\\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0b95\\u0bb0 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0bae \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bbf.\\u0b95\\u0bc7.\\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0bcd\\u0baa\\u0bbe\\u0baa\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b85\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bc1\\u0bb5\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u2026.", "\\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0b95\\u0bb0 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc7\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0b86\\u0bb0\\u0bcd.\\u0baa\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bbe, \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8e\\u0bb8\\u0bcd. \\u0bae\\u0bc1\\u0bb0\\u0bb3\\u0bbf, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8e\\u0bb8\\u0bcd.\\u0bb0\\u0bbe\\u0b9c\\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0bcd, \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.V.P.\\u0baa\\u0bbf\\u0bb0\\u0baa\\u0bbe\\u0b95\\u0bbe\\u0bb0\\u0ba9\\u0bcd, \\u0bae\\u0bbe\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u2026", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b95\\u0bbf\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0bae\\u0bc1\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0bae\\u0bcd-5, \\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd - 54, 55, 56, 57, 59 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd 60\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0b9f\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0ba4\\u0bc6\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0b95\\u0bb0 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc2\\u0bb2\\u0ba4\\u0ba9 \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb0\\u0bc2.3.95 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bb5\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bb1\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bc6\\u0bb3\\u0bbf (TRANSFORMER VIEW
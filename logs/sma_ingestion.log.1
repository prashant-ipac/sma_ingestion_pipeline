u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95\\u0bb5\\u0bc7.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "\\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bb0\\u0b9a\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd, \\u0bb5\\u0bbf\\u0ba3\\u0bcd\\u0bb5\\u0bc6\\u0bb3\\u0bbf \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b8f.\\u0baa\\u0bbf.\\u0b9c\\u0bc7.\\u0b85\\u0baa\\u0bcd\\u0ba4\\u0bc1\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1. \\u0ba4\\u0b9f\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb2 \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4 \\u0b85\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f \\u0b95\\u0ba9\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0ba8\\u0ba9\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9f \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd.", "Had a great conversation today with H.E. Eng. Khalil Bin Ibrahim Bin Salamah, Vice Minister of Industry and Mineral Resources for Industrial Affairs, and his colleagues from the Kingdom of Saudi Arabia.\\n\\nI explained why and how Tamil Nadu stands out as India\\u2019s most advanced industrial state, built on a strong foundation of education, inclusive growth and innovation.", "We discussed how Tamil Nadu has created a unique ecosystem where policy, academia and industry work hand in hand, making it India\\u2019s top state for manufacturing and one of the fastest growing hubs for emerging sectors like electronics, EVs, aerospace, defence, renewables and GCCs.\\n\\nA partnership between KSA and Tamil Nadu has a strong potential for growth and today\\u2019s meeting opens doors to explore avenues that can shape the next phase of India\\u2013Saudi economic collaboration.", "#InvestInTN #BullishOnTN #JobsForTN", "#Hitachi\\u2019s Chennai GCC is going to get much much more bigger!\\n\\nToday, Honourable Chief Minister of Tamil Nadu, Thiru. M. K. Stalin avargal met with Hitachi Energy\\u2019s leadership to finalise their next phase of expansion in the state - a proposed investment of up to Rs. 2000 crore which will create up to 3000 new jobs - and these are all high-value, high-paying, hi-tech jobs!", "Their Global Technology and Innovation Center in Chennai is already their largest global hub with around 3000 engineers driving 1000+ projects across 46 countries, and in just two years they are already expanding!\\n\\nTHIS highlights the massive talent availability in Tamil Nadu!\\n\\nEvery reinvestment and expansion is a testament to Tamil Nadu\\u2019s unmatched talent and pro-business environment under the leadership of our Honourable Chief Minister M. K. Stalin avargal!", "#InvestInTN #BullishOnTN #JobsForTN #DravidianModel", "\\u0ba8\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b89\\u0bb2\\u0b95\\u0bb3\\u0bbe\\u0bb5\\u0bbf\\u0baf \\u0bb5\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc2\\u0bb4\\u0bb2\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0ba3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0b8e\\u0ba4\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc1!\\n\\n\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd TRB \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bae\\u0bcd!", "\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd #\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd_\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u2665\\ufe0f\\u2728\\n\\n #MannaiMinnum #MannaiBusStand", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0bae\\u0bcd, \\u0b9a\\u0bc7\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc7\\u0ba3\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc7\\u0ba3\\u0bbf \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd - 115 (\\u0b85), \\u0bb7\\u0bc7\\u0b95\\u0bcd \\u0ba4\\u0bbe\\u0bb5\\u0bc2\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bc1 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 1000 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bb4\\u0b95 \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0ba3\\u0bbf\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b89\\u0ba4\\u0baf\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u2026", "\\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0b95\\u0bb0 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba8\\u0bc7.\\u0b9a\\u0bbf\\u0bb1\\u0bcd\\u0bb1\\u0bb0\\u0b9a\\u0bc1, \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b86\\u0bb3\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8f\\u0b86\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0b8e\\u0bae\\u0bcd.\\u0b95\\u0bbe\\u0bae\\u0bb0\\u0bbe\\u0b9c\\u0bcd, \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u2026", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0bae\\u0bcd, \\u0b9a\\u0bc7\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc7\\u0ba3\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0b9a\\u0bc7\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd - \\u0b95\\u0bb4\\u0b95 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bcb\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1, \\u0b87\\u0bb0\\u0bbe\\u0baf\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b8e\\u0bae\\u0bcd.\\u0b8e\\u0bb8\\u0bcd.\\u0bae\\u0bb9\\u0bbe\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bb4\\u0b95 \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0ba3\\u0bbf\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1 udhay_stalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u2026", "\\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0b95\\u0bb0 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0b
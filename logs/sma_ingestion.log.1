c1!\\n\\n#VoteTheft #Demonetisan #SIR", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbe\\u0b95, \\u0b95\\u0bb4\\u0b95 \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0ba3\\u0bbf\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1 udhay_stalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0ba8\\u0b9f\\u0bc8 \\u0baa\\u0bcb\\u0b9f\\u0bc1\\u0bae\\u0bcd dmkyouthwing \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bb5\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd #\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b9575_\\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0b
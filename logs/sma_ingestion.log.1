\\u0bc1.", "\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb2\\u0bbf \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0bb0\\u0bbe\\u0baa\\u0bb0\\u0bcd\\u0b9f\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0bc2\\u0bb8\\u0bcd MP, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b9a\\u0bca\\u0bb0\\u0bcd\\u0ba3 \\u0b9a\\u0bc7\\u0ba4\\u0bc1\\u0bb0\\u0bbe\\u0bae\\u0ba9\\u0bcd, \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b95\\u0bbf\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0bbf\\u0bb5\\u0bb0\\u0bbe\\u0b9c\\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 K S \\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd", "Be alert about #SIR  Prevent #VoteChor", "Select Committee- Insolvency and Bankruptcy Code (Amendment) Bill, 2025.", "\\u201cThe real strength of India lies in its unity.\\u201d \\u2013 Sardar Vallabhbhai Patel\\n\\nOn his birth anniversary, we remember the Iron Man of India, whose vision, courage, and statesmanship laid the foundation of a united and strong nation.\\n\\nSardar Patel\\u2019s relentless efforts in integrating more than 560 princely states stand as a testament to his unmatched leadership and unwavering commitment to national unity.", "Let us pay our heartfelt tribute to this great son of India and reaffirm our resolve to uphold the values of integrity, unity, and selfless service that he lived by.\\n\\n#SardarPatel #NationalUnityDay", "\\"I shall continue to serve until my last breath, and when I die, every drop of my blood will invigorate India and strengthen it.\\"\\n\\nIndira Gandhi was the embodiment of courage, sacrifice, and determination \\u2014 a visionary leader who guided India towards self-reliance and progress. She has inspired generations of women and continues to do so even today.", "On her martyrdom day, let us remember her with respect and gratitude. Her life and legacy will continue to guide us on the path of strength and service to the nation.\\n\\n#IndiraGandhi", "\\u0bae\\u0ba9 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0b89\\u0b9f\\u0bb2\\u0bcd \\u0bb5\\u0bb2\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0b95 \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0b95\\u0bc8 \\u0b95\\u0bc2\\u0b9f\\u0bc1\\u0bae\\u0bcd..\\n\\n#kanniyakumari #congress", "#\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bb2\\u0bcd #sir #specialrevision2025 #VoterList  #VoterUpdate #ElectionCommission #PoliticalNews #VoteForDemocracy #VotingRights #ManickamTagore", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1(31.10.2025)\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0ba9\\u0bcd\\u0bb1\\u0bae\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0b90\\u0bb0\\u0bbe\\u0bb5\\u0ba4\\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1 \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0bae\\u0ba3\\u0bbf \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0bb0\\u0ba4\\u0bcd\\u0ba9\\u0bbe \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbe \\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf  \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd , \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b89\\u0bb2\\u0b95\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b90\\u0bb0\\u0bbe\\u0bb5\\u0ba4\\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bc6\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd \\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0bae\\u0bbe\\u0bae\\u0bbe\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0b9c\\u0bc6\\u0baf\\u0bcd\\u0bb9\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.S.V.\\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0ba9\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0ba3\\u0bcd\\u0bae\\u0bc1\\u0b95\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb0\\u0bae\\u0ba3\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0b9a\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bb5\\u0bc7\\u0bb2\\u0bcd\\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0ba9\\u0bcd, \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd RTI \\u0baa\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd.", "#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf_\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbe_\\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9c\\u0bbf #thiruparankundram #floraltribute  #MartyrdomDay #IronLadyOfIndia", "#Malaimurasu #tamilpolitics  #NewsUpdate  #ModiSpeech #PoliticalNews  #Odisha #BiharPolitics #BJPGovernment  ##indianpolitics #ManickamTagore", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1(31.10.2025)\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0ba9\\u0bcd\\u0bb1\\u0bae\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0b90\\u0bb0\\u0bbe\\u0bb5\\u0ba4\\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1 \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0bae\\u0ba3\\u0bbf \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0bb0\\u0ba4\\u0bcd\\u0ba9\\u0bbe \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbe \\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd , \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b89\\u0bb2\\u0b95\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b90\\u0bb0\\u0bbe\\u0bb5\\u0ba4\\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bc6\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0ba3\\u0bcd\\u0bae\\u0bc1\\u0b95\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb0\\u0bae\\u0ba3\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0b9a\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bb5\\u0bc7\\u0bb2\\u0bcd\\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0ba9\\u0bcd, \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd RTI \\u0baa\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd.", "#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf_\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbe_\\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9c\\u0bbf #thiruparankundram #floraltribute  #MartyrdomDay #ironladyofindia", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1(31.10.2025) \\u0b9f\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbf \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0bb5\\u0bb3\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0b87\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0ba9\\u0bbf\\u0ba4\\u0bb0\\u0bcd \\u0b9a\\u0bb0\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0baa\\u0bbe\\u0baf\\u0bcd \\u0baa\\u0b9f\\u0bc7\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0b95\\u0bbf\\u0bb2 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0b95\\u0bbe\\u0bb0\\u0bcd\\u0b9c\\u0bc1\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc7 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd, \\u0b85\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b9a\\u0bcb\\u0ba9\\u0bbf\\u0baf\\u0bbe \\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd, \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb0\\u0bbe\\u0b95\\u0bc1\\u0bb2\\u0bcd \\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n#SardarVallabhbhaiPatel #ironmanofindia", "Leader of Opposition rahulgandhi ji Paid tribute to former Prime Minister Smt. Indira Gandhi at the Indira Gandhi Memorial in New Delhi on her martyrdom anniversary. Her courage, compassion, and unwavering love for India continue to inspire me every day.", "\\u0b9a\\u0bb0\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0baa\\u0bbe\\u0baf\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc7\\u0bb2\\u0bcd \\u0b9c\\u0bc6\\u0baf\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\ud83c\\uddee\\ud83c\\uddf3\\n\\n1875 \\u0b85\\u0b95\\u0bcd\\u0b9f\\u0bcb\\u0baa\\u0bb0\\u0bcd 31 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bc1\\u0b9c\\u0bb0\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0b9a\\u0bb0\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0baa\\u0bbe\\u0baf\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc7\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b9a\\u0bc1\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bc0\\u0bb0 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bcb\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0bb5\\u0bb0\\u0bbe\\u0b95 \\u0ba4\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd.\\n\\u0b85\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b8e\\u0bb3\\u0bbf\\u0baf \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0b95\\u0bcd\\u0b9
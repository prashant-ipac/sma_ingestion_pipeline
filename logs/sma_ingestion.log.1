26 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bbf\\u0bb2\\u0bcd,\\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0b9c\\u0ba9\\u0ba8\\u0bbe\\u0baf\\u0b95 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf, \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95-\\u0bb5\\u0bc8 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b87\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba4\\u0bbf\\u0b95 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bc0\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd - \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.NainarBJP \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n#\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0bae\\u0bcd_\\u0ba4\\u0bb2\\u0bc8\\u0ba8\\u0bbf\\u0bae\\u0bbf\\u0bb0_\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0ba9\\u0bbf\\u0ba9\\u0bcd_\\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd", "\\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0ba4\\u0bc6\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0b8e\\u0ba9\\u0bcd.\\u0b9f\\u0bbf.\\u0baa\\u0bbf.\\u0b9a\\u0bbf. \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0ba3\\u0bb0\\u0bcd\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd 11 \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0b99\\u0bcd\\u0b95\\u0ba9\\u0bcd\\u0bb5\\u0bbe\\u0b9f\\u0bbf \\u0bae\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0baa\\u0bc2\\u0bae\\u0bbf\\u0baa\\u0bc2\\u0b9c\\u0bc8 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0ba3\\u0bca\\u0bb3\\u0bbf", "A special outreach camp was organized in South Chennai Parliamentary Constituency to highlight the welfare schemes of Hon\\u2019ble Prime Minister Narendra Modi.\\n\\nApplications were received for various initiatives \\u2014 including schemes for street vendors and women entrepreneurs.\\n\\nA total of 82 applications were registered, of which 30 were immediately sanctioned for loans, while the remaining are under review", "\\u0ba4\\u0bc6\\u0ba9\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba8\\u0bb0\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bbf\\u0bb3\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0bc1\\u0b95\\u0bbe\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc1.\\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc1\\u0b95\\u0bbe\\u0bae\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbe\\u0bb2\\u0bc8\\u0baf\\u0bcb\\u0bb0 \\u0bb5\\u0bbf\\u0baf\\u0bbe\\u0baa\\u0bbe\\u0bb0\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bcb\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bb2 \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\
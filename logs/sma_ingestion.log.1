b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0bb1\\u0ba9\\u0bcd \\u0baa\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0bb0\\u0bcd \\u0bae\\u0ba9\\u0ba4\\u0bbe\\u0bb0 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbf \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n#WorldDisabilityDay", "Rupee in ICU under BJP Rule! \\n\\nWhen #BJP came to power,\\n$1 = \\u20b958\\n\\nAfter 11 years of their poor governance, $1 = \\u20b990.23 the worst fall in India\\u2019s history.\\n\\nA collapsing currency, skyrocketing #inflation, #unemployment at record highs, #economy sinking.\\nAnd yet the Union Government keeps selling speeches instead of solutions.\\n\\nThis is not economic progress. This is economic destruction.\\n\\n#USDvsINR", "When the Chief Election Commissioner himself openly lies in front of national media, what more proof do we need that institutions are being hijacked?\\n\\n#GyaneshKumar claimed that #India was invited to chair #IDEA because of global admiration for our elections, but the truth is, Chairmanship is purely rotational  It was India\\u2019s scheduled turn, Rotation fixed till 2033. His claim was misleading and false.", "If the #CEC can proudly lie on camera, imagine the level of manipulation behind closed doors, from #EVMs to voter rolls to election conduct.\\nThis is not neutrality.\\nThis is a shameless puppet serving the #BJP, not the Constitution.\\n\\nWhen the referee joins the ruling team, #democracy is the first casualty. India deserves an Election Commission, not an Election Companion to propaganda.", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bc7\\u0b9a \\u0bb5\\u0bbf\\u0bb0\\u0bcb\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0bc7\\u0ba9\\u0bcd. \\u0ba4\\u0bc7\\u0b9a\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0bb0\\u0bcb\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0bc7\\u0ba9\\u0bcd. \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bc7 \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0ba4\\u0bc1 \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0bc7\\u0ba9\\u0bcd. \\u0b87\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95\\u0bb5\\u0bc7 \\u0bb5\\u0bbe\\u0bb4\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bc7\\u0bb1\\u0bbf \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \'\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb5\\u0ba9\\u0bcd\' \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0baa\\u0bc6\\u0baf\\u0bb0\\u0bcd \\u0b9a\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. \'\\u0bb2\\u0bcb\\u0b95\\u0bcd \\u0baa\\u0bb5\\u0ba9\\u0bcd\' \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0baa\\u0bc1\\u0bb2\\u0bcd\\u0bb2\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0b87\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0ba9\\u0bcd \\u0baa\\u0bbe\\u0baf\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1!\\n\\n#\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 130\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0b95\\u0bb1\\u0bcd\\u0baa\\u0bb5\\u0bc8 \\u0b95\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b9a\\u0bcd, \\u0b9a\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b85\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bc6\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bb5\\u0bb0\\u0bc8 \\u0b85\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9f \\u0b85\\u0bb1\\u0bae\\u0bbe\\u0ba9\\u0ba4\\u0bc1 \\u0bb5\\u0bb4\\u0bbf\\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "Last month, five workers from Thoothukudi and Tenkasi,  Ponnudurai, Puthiyavan, Petchimuthu, Isakkiraja, and Thalapathi Suresh, were abducted by an armed group in Mali. With no updates so far, their families remain in unbearable anxiety and grief.\\n\\nDuring Zero Hour in Lok Sabha today, I urged the Union Government to act urgently, ensure their safe rescue, and bring them back home without delay.", "\\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0bb2\\u0bbf \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b86\\u0baf\\u0bc1\\u0ba4\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0bbe\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0ba9\\u0bcd\\u0b95\\u0bbe\\u0b9a\\u0bbf\\u0baf\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bca\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0ba4\\u0bc1\\u0bb0\\u0bc8, \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bb5\\u0ba9\\u0bcd, \\u0baa\\u0bc7\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b87\\u0b9a\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb3\\u0baa\\u0ba4\\u0bbf \\u0b9a\\u0bc1\\u0bb0\\u0bc7\\u0bb7\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf \\u0b90\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8 \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b87\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bc7\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc1\\u0baf\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b86\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba9\\u0bb0\\u0bcd. \\n\\n\\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bbf\\u0bb5\\u0b95\\u0bbe\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0bb5\\u0bbf\\u0bb0\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0b85\\u0ba4\\u0bcd\\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95 \\u0bae\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa \\u0bb5\\u0bb4\\u0bbf\\u0bb5\\u0b95\\u0bc8 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb2\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bc7\\u0b9a\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.\\n\\n#DMKParliament", "Participated in the protest opposing the Union BJP\\u2019s new Labour Codes today along with INDIA Alliance MPs at Parliament. This is a direct attack on workers\\u2019 rights because it effectively obliterates collective bargaining, erodes minimum wages and job security, and opens the door to pre-independence type unchecked corporate exploitation. \\n\\nWe demand the immediate withdrawal of these regressive reforms to Labour Laws.\\n\\n#DMKinParliament", "\\u0b9a\\u0bb0\\u0bcd\\u0bb5\\u0ba4\\u0bc7\\u0b9a \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1. \\u0b9a\\u0bb5\\u0bbe\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb2 \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0ba9\\u0bbe\\u0bb3\\u0bbf \\u0b9a\\u0b95\\u0bcb\\u0ba4\\u0bb0 - \\u0b9a\\u0b95\\u0bcb\\u0ba4\\u0bb0\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bb2\\u0ba9\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1\\u0b9f\\u0ba9\\u0bcd, \\u0b9a\\u0bc1\\u0baf\\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8\\u0baf\\u0bcb\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bbf\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bb0\\u0bae\\u0bcd \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0ba8\\u0bae\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0b9f\\u0bae\\u0bc8!\\n\\n\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bc1 \\u0baa\\u0bcb\\u0bb2, \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0bae\\u0bbe\\u0b95 \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb5\\u0bcb\\u0bae\\u0bcd.", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0bae\\u0bca\\u0bb4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd A.I. \\u0b8e\\u0ba9\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb1\\u0bcd\\u0b95\\u0bc8 \\u0ba8\\u0bc1\\u0ba3\\u0bcd\\u0ba3\\u0bb1\\u0bbf\\u0bb5\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0ba9?\\n\\nRaised critical questions to goi_meity on Indian-language AI datasets, especially Tamil Datasets and digital inclusion:\\n\\n\\ud83d\\udd35What are the Govt-created or funded AI datasets for speech recognition, machine translation & content moderation?\\n\\n\\ud83d\\udd35 How much was allocated vs actually utilised in the last 5 years \\u2014 language-wise & agency-wise?", "\\ud83d\\udd35 What dedicated effort is being made to build high-quality Tamil datasets, including spoken variants, to improve AI accuracy & safety?\\n\\n\\ud83d\\udd35 Have Tamil linguistic experts, universities or research bodies been consulted? If yes, where are the details?\\n\\n\\ud83d\\udd35 What is the total budget, allocation, sanction & expenditure for Tamil-language AI datasets?\\n\\nTransparent AI needs transparent data. \\n#IndiaAI #TamilAI #DigitalInclusion\\n\\nmkstalin udhay_stalin arivalayam dmkyouthwing DMKITwing dmksdwing dmkchennai Chennai", "Raised critical questions to goi_meity on Indian-language AI datasets, especially Tamil Datasets and digital inclusion:\\n\\n\\ud83d\\udd35What are the Govt-created or funded AI datasets for speech recognition, machine translation & content moderation?\\n\\n\\ud83d\\udd35 How much was allocated vs actually utilised in the last 5 years \\u2014 language-wise & agency-wise?\\n\\n\\ud83d\\udd35 What dedicated effort is being made to build high-quality Tamil datasets, including spoken variants, to improve AI accuracy & safety?", "\\ud83d\\udd35 Have Tamil linguistic experts, universities or research bodies been consulted? If yes, where are the details?\\n\\n\\ud83d\\udd35 What is the total budget, allocation, sanction & expenditure for Tamil-language AI datasets?\\n\\nTransparent AI needs transparent data. \\n#IndiaAI #TamilAI #DigitalInclusion\\n\\nmkstalin udhay_stalin arivalayam dmkyouthwing DMKITwing dmksdwing dmkchennai", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0ba4\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd!\\n\\n\\u0baa\\u0bbf\\u0bb3\\u0bcd\\u0bb3\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0b9a\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bcb\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0bae
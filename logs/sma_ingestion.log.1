\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0ba9\\u0bcd, \\u0b8e\\u0bae\\u0bcd.\\u0b8e\\u0bb2\\u0bcd.\\u0b8f, \\u0ba4\\u0b9e\\u0bcd\\u0b9a\\u0bc8 \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a.\\u0bae\\u0bc1\\u0bb0\\u0b9a\\u0bca\\u0bb2\\u0bbf, \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b95\\u0bbe.\\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe\\u0ba4\\u0bc1\\u0bb0\\u0bc8, \\u0baa\\u0bc7\\u0bb0\\u0bbe\\u0bb5\\u0bc2\\u0bb0\\u0ba3\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8e\\u0ba9\\u0bcd.\\u0b85\\u0b9a\\u0bcb\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd, \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bb5\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8e\\u0ba9\\u0bcd.\\u0baa\\u0bbf.\\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0ba9\\u0bcd, \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0ba3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8f\\u0ba9\\u0bbe\\u0ba4\\u0bbf \\u0baa\\u0bbe\\u0bb2\\u0bc1, \\u0b95\\u0bb4\\u0b95 \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bbf.\\u0ba8\\u0bbf\\u0bb5\\u0bc7\\u0ba4\\u0bbe \\u0b9c\\u0bc6\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bc1\\u0bb0\\u0bc7\\u0bb7\\u0bcd \\u0b9c\\u0bc6.\\u0bae\\u0ba9\\u0bcb\\u0b95\\u0bb0\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bb5\\u0bc7.\\u0b95\\u0bcc\\u0ba4\\u0bae\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd.\\u0b86\\u0ba9\\u0ba8\\u0bcd\\u0ba4\\u0bcd, \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd", "\\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd.\\u0b86\\u0ba9\\u0ba8\\u0bcd\\u0ba4\\u0bcd, \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0baa\\u0bbf.\\u0b95\\u0bc7.\\u0baa\\u0bbe\\u0baa\\u0bc1, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1\\u0b95\\u0bae\\u0ba4\\u0bc1 \\u0b87\\u0bb7\\u0bcd\\u0bb0\\u0ba4\\u0bcd, \\u0ba4\\u0b9e\\u0bcd\\u0b9a\\u0bc8 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b86\\u0bb0\\u0bcd.\\u0bb0\\u0bbe\\u0ba3\\u0bbf\\u0b95\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd, \\u0baa\\u0bc1\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bb5\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.VGR.\\u0bae\\u0ba3\\u0bbf\\u0bb5\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd, \\u0ba4\\u0b9e\\u0bcd\\u0b9a\\u0bc8 \\u0ba4\\u0bc6\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8e\\u0bae\\u0bcd.\\u0b95\\u0bcb\\u0bb5\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bb0\\u0bbe\\u0b9c\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a.\\u0b9a\\u0ba3\\u0bcd\\u0bae\\u0bc1\\u0b95\\u0b9a\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bb0\\u0bae\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bbf.\\u0bb0\\u0bbe\\u0bae\\u0ba4\\u0bbe\\u0bb8\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b86.\\u0baa\\u0bbe\\u0bb2\\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9f\\u0bbf.\\u0b9a\\u0bc0\\u0ba9\\u0bbf\\u0bb5\\u0bbe\\u0b9a\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba8.\\u0bb2\\u0bc6\\u0b9f\\u0bcd\\u0b9a\\u0bc1\\u0bae\\u0ba3\\u0b95\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b86.\\u0bb0\\u0bbe\\u0b9c\\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u2026", "\\"\\u0b89\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf, \\u0b86\\u0bb0\\u0bbe\\u0baf\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0b9f\\u0bbf\\u0baf\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b95\\u0bb1\\u0bcd\\u0bb1\\u0bb2\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0bb5\\u0bc7 \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0ba4\\u0bc1\\" \\u0b8e\\u0ba9 \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc2\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bc1\\u0bb0\\u0bc8 \\u0b8e\\u0ba9\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd!\\n\\n\\u0b85\\u0ba4\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0bb0\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0b9f\\u0bb1\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd 2021-\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\"Physical Activity for Skill Development Through Machine Learning\\" \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bb2\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bbf\\u0ba9\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd.", "\\u0b85\\u0ba4\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0bae\\u0bca\\u0bb4\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bc1 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc1. \\u0b85\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u201c\\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u201d \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bc7\\u0ba9\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0bb5\\u0bcb\\u0b9f\\u0bc1 \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\ud83d\\udc68\\u200d\\ud83c\\udf93\\n\\n*Learning should never end. We must keep widening our horizons and continue pursuing higher studies and research.* This is the advice given by our Dravidian Headmaster - Hon\'ble Chief Minister Thiru. mkstalin and it has been a guiding force in my own journey.", "Motivated by his words, I began my PH.D. in 2021 in the Department of Physical Education at National College, Tiruchirappalli, under the supervision of Dr. Prasanna Bajali, on the topic \\u201cPhysical Activity for Skill Development Through Machine Learning\\u201d.\\n\\nMy viva voce took place today. I presented the conclusions of my research, successfully defended my thesis and I am glad to share that I have now earned my doctoral degree. \\ud83c\\udf93", "\\u0b9a\\u0bc7\\u0bb2\\u0bae\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bb0\\u0bbe\\u0baf\\u0ba9\\u0bcd \\u0bae\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0bb5\\u0bc7\\u0bb2\\u0bae\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\n\\u0b95\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bbf \\u0b9a\\u0bc1\\u0b95\\u0ba9\\u0bcd\\u0baf\\u0bbe,\\n\\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0baa\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0b89\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b89\\u0bb1\\u0bc8\\u0bb5\\u0bbf\\u0b9f\\u0baa\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, JEE \\u0ba8\\u0bc1\\u0bb4\\u0bc8\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\n\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bb5\\u0bb0\\u0bcd. \\n\\u0ba4\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\nProduction Engineering \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd. \\n \\n\\u0ba8\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bb0\\u0bcd\\u0bb5\\u0ba4\\u0bc7\\u0b9a \\u0b85\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\n\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0bae\\u0bc1\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0b89\\u0baf\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bb3\\u0bcd \\n\\u0ba8\\u0bc1\\u0bb4\\u0bc8\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\n\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc8, \\u0b89\\u0baa\\u0b95\\u0bb0\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0baf\\u0ba3\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bae\\u0bcd,", "\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc8, \\u0b89\\u0baa\\u0b95\\u0bb0\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0baf\\u0ba3\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bae\\u0bcd, \\n\\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bcd\\n\\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd mkstalin \\n\\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bc1!", "\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0b89\\u0baf\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\n\\u0b86\\u0ba4\\u0bbf\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f\\u0bb0\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\u0ba8\\u0bc1\\u0bb4\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc1\\u0b9f\\u0bb0\\u0bbe\\u0bb2\\u0bcd \\u0b89\\u0bb2\\u0b95\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bb4\\u0bbf \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd.\\n\\u0b9a\\u0bbf\\u0bb1\\u0b95\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0bb5\\u0bbe\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b86\\u0bb3\\u0bcd\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc7!\\n\\n#\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd_\\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4_\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd eps.tamilnadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb0\\u0bbe\\u0b9c\\u0b95\\u0bae\\u0bcd\\u0baa\\u0bb3 \\u0ba4\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0ba8\\u0bbe\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0b9a\\u0b99\\u0bcd\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bbe\\u0ba9, \\u0bb5\\u0bc0\\u0bb0\\u0baa\\u0bbe\\u0ba3\\u
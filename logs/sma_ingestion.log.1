\\u0ba3\\u0bbf\\u0ba9\\u0bcd 221 \\u0b86\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bc1\\u0bb5\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf.", "\\u0b86\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bb0\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0b9a\\u0bbe\\u0ba4\\u0bbe\\u0bb0\\u0ba3 \\u0ba8\\u0bbf\\u0bb2\\u0baa\\u0bcd\\u0baa\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 200 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd, \\u0b95\\u0bcb\\u0baf\\u0bae\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0b9f\\u0bbf\\u0ba9 \\u0b89\\u0bb4\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb2\\u0bcd, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0baa\\u0bb2 \\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0b95\\u0bb0\\u0bae\\u0bbe\\u0b95 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bcd, \\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0bae\\u0bcd \\u0b8e\\u0ba9, \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b95\\u0bcb\\u0baf\\u0bae\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0ba9\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0b89\\u0ba3\\u0bcd\\u0b9f\\u0bc1.", "\\u0b9a\\u0bc1\\u0bb5\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0b9a\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0bbe\\u0ba3\\u0bbf \\u0ba4\\u0ba3\\u0bcd\\u0ba3\\u0bc0\\u0bb0\\u0bc1\\u0bae\\u0bcd, \\u0b87\\u0ba9\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0b95\\u0bca\\u0b99\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bc1\\u0bae\\u0bcd, \\u0b85\\u0bb1\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0b9f\\u0bcd\\u0baa\\u0bb5\\u0bc6\\u0b9f\\u0bcd\\u0baa \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bbe\\u0ba9 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0baf\\u0bb0\\u0bcd\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0b95\\u0bcb\\u0baf\\u0bae\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bcd, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bb4\\u0bbf\\u0bb5\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0baa\\u0bc1\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0ba3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0bb5\\u0bbf\\u0bb0\\u0bc8\\u0bb5\\u0bbf\\u0bb2\\u0bcd, \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bc8\\u0baf\\u0bbe\\u0bb2\\u0bbe\\u0b95\\u0bbe\\u0ba4 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8 \\u0b85\\u0b95\\u0bb1\\u0bcd\\u0bb1\\u0bbf, \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0b95\\u0bcb\\u0baf\\u0bae\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0baf\\u0bc8 \\u0bae\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd.", "\\u0ba8\\u0bc6\\u0b9e\\u0bcd\\u0b9a\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd \\u0b85\\u0b9a\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bc8 \\u0baf\\u0bbe\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0baf\\u0bae\\u0bc1\\u0bae\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8\\ud83d\\udd25 @actorvijay \\n\\n#tvkitwing #tvkvijay #thalapathy #thalapathyvijay #tamilagavettrikazhagam #vijay", "\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b93\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0b92\\u0bb2\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bcd! @actorvijay \\n\\n#tvkitwing #tvkvijay #thalapathy #thalapathyvijay #tamilagavettrikazhagam #vijay", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbe\\u0bb3\\u0bc8\\u0baf \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1 \\ud83d\\udd25@actorvijay \\n\\n#tvkitwing #tvkvijay #thalapathy #thalapathyvijay #tamilagavettrikazhagam #vijay #tvk", "Thalapathy \\ud83d\\udd25", "Honoured to be deputed by our Hon\\u2019ble Chief Minister Thiru mkstalin to represent the Government of Tamil Nadu at the 350th year commemoration of the supreme sacrifice of the Ninth Sikh Guru, Sri Guru Tegh Bahadur , held at Sri Anandpur Sahib in Punjab.\\n\\nAlong with Hon\\u2019ble MP Dr. kalanidhiveeraswamy , I formally conveyed the greetings of our Hon\\u2019ble Chief Minister Thiru M.K. Stalin to the Hon\\u2019ble Chief Minister of Punjab, Thiru bhagwantmann1 , and handed over his message on this sacred occasion.", "Tamil Nadu joins the Sikh community and the people of Punjab in paying respectful homage to Guru Tegh Bahadur, whose life and martyrdom continue to inspire humanity across faiths and regions.", "Delighted to inaugurate the iTNT Coimbatore Regional Hub at the GCT Campus \\u2014 our third regional centre in Tamil Nadu and the first for the Western Region, following Madurai and Trichy.", "As part of the event, I also launched the Bosch Innovation Challenge with Bosch Global Software Technologies and itnthub , and IP Nexus 2026 with Karpagam Innovation and Incubation Council to strengthen IP commercialisation and technology transfer. An MoU was also exchanged with PSG-STEP to establish iTNT Hub\\u2019s satellite office in Coimbatore.\\n\\nTamil Nadu is steadily diversifying its research ecosystem and converting this strength into a vibrant and future-ready Deep Tech landscape.", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b89\\u0baf\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0baa\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0ba3\\u0bcd \\u0baa\\u0bbf\\u0bb3\\u0bcd\\u0bb3\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd \\u0bb0\\u0bc2.1,000 \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd #\\u0baa\\u0bc1\\u0ba4\\u0bc1\\u0bae\\u0bc8\\u0baa\\u0bcd_\\u0baa\\u0bc6\\u0ba3\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b85\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b8e\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0bc8\\u0baf \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bb5\\u0bbf\\u0ba4\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bb1\\u0bcd\\u0b9a\\u0bbe\\u0ba9\\u0bc
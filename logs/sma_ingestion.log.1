cd\\u0b9a\\u0bbf \\u0b95\\u0bbe\\u0ba3 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba8\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0bae\\u0bbe\\u0bb0\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bb0\\u0bbe\\u0b9c\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "\\u0b9a\\u0bc1\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b8e\\u0bb2\\u0bcd. \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0ba8\\u0bbe\\u0ba4 \\u0b95\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 116 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 (25.10.2025) \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8, \\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bae\\u0bc2\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0baa\\u0bb5\\u0ba9\\u0bbf\\u0bb2\\u0bcd, \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb2\\u0bb0\\u0bcd \\u0ba4\\u0bc2\\u0bb5\\u0bbf \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "LIC can issue long rebuttals, but the core question remains: why did LIC India\'s \\u201cdue diligence\\u201d lead to major investments only in the Adani Group, especially when global funds and foreign banks were backing away at that time?\\n\\nThis is people\\u2019s life savings, not a private purse.If there was no external pressure, release the investment committee files. Let facts speak.", "One thing is very clear.All our public institutions are meant to serve the people.\\nBut  they are serving only the Adani group and doing so at the behest of the Modi government.", "\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bc7 \\u0b85\\u0bb4\\u0bbf\\u0baf\\u0bbe\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bae\\u0bcd ....\\n\\n#kanyakumari #student", "\\u0ba4\\u0bcb\\u0bb4\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc7 \\u0b9a\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bae\\u0bbe\\u0b95 \\u0b89\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd ! actorvijay", "\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0baa\\u0bb5\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0ba9\\u0bcd\\n\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb0\\u0bb5\\u0bb4\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bb5\\u0ba9\\u0bcd \\u0ba8\\u0b9f\\u0bbf\\u0b95\\u0ba9\\u0bcd !\\n\\n\\u0b89\\u0bb2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0baa\\u0bbe\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0ba9\\u0bcd \\u
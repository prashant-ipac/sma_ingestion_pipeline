\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf..!\\n\\n#\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0bae\\u0bcd_\\u0ba4\\u0bb2\\u0bc8\\u0ba8\\u0bbf\\u0bae\\u0bbf\\u0bb0_\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0ba9\\u0bbf\\u0ba9\\u0bcd_\\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd", "\\"\\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0b9a\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bc0\\u0bb0\\u0bcd \\u0ba4\\u0bc7\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0ba4\\u0bc1\\" \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b9a\\u0bca\\u0ba9\\u0bcd\\u0ba9\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0bbe\\u0b95, \\"\\u0b92\\u0bb0\\u0bc1 \\u0b9a\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bc0\\u0bb0\\u0bcd \\u0b95\\u0bc2\\u0b9f \\u0bb5\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc1\\" \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bbf \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd, \\u0b85\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0b9c \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd!\\n\\n#\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0bae\\u0bcd_\\u0ba4\\u0bb2\\u0bc8\\u0ba8\\u0bbf\\u0bae\\u0bbf\\u0bb0_\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0ba9\\u0bbf\\u0ba9\\u0bcd_\\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd", "\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bb5\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bbf\\u0bb1\\u0b95\\u0bc1, \\u0b9a\\u0bca\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bbf \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0bb5\\u0bc1, \\u0bae\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba3 \\u0b89\
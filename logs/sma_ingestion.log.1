\\u0bae\\u0ba3 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bc8\\u0baf\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bae\\u0ba3\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0baa\\u0bcb\\u0ba4\\u0bc1", "\\u0b9a\\u0bbf\\u0bb5\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bc8, \\u0bae\\u0bbe\\u0ba9\\u0bbe\\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0, \\u0ba8\\u0b95\\u0bb0, \\u0baa\\u0bc7\\u0bb0\\u0bc2\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd BLA 2 \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0baa\\u0bcb\\u0ba4\\u0bc1", "\\u0b87\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0bae\\u0ba3\\u0bbf \\u0b85\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbe \\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 108\\u0b86\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0ba9\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0bbf\\u0bb5\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 MP \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbe \\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0baa\\u0bcb\\u0ba4\\u0bc1. #IndiraGandhi", "#germany", "Last week, I had the privilege of being part of the delegation of Indian Members of Parliament to Germany \\u2014 visiting both Berlin and the Free State of Thuringia \\u2014 under the Guest Programme of the Federal Republic of Germany. The visit centred on understanding how a mature federal democracy responds to the pressures of rising populism, disinformation, and the growing influence of Big Tech.", "Our delegation included Ms. Priyanka Chaturvedi, Dr. John Brittas, Mr. Arun Nehru, Mr. Aga Syed Ruhullah Mehdi, Dr. Hemang Joshi and Mr. Pushpendra Saroj. Over several days, we engaged with German institutions that are at the heart of democratic resilience and federal governance.", "In Berlin, we held detailed discussions with the Federal Agency for Civic Education, which plays a critical role in countering misinformation and strengthening democratic literacy. Their approach to ensuring transparency from major tech platforms was particularly instructive. We also met senior officials at the Federal Foreign Office for a deep exchange on global political trends and shared democratic challenges.", "A highlight was our visit to the Bundestag, where we interacted with Mr. Josef Oster, Acting Chairman of the Committee on Internal Affairs, along with committee members from across the political spectrum. Their candid reflections on German politics and policy priorities offered meaningful insights. At the Bundesrat, Dr. Georg Kleeman, Deputy Secretary General, explained the dynamics of Germany\\u2019s powerful federal chamber and the role of the L\\u00e4nder in national decision-making.", "Germany\\u2019s federal structure stood out \\u2014 robust state autonomy, clear separation of powers, and strong institutional checks that prevent over-centralisation. Our visit to Erfurt, capital of Thuringia, helped us appreciate this in depth. At the Thuringian Landtag, President Dr. Thadaus K\\u00f6nig briefed us on the functioning of their state parliament, coalition negotiations, and legislative responsibilities. The Mayor of Erfurt, Mr. Andreas Horn, extended a warm welcome at the historic City Hall.", "We also visited Schloss Friedenstein in Gotha, once home to the Dukes of Saxe-Coburg and Gotha, and now a treasure house of", "\\u0ba8\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1 (18.11.2025) \\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 72-\\u0b86\\u0bb5\\u0ba4\\u0bc1 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb1\\u0bb5\\u0bc1 \\u0bb5\\u0bbe\\u0bb0 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd, \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb1\\u0bb5\\u0bc1 \\u0b9a\\u0b99\\u0bcd\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0bae\\u0bbe\\u0ba3\\u0bb5,\\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bb0\\u0bbf\\u0b9a\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd. \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb1\\u0bb5\\u0bc1 \\u0b9a\\u0b99\\u0bcd\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0bbe\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0ba4\\u0bb4\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd,\\u0b95\\u0bc7\\u0b9f\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd ,\\u0b9a\\u0bc1\\u0baf \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd,\\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1  \\u0b95\\u0b9f\\u0ba9\\u0bcd \\u0b89\\u0ba4\\u0bb5\\u0bbf \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd. \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb0\\u0bcd, \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bc7\\u0baf\\u0bb0\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbf\\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bb1\\u0bb5\\u0bc1", "\\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbf\\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bb1\\u0bb5\\u0bc1
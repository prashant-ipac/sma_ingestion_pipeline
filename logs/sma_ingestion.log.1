0b95\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd..!", "Blessed to be at #KashiTamilSangamam 4.0 among our brothers & sisters from TN and other parts of India. Our beloved PM Thiru Narendra Modi avl\\u2019s vision is ensuring that our rich Tamil culture finds its place in our education system. With Hon CM of UP Thiru Yogi Adityanath avl\\u2019s stewardship and our Hon Minister of Education Thiru Dharmendra Pradhan avl\\u2019s push, Tamil culture is celebrated beyond the borders of TN.", "This historic gathering bridges Kashi\\u2019s timeless spirituality with Tamil Nadu\\u2019s rich heritage. Through #TamilKarkalam, UP schools will now teach Tamil, while UP students will travel to TN to discover our cultural treasures. IIT Madras and BHU stand as partners in this cultural collaboration.", "Language must unite, never divide. When a student from Varanasi learns Tamil and a student from Madurai discovers Kashi\\u2019s wisdom, we strengthen the spirit of Ek Bharat, Shreshtha Bharat and this is how we honour our ancestors while building the India of tomorrow.", "DMK: Masters of Manipulation", "\\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc7\\u0bb5\\u0bc8 \\u0bae\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0baa\\u0bb0\\u0bbf\\u0bae\\u0bb2\\u0bc8 \\u0b90\\u0baf\\u0baa\\u0bcd\\u0baa\\u0bbe \\u0b9a\\u0bc7\\u0bb5\\u0bbe \\u0b9a\\u0bae\\u0bbe\\u0b9c\\u0bae\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0bb8\\u0bcd\\u0bb0\\u0bc0 \\u0b90\\u0baf\\u0baa\\u0bcd\\u0baa \\u0b9a\\u0bc1\\u0bb5\\u0bbe\\u0bae\\u0bbf \\u0baa\\u0b9f\\u0bbf \\u0baa\\u0bc2\\u0b9c\\u0bc8 \\u0b95\\u0bbe\\u0ba3\\u0bca\\u0bb3\\u0bbf.\\n\\n\\u0b9a\\u0bc1\\u0bb5\\u0bbe\\u0bae\\u0bbf\\u0baf\\u0bc7! \\u0b9a\\u0bb0\\u0ba3\\u0bae\\u0bcd \\u0b90\\u0baf\\u0baa\\u0bcd\\u0baa\\u0bbe!!", "\\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc0\\u0ba4\\u0bc1 \\u0b85\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bc1\\u0bb1\\u0bc8, \\u0b95\\u0bca\\u0b9f\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bca\\u0bb2\\u0bc8\\u0b95\\u0bb3\\u0bcd, \\u0b9a\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bae\\u0bcd \\u0bb2\\u0bbe\\u0b95\\u0bcd \\u0b85\\u0baa\\u0bcd \\u0b9f\\u0bc6\\u0ba4\\u0bcd \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0ba4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9a\\u0bcd \\u0b9a\\u0bc2\\u0b9f\\u0bc1, \\u0baa\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0baa\\u0bbe\\u0bb2\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0bb5\\u0ba9\\u0bcd\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9 \\u0b8e\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bc8 \\u0b8e\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bc8 \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba9.\\n\\n\\u0b87\\u0ba4\\u0bc8\\u0baf\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \'\\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0bae\\u0bcd\' \\u0b8e\\u0ba9\\u0b9a\\u0bcd \\u0b9a\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd \\u0baa\\u0bc2\\u0b9a\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0baf\\u0bc8 \\u0bae\\u0bb1\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf!\\n\\n- \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\
95\\u0bb4\\u0b95\\u0bae\\u0bcd. \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bbe.\\u0b9a\\u0bbf.\\u0b9a\\u0bbf\\u0bb5\\u0b9a\\u0b99\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd.\\n\\n#DravidianModel \\n#PublicTransportDay", "\\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0ba4\\u0bc0\\u0bb5\\u0bbf\\u0bb0 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bcd (SIR) \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0ba4\\u0bbf\\u0bb5\\u0bb2\\u0bc8\\u0baf\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0ba3\\u0bcd\\u0ba3\\u0bbf \\u0b85\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba4\\u0bc1\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bae\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0bc1\\u0baf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0b95\\u0bcd\\u0b95 \\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0b9f\\u0bbf \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd. \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b9c\\u0ba9\\u0ba8\\u0bbe\\u0baf\\u0b95\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bca\\u0bb2\\u0bc8 \\u0ba8\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0b9f\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0ba8\\u0bae\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd!\\n\\n#\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1_\\u0ba4\\u0bb2\\u0bc8\\u0b95\\u0bc1\\u0ba9\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc1", "Tamil Nadu isn\\u2019t just competing in sports, we\\u2019re redefining how a State powers athletic excellence through #governance.\\n\\nUnder the #DravidianModel,\\n1. Barriers to access are removed\\n2. Rural athletes rise with State support\\n3. Transparent, merit based selection is ensured\\n4. International standard facilities reach every district\\n5. Sports becomes a tool for social justice, not just medals", "This is why #TamilNadu is producing #Olympians, world #champions, para athlete stars, and record medal winners, not by chance, but by policy.\\n\\nDetailed column, Hon\'ble Deputy Chief Minister Thiru. udhay_stalin  for the_hindu \\n\\n\\ud83d\\udd17: https://www.thehindu.com/opinion/lead/applying-the-dravidian-algorithm-to-sports/article69327252.ece\\n\\n#DMK4TN", "\\"\\u0b95\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 - \\u0b9a\\u0bbf\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0bc1 - \\u0ba8\\u0bc0\\u0bb2\\u0bae\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0b8e\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bcd \\u0b95\\u0bbe\\u
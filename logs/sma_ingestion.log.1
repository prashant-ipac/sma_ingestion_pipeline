u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0ba4\\u0bb5\\u0bb1\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bb1\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0b9f\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0bae\\u0bc1\\u0baf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0bb5\\u0bc6\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0b9a\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.", "\\u0b9a\\u0bca\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bcd \\u0ba4\\u0bb5\\u0bb1\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95, \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc0\\u0ba4\\u0bc1 \\u0baa\\u0bb4\\u0bbf \\u0b9a\\u0bc1\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd \\u0ba4\\u0baf\\u0bbe\\u0bb0\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8. \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0bb1\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bc7 \\u0bae\\u0bc6\\u0b9f\\u0bcd\\u0bb0\\u0bcb \\u0b95\\u0bcb\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa \\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bbe\\u0bb0\\u0ba3\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0b8e\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0b92\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb5\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd mkstalin..!", "It is truly disheartening to witness how, year after year, the atheist LDF govt\\u2019s apathy has resulted in avoidable hardship for lakhs of Ayyappa devotees.", "Pilgrims from across the nation are being put through immense difficulty due to the LDF govt\\u2019s poor preparation and mismanagement. On one hand, essential services for devotees remain inadequate; on the other, it is deeply troubling to learn that organisations such as the Ayyappa Seva Sangham, the Amritanandamayi Math, and the Subramanya Religious Trust have reportedly been restricted from offering their voluntary support.", "Sabarimala is not merely a pilgrimage site; it is a spiritual anchor for millions in our country. The least a government can do is uphold its responsibility with sincerity and respect.", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0ba4\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0ba3\\u0bae\\u0bcd \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bc7 \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1?", "\\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4 \\u0ba8\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b8f\\u0bb0\\u0bbe\\u0bb3\\u0bae\\u0bcd.", "\\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc0\\u0ba4\\u0bc1 \\u0b95\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0bca\\u0baf\\u0bcd \\u0baa\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95.\\n\\narivalayam", "When I entered the Coimbatore South election, I knew it wouldn\\u2019t be a regular contest. Running against actor Kamal Haasan brought attention, expectations, and pressure. But my focus stayed on the people who trusted me. Every decision, every step, and every message came from that place of responsibility. \\ud83e\\udd1d\\n\\n#MyVoice #CoimbatoreSouth #ElectionStories #KamalHaasan #LeadershipJourney", "\\u0ba4\\u0bb5\\u0bb1\\u0bbe\\u0ba9 \\u0bae\\u0bc6\\u0b9f\\u0bcd\\u0bb0\\u0bcb \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b9a\\u0bae\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.\\n\\narivalayam l #Metro", "The 56th edition of #IFFI was flagged off Open Parade today in Goa. Over the years, the festival has firmly established itself as one of the world\\u2019s premier film events \\u2014 a vibrant platform that brings together filmmakers, fosters co-production, encourages innovation and collaboration, and continues to nurture the next generation of Bharat\\u2019s storytellers and content creators.", "Under the visionary leadership of Hon\\u2019ble Prime Minister Shri narendramodi ji, and the guidance of Hon\\u2019ble Union Minister of Information & Broadcasting Shri. ashwini.vaishnaw ji, Hon\\u2019ble Governor of Goa Shri Pusapati Ashok Gajapathi Raju ji, Hon\\u2019ble Chief Minister of Goa Shri. drpramodpsawant ji, and Hon\\u2019ble Minister Shri. shripadyessonaik ji, IFFI has scaled new heights, emerging as a truly global celebration of the media and entertainment industry.\\n\\n#IFFI56\\n#OpenParade", "Inaugurated the WAVES Film Bazaar at the 56th #IFFI in Goa today. \\nThis dynamic marketplace, held as part of one of Asia\\u2019s premier film festivals, is strengthening India\\u2019s creative economy and opening new avenues for co-production, content creation, and global partnerships.", "The event was also graced by Shri Sanjay Jaju ji, Secretary, Ministry of Information & Broadcasting; legendary actor Shri. Balakrishna ji; the ever-inspiring Shri Anupam Kher ji; festival director Shri Shekhar Kapur ji; Ms Jaewon Kim, Member of National Assembly, Republic of Korea; along with other officers and distinguished guests \\u2014 together setting the tone for vibrant days of collaboration, innovation, and cinematic exchange.", "A proud moment for India as Ms Jaewon Kim, Member of National Assembly, Republic of Korea, sings Vande Maataram at the inauguration of #WAVESFilmBazaar on day 1 of the 56th International Film Festival of India. This reflects the global stature of India, led by our Hon\\u2019ble Prime Minister Shri Narendra Modi ji, and the impact of our 150 year old national song - irrespective of regions, languages, and cultures.\\n\\n#IFFI\\n#VandeMaataram\\n\\n narendramodi ashwini.vaishnaw mib_india"], "model": "voyage-multilingual-2", "input_type": "document", "truncation": true, "output_dtype": "float", "output_dimension": 1024, "encoding_format": "base64"}' message='Post details'

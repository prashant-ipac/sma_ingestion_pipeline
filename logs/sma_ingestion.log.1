bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf, \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0bae\\u0bc1\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bcb\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0ba3\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bca\\u0b9f\\u0bbf \\u0b8f\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bae\\u0bbe\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 (06.12.2025) \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b8e\\u0bb4\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc2\\u0bb0\\u0bcd \\u0bb0\\u0bae\\u0b9f\\u0bbe \\u0bb9\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bcd \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc1. \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b95\\u0bc1. \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bc8 MLA \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0ba9 \\u0b89\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd.", "\\u0b85\\u0b95\\u0bbf\\u0bb2 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb5\\u0bbf.\\u0b95\\u0bc7. \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bb4\\u0b95\\u0ba9\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb0\\u0bc2\\u0baa\\u0bbf \\u0bae\\u0ba9\\u0bcb\\u0b95\\u0bb0\\u0ba9\\u0bcd MLA, \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0bca\\u0bb0\\u0bcd\\u0ba3 \\u0b9a\\u0bc7\\u0ba4\\u0bc1\\u0bb0\\u0bbe\\u0bae\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b87\\u0ba4\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb2\\u0bcd\\u0bb2\\u0bbe \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd.", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0baa\\u0bbe \\u0b9a\\u0bbe\\u0b95\\u0bc7\\u0baa\\u0bcd \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0baa\\u0bbf.\\u0b86\\u0bb0\\u0bcd. \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 69-\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 (6.12.2025) \\u0b9a\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb4\\u0bae\\u0bc8, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b95\\u0bc1. \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bc8, \\u0b8e\\u0bae\\u0bcd.\\u0b8e\\u0bb2\\u0bcd.\\u0b8f., \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0bae\\u0bc1\\u0b95 \\u0bb5\\u0bb3\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3, \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0baa\\u0bbf.\\u0b86\\u0bb0\\u0bcd. \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd.", "\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bbe\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb0\\u0b9a\\u0bb0\\u0bcd Ex MP, \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0bb0\\u0bc2\\u0baa\\u0bbf \\u0bae\\u0ba9\\u0bcb\\u0b95\\u0bb0\\u0ba9\\u0bcd MLA, \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b87\\u0ba4\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb2\\u0bcd\\u0bb2\\u0bbe \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0bbf\\u0bb5\\u0bb0\\u0bbe\\u0b9c\\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0ba9\\u0bcd MC \\u0ba4\\u0bbf\\u0bb0\\u0bc1. MS. \\u0ba4\\u0bbf\\u0bb0\\u0bb5\\u0bbf\\u0baf\\u0bae\\u0bcd MC \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9c\\u0bc6.\\u0b9f\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0baa\\u0bbe\\u0baa\\u0bc1 MC ,\\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0baa\\u0bc7\\u0bb0\\u0bbf\\u0baf\\u0b95\\u0bcd\\u0b95 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd.\\n\\n#drbrambedkar", "\\u0b85\\u0b95\\u0bbf\\u0bb2 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0ba4\\u0bbf\\u0bb1\\u0ba9\\u0bcd \\u0ba4\\u0bc7\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0b95 \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b85\\u0bb4\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd.\\n\\n\\u0b95\\u0bc0\\u0bb4\\u0bc7 \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 QR Code-\\u0b90 \\u0bb8\\u0bcd\\u0b95\\u0bc7\\u0ba9\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0bb2\\u0bcd\\u0bb2\\u0ba4\\u0bc1 \\u0b95\\u0bc0\\u0bb4\\u0bc7\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0bb2\\u0bbf\\u0b99\\u0bcd\\u0b95\\u0bc8 \\u0b95\\u0bbf\\u0bb3\\u0bbf\\u0b95\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0ba3\\u0bcd\\u0ba3\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd.\\n\\n\\u0bb5\\u0bbf\\u0ba3\\u0bcd\\u0ba3\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0b95\\u0b9f\\u0bc8\\u0b9a\\u0bbf \\u0ba4\\u0bc7\\u0ba4\\u0bbf: \\u0b9f\\u0bbf\\u0b9a\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd 6, 2025.\\n\\nEnglish:\\nhttps://docs.google.com/forms/d/e/1FAIpQLSfCkuo9PdMIWIe4ckh2JQhVSe3n4I-YRBoM6q-LaGx6IX1dRw/viewform?usp=header\\n\\nTamil: https://docs.google.com/forms/d/e/1FAIpQLSfwavHV99aZ7RTFSZT4tawIVYQypZ9hg4Pl6ERCdrg2NzSnog/viewform?usp=header", "\\u0b9a\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bbe\\u0bae\\u0bc7\\u0ba4\\u0bc8 \\u0baa\\u0bbe\\u0baa\\u0bbe \\u0b9a\\u0bbe\\u0b95\\u0bc7\\u0baa\\u0bcd \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd  \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf. \\n\\n#DrBRAmbedkar", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0baa\\u0bbe \\u0b9a\\u0bbe\\u0b95\\u0bc7\\u0baa\\u0bcd \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0baa\\u0bbf.\\u0b86\\u0bb0\\u0bcd. \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 69-\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 (6.12.2025) \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0bae\\u0bc1\\u0b95 \\u0bb5\\u0bb3\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3, \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0baa\\u0bbf.\\u0b86\\u0bb0\\u0bcd. \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb2\\u0bb0\\u0bcd \\u0ba4\\u0bc2\\u0bb5\\u0bbf \\u0b85\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "The Indigo fiasco isn\\u2019t an isolated slip .It\\u2019s the predictable outcome of India\\u2019s new aviation duopoly. After the Modi government\\u2019s policies wiped out competition, two players now control the skies with zero fear of accountability.", "Passengers are put through enormous stress. Long queues, last-minute chaos, arbitrary offloading, and humiliation at airports. It\\u2019s heartbreaking to see ordinary people, including seniors and families, treated this way.Indigo\\u2019s mistake is a symptom of deeper governance failure  and RahulGandhi is yet again right in calling out this captured, anti consumer system. India needs competition and regulators who protect passengers, not corporate comfort.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0baa\\u0bbe\\u0baa\\u0bbe \\u0b9a\\u0bbe\\u0b95\\u0bc7\\u0baa\\u0bcd \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 69\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5 \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bb2\\u0bb0\\u0bcd \\u0ba4\\u0bc2\\u0bb5\\u0bbf \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8\\u0baf\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd\\ud83d\\ude4f\\ud83d\\ude4f\\ud83d\\ude4f\\n#Ambedkar #BRAmbedkar #RememberingAmbedkar #Congress #ManickamTagore", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd, \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0bb0\\u0ba4\\u0bcd\\u0ba9\\u0bbe - \\u0baa\\u0bbe\\u0baa\\u0bbe \\u0b9a\\u0bbe\\u0b95\\u0bc7\\u0baa\\u0bcd \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 69\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1.\\n\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf, \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0bae\\u0bcd, \\u0b9a\\u0bbe\\u0ba4\\u0bbf, \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b92\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bcb\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \
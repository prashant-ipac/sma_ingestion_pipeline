bc8\\u0b95\\u0bb3\\u0bc8, \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 #DravidianModel \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0bae\\u0bc1\\u0baf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd!", "\\ud83d\\udea8\\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1! \\ud83d\\udce2\\n\\nS.I.R \\u0baa\\u0b9f\\u0bbf\\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bc2\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0b9f\\u0bbf\\u0b9a\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd 4 -\\u0b86\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd \\u0b9a\\u0bae\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0ba9\\u0bcd\\u0bb2\\u0bc8\\u0ba9\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bc2\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b9f \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0b85\\u0ba3\\u0bbf 24\\u00d77 \\u0ba4\\u0baf\\u0bbe\\u0bb0\\u0bbe\\u0b95 \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\n\\n\\u0ba4\\u0bc0\\u0bb5\\u0bbf\\u0bb0 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0baa\\u0b9f\\u0bbf\\u0bb5\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb5\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bb1\\u0bbf\\u0bb5\\u0ba4\\u0bc1 \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0bb4\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bc7\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 dmkitwing -\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc6\\u0b9a\\u0bc7\\u0b9c\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n#DMK4TN  #\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1_\\u0ba4\\u0bb2\\u0bc8\\u0b95\\u0bc1\\u0ba9\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc1", "India gets a \\u201cC Grade\\u201d from the #IMF, and the blame lies squarely on the #BJP Union Government!\\n\\nFor the second year in a row, the IMF has slammed India\\u2019s national accounts, including #GDP, with a \\u2018C\\u2019, the second-lowest possible grade.\\n\\nWhy? Because under the #BJP:\\n\\nGDP numbers are built on an outdated 2011-12 base year\\n\\nWhen the #economy has changed dramatically, digital payments, services boom, consumption shifts, the BJP still uses a 13 year old base year.\\n\\nWhy no update?", "Why no update?\\n\\nBecause updating it would expose the inflated GDP claims and reveal the real slowdown that BJP has been hiding.\\n\\nThe Informal sector which accounts for 50% of India\\u2019s economy are not properly captured\\n\\nIMF says India\\u2019s data misses real spending patterns and informal #employment.\\n\\nBJP\\u2019s mismanagement destroyed MSMEs, and now the #data hides that decline.\\n\\nHuge discrepancies between Income based and Expenditure based GDP", "IMF flagged sizeable inconsistencies, meaning India\\u2019s GDP numbers don\\u2019t even match within its own methods.\\n\\nUse of outdated wholesale price indices instead of modern producer price indices\\n\\nBecause BJP never built the statistical infrastructure required.\\n\\nInflation data also outdated\\n\\nEven #CPI is stuck in 2011-12 consumption patterns.\\n\\nThis conveniently underreports how expensive life has actually become.\\n\\nIMF\\u2019s verdict is clear: India\\u2019s data quality has \\u201cweaknesses that hamper surveillance.\\u201d", "Yet BJP celebrates 5 trillion dreams while failing at the basic duty of maintaining credible economic statistics.\\n\\nThis is what happens when a government prioritises propaganda over transparency, headlines over hard data, and optics over accountability.", "\\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1.. \\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1 \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf!\\n\\n\\u0baa\\u0bb2 \\u0bae\\u0bbe\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95 \\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc6\\u0b95\\u0bbe \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf \\u0b85\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9a\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bc0\\u0ba4\\u0bbf \\u0baa\\u0bc7\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bbf \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf. \\u0b86\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0baf\\u0bbe\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 - \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba8\\u0baf\\u0bb5\\u0b9e\\u0bcd\\u0b9a\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf\\u0baf\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bb5\\
u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc7\\u0b95\\u0bbe\\u0ba4\\u0bc1; \\u0b8f\\u0ba9\\u0bc6\\u0ba9\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bc7\\u0bb2\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0ba3\\u0bbe\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bc1\\u0baf\\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf, \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f\\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf!", "For decades, #TamilNadu has protected harmony with #rationalism, #unity and cultural pride.\\n\\nBut today, desperate sangh parivar forces are trying to import #hate, twist history, and ignite riots for votes.\\n\\nThe controversies manufactured around Thiruparangundram were never about #faith, they were about provoking violence and breaking Tamil Nadu\\u2019s #peace.\\n\\nWhile the #BJP ecosystem tries to divide, Tamil Nadu stands united, #secular, self-respecting and unshakeable.", "\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1 08.12.2025 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 4 \\u0bae\\u0ba3\\u0bbf\\u0baf\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0baa\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0b95\\u0bcb\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bb1\\u0bae\\u0bcd, \\u0baa\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0ba8\\u0b95\\u0bb0\\u0bcd \'\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0b95\\u0bbe \\u0baa\\u0bc7\\u0bb2\\u0bb8\\u0bbf\\u0bb2\\u0bcd\' \\u0bae\\u0ba4\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bb1\\u0bcd\\u0bb1 \\u0bae\\u0bc1\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf\' \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bbf \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u201c\\u0bae\\u0ba4\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u201d \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bb2\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u201c\\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd\\u201d \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd.\\n\\n- \\u0bae\\u0ba4 \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bb1\\u0bcd\\u0bb1 \\u0bae\\u0bc1\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bbf\\n\\n#StandWithMKSSaveTN", "\\u0baa\\u0b95\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0b95\\u0bc8 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95 \\u0b95\\u0bc2\\u0b9f\\u0bbe\\u0ba4\\u0bc1, \\u0b9a\\u0bae\\u0bbe\\u0ba4\\u0bbe\\u0ba9\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b87\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8 \\u0b9a\\u0ba9\\u0bbe\\u0ba4\\u0bbe\\u0ba9\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bb2\\u0bcd\\u0bb2 \\u0b87\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8!\\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bc7 \\u0b89\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0ba8\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1 \\u0b87\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0ba9\\u0bbf\\u0ba4\\u0bb0\\u0bbe\\u0b95 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd. \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba9\\u0bc8 \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b92\\u0bb0\\u0bc1\\u0ba8\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0b9f\\u0bc1\\u0baa\\u0b9f\\u0bbe\\u0ba4\\u0bc1. \\u0baa\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba9\\u0bc8 \\u0b9a\\u0b95\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bb0\\u0bae\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n-  \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0bcd\\u0baa\\u0bbe\\u0baa\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n#StandWithMKSSaveTN", "\\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0bae\\u0bcd \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bcd \\u0ba4\\u0b9f\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0b89\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0b85\\u0b9f\\u0bbf \\u0ba8\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0bae\\u0bc8\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0b95 \\u0b85\\u0bae\\u0bc8\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0b87\\u0ba4\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0bae\\u0bca\\u0bb4\\u0bbf!\\n\\n- \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#Ambedkar  #DMK4TN", "\\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bcb\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bcb\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bae\\u0bae\\u0bbe\\u0b95 \\u0bb5\\u0bbe\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bbf\\u0baf \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0b9a\\u0bae\\u0bc1\\u0ba4\\u0bbe\\u0baf\\u0bae\\u0bbe\\u0b95 \\u0b85\\u0bae\\u0bc8\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0ba8\\u0bae\\u0bcd\\u0bae\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b87\\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bae\\u0bcd!\\n\\n- \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#DMK4TN", "\\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba8\\u0bbe\\u0bb3\\u0bc8\\u0baf\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b89\\u0ba4\\u0baf\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd.\\n\\n#Ambedkar  #DyCMUdhay", "Tamil Nadu will never bow to hate!\\n\\nWhile imported hate machines fuel riots for votes, #TamilNadu protects #harmony through #governance, not violence.\\n\\nTamil Nadu will not let anyone hijack our identity, divide our people, or turn sacred soil into a battleground for communal experiments.\\n\\n#Unity is our culture. #Rationalism is our strength.", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b9a\\u0bbe\\u0b9a\\u0ba9\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0bbf, \\u0bb5\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bc7 \\u0b89\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1!\\n\\n#DMKITWINGArivagam", "\\u0b95\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bc8 \\u0ba4\\u0bc0\\u0baa\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bc8 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0ba3\\u0bcd\\u0ba3\\u0bbe\\u0bae\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0ba4\\u0bc1 \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95. \\u0b85\\u0bb0\\u0b9a\\u0bc1. \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bb5\\u0bb0\\u0baa\\u0bcd \\u0baa\\u0bc2\\u0bae\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0ba4\\u0bc1 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0b95\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bb2\\u0bcd. \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0ba3\\u0bcd\\u0ba3\\u0bbe\\u0bae\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bb3\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b8e\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0baa\\u0b95\\u0bcd\\u0ba4\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0ba4\\u0bc2\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe?\\n\\n#\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 133\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0b92\\u0bb4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b89\\u0b9f\\u0bc8\\u0baf\\u0bb5\\u0bb0\\u0bbe\\u0b95 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd. \\u0b92\\u0bb4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0ba4\\u0bb5\\u0bb1\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baf\\u0bbe\\u0bb0\\u0bbe\\u0baf\\u0bbf\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0bb4\\u0bbf\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95\\u0bb5\\u0bc7 \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bb5\\u0bb0\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bbf\\u0bb3\\u0bb5\\u0bc1\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b9a\\u0bbe\\u0ba4\\u0bbf\\u0baf 
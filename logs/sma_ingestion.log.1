bbf.\\u0b86\\u0bb0\\u0bcd.\\u0b9a\\u0bbe\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0b95\\u0bbe\\u0ba9\\u0bcd\\u0b83\\u0baa\\u0bcd\\u0bb3\\u0bc2\\u0baf\\u0ba9\\u0bcd\\u0bb8\\u0bcd \\u0b85\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd (Confluence Hall)\\u0bb2\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\"\\u0b8e\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb5\\u0b9f\\u0bbf \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb5\\u0b9f\\u0bbf\\" \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bb5\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.", "\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd - \\u0b8e\\u0ba4\\u0bc7\\u0b9a\\u0bcd\\u0b9a\\u0ba4\\u0bbf\\u0b95\\u0bbe\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd!\\n\\n#\\u0b8e\\u0ba9\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb5\\u0b9f\\u0bbf_\\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb5\\u0b9f\\u0bbf \\n#\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1_\\u0ba4\\u0bb2\\u0bc8\\u0b95\\u0bc1\\u0ba9\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc1", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bb5\\u0bbf\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bb5\\u0bbf\\u0b95\\u0bbf\\u0ba4 \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0baf\\u0bc0\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bbe\\u0ba9\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bb3\\u0bbe\\u0b95 \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba9. \\u0b92\\u0bb0\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0bae\\u0bb1\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bbf \\u0b89\\u0bb2\\u0b95\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0ba9\\u0bb0\\u0bcd. \\u0b85\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bbe\\u0bb0\\u0ba3\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd.\\n\\n- \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#DMK4TN", "\\u0b8e\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b9a\\u0bcb\\u0ba4\\u0ba9\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0b95\\u0bbe\\u0bb2\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b8e\\u0ba8\\u0bcd\\u0ba4 \\u0b9a\\u0bc2\\u0bb4\\u0bb2\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bcd\\u0bae\\u0bc8, \\u0ba8\\u0bae\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8, \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b87\\u0ba4\\u0bc1\\u0baa\\u0bcb\\u0ba9\\u0bcd\\u0bb1 \\u0bb5\\u0bbf\\u0bb4\\u0bc1\\u0bae\\u0bbf\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bc8\\u0bb5\\u0bbf\\u0b9f\\u0bbe\\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n- \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#DMK4TN", "\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0bb0\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bbf\\u0ba4\\u0bbe\\u0b9a\\u0ba9\\u0bcd \\u0bae\\u0bc7\\u0bb2\\u0bbe\\u0ba3\\u0bcd\\u0bae\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9 33\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bb3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd!\\n\\n#DMK4TN", "#SIR in Tamil Nadu: We will resist disenfranchisement and defeat #VoteTheft.\\n\\nTo carry out Special Intensive Revision just months before the election, and especially during the monsoon months of November and December, brings serious practical difficulties. To conduct SIR in a hasty and opaque manner is nothing but a conspiracy by the ECI to rob citizens of their rights and help the BJP.", "In Bihar, large numbers of women, minorities and people from SC and ST communities were removed from the electoral rolls, and the absence of transparency has fuelled serious suspicion in the public mind.\\n\\nNow the ECI has announced that #SIR will begin in Tamil Nadu from next week. Following the announcement, we held discussions with our alliance partners, and on that basis an all party meeting will be convened on 2 November to decide the next course of action.", "The right to vote is the foundation of democracy. Tamil Nadu will fight against any attempt to murder it, and Tamil Nadu will win.\\n\\n\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd #SIR: \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bb1\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd! \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bae\\u0bc1\\u0bb1\\u0bbf\\u0baf\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd!\\n\\n\\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbf\\u0b95 \\u0ba8\\u0bc6\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0b85\\u0ba4\\u0bc1\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb0\\u0bc1\\u0bb5\\u0bae\\u0bb4\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bae\\u0bbe\\u0ba9 \\u0ba8\\u0bb5\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd, \\u0b9f\\u0bbf\\u0b9a\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd #SIR \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb5\\u0ba4\\u0bc1 \\u0ba8\\u0b9f\\u0bc8\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bb5\\u0bbe\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1. \\u0b85\\u0bb5\\u0b9a\\u0bb0\\u0b95\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd SIR \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0baa\\u0bbe.\\u0b9c.\\u0b95.\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbe\\u0ba4\\u0b95\\u0bae\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.", "\\u0b8f\\u0bb1\\u0bcd\\u0b95\\u0bc6\\u0ba9\\u0bb5\\u0bc7, \\u0baa\\u0bc0\\u0b95\\u0bbe\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b9a\\u0bbf\\u0bb1\\u0bc1\\u0baa\\u0bbe\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bcd, \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bb2\\u0bcd - \\u0baa\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bcb\\u0bb0\\u0bcd \\u0b85\\u0ba4\\u0bbf\\u0b95 \\u0b85\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bc0\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1\\u0b9f\\u0ba9\\u0bcd, \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0ba4\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b90\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0bae\\u0ba9\\u0ba4\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0bb4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0bb5\\u0bbe\\u0bb0\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd SIR \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bc7\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd. \\u0b85\\u0ba4\\u0ba9\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bb5\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd 2 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb4\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b85\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0b9f\\u0bcd\\u0b9f \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b86\\u0bb2\\u0bcb\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd.\\n\\n\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b9c\\u0ba9\\u0ba8\\u0bbe\\u0baf\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8. \\u0b85\\u0ba4\\u0ba9\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b9c\\u0ba9\\u0ba8\\u0bbe\\u0baf\\u0b95\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bca\\u0bb2\\u0bc8\\u0baf\\u0bc8 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bb5\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0bae\\u0bcd!", "On #WorldOccupationalTherapyDay, we salute the therapists who empower people to live with dignity and independence.\\n\\nOur #DravidianModel Government furthers this mission through Vizhuthugal - One Stop Centre for differently abled persons, and the Centre for Excellence for Persons with ASD.\\n\\nTogether, we are building a Tamil Nadu where care, inclusion, and opportunity reach every individual.", "\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0bb5\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0b95\\u0bbf\\u0ba4\\u0bae\\u0bb2\\u0bcd\\u0bb2; \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb4\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0b99\\u0bcd\\u0b95\\u0bc0\\u0b95\\u0bbe\\u0bb0\\u0bae\\u0bcd! \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb1\\u0bb5\\u0bc1\\u0b95\\u0bcb\\u0bb2\\u0bcd!\\n\\n\\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bcb\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd - \\u0baa\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd CEO \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b89\\u0baf\\u0bb0\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8 \\u0ba4\\u0bc7\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0bb5\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bbf\\u0ba4\\u0bbe\\u0b9a\\u0ba9\\u0bcd \\u0bae\\u0bc7\\u0bb2\\u0bbe\\u0ba3\\u0bcd\\u0bae\\u0bc8 \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd!", "\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbe\\u0bb2\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb2\\u0b95\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0baf\\u0bb0\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9f \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd! \\u0b87\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb2 \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bae\\u0bcd \\u0bae\\u0ba3\\u0bcd\\u0ba3\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b9f \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9f \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd!\\n\\nbimtrichy", "When it rains, it pours, even taxes. Now, there\\u2019s #GST on the \\u201cRain Fee\\u201d too!\\n\\nCitizens are already paying extra for delivery delays caused by weather, but taxing even the rain shows how far this government will go to squeeze every drop from the common man.\\n\\nThis isn\\u2019t #governance. It\\u2019s greed, GST on every breath, drop, and drizzle!\\n\\n#BJPFails", "\\u0bae\\u0bc2\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bc7\\u0bb3\\u0bbe\\u0ba3\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0b9a\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0b95\\u0bbe\\u0bb7\\u0bcd\\u0bae\\u0bc0\\u0bb0\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bbf\\u0bae\\u0bc8 \\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb2\\u0bbe\\u0b95\\u0bcd \\u0ba4\\u0b9f\\u0bc8 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0baa\\u0bbe.\\u0b9c.\\u0b95.\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bcb\\u0ba4 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc8, \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bb5\\u0bbe\\u0baf\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bcd\\u0ba4\\u0bbf, \\u0bae\\u0bc1\\u0ba4\\u0bc1\\u0b95\\u0bc1 \\u0bb5\\u0bb3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b86\\u0ba4\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bcb\\u0ba4 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8f\\u0bb0\\u0bbe\\u0bb3\\u0bae\\u0bcd.. \\u0b87\\u0ba4\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0b9a\\u0bc0\\u0bb0\\u0bb4\\u0bbf\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b8f\\u0bb0\\u0bbe\\u0bb3\\u0bae\\u0bcd..", "\\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 S.I.R \\u0b8e\\u0ba9\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \'\\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0ba4\\u0bc0\\u0bb5\\u0bbf\\u0bb0 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bc8\' \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0bb4\\u0bc1 \\u0bae\\u0ba9\\u0ba4\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0b85\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb
0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "\\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0bc0\\u0b95\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b87\\u0bb0\\u0bc1 \\u0b95\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1  \\u0bae\\u0bc1\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0ba4\\u0bc7\\u0b9a\\u0baa\\u0b95\\u0bcd\\u0ba4\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc1\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bc0\\u0bb0\\u0bb0\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bc7\\u0ba4\\u0bbe\\u0b9c\\u0bbf \\u0b9a\\u0bc1\\u0baa\\u0bbe\\u0bb7\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0baa\\u0bcb\\u0bb8\\u0bcd \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0bb0\\u0bbe\\u0ba3\\u0bc1\\u0bb5\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0b9f\\u0bc8\\u0baf\\u0bc8 \\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9  \\u0bb5\\u0bc0\\u0bb0\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0ba9\\u0bbe\\u0bb0\\u0bcd \\u0b90\\u0baf\\u0bbe \\u0baa\\u0b9a\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bca\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bbe\\u0bae\\u0bb2\\u0bbf\\u0b99\\u0bcd\\u0b95 \\u0ba4\\u0bc7\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0bb0\\u0bc1\\u0baa\\u0bc2\\u0b9c\\u0bc8 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1.\\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc8 \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0bb5\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.\\n\\n#\\u0ba4\\u0bc7\\u0bb5\\u0bb0\\u0bcd\\u0b9c\\u0bc6\\u0baf\\u0ba8\\u0bcd\\u0ba4\\u0bbf", "Attended the valedictory session of the 3rd National Conference of NeVA (National e-Vidhan Application), organised for Secretaries of all Legislatures and Nodal Departments of States, at the Main Committee Room, Parliament House Annexe, New Delhi.\\n\\nThe NeVA initiative is a major step towards digital empowerment of our legislatures, ensuring transparency, efficiency, and paperless governance in line with Hon\\u2019ble Prime Minister Shri. narendramodi ji\\u2019s \\nvision of #DigitalIndia.", "Visited Doordarshan Kendra, Mandi House, New Delhi, as part of the ongoing #SwachhataAbhiyan.\\nJoined by Shri Navneet Kumar Sehgal ji, Chairman, Prasar Bharati; Shri Gaurav Dwivedi ji, CEO, Prasar Bharati; Shri Satish Nambudiripad ji, Director General, Doordarshan; Ms. Priya Kumar ji, Director General, DD News; and Shri Rabindra Kumar Jena ji, Senior Economic Advisor, Ministry of Information & Broadcasting.", "\\u0ba4\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0ba9\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1, \\u0baa\\u0b9a\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bca\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bbe\\u0bae\\u0bb2\\u0bbf\\u0b99\\u0bcd\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0baf\\u0bcd\\u0baf\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0b9f\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbf \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0bb5\\u0bb3\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd.", "Visited the Main Secretariat Building at Shastri Bhawan, New Delhi, as part of the Swachhata Abhiyan.", "Our collective efforts reaffirm the commitment to a clean, efficient, and responsible work environment \\u2014 as envisioned by Hon\\u2019ble Prime Minister Shri. narendramodi ji under the Swachh Bharat Mission. Was joined by Shri Sanjay Jaju ji, Secretary, Ministry of Information & Broadcasting, Shri C. Senthil Rajan ji, Joint Secretary, Shri Rabindra Kumar Jena ji, Senior Economic Advisor, and Shri Dhirendra Ojha, Pr DG PIB.", "#SwachhataAbhiyan", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1, \\u0b9a\\u0bc1\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0ba9\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0baa\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0b85\\u0baf\\u0bcd\\u0baf\\u0bbe \\u0baa\\u0b9a\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bca\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bbe\\u0bae\\u0bb2\\u0bbf\\u0b99\\u0bcd\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b9c\\u0bc6\\u0baf\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0bb5\\u0bb3\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0baf\\u0bcd\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd.\\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bcb\\u0ba4\\u0bc1, \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bbf\\u0baf \\u0b9c\\u0ba9\\u0ba4\\u0bbe \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb5\\u0bc7\\u0ba3\\u0bc1\\u0b95\\u0bcb\\u0baa\\u0bbe\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbf \\u0bb5\\u0bbe\\u0bb4\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb2\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.", "\\"\\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0bc0\\u0b95\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0ba9\\u0bcd \\u0b87\\u0bb0\\u0bc1 \\u0b95\\
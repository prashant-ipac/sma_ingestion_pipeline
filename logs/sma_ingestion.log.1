b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0bae\\u0bcb\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbe\\u0b9a\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bc7\\u0b9a\\u0bcd\\u0b9a\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0ba8\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3 \\u0bae\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0ba8\\u0bb0\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b85\\u0bb2\\u0bc8 \\u0bb5\\u0bc0\\u0b9a\\u0bc1\\u0b95\\u0bbf\\u0bb1 \\u0bae\\u0bc1\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0b86\\u0baf\\u0bbf\\u0bb0\\u0bae\\u0bcd \\u0ba8\\u0bb0\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bae\\u0bcb\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb0\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb0\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc2\\u0ba9\\u0bcd\\u0bb1 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc1.\\n\\n\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b95\\u0bc1. \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bc8", "Checking and verifying the electoral roll by itself is not a bad idea. But anybody who\\u2019s already in the electoral roll and has voted in the previous election can\\u2019t be arbitrarily removed from it. This should be an inclusionary exercise, not an exclusionary one. This should not be an exercise to mischievously delete names. That anyway can\\u2019t be done in Tamil Nadu because the political parties are very strong and have grassroots-level workers who will keep a vigilant eye on the activities of the Election", "a vigilant eye on the activities of the Election Commission", "\\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b85\\u0b9c\\u0bbf\\u0ba4\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd\\u00a0 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0bb4\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bcd\\u0b95\\u0bbe\\u0ba3\\u0bb2\\u0bc8 \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd. \\u0baa\\u0bb2 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbe\\u0b95 \\u0b85\\u0bb5\\u0bb0\\u0bc8 \\u0b95\\u0bb5\\u0ba9\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0b8e\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0bbe\\u0ba9, \\u0baa\\u0ba3\\u0bbf\\u0bb5\\u0bbe\\u0ba9 ,\\u0bae\\u0ba9\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bc7\\u0b9a\\u0bc1\\u0b95\\u0bbf\\u0bb1 \\u0ba8\\u0bc7\\u0bb0\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0bae\\u0ba9\\u0bbf\\u0ba4\\u0bb0\\u0bbe\\u0b95\\u0bb5\\u0bc7 \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd.\\u00a0\\u00a0\\n\\n\\u0bb0\\u0b9a\\u0bbf\\u0b95\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8, \\u0b8a\\u0b9f\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0ba3\\u0bc1\\u0b95\\u0bc1\\u0bae\\u0bc1\\u0bb1\\u0bc8 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba4\\u0ba9\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bcd, \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0bae\\u0bbe\\u0b95 \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0b9a\\u0bc1\\u0baf\\u0baa\\u0bb0\\u0bbf\\u0b9a\\u0bcb\\u0ba4\\u0ba9\\u0bc8 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u00a0 \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0b95\\u0bbf\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0b8e\\u0ba3\\u0bcd\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0bb4\\u0bae\\u0bbe\\u0ba9\\u0bb5\\u0bc8; \\u0b85\\u0bb5\\u0bc8 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bbf\\u0bb5\\u0bbe\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bae\\u0bbe\\u0ba9 \\u0bb5\\u0bbf\\u0bb7\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b85\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc2\\u0bb1\\u0bbf\\u0baf\\u0baa\\u0b9f\\u0bbf, \\u0b85\\u0bb5\\u0bc8 \\u0b9a\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba9 \\u0bae\\u0ba9\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0ba8\\u0bae\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.", "\\u0bb5\\u0b9a\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0ba9 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf,\\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u00a0 \\u0ba4\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0ba4\\u0baf\\u0bbe\\u0bb0\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb5\\u0ba4\\u0bc1\\u00a0 \\u0b8e\\u0bb3\\u0bbf\\u0ba4\\u0bb2\\u0bcd\\u0bb2. \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b86\\u0bb4\\u0bae\\u0bbe\\u0ba9 \\u0baa\\u0bc1\\u0bb0\\u0bbf\\u0ba4\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.\\u00a0\\n\\n\\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b9f\\u0bc8\\u0baf  \\u0b95\\u0bbe\\u0bb0\\u0bcd \\u0bb0\\u0bc7\\u0b9a\\u0bbf\\u0b99\\u0bcd \\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0b9f\\u0bc8\\u0baf\\u00a0 \\u0ba8\\u0bb2\\u0bcd\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bb3\\u0bcd!", "I watched AjithKumar\\u2019s full interview. Having observed him for decades, I\\u2019ve always found him to be a genuine, humble, and straightforward person. The views he expressed about fan behaviour, media coverage, and their wider impact deserve serious discussion in public forums. I hope, as he repeatedly mentioned, they are received in the right spirit.\\n\\nPushing the limits beyond comfort zones is never easy, and his understanding of life and success is truly heart-warming. All the very best Mr. AjithKumar!", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 (01.11.2025) \\u0ba4\\u0bbf\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0b95\\u0bc1\\u0b9c\\u0bbf\\u0bb2\\u0bbf\\u0baf\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0bb1\\u0bc8 \\u0b8a\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b8a\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1  \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0b9a\\u0baa\\u0bc8 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf. \\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc7\\u0b9f\\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0b9c\\u0ba9\\u0bcd, \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bc0\\u0ba9\\u0bbf\\u0bb5\\u0bbe\\u0b9a\\u0ba9\\u0bcd ,\\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0bbe\\u0bae\\u0bbf\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd,\\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd,\\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba9\\u0bb0\\u0bcd.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bb0\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0baa\\u0bbe\\u0baf\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc7\\u0bb2\\u0bbf\\u0ba9\\u0bcd 150\\u0b86\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0b9a\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0baa\\u0bca\\u0bb1\\u0bbf\\u0baf\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0ba8\\u0bc7\\u0bb0\\u0bc1 \\u0baf\\u0bc1\\u0bb5 \\u0b95\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbe \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bbe\\u0ba9 \\u0baa\\u0bbe\\u0ba4\\u0baf\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc8 - \\u201c\\u0b92\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd\\u201d \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd.", "\\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b95\\u0bc7\\u0bb2\\u0bcb \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc2\\u0bb2\\u0bae\\u0bcd, \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0b
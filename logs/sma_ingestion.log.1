bbe\\u0baf\\u0baa\\u0bc1\\u0bb0\\u0bae\\u0bcd \\n\\u0b87\\u0b9f\\u0bae\\u0bcd: \\u0b9a\\u0bae\\u0bc1\\u0ba4\\u0bbe\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bae\\u0bcd, \\u0baa\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\n2.\\t\\u0b95\\u0b9f\\u0bb5\\u0bc2\\u0bb0\\u0bcd \\n\\u0b87\\u0b9f\\u0bae\\u0bcd: \\u0bb5\\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bae\\u0bcd \\u0bae\\u0bb9\\u0bbe\\u0bb2\\u0bcd, \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bae\\u0ba3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\n\\n\\u0bae\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0baa\\u0bc1\\u0bb0\\u0bbf \\n\\n1.\\t\\u0b8e\\u0bae\\u0bcd. \\u0b87\\u0b9f\\u0bc8\\u0baf\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf, \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb4\\u0bc8\\u0baf\\u0baa\\u0bbe\\u0bb3\\u0bc8\\u0baf\\u0bae\\u0bcd \\n\\u0b87\\u0b9f\\u0bae\\u0bcd: \\u0baa\\u0bb4\\u0bc8\\u0baf\\u0baa\\u0bbe\\u0bb3\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0bb3\\u0bcd \\u0b95\\u0bcb\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb2\\u0bcd\\n\\n\\u0bb5\\u0bc7\\u0b9f\\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bcd \\n\\n1.\\t\\u0bae\\u0bbe\\u0bb2\\u0bcd\\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\n\\u0b87\\u0b9f\\u0bae\\u0bcd: V.P.R.C \\u0b9a\\u0bae\\u0bc1\\u0ba4\\u0bbe\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bae\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0b85\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb2\\u0bcd\\n\\n\\u0bb5\\u0bbf\\u0bb0\\u0bbe\\u0bb2\\u0bbf\\u0bae\\u0bb2\\u0bc8 \\n\\n1.\\t\\u0b85\\u0ba9\\u0bcd\\u0ba9\\u0bb5\\u0bbe\\u0b9a\\u0bb2\\u0bcd \\n\\u0b87\\u0b9f\\u0bae\\u0bcd: \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bcd \\u0b9a\\u0bae\\u0bc1\\u0ba4\\u0bbe\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bae\\u0bcd, \\u0b87\\u0bb2\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc2\\u0bb0\\u0bcd", "\\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0ba4.\\u0bb5\\u0bc6.\\u0b95 \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f \\u0ba8\\u0bc6\\u0bb0\\u0bbf\\u0b9a\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bbf\\u0bb4\\u0ba8\\u0bcd\\u0ba4 \\u0b8e\\u0bae\\u0ba4\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bb0\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b86\\u0bb1\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b95\\u0bc2\\u0bb1\\u0bbf, \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0ba8\\u0bbf\\u0bb5\\u0bbe\\u0bb0\\u0ba3 \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b95\\u0bbe\\u0b9a\\u0bcb\\u0bb2\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd. \\u0b92\\u0bb5\\u0bcd\\u0bb5\\u0bca\\u0bb0\\u0bc1\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bcb\\u0ba4\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0ba8\\u0bc6\\u0b9e\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0b89\\u0bb1\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0baa\\u0bcb\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.", "\\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bc1 \\u0ba4\\u0bc0\\u0baa\\u0bae\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0bb4\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0bcb\\u0bae\\u0bcd.. \\n\\n#kanniyakumari #education #student #hvasanthakumar", "\\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b87\\u0ba3\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd, \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd E.M. \\u0b9a\\u0bc1\\u0ba4\\u0bb0\\u0bcd\\u0b9a\\u0ba9 \\u0ba8\\u0bbe\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0baa\\u0bcd\\u0baa\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 79\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1.\\n\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4 \\u0bb5\\u0baf\\u0ba4\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8 \\u0bb5\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.\\n\\n#EMSudarsanaNatchiappan #congress", "Today, I have written to Hon\\u2019ble Home Minister Shri amitshahofficial Ji regarding the serious shortfall of OBC-reserved posts in the ongoing Delhi Police recruitment drive.\\n\\n\\ud83d\\udcc4 (Attached: My official letter)\\n\\nAs per Government of India\\u2019s reservation policy, 27% of posts must be reserved for OBC candidates.\\n\\n\\ud83d\\udc49 Out of 7,565 notified posts, OBCs should have received 2,043 posts.\\n\\ud83d\\udc49 But only 1,608 posts have been allotted.\\n\\ud83d\\udc49 This leaves a deficit of 435 posts.", "This discrepancy is a direct violation of:\\n\\u2705 Constitutional mandate\\n\\u2705 Reservation policy of the Govt. of India\\n\\u2705 Notification of NCT of Delhi\\n\\nSuch denial of rightful opportunities to OBC youth is unacceptable.\\n\\nThe OBC community is deeply agitated. Such actions undermine faith in the recruitment process and the government\\u2019s repeated assurances of justice.", "I have sought urgent clarification from the Home Minister:\\n\\u00a0\\u00a0\\u00a0\\u2022\\u00a0\\u00a0\\u00a0Why reduction of 435 OBC posts?\\n\\u00a0\\u00a0\\u00a0\\u2022\\u00a0\\u00a0\\u00a0Why quota not followed?\\n\\u00a0\\u00a0\\u00a0\\u2022\\u00a0\\u00a0\\u00a0When will corrective action be taken?\\n\\nThis is not just about numbers. It is about justice, equality, and the future of lakhs of OBC aspirants.\\n\\nI urge the Government to immediately correct this injustice and restore faith in our system.\\n\\n#obcjustice #reservationrights \\naiobcsa Dr. Anil Jaihind\\ndevendra.yadav.official \\nramshing.samota", "#sunnews #rahulgandhiji #karurstampede #karurspeech #tvkvijay #tamilnadupolitics #congress #newsupdates #manickamtagore", "40 \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd \\u0baa\\u0bcb\\u0ba9\\u0ba4\\u0bc1 \\u0b92\\u0bb0\\u0bc1 \\u0bb5\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0ba4\\u0bbe\\u0bae\\u0bcd !\\n\\n\\u0baa\\u0bbf\\u0ba3\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba3\\u0bcd\\u0ba3\\u0bbf \\u0ba8\\u0bbe\\u0baf\\u0bc7 \\u0baa\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b8e\\u0ba9\\u0bcd\\u0ba9 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc7\\u0b9a\\u0bc1\\u0bb5\\u0bbe\\u0baf\\u0bbe ?\\n\\n\\u0b89\\u0ba9\\u0bcd \\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b8a\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0bae\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b89\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b8a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0ba9\\u0bc1\\u0bae\\u0bcd\\u0b9f\\u0bbe !\\n\\nSavukkuOfficial", "\\u0bb5\\u0bbf\\u0b9c\\u0baf\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baf\\u0bbe\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb5\\u0bb1\\u0bbe\\u0b95 \\u0baa\\u0bc7\\u0b9a\\u0bbe\\u0ba4\\u0bbf\\u0b99\\u0bcd\\u0b95 \\u0b85\\u0bb5\\u0bb0\\u0bcd \\u0bb0\\u0bca\\u0bae\\u0
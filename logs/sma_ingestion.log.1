cd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0baa\\u0bca\\u0baf\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc0\\u0baf \\u0b9a\\u0b95\\u0bcd\\u0ba4\\u0bbf \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95-\\u0bb5\\u0bc7 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bca\\u0bb4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bb2\\u0bcd \\u0b8e\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1.", "Inaugurated the #SansadKhelMahotsav at Katni, Khajuraho, Madhya Pradesh. Under the visionary leadership of Hon\\u2019ble Prime Minister Shri narendramodi ji, initiatives like Sansad Khel Mahotsav, Khelo India, and Fit India are transforming sports at the grassroots\\u2014empowering youth, building discipline, and nurturing future champions.\\n\\nGrateful to Shri VD Sharma ji, Hon\\u2019ble Member of Lok Sabha from Khajuraho, for the kind invitation.", "Delighted to be joined by: \\nShri Dileep Ahirwar ji, Hon\\u2019ble Minister for Forest and Environment, Government of \\nMadhya Pradesh;\\nPadma Shri Satyendra Singh Lohia ji, Para Swimmer;\\nShri Kedar Jadhav ji, Former Indian Cricketer;\\nShri Sanjay Pathak ji, Hon\\u2019ble MLA; \\nShri Sandeep Jaiswal ji, Hon\\u2019ble MLA; \\nShri Pranay Pandey ji, Hon\\u2019ble MLA; \\nShri Dheeran Singh ji, Hon\\u2019ble MLA; \\nShri Brijendra Lodhi ji, Hon\\u2019ble MLA; \\nShri Prahlad Lodhi ji, Hon\\u2019ble MLA; \\nShri Aravind Pateeria ji, Hon\\u2019ble MLA;", "Shri Aravind Pateeria ji, Hon\\u2019ble MLA; \\nand Shri Rajesh Verma ji, Hon\\u2019ble MLA, who all graced the event with their presence.", "ABP \\u0b8a\\u0b9f\\u0b95 \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bbf\\u0baf \\u0ba8\\u0bc7\\u0bb0\\u0bcd\\u0b95\\u0bbe\\u0ba3\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1........\\n\\n \\u0baa\\u0bbe\\u0bae\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd dr.anbumaniramadoss  \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bc8 \\u0baa\\u0bc1\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0bae\\u0bc1.\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd annamalai_kuppusamy \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd........", "\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bcc\\u0bb0\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4 ABP \\u0b8a\\u0b9f\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0bae\\u0bae\\u0bcd.......", "\\u0b9a\\u0bbe\\u0ba4\\u0bbf\\u0bb5\\u0bbe\\u0bb0\\u0bbf \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b85\\u0bb5\\u0b9a\\u0bbf\\u0baf\\u0bae\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 AbP \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0bae\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bc7\\u0b9a\\u0bbf\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0bae\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0ba3\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd...........", "\\u0ba4\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 - ITC GRAND CHOLA \\u0bb9\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bbf\\u0bb2\\u0bcd, ABP Network \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bc7\\u0bb0\\u0bcd\\u0b95\\u0bbe\\u0ba3\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0b95 \\u0bb5\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bbe\\u0bae\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0ba3\\u0bbf \\u0b87\\u0bb0\\u0bbe\\u0bae\\u0ba4\\u0bbe\\u0bb8\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4 ABP Network \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95 \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bbe\\u0bb0\\u0bbf (CEO) \\u0b9a\\u0bc1\\u0ba9\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.!", "\\u0baa\\u0bbe\\u0bae\\u0b95 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1! \\n\\n\\u0b9f\\u0bbf\\u0b9a\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd 17 \\u0b86\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0ba4\\u0bbf \\u0baa\\u0bbe\\u0bae\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0ba3\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b86\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd! \\n\\n\\u0b9a\\u0bbe\\u0ba4\\u0bbf\\u0bb5\
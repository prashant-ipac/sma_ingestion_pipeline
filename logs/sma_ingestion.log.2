0bbf", "\\u0b95\\u0bbe\\u0bb7\\u0bcd\\u0bae\\u0bc0\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc6\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\n\\u0b95\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bbf\\u0bb1\\u0b95\\u0bc1, \\u0b86\\u0bb3\\u0bc1\\u0ba8\\u0bb0\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bbe\\u0bb7\\u0bcd\\u0bae\\u0bc0\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba9 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0b9f\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b92\\u0bb0\\u0bc1 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b87\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0bc8\\u0baf \\u0b9c\\u0ba9\\u0ba8\\u0bbe\\u0baf\\u0b95 \\u0bb5\\u0bbf\\u0bb0\\u0bcb\\u0ba4, \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0baf\\u0bb2\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0ba9 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0bb3\\u0bc8 \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0bae\\u0bc1\\u0bae\\u0bcd, \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcb\\u0b9f\\u0bc1 \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0bae\\u0bcd.\\n\\n\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 mkstalin  \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf-\\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0b89\\u0bb1\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b86\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b89\\u0bb0\\u0bc8.", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0ba9 \\u0baa\\u0bbe\\u0b9c\\u0b95\\u0bb5\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba4\\u0ba9\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0ba3\\u0bc8\\u0baf\\u0b9f\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0bae\\u0bbe\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95\\u0bb5\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd 2026 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b93\\u0b9f \\u0b93\\u0b9f \\u0bb5\\u0bbf\\u0bb0\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n\\u0b95\\u0bb4\\u0b95 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b86. \\u0b87\\u0bb0\\u0bbe\\u0b9a\\u0bbe \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#BJPFails", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 1080\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0b92\\u0bb0\\u0bc1 \\u0ba4\\u0bc1\\u0ba9\\u0bcd\\u0baa\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0b85\\u0ba4\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3, \\u0ba4\\u0bae\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bc7 \\u0baa\\u0bbf\\u0bb1\\u0bb0\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0bb1 \\u0ba4\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b95\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0baf \\u0ba4\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "\\u0bb5\\u0bbe\\u0b9c\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0bcd & \\u0bb0\\u0bb5\\u0bbf IAS  \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba8\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0baa\\u0bbf.\\u0b8e\\u0bb8\\u0bcd. \\u0bb0\\u0bb5\\u0bc0\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bc8\\u0bb5\\u0bc1\\u0bb1\\u0bcd\\u0bb1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.\\n\\n\\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bb0\\u0bcd, \\u0ba8\\u0ba3\\u0bcd\\u0baa\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b86\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0b87\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb2\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.", "The passing away of Comrade Thiru. Suravaram Sudhakar, former General Secretary of the Communist Party of India and former Member of Parliament, is a great loss to the Left movement and the nation. He tirelessly fought for the rights of the common people, and held those in power to account. I extend my deepest condolences to all who are grieving his loss.", "Attended the MakeGPT Conference at IITmadras , in collaboration with Kochadai Technology Solutions. The live demo \\u2014 building a full embedded system in under a minute \\u2014 was remarkable. At a time when AI often raises fears of disruption, innovations like these show how technology can also empower and inspire.", "AI is not a sudden revolution but a long evolution, driven by abundant data, cheap computing power, and wider access. What excites me most is that innovations like this enable not just experts, but students, enthusiasts, and people from all walks of life to create meaningful products. They lower barriers and open doors to creativity everywhere.", "But this also calls for a shift in our mindset. Education must focus on values and critical thinking, while policy must strengthen MSMEs and local innovators. With its strong human capital, Tamil Nadu can turn these global shifts into inclusive growth. Such innovations remind us that the future of technology belongs to everyone, everywhere.", "#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9
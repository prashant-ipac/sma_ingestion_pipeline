\\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95 \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bcd  \\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0bbf\\u0b95\\u0bb3\\u0bcd!", "\\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bb2\\u0bc7 arivalayam \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0bb3\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb0\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0ba9\\u0bbe?", "It was a pleasure to meet our Hon Minister for Road Transport & Highways, Thiru gadkari.nitin avl, along with our Hon MoS, Thiru murugan_tnbjp avl, in New Delhi today. We conveyed our sincere gratitude for the transformative strides in National Highway development across TN over the past decade, a testament to the able & visionary leadership of our Hon Prime Minister, Thiru narendramodi avl.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1, \\u0b86\\u0b95\\u0bb8\\u0bcd\\u0b9f\\u0bcd 7, \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0b95\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd! \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd \\u0b87\\u0ba4\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b86\\u0bb4\\u0bae\\u0bbe\\u0ba9 \\u0b89\\u0ba3\\u0bb0\\u0bcd\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0b8e\\u0bb4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.\\n\\n2015-\\u0bb2\\u0bcd, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf, \\"\\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf \\u0b86\\u0b9f\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0baf\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba8\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd\\" \\u0b8e\\u0ba9 \\u0b89\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bbe\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcb\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b87\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0bae\\u0bc1\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.", "\\u0b95\\u0bcb\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0b8e\\u0bb3\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0ba9\\u0bcd. \\u0b9a\\u0bbf\\u0bb1\\u0bc1 \\u0bb5\\u0baf\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0ba8\\u0bc6\\u0b9a\\u0bb5\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0ba3\\u0bcd\\u0ba3 \\u0ba8\\u0bc2\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bbe\\u0baf\\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4 \\u0b95\\u0ba3\\u0bcd\\u0b95\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd \\u0bae\\u0ba9\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb4\\u0bb2\\u0bbe\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0ba9.  \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf nsitharaman \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf \\u0bae\\u0bc0\\u0ba4\\u0bbe\\u0ba9 \\u0b95\\u0bbe\\u0ba4\\u0bb2\\u0bcd, \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0baa\\u0bc1\\u0b9f\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0b95\\u0bbf\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bb0\\u0bc1\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b87\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0bb4\\u0bae\\u0bbe\\u0b95 \\u0b95\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf\\u0baf\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0ba9.", "\\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b89\\u0ba3\\u0bb0\\u0bcd\\u0bb5\\u0bc8 \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb2, \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc7\\u0bb5\\u0bc8 \\u0bae\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u2018\\u0b95\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf \\u0b86\\u0b9f\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u2019 \\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bc8 2017 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd. \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bb0\\u0bc8 \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0b95\\u0bb0\\u0bae\\u0bbe\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0b95\\u0bb8\\u0bcd\\u0b9f\\u0bcd 22\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0ba4\\u0bbf 8 \\u0b86\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bc1\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b87\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1 \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bb0\\u0bc1\\u0b9f\\u0bae\\u0bcd 100\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0bb0\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b86\\u0baf\\u0bbf\\u0bb0\\u0b95\\u0bcd\\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bbf\\u0baf \\u0b86\\u0b9f\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0baf\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bc1\\u0bb5\\u0ba4\\u0bc1 \\u0b8e\\u0ba9\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0ba4\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.", "\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd, \\u0ba8\\u0bae\\u0bcd \\u0ba8\\u0bc6\\u0b9a\\u0bb5\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0ba9\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bc2\\u0b9f\\u0bcd\\u0b9f, \\u0b95\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf \\u0b86\\u0b9f\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd! \\u0b87\\u0ba4\\u0bc1 \\u0bb5\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0b9f\\u0bc8 \\u0b85\\u0bb2\\u0bcd\\u0bb2; \\u0ba8\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0ba4\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1! \\n\\n#handloomday", "\\u0b87\\u0ba4\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb5\\u0bbf\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb2 \\u0baa\\u0bc1\\u0ba9\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0ba4\\u0bc2\\u0bb0\\u0bbf\\u0b95\\u0bc8\\u0baf\\u0bbe\\u0bb2\\u0bcd \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bbe\\u0ba9 \\u0baa\\u0bb2 \\u0b93\\u0bb5\\u0bbf\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb0\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bb5\\u0bbf\\u0ba4\\u0bc8\\u0baf\\u0bbe\\u0baf\\u0bcd, \\u0b93\\u0bb5\\u0bbf\\u0baf\\u0bae\\u0bbe\\u0baf\\u0bcd, \\u0b95\\u0bbe\\u0bb5\\u0bbf\\u0baf\\u0bae\\u0bbe\\u0baf\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb5\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0bb0\\u0bb5\\u0bc0\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0ba8\\u0bbe\\u0ba4\\u0bcd \\u0ba4\\u0bbe\\u0b95\\u0bc2\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0ba9\\u0bcd \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf!", "\\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0ba8\\u0bbf\\u0bb2\\u0bc8 \\u0b86\\u0bb3\\u0bc1\\u0ba8\\u0bb0\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0baa\\u0bc1\\u0ba4\\u0bc1\\u0bb5\\u0bc8 \\u0bb0\\u0bbe\\u0b9c\\u0bcd \\u0ba8\\u0bbf\\u0bb5\\u0bbe\\u0b9a\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b8e\\u0ba9\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bc6
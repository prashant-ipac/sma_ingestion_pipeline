0baf \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd.", "\\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, AM \\u0b9c\\u0bc6\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf. \\u0bb0\\u0bae\\u0bcd\\u0baf\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bc0\\u0bb4\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbe\\u0baa\\u0ba8\\u0bcd\\u0ba4\\u0bcd \\u0b9a\\u0baa\\u0bbe \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b85\\u0b9a\\u0bcb\\u0b95\\u0bcd \\u0baa\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bc0\\u0bb4\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbe\\u0baa\\u0ba8\\u0bcd\\u0ba4\\u0bcd \\u0baf\\u0bc1\\u0bb5\\u0baa\\u0bb0\\u0bbf\\u0bb7\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb0\\u0bbe\\u0b95\\u0bc7\\u0bb7\\u0bcd \\u0ba4\\u0bcb\\u0bb7\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, AM \\u0b9c\\u0bc6\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0b95\\u0bbe\\u0bb5\\u0bc0\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0baa\\u0bbe\\u0bb5\\u0bcd\\u0ba8\\u0bc7\\u0bb7\\u0bcd \\u0ba4\\u0bbf\\u0baf\\u0bcb
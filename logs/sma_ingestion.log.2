u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd EPSTamilNadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd\\n#\\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bbf\\u0ba9\\u0bcd_\\u0b8e\\u0bb4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd \\n#\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd_\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd\\n#\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8_\\u0bae\\u0bc0\\u0b9f\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0baf 2024-2025 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b9a\\u0bae\\u0b95\\u0bcd\\u0bb0\\u0bbe \\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0bb7\\u0bbe \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0ba8\\u0bbf\\u0ba4\\u0bbf 2,151 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0bb0\\u0bc2\\u0baa\\u0bbe\\u0baf\\u0bc8 \\u0b89\\u0b9f\\u0ba9\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0bb5\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc8 \\u0bb5\\u0bb2\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb2\\u0bcd!", "Rahuuuuuuuuul Gandhi \\ud83d\\udd25", "\\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0bb0\\u0bcd\\n\\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc1. \\u2764\\ufe0f\\n\\n#RahulGandhi", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 (29.07.2025) \\u0b95\\u0bcb\\u0baf\\u0bae\\u0bcd\\u0baa\\u0bc
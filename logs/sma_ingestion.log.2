\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0b86\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bbe\\u0b95 \\u0ba4\\u0bc1\\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bbf, \\u0baa\\u0bb2 \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bca\\u0bb3\\u0bbf \\u0ba4\\u0bc0\\u0baa\\u0bae\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bb0\\u0b9a\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bb0\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bb0\\u0b9a\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0ba4\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bc8\\u0baf\\u0bc7 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bbe\\u0b95 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bb3\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bc7\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bc7\\u0bb5\\u0bc8 \\u0baa\\u0bc1\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4 \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd. \\u0b9a\\u0bb0\\u0bcd\\u0bb5\\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0b87\\u0bb0\\u0bbe\\u0ba4\\u0bbe\\u0b95\\u0bbf\\u0bb0\\u0bc1\\u0bb7\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bcb\\u0bae\\u0bcd! \\u0b86\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bc1\\u0bb5\\u0bcb\\u0bae\\u0bcd!\\n\\n\\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bc8 \\u0b9a\\u0bc6\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bb3\\u0bbe\\u0ba9 \\u0b86\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bbf\\u0baf \\u0b86\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0ba9 \\u0ba8\\u0bb2\\u0bcd\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n#happyteachersday2025", "\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0ba9\\u0bb5\\u0bb0\\u0bcd \\u0bb5.\\u0b89.\\u0b9a\\u0bbf\\u0ba4\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0ba9\\u0bbe\\u0bb0\\u0bcd. \\n\\n\\u0baa\\u0bbf\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bbf\\u0baf\\u0b95\\u0bcd \\u0b95\\u0baa\\u0bcd\\u0baa\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0baa\\u0bcd\\u0baa\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd. \\u0b87\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0b9a\\u0bc1\\u0ba4\\u0bc7\\u0b9a\\u0bbf \\u0ba8\\u0bc0\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0baa\\u0bcd\\u0baa\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0bae\\u0bcd \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bca\\u0bb4\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0b9f\\u0bc8\\u0baf\\u0bc7 \\u0b95\\u0b9f\\u0bb2\\u0bcd\\u0bb5\\u0bb4\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba4\\u0bc1.", "\\u0baa\\u0bbf\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bbe\\u0bb2\\u0bcd \\u0ba4\\u0bc7\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bcb\\u0b95\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0bae\\u0bcd \\u0b9a\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b86\\u0baf\\u0bc1\\u0bb3\\u0bcd \\u0ba4\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bc8 \\u0bb5\\u0bbf\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bb5\\u0ba4\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b86\\u0bb3\\u0bbe\\u0ba9\\u0bbe\\u0bb0\\u0bcd. \\u0ba8\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bbf\\u0baf \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0bb5\\u0bc0\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bcb\\u0bae\\u0bcd.", "\\u0b93\\u0ba3\\u0bae\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1... \\u0b95\\u0bc7. \\u0b95\\u0bc7. \\u0ba8\\u0b95\\u0bb0\\u0bbf\\u0bb2\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b90\\u0baf\\u0baa\\u0bcd\\u0baa\\u0ba9\\u0bcd \\u0b95\\u0bcb\\u0baf\\u0bbf\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0ba9\\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc1\\n\\nAt KK Nagar Ayyappan Temple on the auspicious occasion of Onam.", "\\u0ba8\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb3\\u0b9a\\u0bb0\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0b99\\u0bcd\\u0b95\\u0b9f\\u0b9a\\u0bc1\\u0baa\\u0bcd\\u0bb0\\u0bae\\u0ba3\\u0bbf\\u0baf \\u0b9a\\u0bc1\\u0bb5\\u0bbe\\u0bae\\u0bbf \\u0b95\\u0bcb\\u0baf\\u0bbf\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0baa\\u0bbf\\u0bb7\\u0bc7\\u0b95 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0ba9\\u0bc8 \\u0ba4\\u0bb0\\u0bbf\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf.\\n\\n \\u0baa\\u0bb2 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b85\\u0b95\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0b87\\u0baa\\u0bcd\\u0baa\\u0bb4\\u0bae\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0bb0\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8 \\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bc6\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.\\u00a0 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0bb0\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0bb5\\u0bbf\\u0bb7\\u0bcd\\u0ba3\\u0bc1 \\u0b9a\\u0b95\\u0bcd\\u0b95\\u0bb0\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0ba3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bbe\\u0bb2\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95 \\u0b95\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bbe\\u0ba9\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bbe\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0bae\\u0bcd\\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0ba9\\u0bc8 \\u201c\\u0bb5\\u0bc6\\u0b99\\u0bcd\\u0b95\\u0b9f \\u0b9a\\u0bc1\\u0baa\\u0bcd\\u0bb0\\u0bae\\u0ba3\\u0bbf\\u0baf\\u0bb0\\u0bcd\\u201d \\u0b8e\\u0ba9 \\u0baa\\u0bc6\\u0baf\\u0bb0\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9 \\u0b95\\u0bc2\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.", "Happy to worship Lord Murugan in Venkata Subramanya Swamy temple in Valasaravakkam yesterday. Many years ago this Murugan idol was unearthed during the process of laying cornerstones for a residential layout plot. It is said that Thirumuruga Kirubanda Variyar came to the site and, after examining the iconography, named the Murugan as \\"Venkata Subramaniyar\\" due to the presence of Vishnu Chakra behind his head", "\\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0bae.\\u0b95.\\u0bb8\\u0b
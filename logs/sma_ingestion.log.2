\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0b87\\u0bb0\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b87\\u0bb2\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0bb5\\u0bbf\\u0b95\\u0bbf\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b8e\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b92\\u0bb0\\u0bc7 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bc1!\\n\\n- \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0ba4\\u0bae\\u0bcd \\n\\n#DMK4TN  #TamilNaduRising", "\\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc6\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bbf\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0baf\\u0bcb \\u0b9f\\u0bc8\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bcd, \\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9f\\u0bc8\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bcd, \\u0ba8\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b8e\\u0bb0\\u0bbf\\u0b9a\\u0b95\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bc1\\u0ba8\\u0b95\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b9c\\u0bb5\\u0bc1\\u0bb3\\u0bbf \\u0baa\\u0bc2\\u0b99\\u0bcd\\u0b95\\u0bbe, \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0bb2\\u0bcd \\u0ba8\\u0bc0\\u0bb0\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0ba8\\u0bc0\\u0bb0\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bb5\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba9.\\n\\n#\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1!\\n\\n2024-25 \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bc7\\u0bb2\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0ba3\\u0bbe\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf 11.19% \\u0b86\\u0b95 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.\\n\\n\\u0b87\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0baa\\u0bc1 2010-11 \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bbf\\u0bb1\\u0b9e\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bbe\\u0ba9\\u0bcd 13.12% \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0b87\\u0bb0\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b87\\u0bb2\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b85\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1.\\n\\n#TamilNaduRising", "Tamil Nadu\\u2019s Growth Story, Where Dravidian Governance Meets Economic Excellence!\\n\\nAfter 14 years, #TamilNadu has clocked a historic 11.19% real #GDP growth in 2024-25, a milestone not seen since 2010-11. And guess what? Both times, it was under a #DMK led government.\\n\\nThis is #DravidianModel #Governance in action, where #SocialJustice meets fiscal discipline, and #welfare walks hand in hand with #wealth creation.", "Under our Hon\'ble Chief Minister of Tamilnadu Thiru.M.K.Stalin\'s dynamic leadership, Tamil Nadu is not just outperforming national averages, it\\u2019s leading #India\\u2019s economic rebound. With a per capita income of \\u20b93.61 lakh, strong sectoral performance, and the highest #GSDP growth among major states, Tamil Nadu is charging towards the ambitious 1 trillion US Dollar #economy mark.", "\\ud83d\\udd17: https://www.thehindu.com/news/national/tamil-nadu/after-14-years-tamil-nadu-records-double-digit-growth-in-real-terms/article69897160.ece\\n\\n#DMK4TN #TamilNaduRising", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 1062\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0baa\\u0bbf\\u0b9a\\u0bcd\\u0b9a\\u0bc8\\u0baf\\u0bc6\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bb0\\u0bcd \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0bb4 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b89\\u0bb2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0ba9\\u0bbe\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0baa\\u0bb5\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bca\\u0bb4\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "Honoured to attend the launch of \'The Man Who Fed India\' in New Delhi, a heartfelt tribute to Dr. M.S. Swaminathan, the father of India\\u2019s Green Revolution. Written by Priyambada Jayakumar published by HarperCollins, the book captures his scientific excellence and his compassion for farmers.\\n\\nIt was a privilege to share the stage with scholars, fellow MPs, and friends of Dr. Swaminathan.", "Today, on behalf of Tamil Nadu, I joined the dharna at Jantar Mantar in solidarity with Telangana\\u2019s demand for 42% OBC reservations.\\n\\nWe stand united for social justice, equity, and demand immediate action on the caste census and reservation bill.\\n\\nI strongly condemn the Union Government using Governors to undermine state autonomy and the rights of the people.", "Happy to see Tamil Nadu achieve a remarkable 11.19% real economic growth in 2024\\u201325. It the highest in India and Tamil Nadu is the only state to cross double digit growth, despite the burden of unfair Union tax devolution.\\n\\nAfter Thalaivar Kalaignar, it\'s Annan Thalapathy Thiru.  M.K. Stalin who carries forward the Dravidian developmental legacy with unmatched resolve.", "Participated in the INDIA alliance floor leaders\\u2019 meeting this morning in Parliament to deliberate the misuse of the SIR of electoral rolls and its profound implications on the integrity of conduct of free and fair elections.\\n\\nLater, I joined fellow MPs in protesting within Parliament, demanding accountability and the protection of institutions of democracy. The alliance reaffirmed its resolve to stand united against the malicious, deliberate, undemocratic attempts to undermine the electoral process.", "#DMKinParliament", "\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bc1\\u0b95\\u0bbe\\u0bae\\u0bcd!\\n\\n\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\nmkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf - \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd TRB \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd, \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd 09.08.2025-\\u0b9a\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb4\\u0bae\\u0bc8-\\u0b95\\u0bbe\\u0bb2\\u0bc8 9 \\u0bae\\u0ba3\\u0bbf \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0bae\\u0ba4\\u0bbf\\u0baf\\u0bae\\u0bcd 2 \\u0bae\\u0ba3\\u0bbf \\u0bb5\\u0bb0\\u0bc8 - \\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b87\\u0bb0\\u0bbe\\u0b9a\\u0b95\\u0bcb\\u0baa\\u0bbe\\u0bb2\\u0b9a\\u0bbe\\u0bae\\u0bbf \\u0b95\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bb5\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\n\\nTATA Electronics, Hyundai, TNPL \\u0baa\\u0bcb\\u0ba9\\u0bcd\\u0bb1 \\u0ba8\\u0bc2\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0ba9\\u0bbf \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95 \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0ba9.", "8\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b90\\u0b9f\\u0bbf\\u0b9c, \\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0bb3\\u0bae\\u0bcb, \\u0b9f\\u0bbf\\u0b95\\u0bbf\\u0bb0\\u0bbf \\u0b8e\\u0ba9 \\u0ba4\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bc8 \\u0baa\\u0bc6\\u0bb1 \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b85\\u0bb4\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd.\\n\\n#\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd_\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\n#MinnumMannai", "\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0
a\\u0bbf \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc7 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1!\\n\\n#CMMKStalin  #DMK4TN", "\\u0baa\\u0bb5\\u0bb3\\u0bb5\\u0bbf\\u0bb4\\u0bbe \\u0b95\\u0ba3\\u0bcd\\u0b9f \\u0b9c\\u0ba9\\u0ba8\\u0bbe\\u0baf\\u0b95 \\u0baa\\u0bc7\\u0bb0\\u0bbf\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bbe\\u0b95 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1! \\n\\n#CMMKStalin  #DMK4TN", "\\u0b89\\u0b9f\\u0bb2\\u0bcd\\u0ba8\\u0bb2\\u0bbf\\u0bb5\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0b95\\u0bbf\\u0b9a\\u0bcd\\u0b9a\\u0bc8 \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0b95\\u0bc8\\u0b9a\\u0bbe\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd \\u0ba4\\u0bcb\\u0bb4\\u0bb0\\u0bcd \\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0b95\\u0ba3\\u0bcd\\u0ba3\\u0bc1 \\u0b85\\u0baf\\u0bcd\\u0baf\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0b89\\u0b9f\\u0bb2\\u0bcd\\u0ba8\\u0bb2\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bcb\\u0bb4\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0b9a\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0b9f\\u0bae\\u0bc1\\u0bae\\u
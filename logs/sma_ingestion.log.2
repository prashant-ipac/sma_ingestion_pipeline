ae\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0bb5\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0ba4\\u0bc1\\u0bb0\\u0bcb\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8. \\u0b85\\u0ba4\\u0ba9\\u0bc8 \\u0bae\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0bae\\u0bc2\\u0baa\\u0bcd\\u0baa\\u0ba9\\u0bbe\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0b95\\u0bae\\u0bc2\\u0b9f\\u0bbf \\u0b85\\u0ba3\\u0bbf\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bae\\u0bb2\\u0bbe \\u0b9a\\u0bc0\\u0ba4\\u0bbe\\u0bb0\\u0bbe\\u0bae\\u0ba9\\u0bcd.\\n\\n#\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "Remember, remember the month of September! \\u2013 #DravidianMonth \\ud83d\\udda4\\u2764\\ufe0f\\n\\nUnder the guidance of our Dravida Nayagar, Hon\\u2019ble CM Thiru. M. K. Stalin , and with the encouragement of our Hon\\u2019ble Dy. CM Thiru. Udhayanidhi Stalin , the DMK ITWing  celebrates, for the 4th consecutive year, September as Dravidian Month, a digital tribute to the visionaries of the Dravidian movement, carrying the torch of #SocialJustice, #Equality, and #SelfRespect to the younger generation.", "This September, let us remember, reflect, and recommit ourselves to the Dravidian ideology that continues to inspire generations.\\n\\nThe New Indian Express \\n\\n\\ud83d\\udd17: https://www.newindianexpress.com/states/tamil-nadu/2025/Sep/02/dmk-it-wing-launches-dravidian-month-fete\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd", "Remember, remember the month of September! \\u2013 #DravidianMonth \\ud83d\\udda4\\u2764\\ufe0f\\n\\nUnder the guidance of our Dravida Nayagar, Hon\\u2019ble CM Thiru. mkstalin, and with the encouragement of our Hon\\u2019ble Dy. CM Thiru. UdhayStalin, the DMKITWing celebrates, for the 4th consecutive year, September as Dravidian Month, a digital tribute to the visionaries of the Dravidian movement, carrying the torch of #SocialJustice, #Equality, and #SelfRespect to the younger generation.", "This September, let us remember, reflect, and recommit ourselves to the Dravidian ideology that continues to inspire generations.\\n\\nArticle by ezhil_jkm for NewIndianExpress\\n\\n\\ud83d\\udd17: https://www.newindianexpress.com/states/tamil-nadu/2025/Sep/02/dmk-it-wing-launches-dravidian-month-fete\\n\\n#DMK4TN", "\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0bb5\\u0bb0\\u0bbe\\u0ba9 \\u0baa\\u0ba9\\u0b95\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb5\\u0bbe\\u0bb0\\u0bbf \\u0b87\\u0b9f\\u0b92\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b86\\u0ba3\\u0bc8, \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0bb1\\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0ba4\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0bcd \\u0baa\\u0baf\\u0bbf\\u0bb2 \\u0b9a\\u0bae\\u0bb8\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bae\\u0bcd \\u0b95\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8 \\u0b86\\u0b95\\u0bbf\\u0baf \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9 \\u0b85\\u0bb0\\u0b9a\\u0bbe\\u0ba3\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd!\\n\\n\\u0b86\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd. \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8 \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd. \\u0b85\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0bae\\u0bc1\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0ba9\\u0b95\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bb0\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd", "\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bca\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bbe\\u0bb0\\u0ba3\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0bb5\\u0bb0\\u0bbe\\u0ba9 \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0b9a\\u0bbf.\\u0ba8\\u0b9f\\u0bc7\\u0b9a\\u0ba9\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd 1912 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0ba3\\u0bb0\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b95\\u0bc1\\u0bb0\\u0bb2\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f\\u0bb0\\u0bcd \\u0b9a\\u0b99\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd.\\n\\n1914 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0
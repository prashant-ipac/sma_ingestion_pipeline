0\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bbe\\u0bb1\\u0bbe\\u0b95, \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf, \\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0bae\\u0bcd, \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bb2\\u0ba9\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b9c\\u0bbf\\u0b8e\\u0bb8\\u0bcd\\u0b9f\\u0bbf \\u0bb5\\u0bb0\\u0bbf \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bc8 \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1 \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc1.", "\\u0b9c\\u0bbf\\u0b8e\\u0bb8\\u0bcd\\u0b9f\\u0bbf \\u0bb5\\u0bb0\\u0bbf \\u0bae\\u0bc0\\u0ba4\\u0bbe\\u0ba9 \\u0b85\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc1\\u0bb1\\u0bc8 \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0bae\\u0bbf\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9\\u0ba4\\u0bca\\u0bb0\\u0bc1 \\u0ba4\\u0bc0\\u0baa\\u0bbe\\u0bb5\\u0bb3\\u0bbf \\u0baa\\u0bb0\\u0bbf\\u0b9a\\u0bbf\\u0ba9\\u0bc8 \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba8\\u0bb0\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b9c\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf. nsitharaman \\u0b85\\u0bae\\u0bcd\\u0bae\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbe\\u0b95 \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0bae\\u0ba9\\u0bae\\u0bbe\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0b95\\u0bb3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.", "The #NextGenGST is a transformative decision implemented under the farsighted vision of our Honourable Prime Minister Shri narendramodi ji. These tax reforms have been devised to simplify the indirect tax system and is aimed at benefitting every sector of national development. Replacing the current four slabs of 5%, 12%, 18%, and 28%, now essentials and non essentials will be taxed at 5% and 18% respectively. This is a significant dip, easing tax burdens for the middle-class and bridging the financial gap", "the middle-class and bridging the financial gap rampant in the pre-GST era.", "\\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0bae\\u0bc1\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd, \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0
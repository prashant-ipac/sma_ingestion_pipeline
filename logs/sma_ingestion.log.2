u0bcd \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1! \\n\\n\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#CMStalinInEurope", "\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bc8 \\u0bb0\\u0bc2.10.62 \\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0b95\\u0bcb\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b88\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 929 \\u0baa\\u0bc1\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0ba3\\u0bb0\\u0bcd\\u0bb5\\u0bc1 \\u0b92\\u0baa\\u0bcd\\u0baa\\u0ba8\\u0bcd\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc8\\u0baf\\u0bc6\\u0bb4\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0b95\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba9\\n\\n\\u0b87\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0bb2\\u0bbe\\u0ba9 \\u0b92\\u0baa\\u0bcd\\u0baa\\u0ba8\\u0bcd\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bbe\\u0b95 \\u0bae\\u0bbe\\u0bb1\\u0bbf \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba9. \\u0b87\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0bb5\\u0bbf\\u0baa\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc7 \\u0b9a\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\n\\n\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#CMStalinInEurope", "While #USTariff slam our exporters, the #BJP Union government offers nothing but platitudes, leaving #TamilNadu\\u2019s textile mills, workers and #MSMEs to bear the cost.\\n\\nThis is not #diplomacy or strategy; it\\u2019s negligence. The Union must urgently roll out targeted relief, duty remission, #export incentives and a forceful trade diplomacy, or watch Indian #jobs and manufacturers pay the bill for political complacency.\\n\\nOpinion by our Hon\'ble CMOTamilnadu Thiru. mkstalin for bsindia", "\\ud83d\\udd17: https://www.business-standard.com/opinion/columns/india-must-safeguard-its-export-oriented-industries-and-emerge-stronger-125083000019_1.html", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 35\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0baa\\u0bca\\u0bb1\\u0bbe\\u0bae\\u0bc8, \\u0baa\\u0bc7\\u0bb0\\u0bbe\\u0b9a\\u0bc8, \\u0baa\\u0bca\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bcb\\u0baa\\u0bae\\u0bcd, \\u0baa\\u0bc1\\u0ba3\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb1\\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0ba4\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "\\u0b95\\u0bc1\\u0b9c\\u0bb0\\u0bbe\\u0ba4\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0
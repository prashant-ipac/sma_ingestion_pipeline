u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb0\\u0baf\\u0bbf\\u0bb2\\u0bcd\\u0bb5\\u0bc7 \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u2018\\u0b87\\u0ba9\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0bb2\\u0bbe\\u0b95\\u0bcd\' \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbe\\u0ba4 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0bb0\\u0baf\\u0bbf\\u0bb2\\u0bcd\\u0bb5\\u0bc7 \\u0b8a\\u0bb4\\u0bbf\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0ba9\\u0ba8\\u0bcd\\u0ba4\\u0bcb\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd.\\n\\n#\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 1039\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0b89\\u0bb4\\u0bb5\\u0ba9\\u0bcd, \\u0ba4\\u0ba9\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba8\\u0bbe\\u0bb3\\u0bcd\\u0ba4\\u0bcb\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bb5\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd, \\u0b85\\u0bb5\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bbf\\u0bb2\\u0b95\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba9\\u0bc8\\u0bb5\\u0bbf\\u0baa\\u0bcb\\u0bb2 \\u0b85\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0baf\\u0bcd\\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "10 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd 1 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd #\\u0b93\\u0bb0\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd_\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8!", "Historic day for trade ties between #Japan and #TamilNadu \\ud83c\\udf8a\\n\\nGuidance Tamil Nadu\\u2019s Japan Desk is now officially open !\\n\\nThe Guidance Desk in #Osaka will be a dedicated effort to facilitate trade, investment and cultural exchange between Tamil Nadu and Japan. With over 580 Japanese establishments already present in Tamil Nadu and strong MoUs with Osaka, Hiroshima, Ehime etc. this Desk will serve as a powerful point of contact for existing and new investors.", "It also becomes part of our growing international network of investment facilitation desks under Guidance, following our successful launches in Vietnam and Taiwan.\\n\\nWe were honoured to have the Honourable Vice Governor of Osaka, senior leaders from JETRO and our Indian Consul General in Osaka Thiru. Chandru Appar join us for the inauguration.", "Tamil Nadu is moving swiftly with intent and clarity, just as our Honourable Chief Minister of Tamil Nadu Thiru. MK Stalin avargal has envisioned, to attract even more investments in new sectors from our long-standing partners and friends in East Asia. \\n\\n#InvestInTN #JobsForTN #BullishOnTN"], "model": "voyage-multilingual-2", "input_type": "document", "truncation": true, "output_dtype": "float", "output_dimension": 1024, "encoding_format": "base64"}' message='Post details'

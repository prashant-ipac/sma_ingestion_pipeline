a8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0b9a\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n#AdmkFails", "Let there be no doubt!\\nIn #TamilNadu, we don\\u2019t raise #students to worship #violence or hatred. We raise them to think, question, and walk the path of #justice and #equality.", "\\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0bb5\\u0bb4\\u0bbf, \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0bb5\\u0bb4\\u0bbf, \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0bb5\\u0bb4\\u0bbf \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba8\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0baa\\u0bb2 \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0baa\\u0bcb\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9a\\u0bc7 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bbf\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bbe\\u0ba4\\u0bc1. \\u0b9c\\u0ba9\\u0bbe\\u0baa\\u0bcd \\u0b95\\u0bbe\\u0b9c\\u0bbe \\u0bae\\u0bbf\\u0baf\\u0bbe\\u0ba9\\u0bcd \\u0bb0\\u0bbe\\u0bb5\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0bcd \\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bc8 \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0b9a\\u0bae\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bcb\\u0b9f\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \
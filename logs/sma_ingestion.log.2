f\\u0bb0\\u0bae\\u0bcd \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\n\\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.NainarBJP \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd!", "\\u0ba4\\u0bbe\\u0baf\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0ba9\\u0bbf\\u0baf \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n#HappyBdayPMModi", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0b92\\u0bb0\\u0bc7 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc7 - \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. NainarBJP \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0bbe\\u0bb0\\u0bae\\u0bcd..!", "\\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0ba9\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bb2 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bb2\\u0ba9\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0ba8\\u0bb2\\u0bcd\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd !\\n\\n#HappyBdayPMModi", "\\u0b89\\u0bb2\\u0b95\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0b9a\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0bbf, \\u0bb8\\u0bcd\\u0bb0\\u0bc0 \\u0bb5\\u0bbf\\u0bb8\\u0bcd\\u0bb5\\u0b95\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc1\\u0ba9\\u0bbf\\u0ba4 \\u0b9c\\u0bc6\\u0baf\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bc8\\u0bb5\\u0bbf\\u0ba9\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb3\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bbf\\u0baf \\u0bb5\\u0bbf\\u0bb8\\u0bcd\\u0bb5\\u0b95\\u0bb0\\u0bcd\\u0bae\\u0bbe \\u0b9c\\u0bc6\\u0baf\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0ba8\\u0bb2\\u0bcd\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd!", "\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0bae\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0ba4\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b95\\u0bb0\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bbe \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0ba9\\u0bbf\\u0baf \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n#HappyBdayPMModi", "\\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba8\\u0bb0\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 75-\\u0b86\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0b95\\u0bc1 \\u0baa\\u0bbf\\u0bb0\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bae\\u0bbe\\u0b95 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0bb5\\u0bbf\\u0ba3\\u0bcd\\u0bb5\\u0bc6\\u0bb3\\u0bbf \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bb5\\u0ba9\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bbe\\u0b95 \\u0b85\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1, \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0b9f\\u0bc7 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0ba4\\u0bae\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.\\n\\n#HappyBdayPMModi", "\\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba8\\u0bb0\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 75-\\u0b86\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0b95\\u0bc1 \\u0baa\\u0bbf\\u0bb0\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bae\\u0bbe\\u0b95 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0bb5\\u0bbf\\u0ba3\\u0bcd\\u0bb5\\u0bc6\\u0bb3\\u0bbf \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bb5\\u0ba9\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bbe\\u0b95 \\u0b85\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1, \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0b9f\\u0bc7 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0ba4\\u0bae\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.\\n\\n#HappyBdayPMModi", "Delighted to have had the opportunity to take part in the Conference on \\u201cGreat Indian Dream 2047\\u201d organised by Thiru Vinoj P Selvam avl, Founder, Namo Educational Trust, along with prominent Tamil Journalist Thiru Rangaraj Pandey avl & Thiru E.Sanjeevi avl, Founder, Business and Cultural Development Forum on the occasion of the 75th birthday of our Hon PM Thiru narendramodi avl.", "Our beloved PM has emerged as one of the most consequential leaders of our era, defined by his ability to see opportunity in crisis. When India faced global uncertainties, his foresight and decisive leadership turned challenges into pathways for growth, ensuring stability and resilience.", "Despite holding the highest office, his humility and simplicity have connected him deeply with the people, making him a leader who inspires trust and confidence. A deep thinker, he has consistently balanced long-term vision with practical execution, demonstrating a rare blend of strategic clarity and grounded realism.", "His decisiveness and foresight have reshaped India\\u2019s economic, technological, and strategic trajectory, positioning our nation as a rising power. What makes him consequential is his bold decision-making and ability to pair it with humility and sincerity, ensuring people remain at the heart of governance.", "#MyModiStory\\n\\nTrue greatness is not measured by power or position, but by humility, respect, and the care a leader shows for every individual. I have seen this side of Narendra Modi avl many times. Even in small moments, his sensitivity and attention to people leave a lasting impression.", "One such moment in Chennai will always remain close to my heart. During a visit of Prime Minister Modi avl to Chennai, two senior citizens had come to meet him. They were wheelchair-bound. They were supposed to go inside the room to meet him, but climbing the stairs was impossible for them.", "When Modi ji realized this, he immediately came out himself. He went to where they were sitting and spoke to them with patience and respect. When they tried to seek his blessings, but he replied, \\u201cNo, I need your blessings,\\u201d and bowed to take their blessings.\\n\\nThat moment left me deeply moved. Even at the highest position of power, he shows such humility and respect. He makes every individual feel seen, valued, and honored.\\n\\nnarendramodi themodistory", "Stealing and exploiting runs deep in the very DNA of the DMK. The lofty rhetoric of Social Justice that the party never tires of repeating has remained little more than lip service, and in practice, the DMK has consistently failed to implement social justice in its truest spirit, even within their cadres.", "A telling example of this is the conduct of Ochu Baalu, a DMK functionary in Madurai, who, when confronted by a man rightfully asking for his dues after having completed the work assigned to him, resorted to casteist slurs and abuses and threatened to shame him publicly.\\n\\nThis incident is not an exception but a mirror reflecting DMK\\u2019s true character.", "Heartiest birthday greetings to our Hon PM Thiru Narendra Modi avl. His selfless service to the nation lights our path forward. \\n\\nPraying for his good health and long life to empower him to drive India towards ever-greater glory! \\n\\n#HappyBdayPMModi", "Wishing a very Happy Birthday to our Hon\\u2019ble PM Shri narendramodi ji.\\n\\nHis vision, leadership, and ability to groom party leaders truly make him an extraordinary leader. I feel fortunate to have experienced how he motivates every karyakarta, instills responsibility, and inspires us to take bold decisions and contribute towards the Party and the Nation.\\n\\n#HappyBdayPMModi l #MyModiStory", "\\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba8\\u0bb0\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bcb\\u0bb7\\u0ba9\\u0bcd \\u0b85\\u0baa\\u0bbf\\u0baf\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd, \\u0baa\\u0bbe\\u0bb2\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0baf\\u0bcd\\u0bae\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba3\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf, \\u0b9a\\u0bc1\\u0b95\\u0bbe\\u0ba4\\u0bbe\\u0bb0\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b8a\\u0b9f\\u0bcd\\u0b9f\\u0b9a\\u0bcd\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bb5\\u0bc8 \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9f\\u0ba9\\u0bcd, \\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0ba4\\u0bc6\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0bae\\u0bc1\\u0baf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0ba9. \\u0b87\\u0ba4\\u0ba9\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95, \\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0ba4\\u0bc6\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\
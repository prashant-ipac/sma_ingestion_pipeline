ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bbe\\u0ba4\\u0bc8\\n\\n#CMBreakfastScheme", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd :31\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0b9a\\u0bc6\\u0bb4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb0\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bbf\\u0baf \\u0b85\\u0bb1\\u0bb5\\u0bb4\\u0bbf \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bbf\\u0bb0 \\u0b86\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bbf\\u0baf \\u0bb5\\u0bb4\\u0bbf \\u0bb5\\u0bc7\\u0bb1\\u0bc6\\u0ba9\\u0bcd\\u0ba9 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1?\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "Glad to join the \\u201cWomen in Politics\\u201d event by IWA in Chennai. We discussed the hurdles women face in political life and the need to build supportive systems for leadership. The session reaffirmed that empowering women leaders is key to shaping an inclusive and just society.", "\\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0b9a\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba3\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bbe\\u0ba9\\u0ba4\\u0bc1, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0ba4\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0ba8\\u0b95\\u0bb0\\u0baa\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\n\\n\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1.\\u0b95. \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0b9e\\u0bcd\\u0b9a\\u0bbe\\u0baa\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0baa\\u0b95\\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bcd \\u0bae\\u0bbe\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bc2\\u0bb0\\u0bcd, \\u0baa\\u0bc1\\u0ba9\\u0bbf\\u0ba4 \\u0b9a\\u0bc2\\u0b9a\\u0bc8\\u0baf\\u0baa\\u0bcd\\u0baa\\u0bb0\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0b85\\u0ba4\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc7\\u0ba9\\u0bcd.", "\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0baf\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bbe\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0b95,\\n\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0b95\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0b9a\\u0bcd\\u0b9a\\u0bbf - \\u0bae\\u0b95\\u0bbe\\u0ba4\\u0bc7\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba3\\u0bae\\u0bcd \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0b9f\\u0bc8\\u0baf\\u0bc7, \\u0b95\\u0bbe\\u0bb3\\u0b95\\u0bae\\u0bcd \\u0b86\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd TRB.\\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0bb2\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba3\\u0bc1\\u0b95\\u0bc1 \\u0b9a\\u0bbe\\u0bb2\\u0bc8\\u0b95\\u0bb3\\u0bcd, \\u0b85\\u0ba4\\u0ba9\\u0bcd \\u0b9a\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0b9f \\u0baa\\u0baf\\u0ba9\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bc8 \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.\\n\\n#\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd_\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\n#MinnumMannai", "A compelling read on the new Online Gaming Act by Senior Advocate Amit Anand Tiwari. The piece argues it\'s a \\"colourable legislation\\" where the Union is trying to do indirectly what it cannot do directly. \\n\\nThe Union Govt is straying into areas constitutionally reserved for states, as subjects like \'betting and gambling\' are on the State List. This Act is a clear instance of federal overreach, undermining the autonomy of states.", "This fits a worrying pattern seen in recent years on issues concerning subjects in State List like Agriculture (the now repealed farm laws) and Co-operation, and also concerning Concurrent List subjects (Minor Ports) where the Union Govt has encroached upon the states\' legislative domain.", "\\u0b8e\\u0ba9\\u0ba4\\u0bc1 #\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc2\\u0bb0\\u0bcd \
cd\\u0ba4\\u0bc7\\u0ba9\\u0bcd. \\n\\n\\u0ba4\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1, \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bc1  \\u0b95\\u0bc2\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0bae\\u0bc2\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bc1\\u0bb3\\u0bbf\\u0bb0\\u0bcd\\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bc6\\u0ba9 \\u0b85\\u0bb0\\u0b9a\\u0bbe\\u0ba3\\u0bc8 \\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bb0\\u0baf\\u0bbf\\u0bb2\\u0bcd\\u0bb5\\u0bc7 \\u0bb5\\u0bbe\\u0bb0\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbf.", "\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0baa\\u0bbe\\u0bb2\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b95\\u0bc0\\u0bb4 \\u0ba8\\u0bc6\\u0bae\\u0bcd\\u0bae\\u0bc7\\u0bb2\\u0bbf \\u0bb5\\u0bb0\\u0bc8 \\u0bb5\\u0b9f\\u0bb5\\u0bbe\\u0bb1\\u0bc1 \\u0ba8\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0bcd\\u0bb5\\u0bbe\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc7\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b86\\u0b95\\u0bbe\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bae\\u0bb0\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b85\\u0b95\\u0bb1\\u0bcd\\u0bb1 \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd.TRB.\\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd. \\n\\n#\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd_\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\n#MinnumMannai", "I was happy to be the Chief Guest at 19th Graduation Day of MEASI Institute of Information Technology, where I had the honour of conferring degrees to MCA graduates.\\n\\nIn my address, I reflected on the remarkable legacy of MEASI, an institution deeply rooted in the values of social justice and inclusion, with a history spanning over a century.", "I encouraged the graduates to continue learning beyond the classroom and to lead lives that are not just personally successful, but also meaningful. The best way to honour the vision of MEASI\\u2019s founders is to give back, help build a more equitable society, and carry forward the values of learning and service.", "Inaugurated the Anna University : Nemetschek Centre of Excellence for Architecture, Engineering & Construction \\u2014 a timely step as AI, ML, and IT continue to reshape education.\\n\\nIn my remarks, I recalled my visit to the Nemetschek Group headquarters in Munich that offered an eye-opening glimpse into how tech can transform infrastructure design and delivery. Their generous decision to provide their software suite free to Anna University will help students gain future-ready skills.", "This Centre reflects the kind of collaboration that we need between the academia, industry and government. Proud that ICT Academy of Tamil Nadu, under the IT & Digital Services Department, will support its implementation. It will serve as a key hub for training, research, and skilling to ensure that foundational disciplines like Civil and Architecture evolve with the times and continue contributing profoundly to our nation\\u2019s progress.", "\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\ud83d\\udca5 \\n#pmk #anbumaniramadoss #ramadoss #anbumani", "\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bb3\\u0bcd\\u0bb3\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0bb5\\u0baf\\u0bb2\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b8e\\u0bb4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb8\\u0bcd \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bc1...", "Next Friday \\ud83d\\udca5 @actorvijay \\n\\n#tamilagavettrikazhagam #thalapathy #thalapathyvijay #tvkvijay #tvkitwing", "\\u0b87\\u0ba4\\u0bc1 \\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b89\\u0ba3\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd.@actorvijay \\n\\n#tamilagavettrikazhagam #tvkvijay #tvkitwing #thalapathy #thalapathyvijay #vijay", "\\u0ba4\\u0bc6\\u0ba9\\u0bcd\\u0b95\\u0bbe\\u0b9a\\u0bbf  \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\ud83d\\udca5 @actorvijay \\n\\n#tamilagavettrikazhagam #thalapathyvijay #thalapathy #vijay #tvkvijay #tvkitwing", "Attended the 19th Deevara Day State Conference of Akhila Kerala Deevara Sabha, marking its glorious Golden Jubilee.\\nUnder Hon\\u2019ble Prime Minister Shri. narendramodi Ji\\u2019s leadership, the Government has ensured historic support for our fishermen\\u2014through landmark schemes like PMMSY, Blue Revolution, & Sagar Parikrama, empowering over 3 crore livelihoods.", "Congratulations to Akhila Kerala Deevara Sabha for 50 years of tireless service, unity and upliftment. Together, we will realise the dream of Viksit Bharat with dignity and opportunity for all. \\n\\n #ViksitBharat #ViksitKerala", "Attended the Digital Entertainment Summit, organised by Storyboard18, Network 18. Focused on facilitating conversations around innovation, policies, and partnerships, this summit marked another step towards shaping the future of India\\u2019s Media and Entertainment industry, as envisioned by our Hon\\u2019ble Prime Minister Shri. narendramodi ji.\\n\\n#DigitalEntertainmentSummit", "\\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcb\\u0b9f\\u0bc1 \\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bbe\\u0b95 \\u0b89\\u0ba3\\u0bb5\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0ba3\\u0bbf \\u0b87\\u0bb0\\u0bbe\\u0bae\\u0ba4\\u0bbe\\u0b9a\\u0bc1 \\n\\n\\ud83e\\ude75\\ud83d\\udc9b\\u2764\\ufe0f", "\\"\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb3\\u0bbf \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0b8a\\u0b9f\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bc7\\u0bb0\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd\\" \\u0baa\\u0bbe\\u0bae\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0ba3\\u0bbf \\u0b87\\u0bb0\
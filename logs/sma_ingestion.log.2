\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd! \\u0ba4\\u0bc6\\u0ba9\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f \\u0b95\\u0ba9\\u0bb5\\u0bc1 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.\\n\\n\\"VinFast\\" \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#VinFast", "\\u0bb5\\u0bbe\\u0b95\\u0ba9 \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0ba8\\u0b95\\u0bb0\\u0bae\\u0bcd!\\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0b92\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bca\\u0ba4\\u0bcd\\u0ba4 \\u0bae\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0ba9 \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd 40% \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b86\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1; \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0ba9 \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf, \\u0bae\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0ba9 \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0ba8\\u0b95\\u0bb0\\u0bc6\\u0ba9 \\u0ba8\\u0bc6\\u0b9e\\u0bcd\\u0b9a\\u0bc8 \\u0ba8\\u0bbf\\u0bae\\u0bbf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0ba9\\u0bcd!\\n\\n\\"VinFast\\" \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\nmkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#VinFast", "\\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b95\\u0ba9\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bbe\\u0ba9 \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0ba4\\u0bbf\\u0bb1\\u0ba9\\u0bcd \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1, \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 200\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0ba9\\u0bcd\\u0b83\\u0baa\\u0bbe\\u0bb8\\u0bcd\\u0b9f\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc8 \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n\\"VinFast\\" \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\nmkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n #VinFast", "\\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0bb5\\u0bbf\\u0ba9\\u0bcd\\u0b83\\u0baa\\u0bbe\\u0bb8\\u0bcd\\u0b9f\\u0bcd (VinFast) \\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0b9a\\u0bbe\\u0bb0 \\u0bb5\\u0bbe\\u0b95\\u0ba9 \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbe\\u0bb2\\u0bc8\\u0baf\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0ba4\\u0bc1 \\u0b8e\\u0bb5\\u0bcd\\u0bb5\\u0bb3\\u0bb5\\u0bc1 \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bae\\u0bcb, \\u0b85\\u0ba4\\u0bc8\\u0bb5\\u0bbf\\u0b9f \\u0b85\\u0baa\\u0bcd\\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b8a\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 (\\u0bae) \\u0bb5\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. trbrajaa \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#VinFast", "The Industrial Revolution in South #TamilNadu has officially begun, and it bears the Stamp of our Hon\'ble CMOTamilnadu mkstalin\\u2019s visionary leadership! \\n\\nToday\\u2019s landmark investments in #Thoothukudi, #Tirunelveli and beyond are not just economic milestones. They are foundations for the next 100 years. From #defence and #spacetech to #electronics, #footwear, #shipbuilding, and #textiles, southern Tamil Nadu is being transformed into an industrial and innovation powerhouse.", "\\ud83d\\ude80 Defence & Space Hub in Thoothukudi\\n\\ud83d\\udc5f \\u20b91,720 Cr Korean Footwear Unit in Nellai\\n\\ud83d\\udea2 \\u20b91,500 Cr Shipbuilding Components Unit\\n\\ud83d\\udcdf \\u20b94,995 Cr PCB Manufacturing Unit\\n\\ud83e\\uddf5 \\u20b94,953 Cr Man-Made Fibre Plant\\n\\nOver 30,000 direct #jobs and lakhs more in indirect opportunities. All under a leadership that believes in balanced #growth, regional #equity, and future-focused policy.\\n\\n#DravidianModel Governance at Work and #TNRising, from #Kanyakumari to #Chennai.", "\\u0b89\\u0ba4\\u0baf\\u0bae\\u0bbe\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1 \\u0ba4\\u0bc6\\u0ba9\\u0bcd\\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf! \\n\\n\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bb0\\u0bc2.1,119 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0bae\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd, 114 \\u0b8f\\u0b95\\u0bcd\\u0b95\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0bb5\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0bbe\\u0bb8\\u0bcd\\u0b9f\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0b9a\\u0bbe\\u0bb0 \\u0bb5\\u0bbe\\u0b95\\u0ba9 \\u0ba4\\u0baf\\u0bbe\\u0bb0\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 \\n\\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbe\\u0bb2\\u0bc8\\u0baf\\u0bc8 \\u0ba4\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd!\\n\\n#VinFast", "\\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba4\\u0bb0\\u0bae\\u0bbe\\u0ba9 \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1, \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0bae\\u0bbe\\u0ba4\\u0bbf\\u0bb0\\u0bbf \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0bb5\\u0bbf\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bb2\\u0bae\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4 \\u0bb5\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0ba4\\u0bbf\\u0bb0\\u0bbf \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0bb5\\u0ba4\\u0bc8 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd \\u0ba8\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1 mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n#\\u0bae\\u0bc1\\u0bb0\\u0b9a\\u0bca\\u0bb2\\u0bbf", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 1060\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bc8 \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0bb5\\u0bb0\\u0bbf\\u0b9f\\u0bae\\u0bcd, \\u0b87\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0bb5\\u0ba9\\u0bcd \\u0b95\\u0bcb\\u0baa\\u0bae\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bbe\\u0ba4\\u0bc1. \\u0ba4\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb2\\u0bb5\\u0bc7 \\u0baa\\u0bbf\\u0bb1\\u0bb0\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0ba9\\u0bcd \\u0bb5\\u0bb1\\u0bc1\\u0bae\\u0bc8\\u0baf\\u0bc7 \\u0b9a\\u0bbe\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc7.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "My heartfelt condolences on the passing of veteran politician Thiru. Shibu Soren, founder of the Jharkhand Mukti Morcha and former Chief Minister. A towering leader, his lifelong struggle for the rights of Adivasis and the marginalised will be remembered. Shibu Soren redrew the political map of the region and forced political parties to accord the dignity and respect for Scheduled Tribes - which was till then a mere notion engraved in the Indian Constitution.", "I share the grief of his family and the countless lives he touched through his tireless service. He is a true Bharat Ratna!", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1.\\u0b95. \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b8a\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bc1, \\u0b9a\\u0bbf\\u0bb1\\u0bc1 & \\u0ba8\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0bb0\\u0bc2.32,554 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd, 49,845 \\u0ba8\\u0baa\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bc7\\u0bb2\\u0bc8 \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd 41 \\u0baa\\u0bc1\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0ba3\\u0bb0\\u0bcd\\u0bb5\\u0bc1 \\u0b92\\u0baa\\u0bcd\\u0baa\\u0ba8\\u0bcd\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba9.", "\\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b95\\u0bc7.\\u0b95\\u0bc7.\\u0b8e\\u0bb8\\u0bcd.\\u0b8e\\u0bb8\\u0bcd.\\u0b86\\u0bb0\\u0bcd. \\u0bb0\\u0bbe\\u0bae\\u0b9a\\u0bcd\\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba4\\u0bbe.\\u0bae\\u0bcb.\\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bb0\\u0b9a\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1. \\u0b95\\u0bc0\\u0ba4\\u0bbe\\u0b9c\\u0bc0\\u0bb5\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b85\\u0ba9\\u0bbf\\u0ba4\\u0bbe \\u0b86\\u0bb0\\u0bcd. \\u0bb0\\u0bbe\\u0ba4\\u0bbe\\u0b95\\u0bbf\\u0bb0\\u0bc1\\u0bb7\\u0bcd\\u0ba3\\u0ba3\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0ba9\\u0bcb \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb0\\u0bbe\\u0b9c\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9f\\u0bbf.\\u0b86\\u0bb0\\u0bcd.\\u0baa\\u0bbf. \\u0bb0\\u0bbe\\u0b9c\\u0bbe, \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0ba8\\u0bbe. \\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0bbe\\u0ba9\\u0ba8\\u0bcd\\u0ba4\\u0bae\\u0bcd, \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bbe\\u0bb0\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba9\\u0bb0\\u0bcd.", "\\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8 \\u0b8a\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 VinFast \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0b9a\\u0bbe\\u0bb0 \\u0b95\\u0bbe\\u0bb0\\u0bcd \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0ba4\\u0bb3\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bb3\\u0baa\\u0ba4\\u0bbf \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1.\\u0b95. \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcb\\u0ba4\\u0bc1.", "I strongly believe that attracting and grounding investments is like parenting - you can\\u2019t force anything, it won\\u2019t work. You nurture, create the right environment, listen and provide support to enable overall growth. Thats when that growth will happen in a steady and sustainable manner."], "model": "voyage-multilingual-2", "input_type": "document", "truncation": true, "output_dtype": "float", "output_dimension": 1024, "encoding_format": "base64"}' message='Post details'

\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0bcd \\u0b93\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b95!\\n\\n#PeriyarForever aiadmk.official", "I extend my heartfelt greetings to the Hon\'able Prime Minister of India Thiru. narendramodi Avl. on your birthday.\\n\\nOur Nation is becoming superpower under your brave leadership and governance.\\n\\nI pray for your long, healthy, happy life and I wish you continue to serve the biggest democracy in the world.\\n\\neps.tamilnadu aiadmk.official", "\\u0ba4\\u0ba9\\u0ba4\\u0bc1 \\u0b86\\u0bb4\\u0bae\\u0bbe\\u0ba9 \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bbe\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0b95 \\u0baa\\u0bb2\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc7\\u0b9a\\u0ba4\\u0bcd \\u0ba4\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd, \\u0baa\\u0bc6\\u0ba3\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0bbe\\u0ba9 \\u0b9a\\u0bae\\u0bc1\\u0ba4\\u0bbe\\u0baf\\u0bae\\u0bcd \\u0baa\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0b9f\\u0bc1\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bbe\\u0ba4\\u0bbf, \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf\\u0bb5\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0b95\\u0bb2\\u0bb5\\u0ba9\\u0bcd \\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bc8 #\\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb
\\u0bcd\\u0ba4\\u0bbf \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0baa\\u0bca\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0b89\\u0b9f\\u0bb2\\u0bcd\\u0ba8\\u0bb2\\u0bae\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0b9a\\u0bbe\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd.", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1.\\u0b95.  \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0baa\\u0b9f\\u0bbf, \\u0b85\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0ba9\\u0ba4\\u0bc1 \\u0b89\\u0ba3\\u0bcd\\u0ba3\\u0bbe\\u0bb5\\u0bbf\\u0bb0\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb2\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0ba4\\u0bc6\\u0bb1\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc0\\u0bb1\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b8e\\u0bb4\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bc6\\u0bb1\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0ba9\\u0bcd \\u0b9a\\u0bc6\\u0bb5\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0bc0\\u0bb0\\u0bb0\\u0bcd - \\u0bb5\\u0bc6\\u0bb3\\u0bcd\\u0bb3\\u0bc8\\u0baf\\u0ba9\\u0bc7 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bc7\\u0bb1\\u0bc1 \\u0b8e\\u0ba9 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bb2\\u0bcd \\u0b8e\\u0bb4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0baf \\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bb0\\u0bcd \\u0baa\\u0bc2\\u0bb2\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0bb5\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1.\\n\\n\\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0b9a\\u0bc1\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bb5\\u0bc7\\u0b9f\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd  \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0b95\\u0bc2\\u0bb0\\u0bcd\\u0bb5\\u0bcb\\u0bae\\u0bcd.", "\\ud83d\\udea8 EXCITING NEWS from Germany! \\ud83d\\udea8\\n\\nHonourable Chief Minister of Tamil Nadu Thiru. MK Stalin avargal\\u2019s investment mission in Europe kicked off on a high note with three major MoUs signed this morning !", "Knorr-Bremse, the Munich-headquartered global leader in safety and braking systems, will establish its first-ever major manufacturing unit in Tamil Nadu with a massive Rs. 2,000 crore investment. This cutting-edge facility for railway doors and braking systems will create 3,500 new jobs and strengthen our advanced railway components and engineering ecosystem.", "Nordex Group, one of the world\\u2019s top wind turbine manufacturers, has announced an expansion in Tamil Nadu with Rs. 1,000 crore investment, creating 2,500 jobs. This cements our leadership in renewable energy manufacturing and green industrialisation.", "ebm-papst, a global leader in energy-efficient motors and air movement solutions, will expand both its GCC and manufacturing base in Tamil Nadu, with Rs. 201 crore investment over five years, generating 250 high-value jobs in HVAC, automotive and industrial applications.", "The Honourable Chief Minister also met senior leaders from BMW Group and urged them to ensure that their future expansions should happen in Tamil Nadu. They reaffirmed their commitment to the state, citing Tamil Nadu\\u2019s unmatched EV and automotive ecosystem.\\n\\nThese investments represent confidence in Tamil Nadu\\u2019s policy, people and potential amidst global trade shifts. Under the leadership of Honourable CM, we are powering through challenges with courage and ambition !", "#InvestInTN #BullishOnTN #JobsForTN #DravidianModel", "\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd 1\\u0b86\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0bb3\\u0bcd!\\ud83c\\udf99\\ufe0f\\n\\n\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b87\\u0bb0\\u0bb5\\u0bc1 8 \\u0bae\\u0ba3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u201c\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd\\u201d \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0baa\\u0bc7\\u0bb0\\u0bbe\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0b9c\\u0bc6.\\u0b9c\\u0bc6\\u0baf\\u0bb0\\u0b9e\\u0bcd\\u0b9a\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd!\\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b89\\u0bb0\\u0bc8\\u0baf\\u0bc8 X \\u0ba4\\u0bb3\\u0bae\\u0bcd, \\u0bae\\u0bc1\\u0b95\\u0ba8\\u0bc2\\u0bb2\\u0bcd, \\u0baf\\u0bc2\\u0b9f\\u0bbf\\u0baf\\u0bc2\\u0baa\\u0bcd, \\u0b87\\u0ba9\\u0bcd\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bbe\\u0ba3\\u0bb2\\u0bbe\\u0bae\\u0bcd!\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd", "\\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb1\\u0bb5\\u0bbe\\u0b95, \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0bb5\\u0ba9\\u0bbe\\u0b95 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bc7\\u0bb2\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0ba3\\u0bbe\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.\\n\\n#CMStalinInEurope", "\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95!", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b95\\u0bbf\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0bae\\u0bc1\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0bb5\\u0bbe\\u0bb2\\u0bcd\\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0bb8\\u0bcd \\u0b9a\\u0bbe\\u0bb2\\u0bc8, \\u0ba4\\u0ba3\\u0bcd\\u0ba3\\u0bc0\\u0bb0\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bc6\\u0bb0\\u0bc1\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0b9f\\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd\\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0b95\\u0bb0 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb0\\u0ba4\\u0bcd\\u0ba4 \\u0b9a\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bb0\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bae\\u0bcd, 844 \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0b9f\\u0bbf \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd, \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bb2\\u0bcd, \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0ba8\\u0bb2\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0b9a\\u0bcd\\u0b9a\\u0b95\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u201c\\u0b92\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bb3\\u0bbe\\u0b95\\u0bae\\u0bcd\\u201d \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bc1\\u0bb0\\u0bbf\\u0ba4\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0ba
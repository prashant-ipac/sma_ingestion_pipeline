b95\\u0bcd\\u0b95\\u0bc1 \\u201c\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f\\u0bae\\u0bcd\\u201d \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0b8a\\u0b9f\\u0b95\\u0bb5\\u0bbf\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd!\\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b89\\u0bb0\\u0bc8\\u0baf\\u0bc8 X \\u0ba4\\u0bb3\\u0bae\\u0bcd, \\u0bae\\u0bc1\\u0b95\\u0ba8\\u0bc2\\u0bb2\\u0bcd, \\u0baf\\u0bc2\\u0b9f\\u0bbf\\u0baf\\u0bc2\\u0baa\\u0bcd, \\u0b87\\u0ba9\\u0bcd\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bbe\\u0ba3\\u0bb2\\u0bbe\\u0bae\\u0bcd!\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd", "\\ud83d\\udea8 A Total of Rs. 7,020 crore in MoUs creating 15,320 jobs ! \\n\\nFurther to our 3 major MoUs signed earlier, our Honourable Chief Minister of Tamil Nadu Thiru. MK Stalin avargal secured 23 MoUs worth Rs. 3,819 crore, generating 9,070 new jobs at the #TNRising Germany Investors Conclave in D\\u00fcsseldorf, \\n\\nWith this, the overall investments signed in Germany during the Chief Minister\\u2019s visit now stands at a total of Rs. 7,020 crore across 26 MoUs, creating 15,320 #JobsForTN !", "Today\\u2019s conclave further brought in global leaders such as BASF, Herrenknecht, Vensys Energy, Bella, Puls, Witzenmann, and MASH Energy, who are investing across renewable energy, automotive components, industrial equipment, and advanced R&D.\\n\\nMore Importantly, companies which have existing operations have also chosen to reinvest and expand in TN, reaffirming their trust in our unmatched industrial ecosystem and the governance of our Honourable Chief Minister of Tamil Nadu Thiru. MK Stalin avargal \\u2665\\ufe0f\\ud83c\\udf04", "Germany \\u2705 \\n\\nNext stop, UK ! \\u2708\\ufe0f\\n\\n#InvestInTN #BullishOnTN #JobsForTN #DravidianModel", "\\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1: 1", "\\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bbe\\u0b95 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0bb1\\u0bc8 \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc7, \\u0ba4\\u0bae\\u0ba4\\u0bc1 \\u0b8e\\u0bae\\u0bcd\\u0b8e\\u0bb2\\u0bcd\\u0b8f \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95\\u0bae\\u0bcd, \\u0ba8\\u0bc7\\u0bb0\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba9 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1, \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bae\\u0bcd\\u0bae\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bc7\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bae\\u0ba9\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0bb5\\u0b95\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0b
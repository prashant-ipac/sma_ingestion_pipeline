u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bb5\\u0ba4\\u0bc8 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bb0\\u0bbe\\u0b95\\u0bc1\\u0bb2\\u0bcd\\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf \\u0b86\\u0ba4\\u0bbe\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0ba8\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd. \\u0b95\\u0bb0\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0b95\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc7 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0bb0\\u0bb5\\u0bc8 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd 1 \\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0baa\\u0bcb\\u0bb2\\u0bbf \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1, \\u0b92\\u0bb0\\u0bc7 \\u0b85\\u0bb1\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd 80 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b92\\u0bb0\\u0bc7 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 4 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb5\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b93\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b8e\\u0ba9 \\u0b85\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b95\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b86\\u0ba4\\u0bbe\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd.\\n\\n\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b95\\u0bc1 \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bc8 MLA \\n\\n#RahulExposeVoteChori", "\\"\\u0b9a\\u0bc1\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0b85\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb3\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0baf\\u0bc7 \\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\"\\n\\n- \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 rahulgandhi\\n\\n#rahulexposesvotechori", "Courage is answering, not avoiding. \\ud83d\\udd25\\ud83d\\udd25\\n\\n#RahulGandhi", "Dear Election Commission of India,\\nWill you deny that the voter list shown by RahulGandhi is genuine?\\nWill you challenge his claims point by point?\\nWill you reject the evidence of irregularities?\\nIf your answer is no, then you have deceived billions who believe their vote matters.\\nYou have committed fraud, not just on free and fair elections, but on the very soul of Indian democracy. Period."], "model": "voyage-multilingual-2", "input_type": "document", "truncation": true, "output_dtype": "float", "output_dimension": 1024, "encoding_format": "base64"}' message='Post details'

0ba4\\u0bbf \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bc7\\u0b9f\\u0bc1, \\u0b95\\u0bca\\u0bb0\\u0bcb\\u0ba9\\u0bbe \\u0ba8\\u0bc6\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bbf, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bb5\\u0bc6\\u0bb2\\u0bcd\\u0bb2 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba4 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bbe.\\u0b9c.\\u0b95. \\u0bb5\\u0ba9\\u0bcd\\u0bae \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0b93\\u0bb0\\u0bb5\\u0b9e\\u0bcd\\u0b9a\\u0ba9\\u0bc8 \\u0baa\\u0bcb\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0b9f\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b9a\\u0bca\\u0ba9\\u0bcd\\u0ba9 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bcb\\u0bae\\u0bcd!", "\\u2705 Accessibility\\n\\u2705 Accountability\\n\\u2705 Transparency\\n\\u2705 Inclusivity\\n\\u2705 Responsibility\\n\\u2705 Sustainability\\n\\u2600\\ufe0f \\u0b87\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95.!\\n\\nFull video \\ud83d\\udd17 in Bio", "Two powerhouses, one vision for the future\\n\\nIn D\\u00fcsseldorf, I met NRW Minister-President Thiru. hendrik.wuest \\u2014 a leader who has assumed high office at such a young age, and whom I warmly wish to see reach even greater heights in the years ahead.\\n\\nTamil Nadu, India\\u2019s industrial powerhouse, and North Rhine-Westphalia, Germany\\u2019s economic powerhouse, came together with the spirit of trust and optimism.", "I detailed Tamil Nadu\\u2019s remarkable growth under the #DravidianModel, and shared my wish for the great companies in NRW to explore the opportunities in our state. I also extended a cordial invitation for him to visit Tamil Nadu.\\n\\n#CMStalinInEurope #TNRising", "\\ud83c\\udde9\\ud83c\\uddea The Germany leg of my overseas investment mission concludes on a strong note \\n\\n\\ud83e\\udd1d At the #TNRising Germany Investment Conclave, 23 MoUs worth Rs. 3,819 crore were signed, set to generate over 9,000 jobs. Global leaders across renewable energy, automotive components and advanced R&D have chosen Tamil Nadu for their next phase of growth.\\n\\n\\ud83d\\udcc8 In total, 26 MoUs worth Rs. 7,020 crore have been signed during the Germany visit, set to generate over 15,000 jobs in Tamil Nadu.", "\\ud83d\\udca5 The #DravidianModel is translating conversations into commitments and trust into tangible growth.\\n\\ntrbrajaa guidancetamilnaduofficial\\n\\n#CMStalinInEurope", "LOCAL TO NATIONAL MEDIA \\ud83d\\udd25 @actorvijay \\n\\n#tvkvijay #thalapathy #thalapathyvijay #tamilagavettrikazhagam #tvkitwing", "Exclusive pic from madurai maanadu 2.0\\nPc:@rmclicksarts \\n\\n#tvkitwing #tvkvijay #thalapathy #vijay #thalapathyvijay #tamilagavettrikazhagam", "\\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1 \\u0b89\\u0b9f\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b89\\u0b9f\\u0bb2\\u0bcd\\u0ba8\\u0bb2\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0ba3\\u0bbf\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcb\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd!\\n\\n- \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#LetterToBrethren", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0ba4\\u0ba9\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc7 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1 \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b95\\u0bc2\\u0bb1\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd. \\u0ba8\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b8e\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 out of control \\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd!\\n\\n- \\u0b95\\u0bb4\\u0b95 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b86.\\u0b87\\u0bb0\\u0bbe\\u0b9a\\u0bbe \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#DMK4TN", "\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bc8 \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd, \\u0baa\\u0bc7\\u0bb0\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe, \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0bb5\\u0bb0\\u0bc8\\u0baf\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba8\\u0bc0\\u0ba4\\u0bbf 1.0 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8 \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0ba9\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0bae\\u0bbe\\u0bb1\\u0bbf\\u0baf\\u0ba4\\u0bc1. \\u0ba8\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bc8 \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba8\\u0bc0\\u0ba4\\u0bbf 2.0 \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb3\\u0bb5\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bc8 \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf \\u0b95\\u0ba9\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd!\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd \\n#CMStalinInEurope", "Six strategic wins for Tamil Nadu in London today, powering growth, innovation and future readiness.\\n\\nOur agreements with Wilson Power and Britannia RFID will boost our renewable energy industry and improve the competitiveness of exporters from Western Tamil Nadu. We also facilitated partnerships with the University of Exeter and Ecole Intuit Lab that will empower our youth with niche capabilities. And, Lloyd\\u2019s List Intelligence will undoubtedly boost our initiatives in the shipping and maritime sector."], "model": "voyage-multilingual-2", "input_type": "document", "truncation": true, "output_dtype": "float", "output_dimension": 1024, "encoding_format": "base64"}' message='Post details'

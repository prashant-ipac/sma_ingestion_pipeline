3\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bae\\u0bbe?", "5.\\t01/05/2025 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0bae\\u0bb1\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0baf\\u0bb0\\u0bc8 \\u0ba8\\u0bc0\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb1\\u0bc1 17/07/2025 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bcb\\u0bae\\u0bcd. \\u0b87\\u0ba4\\u0bc1 \\u0b8e\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd?\\n\\n\\t6.\\t\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bc8 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0bb5\\u0ba3\\u0bae\\u0bbe\\u0b95 \\u0b86\\u0ba4\\u0bbe\\u0bb0\\u0bc8 \\u0b8f\\u0bb1\\u0bcd\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b8e\\u0ba4\\u0bc1?\\n\\n\\t7.\\t\\u201c\\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bcd\\u201d \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc7 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb2\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0ba9\\u0bbe\\u0bb2\\u0bcd, \\u0b85\\u0ba4\\u0bc1 \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0b9f\\u0ba9\\u0bc1\\u0bae\\u0bcd - \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bc6\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bbe\\u0bae\\u0bc7?\\n\\n#VoteTheft", "The interview by the #CEC is raising more questions than providing answers to the issues highlighted by the #INDIA bloc.\\n\\nThe following questions arise:\\n\\n\\t1.\\tHow can there be so many deletions of eligible voters when house-to-house enumeration was undertaken?\\n\\n\\t2.\\tThe enrolment of new voters is abnormally low. Were these young voters enumerated? Has any database been compiled to show how many youngsters who turned 18 on the qualifying date were included?", "3.\\tThe procedure for enquiry and two appeals, along with their timelines as contemplated under the Registration of Electors Rules, 1960, may exclude a huge number of voters in the forthcoming elections in Bihar. Is the ECI going to address this issue?\\n\\n\\t4.\\tWill the #ECI take these practical difficulties into account while conducting #SIR in other States?", "5.\\tOn 17/07/2025, we requested the ECI to delete the names of deceased voters from the rolls by undertaking the exercise contemplated in its 01/05/2025 notification. When will this be done?\\n\\n\\t6.\\tWhat prevents the ECI from enlisting Aadhaar as one of the acceptable documents to prove a voter\\u2019s claim?\\n\\n\\t7.\\tIf \\u201cFair Elections\\u201d is truly the aim of the ECI, why can\\u2019t it be more transparent and voter-friendly?\\n\\n#VoteTheft", "\\u201c\\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf \\u0baa\\u0bcb\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bb0\\u0ba3\\u0bc1\\u0bae\\u0bcd\\u0ba9\\u0bbe\\u0bb2\\u0bc7 50 \\u0bb0\\u0bc2\\u0baa\\u0bbe\\u0baf\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8. \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb2\\u0baf\\u0bc7 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bc7\\u0ba9\\u0bcd\\u201d \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0b8e\\u0ba3\\u0bcd\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bc8 - \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0\\u0ba4\\u0bcd \\u0ba4\\u0b9f\\u0bc8\\u0baf\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0b95\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 - \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 - \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0baa\\u0baf\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bae\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bc1 #\\u0bb5\\u0bbf\\u0b9f\\u0bbf\\u0baf\\u0bb2\\u0bcd_\\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd!\\n\\n\\u0ba8\\u0bae\\u0ba4\\u0bc1 #DravidianModel-\\u0b87\\u0ba9\\u0bcd 51 \\u0bae\\u0bbe\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0baa\\u0baf\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc2\\u0bb2\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0b9a\\u0b95\\u0bcb\\u0ba4\\u0bb0\\u0bbf\\u0b95\\u0bb3\\u0bcd 50 \\u0b86\\u0baf\\u0bbf\\u0bb0\\u0bae\\u0bcd \\u0bb0\\u0bc2\\u0baa\\u0bbe\\u0baf\\u0bcd \\u0bb5\\u0bb0\\u0bc8 \\u0b9a\\u0bc7\\u0bae\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1\\u0bae\\u0bcd - \\u0b85\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b9a\\u0bc6\\u0bb2\\u0bb5\\u0bb4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0b95\\u0bb3\\u0bbf\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bc1!", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b95\\u0bc7\\u0bb3\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0b8e\\u0bb4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd\\n\\n#VoteChori", "\\u0bae\\u0b99\\u0bcd\\u0b95\\u0bc8 \\u0b9a\\u0bc2\\u0ba4\\u0b95\\u0bae\\u0bbe\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0b95\\u0b99\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc2\\u0bb4\\u0bcd\\u0b95\\u0bb2\\u0bbe\\u0bae\\u0bcd; \\u0b95\\u0b99\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc7 \\u0b9a\\u0bc2\\u0ba4\\u0b95\\u0bae\\u0bbe\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bc7 \\u0baa\\u0bcb\\u0bb5\\u0ba4\\u0bc1 \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb5\\u0ba4\\u0bc8 \\u0baa\\u0bcb\\u0bb2 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bc7\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbf\\u0b95\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc7\\u0bb3\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bbe\\u0b95 \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0bb0\\u0bcd \\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb5\\u0ba4\\u0bc8 \\u0ba4\\u0bb5\\u0bbf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bcc\\u0ba9\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd.\\n\\n#VoteChori", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 1074\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0baa\\u0ba3\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1 \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0ba4 \\u0b95\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bae\\u0bcd\\u0bae\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb4\\u0bbf\\u0bb5\\u0bbe\\u0ba9 \\u0b95\\u0bc1\\u0ba3\\u0bae\\u0bc1\\u0b9f\\u0bc8\\u0baf\\u0bcb\\u0bb0\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bcd, \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bbf\\u0b9f\\u0ba4\\u0bcd \\u0ba4\\u0bbe\\u0bae\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bb0\\u0bcd\\u0bb5\\u0bae\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "Pursuant to my request to Southern Railway for stoppages at Thoothukudi Melur Railway Station, Madurai Division has announced that Train No. 16235 (Tuticorin-Mysuru Express) and Train No. 16236 (Mysuru-Tuticorin) will henceforth halt at Tutimelur. This decision will greatly benefit passengers across this route.\\n\\nI thank railminindia & Southern Railway officials for accepting this request in the interest of the travelling public.\\n\\n#DMKinParliament", "Today in the Lok Sabha, under Rule 377, I highlighted the injustice of Tamil Nadu being forced to bear the majority share of funding for Centrally Sponsored Schemes. I urged the Union Government to ensure fair and equal cost-sharing between the Centre and the States.", "For instance, Tamil Nadu contributes 61% for housing schemes, 73% for fisheries, and 83% for old-age pensions, while these are projected as Union Government schemes. How fair is it to claim them in the Union\\u2019s name when the State shoulders most of the cost?\\n\\n\\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf\\u0bae\\u0bb1\\u0bcd\\u0bb1 \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc7 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb5\\u0bb0\\u0bc1\\u0bb5\\u0ba4\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc1\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf, \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf - \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0b9f\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0ba9 \\u0b9a\\u0bae\\u0bae\\u0bbe\\u0ba9 \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc6\\u0ba9, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd 377 \\u0bb5\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0bb5\\u0bb2\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "\\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0b9a\\u0ba4\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 61%, \\u0bae\\u0bc0\\u0ba9\\u0bcd\\u0bb5\\u0bb3\\u0bae\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 73%, \\u0b93\\u0baf\\u0bcd\\u0bb5\\u0bc2\\u0ba4\\u0bbf\\u0baf\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 83% \\u0b8e\\u0ba9 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc7 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bb3\\u0bb5\\u0bc1 \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0b85\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0baa\\u0bc6\\u0baf\\u0bb0\\u0bcd \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb5\\u0ba4\\u0bc1 \\u0b8e\\u0bb5\\u0bcd\\u0bb5\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf\\u0bae\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd?\\n\\n#DMKinParliament", "Attended the INDIA alliance leaders\\u2019 meeting in Parliament today and joined fellow MPs in protest against flawed electoral roll revisions. We demand free and fair elections, and transparency in electoral roll revisions.\\n\\n#DMKinParliament", "The Tamil Nadu Information Technology and Digital Services Department\\u2019s has signed an MoU with Meta to launch WhatsApp-based citizen services, launching a single number through which people can access 50 essential government services anytime, anywhere.", "In its first phase, citizens will be able to lodge grievances, pay electricity and water bills, pay municipal taxes, and even book metro tickets \\u2014 all within a single chat window. Available in both Tamil and English, this initiative will significantly reduce the need for multiple visits to service centres, bringing essential government services directly to people\\u2019s mobile phones."], "model": "voyage-multilingual-2", "input_type": "document", "truncation": true, "output_dtype": "float", "output_dimension": 1024, "encoding_format": "base64"}' message='Post details'

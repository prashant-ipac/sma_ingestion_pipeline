3\\u0bc8 \\u0bae\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bb4\\u0b95\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n#AdmkFails", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd #\\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd_\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0b9f\\u0bc8\\u0baf\\u0bc8 \\u0ba8\\u0bc0\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0b89\\u0b9a\\u0bcd\\u0b9a\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0bae\\u0bcd \\u0b85\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0bcd \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1 \\u0b86\\u0b95\\u0bc1\\u0bae\\u0bcd. \\u0b87\\u0ba4\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0b95\\u0bbe\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf- \\u0b9a\\u0ba3\\u0bcd\\u0bae\\u0bc1\\u0b95\\u0bae\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe \\u0b8e\\u0ba9\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8.\\n\\n#\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 1064\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b92\\u0bb0\\u0bc1 \\u0bb5\\u0bb4\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba4 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0bb0\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0b95\\u0bc8\\u0baf\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9f \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba4 \\u0baa\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1, \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bc8\\u0baf\\u0b95\\u0bae\\u0bc7 \\u0b88\\u0b9f\\u0bbe\\u0b95\\u0bbe\\u0ba4\\u0bc1.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "Today in New Delhi, I met the Hon\'ble Prime Minister and raised important issues related to my constituency and Tamil Nadu, including the transhipment hub at VOC Port in Thoothukudi. I also thanked him for the support in upgrading Thoothukudi Airport.", "Yesterday, I attended a meeting of senior INDIA alliance leaders where the Leader of the Opposition, Thiru. Rahul Gandhi, briefed us on the shocking extent of voter fraud being enabled by the ECI at the behest of the BJP.\\n\\nThis is a serious threat to our democracy and needs immediate rectification. We stand united to safeguard every Indian\\u2019s fundamental right to vote.", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0b85\\u0ba3\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd TRB \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0b9e\\u0bcd\\u0b9a\\u0bc8 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bcb\\u0bb5\\u0bbf \\u0b9a\\u0bc6\\u0bb4\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f #\\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe_\\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0b95\\u0bae\\u0bcd \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 (#DMKDistrictFirewall) \\u0ba4\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd.\\n\\n\\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0ba9\\u0bcd MLA, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.TKG.\\u0ba8\\u0bc0\\u0bb2\\u0bae\\u0bc7\\u0b95\\u0bae\\u0bcd MLA \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc7\\u0baf\\u0bb0\\u0bcd \\u0b9a\\u0ba9\\u0bcd \\u0bb0\\u0bbe\\u0bae\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0b85\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd OTN-AC\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bbe\\u0ba9 \\u0b86\\u0bb2\\u0bcb\\u0b9a\\u0ba9\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0ba3\\u0bca\\u0bb2\\u0bbf \\u0bb5\\u0bbe\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0b95  \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0b85\\u0ba3\\u0bbf\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd TRB \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc1.", "\\ud83c\\udf8aWelcome to Tamil Nadu, #MuRata !\\ud83c\\udf8a\\n\\nA global leader in advanced electronic components, with a 40% share in multilayer ceramic capacitors, whose components power smartphones in our pockets to NASA\\u2019s Mars helicopter \\u2013 they are right here in #TamilNadu !", "Look carefully at the 3rd Picture...Do you spot the First MLCC chip...Zoom in... That 0.25x0.125 mm chip looks like a spec of dust\\ud83d\\udc40 I personal saw a 1mm X 0.5mm chip being mounted onto a tape and to think that that chip has 200 Layers in it is just astounding !!!", "THIS is the kind of niche Manufacturing that TamilNadu is building today with the help of our Japanese partners. YES PARTNER,every single Investor in TN is considered a Partner by the Govt of TN. Afterall they pave the way for #JobsForTN which inturn gives us Overall Economic Growth...hence TN is #1 in India\\ud83c\\udf1f\\n\\nThis is Murata\\u2019s first facility in India, and they\\u2019ve chosen Chennai, a decision that speaks volumes about the strength of our ecosystem.", "This unit illustrates how our electronics sector is rapidly moving from assembly to high-value component manufacturing.\\n\\n#Chennai and its surrounding districts today form one of the most integrated EMS clusters in Asia, with capabilities ranging from printed circuit board assembly to final product integration. Our matching electronics components manufacturing scheme will only accelerate this momentum and bring many more such global players into the state.", "About a month ago, I was in Kyoto, meeting Murata\\u2019s esteemed leadership and extending Tamil Nadu\\u2019s warm invitation to set shop and expand. I was deeply impressed by their vision and commitment to excellence, and I am confident this is just the start of their journey here.\\n\\nMurata\\u2019s investment is part of a larger wave of Japanese trust in Tamil Nadu. Japanese companies have truly made our state their second home.", "Under the leadership of Honourable Chief Minister of Tamil Nadu Thiru. MK Stalin avargal, we are shaping India\\u2019s electronics future!\\n\\n#InvestInTN #JobsForTN #BullishOnTN", "\\ud83c\\udf1fWhat a pleasant surprise at the the GCC NEXT Summit 2025 !\\n\\nI had the privilege of joining my dear friend Suresh Sambandam for a lively and thoughtful fireside chat at the summit. We spoke about Tamil Nadu\\u2019s enormous talent advantage, our unmatched engineering and technology base, and how our tier 2 cities are quietly turning into tier 1 hubs for knowledge-driven growth.", "The most memorable moment of the event was the spontaneous round of applause from the audience, celebrating the people of Tamil Nadu for achieving double-digit GSDP growth in 2024-25 !\\n\\nThat applause wasn\\u2019t for any government or official. It was for the ambition, the resilience and the sheer brilliance of the hugely talented workforce of TN !", "Our vision under the leadership of Honourable Chief Minister of TamilNadu Thiru. MK Stalin avargal is clear: Make Tamil Nadu the most preferred destination in the world for high-value services and innovation \\u2665\\ufe0f\\n\\nThank You Kreate Works and Suresh \\ud83d\\ude4f\\ud83c\\udffe\\n#InvestInTN #JobsForTN #BullishOnTN", "\\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bb5\\u0bc0\\u0ba9 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0baf\\u0bc1\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b8f\\u0bb1\\u0bcd\\u0baa \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0bae\\u0bca\\u0bb4\\u0bbf\\u0baf\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0b95\\u0bb5\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0b95\\u0bbf\\u0bb1 \\u0ba4\\u0bca\\u0bb2\\u0bc8\\u0ba8\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0bb5\\u0bc8\\u0baf\\u0bc1\\u0b9f\\u0ba9\\u0bcd, \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0bc2\\u0bb1\\u0bcd\\u0bb1\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0baf\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd TVA2001 \\u0b92\\u0bb0\\u0bc1 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0bae\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bc2\\u0bb2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0b87\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bc8 \\u0b87\\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0b95\\u0bcd\\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba8\\u0bc2\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0bb0\\u0bc1\\u0bb5 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bc0\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b93\\u0bb2\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bc1\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba9. \\u0b87\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bc8 17 \\u0b95\\u0bcb\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bc2\\u0bb2\\u0b95\\u0bae\\u0bcd, \\u0ba4\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0bb0\\u0bc0\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95", "\\u0ba4\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0bb0\\u0bc0\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.", "\\u0b92\\u0bb3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b92\\u0bb2\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bca\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bbe\\u0ba3\\u0bca\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0ba8\\u0bbf\\u0bb2\\u0bb5\\u0bb0\\u0bc8\\u0baa\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bb5\\u0bc8 \\u0b85\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0baa\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0b9f\\u0b95\\u0baa\\u0bcd \\u0baa\\u0baf\\u0ba9\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1, \\u0baa\\u0baf\\u0ba9\\u0bb0\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa \\u0b85\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0ba9 \\u0ba4\\u0bc7\\u0b9f\\u0bb2\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0b9f
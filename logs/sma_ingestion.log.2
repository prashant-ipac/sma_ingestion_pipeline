\u0bb0\\u0bbf\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bb0\\u0bbe\\u0b95 \\u0baa\\u0b9e\\u0bcd\\u0b9a\\u0bbe\\u0baa\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0baa\\u0b95\\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bcd \\u0bae\\u0bbe\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\n\\n#CMBreakfastScheme", "\\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc2\\u0bb2\\u0bae\\u0bcd \\u0b87\\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bcb\\u0baa\\u0bb2\\u0b9f\\u0bcd\\u0b9a \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0b9a\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba3\\u0bbf \\u0ba8\\u0bc0\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0baf\\u0bbe\\u0baf\\u0bcd, \\u0ba4\\u0bbe\\u0baf\\u0bbe\\u0baf\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \'\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0ba8\\u0bbe\\u0baf\\u0b95\\u0bb0\\u0bcd\' \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0ba8\\u0bbe\\u0baf\\u0b95\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd! \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b9a\\u0bc6\\u0bb4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd!\\n\\n#CMBreakfastScheme", "#CMBreakfastScheme = Social Investment! \\n#DravidianModel", "When I look at these children, I don\\u2019t just see smiles.\\n\\nIn these children, I see the future of Tamil Nadu; children who can grow up to be doctors, teachers, poets, players, or anything they dream of.\\n\\nMy duty is not only to fill their plates, but also to feed their dreams.\\n\\nWith every breakfast we serve, I strengthen my resolve to give these children the care and opportunities they deserve.", "The expansion of the #CMBreakfastScheme is my promise to build a stronger, brighter Tamil Nadu, where every child grows with care, opportunity, and hope.\\n\\nWhen our children rise, Tamil Nadu rises with them.\\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bb4\\u0bb2\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd, \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0baa\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bb2\\u0bcd\\u0bb2! \\u0ba8\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0baf\\u0bc7 \\u0b95\\u0bbe\\u0ba3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95, \\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95, \\u0b95\\u0bb5\\u0bbf\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95, \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bc0\\u0bb0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95, \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba4\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0baf\\u0bb0\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0ba3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.", "\\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0b9a\\u0bbf\\u0baf\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0ba4\\u0bc1 \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bb2\\u0bcd\\u0bb2, \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0ba9\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0ba9\\u0bb5\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b95\\u0b9f\\u0bae\\u0bc8 \\u0b8e\\u0ba9\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd!\\n\\n\\u0b92\\u0bb5\\u0bcd\\u0bb5\\u0bca\\u0bb0\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0ba3\\u0bb5\\u0bc1 \\u0baa\\u0bb0\\u0bbf\\u0bae\\u0bbe\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1, \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b95\\u0b9f\\u0bae\\u0bc8\\u0baf\\u0bc8 \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb2\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0ba8\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bb0\\u0bbf\\u0bb5\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b95\\u0bb5\\u0ba9\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b8a\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc6\\u0b9e\\u0bcd\\u0b9a\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bae\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bcb\\u0b9f\\u0bc1 \\u0bb5\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb2\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0ba9, \\u0b92\\u0bb3\\u0bbf\\u0bae\\u0baf\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bc6\\u0bb4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0bae\\u0bca\\u0bb4\\u0bbf!\\n\\n\\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0baf\\u0bb0, \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0bae\\u0bcd \\u0b89\\u0baf\\u0bb0\\u0bc1\\u0bae\\u0bcd!", "\\u0bae\\u0ba9\\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bbe\\u0ba9 \\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u2764\\ufe0f\\n\\n#CMBreakfastScheme bhagwantmann1", "#KolathurVisit", "#KolathurVisit", "#KolathurVisit", "#KolathurVisit", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0b85\\u0ba3\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd, \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd trbrajaa \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b87\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbf.", "\\"\\u0b89\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0bb0\\u0bcd \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0bb0\\u0bc7\\" \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8f\\u0bb1\\u0bcd\\u0baa \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0b9a\\u0bbf\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0baf\\u0bc1\\u0bae\\u0bbe\\u0ba9\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\n\\n\\u0b95\\u0bca\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b89\\u0ba3\\u0bb5\\u0bb2\\u0bcd\\u0bb2, \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd \\u2665\\ufe0f\\n\\n#CMBreakfastScheme", "\\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0bbf, \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0ba3\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd. \\u0b87\\u0ba4\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\n\\n\\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd, \\u0baa\\u0b9e\\u0bcd\\u0b9a\\u0bbe\\u0baa\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0b95\\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bcd \\u0bae\\u0bbe\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\n\\n#CMBreakfastScheme", "\\u0bb5\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0b9a\\u0bbf\\u0baf\\u0bcb\\u0b9f\\u0bc1, \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0b9a\\u0bbf \\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b8e\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1, \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bb2\\u0bcd\\u0bb2 \\u0b9a\\u0bbf\\u0bb2 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0ba8\\u0bbe\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0ba9\\u0bb0\\u0bcd\\n\\u0b95\\u0bb4\\u0b95 \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0ba3\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0b
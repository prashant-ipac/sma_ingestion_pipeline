\u0ba4\\u0bbf\\u0b95\\u0bb4\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bc1\\u0bae\\u0bcd! \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0ba8\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0baf\\u0bb0\\u0bc1\\u0bae\\u0bcd!\\n\\n#LetterToBrethren", "\\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bc1 \\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bb5\\u0bcb\\u0bb0\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bb2\\u0bcd!\\n\\n\\u0b9a\\u0bc6\\u0baa\\u0bcd\\u0b9f\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd 17 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bc1 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd!\\n\\n #\\u0bae\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd_\\u0bb5\\u0bbf\\u0bb4\\u0bbe", "\\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u00ad\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u00ad\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba8\\u0b95\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u00ad\\u0baa\\u0bc1\\u0bb1 \\u0baa\\u0b95\\u0bc1\\u00ad\\u0ba4\\u0bbf\\u00ad\\u0b95\\u00ad\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b89\\u0ba4\\u0bb5\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u00ad\\u0bb3\\u0bbf\\u00ad\\u0b95\\u00ad\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u00ad\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bbf\\u00ad\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u00ad\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u00ad\\u0bb5\\u0ba4\\u0ba9\\u0bcd \\u0bae\\u0bc2\\u0bb2\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bcd 20.59 \\u0b87\\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0baf\\u0ba9\\u0bcd\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bb5\\u0bb0\\u0bcd! \\n\\n#CMBreakfastScheme", "\\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b89\\u0ba3\\u00ad\\u0bb5\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u00ad\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba8\\u0b95\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u00ad\\u0baa\\u0bc1\\u0bb1 \\u0baa\\u0b95\\u0bc1\\u00ad\\u0ba4\\u0bbf\\u00ad\\u0b95\\u00ad\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b89\\u0ba4\\u0bb5\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u00ad\\u0bb3\\u0bbf\\u00ad\\u0b95\\u00ad\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u00ad\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bbf\\u00ad\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u00ad\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u00ad\\u0baf\\u00ad\\u0bb5\\u0bbf\\u00ad\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u00ad\\u0bb1\\u0ba4\\u0bc1. \\n\\n\\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bbf\\u0bb0\\u0bbf\\u00ad\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u00ad\\u0b95\\u0ba4\\u0bcd\\u00ad\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc2\\u0bb2\\u0bae\\u0bcd \\u0ba8\\u0b95\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u00ad\\u0baa\\u0bc1\\u00ad\\u0bb1\\u0bae\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 2,429 \\u0baa\\u0bb3\\u0bcd\\u00ad\\u0bb3\\u0bbf\\u00ad\\u0b95\\u00ad\\u0bb3\\u0bbf\\u0bb2\\u0bcd, \\u0b92\\u0ba9\\u0bcd\\u00ad\\u0bb1\\u0bbe\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b90\\u0ba8\\u0bcd\\u00ad\\u0ba4\\u0bbe\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bb0\\u0bc8 \\u0baa\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u00ad\\u0b95\\u0bc1\\u0bae\\u0bcd 3.6 \\u0b87\\u0bb2\\u0b9f\\u0bcd\\u00ad\\u0b9a\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u00ad\\u0bb5 \\u2013 \\u0bae\\u0bbe\\u00ad\\u0ba3\\u00ad\\u0bb5\\u0bbf\\u00ad\\u0baf\\u0bb0\\u0bcd \\u0baa\\u0baf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bc1\\u00ad\\u0bb5\\u0bb0\\u0bcd.\\n\\n\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0bb5\\u0ba9\\u0bcd \\u0bae\\u0b9f\\u0bb2\\u0bcd\\n\\n #CMBreakfastScheme", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bb0\\u0b9a\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bb5\\u0bc7\\u0b9f\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0baf\\u0bb0\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0baa\\u0bbf. \\u0b9a\\u0bc1\\u0ba4\\u0bb0\\u0bcd\\u0b9a\\u0ba9\\u0bcd \\u0bb0\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b86\\u0ba4\\u0bb0\\u0bb5\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bcb\\u0bae\\u0bcd.", "Addressed the 57th Regional Conference of the Southern India Regional Council of ICAI on \\u201cGlobalisation, Free Trade and Tariffs \\u2014 Past, Present and Future.\\u201d\\n\\nFrom Roman coins discovered in Tamil Nadu to the Silk Route and the colonial era, history bears witness to the fact that trade has always shaped civilisations. Today we are at an inflection point \\u2014 a shift from hyper-globalisation towards regional blocs and bilateral pacts.", "Free trade has generated prosperity, though unevenly spread. I reflected on how short-term tariff wars are politically driven, but deeper shifts are underway: diminishing US dollar dominance, growing local currency trade, and India\'s demographic dividend \\u2014 with nearly one in four young people on this planet being Indian.", "As globalisation enters a new phase of fragmentation, India\'s growth story will be written by how well we invest in our people \\u2014 their skills, their ingenuity, their productivity and above all, their ability to adapt. Harnessing this power with vision and purpose will ensure that India will not merely participate in the next chapter of globalisation \\u2014 we will define it.", "Honoured to be Chief Guest at the 65th ICT Academy BRIDGE Conference in Coimbatore on the theme \\u201cTN \\u2013 From Skilling to Global AI Leadership\\u201d\\n\\nKey highlights: \\n\\n\\ud83d\\udd39 Reaffirming our commitment to investment in human capital and inclusive growth, Hon\\u2019ble CM Thiru mkstalin Vetri Nichayam scheme launched in my presence \\u2014 ICT Academy & Tamil Nadu Skill Development Corporation (TNSDC) to train 20,000 unemployed youth with IT skills", "\\ud83d\\udd39 Launch of India Design Week 2026, powered by Autodesk, organised by ICT Academy \\u2014 India\\u2019s largest design fest for budding engineers \\n\\n\\ud83d\\udd39 Kick-off of Snowflake Platform Training Month\\u2014 15 colleges gaining hands-on expertise in AI-driven data platforms \\n\\n\\ud83d\\udd39 Honoured NEXT GEN Edupreneur Awards 2025 winners \\u2014 celebrating innovation in education \\n\\nProud of ictacademyindia & TN IT & Digital Services Dept for consistently bridging academia & industry, empowering Tamil Nadu\\u2019s youth to lead globally in the AI era.", "\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bb0\\u0b9a\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf \\u0bb5\\u0bc7\\u0b9f\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bbe\\u0b95 \\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0b9a\\u0bcd\\u0b9a\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0baa\\u0ba4\\u0bbf \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9a\\u0bc1\\u0ba4\\u0bb0\\u0bcd\\u0b9a\\u0ba9\\u0bcd \\u0bb0\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8, \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bb5\\u0bbf\\u0bae\\u0bbe\\u0ba9 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\n\\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1 \\u0b87\\u0ba9\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u2026\\n\\n#ARaja tiruchisiva SPK_TNCC DrKalanidhiV PWilsonDMK", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0b9a\\u0bc6\\u0baa\\u0bcd\\u0b9f\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd 17\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0ba4\\u0bbf \\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd, \\n\\n\\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bc8 \\u0baa\\u0bc6\\u0bb1\\u0bb5\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b95\\u0bb4\\u0b95 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd, \\u0b95\\u0bb4\\u0b95 \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9, \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0b95\\u0bcb\\u0ba4\\u0bb0\\u0bbf \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0b95\\u0ba9\\u0bbf\\u0bae\\u0bca\\u0bb4\\u0bbf \\u0b95\\u0bb0\\u0bc1\\u0ba3\\u0bbe\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0
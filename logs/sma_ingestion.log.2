0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8e\\u0ba9\\u0bcd.\\u0b86\\u0bb0\\u0bcd.\\u0b87\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bcb, \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf., \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8", "\\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95. \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bbf \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2 \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b92\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd ((DLC)), \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf \\u0b92\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd (CLC) \\u0b86\\u0bb2\\u0bcb\\u0b9a\\u0ba9\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd  \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1 26-07-2025  \\u0b9a\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb4\\u0bae\\u0bc8 \\u0b95\\u0bbe\\u0bb2\\u0bc8 10.00 \\u0bae\\u0ba3\\u0bbf \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0bb2\\u0bc8 5.00 \\u0bae\\u0ba3\\u0bbf \\u0bb5\\u0bb0\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc2\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf \\u0bb5\\u0b95\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8, \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbe\\u0bb2\\u0baf\\u0bae\\u0bcd, \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bc2\\u0ba4\\u0bcd\\u0ba4 \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b87\\u0bb0\\u0bbe.\\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bc8 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd.", "\\u0b87\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd  \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0baa\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b92\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd ((DLC)), \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf \\u0b92\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd ((CLC)) \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb5\\u0bb1\\u0bbe\\u0ba4\\u0bc1 \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bae\\u0bbe\\u0bb1\\u0bc1 \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.\\n\\n\\u0b87\\u0baa\\u0bcd \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0ba4\\u0bbf\\u0bb5\\u0bc7\\u0b9f\\u0bc1 \\u0bb5\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb5\\u0bb1\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bae\\u0bbe\\u0bb1\\u0bc1 \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.\\n\\n \\u0b8e\\u0ba9\\u0bcd.\\u0b86\\u0bb0\\u0bcd.\\u0b87\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bcb, \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf., \\n \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd, \\n \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95. \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8.\\n\\n ******** \\n#DMK", "\\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf \\u0ba4\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b86\\u0ba9\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0bb2\\u0bcd\\u0bb2. \\u0b9a\\u0b9a\\u0bbf\\u0b95\\u0bb2\\u0bbe \\u0ba4\\u0baf\\u0bb5\\u0bbe\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b86\\u0ba9\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf. \\u0b87\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0b85\\u0ba4\\u0bc7\\u0baa\\u0bcb\\u0bb2 \'\\u0baf\\u0bbe\\u0bb0\\u0bbe\\u0bb5\\u0ba4\\u0bc1\' \\u0ba4\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b86\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb2\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd.\\n\\n#\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 1048\\n\\n\\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0b95\\u0bca\\u0bb2\\u0bc8 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0ba4\\u0bc1\\u0baa\\u0bcb\\u0bb2 \\u0ba8\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0bae\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bb5\\u0bb1\\u0bc1\\u0bae\\u0bc8, \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc7 \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb1\\u0bbf\\u0baf\\u0bb5\\u0ba9\\u0bcd \\u0b8f\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0bbe\\u0ba9\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "Today in Parliament, I urged the Union Government to immediately publish the Keezhadi excavation report without further delay.\\n\\nDespite scientific validation from internationally accredited labs confirming Keezhadi\\u2019s antiquity, the Union continues to withhold the report. This deliberate silence is unacceptable and a disservice to Tamil Nadu\\u2019s cultural heritage.\\n\\n\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0ba4\\u0bb3\\u0bae\\u0bbe\\u0ba9 \\u0b95\\u0bc0\\u0bb4\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0b95\\u0bb4\\u0bbe\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b85\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0b89\\u0b9f\\u0ba9\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bbe\\u0bb1\\u0bc1 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd 377 \\u0bb5\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0bb5\\u0bb2\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd.", "\\u0b9a\\u0bb0\\u0bcd\\u0bb5\\u0ba4\\u0bc7\\u0b9a \\u0b85\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bbe\\u0ba9 \\u0b9a\\u0bcb\\u0ba4\\u0ba9\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bb0\\u0bbf\\u0b9a\\u0bcb\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0b95\\u0bc0\\u0bb4\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0ba8\\u0bbf\\u0bb0\\u0bc2\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0baa\\u0bcb\\u0ba4\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b85\\u0ba4\\u0bc8 \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0ba4\\u0bc1, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0bb4\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba8\\u0bc0\\u0ba4\\u0bbf.\\n\\n#DMKinParliament", "I raised an Unstarred Question in Lok Sabha on the need for a direct train link between Thoothukudi and Mumbai - a crucial route for migrant workers, students, and traders from southern Tamil Nadu.\\n\\nThe Ministry of Railways, in its reply, referred only to indirect routes without offering any concrete assurance or timeline for a direct service.\\n\\nThoothukudi and the southern districts deserve equitable infrastructure and focused attention.\\n\\n#DMKinParliament", "Joined the second day of protest with INDIA alliance MPs in front of Parliament against the misuse of the Special Intensive Revision of voter rolls in Bihar and West Bengal. We urge the Union Government to stop weaponising bureaucratic procedures to silently strip the marginalised of their fundamental democratic right to vote.\\n\\n#DMKinParliament", "\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0bb0\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd- \\u0baa\\u0bb0\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0bae\\u0bc7\\u0bb2\\u0bcd\\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bcb\\u0bb0\\u0bcd \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1&\\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95 \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bae\\u0bc7\\u0bb2\\u0bcd\\u0ba8\\u0bbf\
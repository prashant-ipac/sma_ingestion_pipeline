0baf\\u0bc1\\u0bae\\u0bcd.\\n\\n#kovaisouth", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1, \\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0ba4\\u0bc6\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bc0\\u0ba3\\u0bcd\\u0b9f \\u0b95\\u0bbe\\u0bb2 \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0bbf\\u0bb0\\u0b9a\\u0bcd\\u0b9a\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0baa\\u0bb5\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd \\u0b9c\\u0bbf \\u0b95\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0baa\\u0bcd\\u0baa\\u0ba9\\u0bb5\\u0bb0\\u0bcd\\n\\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bbe\\u0b95 \\u0bb5\\u0bbf\\u0bb5\\u0bbe\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd.\\n\\nCollector Coimbatore \\n\\n#kovaisouth", "Attended the 14th Graduation Day Ceremony of Sree Uthradom Thirunal Academy of Medical Sciences in Thiruvananthapuram, Kerala, today. It was a delight to  witness young healthcare professionals reach this important milestone and embark on their next endeavour. Wishing them great success as they step into a life of service in the healthcare sector.", "\\u0b89\\u0bb2\\u0b95\\u0bbf\\u0ba9\\u0bcd \\u0b8e\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bc7\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bb4\\u0bae\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0ba9 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0bae\\u0bca\\u0bb4\\u0bbf \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bb1\\u0bc8\\u0b9a\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. narendramodi \\u0b9c\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bb0\\u0bc0\\u0baa\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0ba4\\u0bc0\\u0bb5\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0ba9 \\u2018\\u0b9f\\u0bcd\\u0bb0\\u0bbf\\u0ba9\\u0bbf\\u0b9f\\u0bbe\\u0b9f\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bca\\u0baa\\u0bbe\\u0b95\\u0bcb\\u2019 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0baf\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bcb\\u0ba4\\u0bc1, \\u0bae\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0bae\\u0bc1\\u0bb1\\u0bc8 \\u0ba4\\u0ba9\\u0ba4\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0baa\\u0bcd \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bc8 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd. \\n\\n\\u2018\\u0b9f\\u0bcd\\u0bb0\\u0bbf\\u0ba9\\u0bbf\\u0b9f\\u0bbe\\u0b9f\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bca\\u0baa\\u0bbe\\u0b95\\u0bcb\\u2019 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b9c\\u0ba9\\u0bbe\\u0ba4\\u0bbf\\u0baa\\u0ba4\\u0bbf \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0b95\\u0bbf\\u0bb1\\u0bbf\\u0bb8\\u0bcd\\u0b9f\\u0bc8\\u0ba9\\u0bcd \\u0b95\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0bb2\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc2\\u0bb0\\u0bcd\\u0bb5\\u0bc0\\u0b95\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\n\\n\\u201c\\u0baa\\u0b9f\\u0bc8\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b95\\u0bc2\\u0bb4\\u0bcd\\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bc1 \\u0ba8\\u0b9f\\u0bcd\\u0baa\\u0bb0\\u0ba3\\u0bcd \\u0b86\\u0bb1\\u0bc1\\u0bae\\u0bcd\\n\\u0b89\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0ba9\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bb0\\u0bc1\\u0bb3\\u0bcd \\u0b8f\\u0bb1\\u0bc1\\u201d.", "- \\u0bb5\\u0bc0\\u0bb0\\u0bae\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0b9f\\u0bc8\\u0baa\\u0bb2\\u0bae\\u0bcd, \\u0ba4\\u0bc7\\u0b9a\\u0ba8\\u0bb2\\u0ba9\\u0bcd \\u0bae\\u0bc0\\u0ba4\\u0bc1 \\u0b85\\u0b95\\u0bcd\\u0b95\\u0bb1\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b85\\u0bb3\\u0bcd\\u0bb3\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbe\\u0ba4 \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bae\\u0bcd, \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bb2\\u0ba9\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd, \\u0b85\\u0bb4\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba4 \\u0b87\\u0bb0\\u0bbe\\u0ba3\\u0bc1\\u0bb5\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9 \\u0b95\\u0bbe\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bcd\\u0baa\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0bc1; \\u0b87\\u0bb5\\u0bc8 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0ba4\\u0bc7\\u0b9a\\u0bae\\u0bcd \\u0bb5\\u0bb3\\u0bae\\u0bcd \\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9\\u0ba4\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0b86\\u0bb1\\u0bc1 \\u0b85\\u0bae\\u0bcd\\u0b9a\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b86\\u0baf\\u0bbf\\u0bb0\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bc1\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0baa\\u0bc7 \\u2018\\u0b85\\u0baf\\u0bcd\\u0baf\\u0ba9\\u0bcd \\u0bb5\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bb5\\u0ba9\\u0bcd\\u2019 \\u0b89\\u0bb0\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bc2\\u0bb1\\u0bbf, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0bc8 \\u0b89\\u0bb2\\u0b95 \\u0b85\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0ba4\\u0bbf\\u0baf\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd.", "\\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b9a\\u0bca\\u0ba9\\u0bcd\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0baa, \\u2018\\u0b9f\\u0bcd\\u0bb0\\u0bbf\\u0ba9\\u0bbf\\u0b9f\\u0bbe\\u0b9f\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bca\\u0baa\\u0bbe\\u0b95\\u0bcb\\u2019 \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0ba9\\u0ba4\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b8e\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bb2\\u0bcd\\u0bb2 \\u0bb5\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0ba9 \\u0ba8\\u0b9f\\u0bcd\\u0baa\\u0bc1\\u0bb1\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc2\\u0bb1\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd.\\n\\n\\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0baf\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bcb\\u0ba4\\u0bc1, \\u2018\\u0b9f\\u0bcd\\u0bb0\\u0bbf\\u0ba9\\u0bbf\\u0b9f\\u0bbe\\u0b9f\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bca\\u0baa\\u0bbe\\u0b95\\u0bcb\\u2019 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0baf\\u0bb0\\u0bbf\\u0baf \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0ba9, \\u2018\\u0ba4\\u0bbf \\u0b86\\u0bb0\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0b86\\u0baa\\u0bcd \\u0ba4\\u0bbf \\u0bb0\\u0bbf\\u0baa\\u0baa\\u0bcd\\u0bb3\\u0bbf\\u0b95\\u0bcd \\u0b86\\u0baa\\u0bcd \\u0b9f\\u0bcd\\u0bb0\\u0bbf\\u0ba9\\u0bbf\\u0b9f\\u0bbe\\u0b9f\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0b9f\\u0bcd \\u0b9f\\u0bca\\u0baa\\u0bbe\\u0b95\\u0bcb\\u2019 \\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0b95\\u0bcc\\u0bb0
bcd\\u0ba4\\u0bc8 \\u0b86\\u0b95\\u0bcd\\u0bb8\\u0bcd\\u0baa\\u0bcb\\u0bb0\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0bb2\\u0bcd\\u0b95\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b87\\u0bb0\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1 \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd!\\n\\n#CMStalinInOxford", "Dravidian Month 2025 \\u2013 Celebrating Our Legacy, Inspiring the Future \\ud83d\\udda4\\u2764\\ufe0f\\n\\nThroughout September, the DMKITWing proudly celebrates #DravidianMonth with daily online events. This year\\u2019s theme is to introduce the heroes of the Dravidian movement to the younger generation through engaging digital content powered by AI.\\n\\nThis is not just a remembrance, but a digital renaissance of the Dravidian spirit, carrying the values of social justice, self respect, equality, and rationalism to future generations.", "newindianexpress \\n\\n\\ud83d\\udd17: https://www.newindianexpress.com/states/tamil-nadu/2025/Sep/02/dmk-it-wing-launches-dravidian-month-fete\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd", "\\u0b9a\\u0bc1\\u0baf\\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bc2\\u0bb1\\u0bcd\\u0bb1\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b89\\u0bb2\\u0b95 \\u0b85\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbe\\u0b9a\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bae\\u0bcd \\u0b92\\u0bb3\\u0bbf\\u0bb0 \\u0baa\\u0bcb\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1! \\ud83d\\udda4\\u2728\\n\\n\\u0b89\\u0bb2\\u0b95 \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0bcd \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0b87\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b86\\u0b95\\u0bcd\\u0bb8\\u0bcd\\u0baa\\u0bcb\\u0bb0\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0bb2\\u0bcd\\u0b95\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb1\\u0bbf\\u0bb5\\u0bc1 \\u0baa\\u0b95\\u0bb2\\u0bb5\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b87\\u0bb0\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd!\\n\\n#CMStalinInOxford", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd 90% \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc1\\u0baf\\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8\\u0baf\\u0bc8 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0ba4\\u0bb0\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95, \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf, \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd. 90% \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b9a\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bc0\\u0ba3\\u0bcd\\u0b9f \\u0ba4\\u0b95\\u0bbe\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95\\u0bb5\\u0bc8 \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0bb0\\u0bcb\\u0ba4 \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n- \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbf \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9f\\u0bbf.\\u0b95\\u0bc7.\\u0b8e\\u0bb8\\u0bcd.\\u0b87\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bcb\\u0bb5\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n\\u0bae\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb0\\u0bc8
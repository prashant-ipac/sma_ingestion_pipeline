b2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8:\\n\\n\\u0bb5\\u0bb1\\u0bc1\\u0bae\\u0bc8 \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1 \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95, \\u0b85\\u0bb1\\u0ba8\\u0bc6\\u0bb1\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0bb2\\u0b95\\u0bbf \\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0bb5\\u0ba9\\u0bc8, \\u0b85\\u0bb5\\u0ba9\\u0bcd \\u0ba4\\u0bbe\\u0baf\\u0bcd\\u0b95\\u0bc2\\u0b9f \\u0b85\\u0baf\\u0bb2\\u0bbe\\u0ba9\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb2\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bc1\\u0bb5\\u0bbe\\u0bb3\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "Joined fellow MPs of the INDIA alliance today at Makar Dwar, Parliament, to protest against the outrageous misuse of SIR by the Election Commission of India in Bihar and West Bengal. We urge the Union Government to stop using institutions as tools of political vendetta.\\n\\n#DMKinParliament", "Attended the INDIA alliance leaders\\u2019 meeting this morning in Parliament. We discussed the misuse of the Special Intensive Revision of the voter list in Bihar and West Bengal, and developments under #OperationSindoor.\\n\\n#DMKinParliament", "\\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc7 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0b9f\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 45 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bb5\\u0bc1 \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0b9f\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc6\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u201c#\\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd_\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u201d \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bc1\\u0b95\\u0bbe\\u0bae\\u0bbf\\u0ba9\\u0bc8, \\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0ba8\\u0bc6\\u0b9f\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd TRB \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bc1\\u0bb5\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\
0b9a\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0baf\\u0bbe? \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc7!", "\\u0b89\\u0b9f\\u0bc8\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0baf\\u0bcd!", "\\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b90\\u0baf\\u0bbe \\u0bb5\\u0bc8\\u0b95\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0ba8\\u0bbe\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b87\\u0bb4\\u0bbf\\u0bb5\\u0bc1\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. NainarBJP \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd!", "\\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bbf\\u0bb3\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bc1\\u0bb5\\u0ba4\\u0bc8 \\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0baf\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bc6\\u0bb3\\u0bcd\\u0bb3\\u0bc8 \\u0b85\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0bb5\\u0bb2\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. NainarBJP \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd!", "This is DMK\\u2019s model of Social Justice. \\n\\nA public servant belonging to the Scheduled Caste community in Tindivanam was cornered continuously by DMK Councillors and was made to apologise by falling at the feet of the DMK Councillor Ramya. This is not the first time DMK has humiliated public servants. This is not an isolated incident; earlier, DMK Minister Thiru Raja Kannappan had abused a government servant with caste slurs.", "What the DMK parades as Social Justice is, in truth, nothing more than Social Injustice.", "\\u0b86\\u0ba9\\u0bcd\\u0bae\\u0bc0\\u0b95\\u0bae\\u0bcd \\u0b86\\u0bb0\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bae\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0b93\\u0bb0\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bb2\\u0bc8 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0baf\\u0bcb\\u0b95\\u0bbf sadhguru \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0ba9\\u0bbf\\u0baf \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd!", "1990s-\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0b95\\u0ba9\\u0b9f\\u0bbe \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 (\\u0b85\\u0bb2\\u0bcd\\u0b9f\\u0bcd\\u0bb0\\u0bbe\\u0b9a\\u0bb5\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bcd \\u0bb8\\u0bcd\\u0b95\\u0bc7\\u0ba9\\u0bcd) \\u0baa\\u0baf\\u0bbf\\u0ba9\\u0bcd\\u0bb1 \\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd.... \\n\\nWhen I pursued advanced medical training in fetal Ultrasound scan in Canada in the 1990s...", "\\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0b95\\u0bbf\\u0b9a\\u0bcd\\u0b9a\\u0bc8 \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd\\n\\u0bb5\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb0\\u0bbf\\u0baf \\u0b90\\u0baf\\u0bbe \\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0b95\\u0bcd\\u0b95\\u0ba3\\u0bcd\\u0ba3\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 02.09.2025 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd.\\n\\n\\u0ba4\\u0bc2\\u0baf, \\u0b8e\\u0bb3\\u0bbf\\u0baf, \\u0b87\\u0ba9\\u0bbf\\u0baf \\u0bae\\u0ba9\\u0bbf\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0bc1\\u0ba9\\u0bbf\\u0ba4\\u0bb0\\u0bcd,\\n\\u0bb5\\u0bb1\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0bb5\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bbe\\u0ba9\\u0bcd\\u0bae\\u0bb4\\u0bc8,\\n\\u0ba4\\u0bbe\\u0bb4\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0ba4\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\u0baf\\u0bc7 \\u0b85\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0ba3\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0b95\\u0bc1\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0ba9\\u0bcd,\\n\\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0baa\\u0ba3\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0b90\\u0baf\\u0bbe \\u0ba8\\u0bb2\\u0bcd\\
af\\u0bbe\\u0b95 \\u0b85\\u0bb5\\u0bb0\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0ba4\\u0bc1 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf..", "Went to Puducherry on the way to Chennai from Cuddalore today. Happy to meet the honorable,CM of Puducherry..He felicitated  me blessed and said Now I am blessing you as a Senior politician.. friend of your father...seeing him for the first time after my resignation as Lt. Governor....it was a different but a great experience..happy to be blessed  by a senior leader in the political field...\\n\\n#Puducherry", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd, \\u0b9f\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbf \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb1\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc8 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0ba9, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. Athikadavu Subramaniam \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb5\\u0bbe\\u0bb4\\u0bc8 \\u0b95\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc8\\u0baf\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0baf\\u0bcb\\u0b95\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0b9e\\u0bcd\\u0b9a\\u0bc0\\u0bb5\\u0bbf \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0ba8\\u0bbf\\u0bae\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbe\\u0b95 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bb0\\u0bcd.", "\\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bb2\\u0ba9\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b8f\\u0bb0\\u0bbe\\u0bb3\\u0bae\\u0bbe\\u0ba9 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc6\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1 \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. narendramodi \\u0b9c\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0bc8 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1, \\u0b9a\\u0bc1\\u0bb5\\u0bbe\\u0bb0\\u0bb8\\u0bcd\\u0baf\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0b95\\u0bbf\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n#Farmers", "Welcomed former Union Minister of State, Shri drsanjeevbalyan1 Ji, at my residence today for a courtesy meeting.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0
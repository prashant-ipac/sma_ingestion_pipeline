0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1, The StartupTN \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bc6\\u0bae\\u0bcd \\u0baa\\u0bc2\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u2018RISING THOOTHUKUDI - Free Skill Training by Startups\\u2019 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0ba9\\u0bc8 \\u0ba4\\u0bc1\\u0bb5\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0bae\\u0bcd.\\n\\n\\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc2\\u0bb4\\u0bae\\u0bc8\\u0bb5\\u0bbf\\u0ba9\\u0bc8 \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bbe\\u0bb0\\u0bbf \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b86\\u0bb0\\u0bcd\\u0bb5\\u0bae\\u0bc1\\u0b9f\\u0bc8\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0ba9\\u0bcd \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0b9f\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0b87\\u0ba8\\u0bcd\\u0ba4 RISING THOOTHUKUDI \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bcd \\u0ba4\\u0bb3\\u0bae\\u0bbe\\u0b95 \\u0b85\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd.", "\\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1. \\u0b95\\u0bc0\\u0ba4\\u0bbe \\u0b9c\\u0bc0\\u0bb5\\u0ba9\\u0bcd, \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc7\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9c\\u0bc6\\u0b95\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0b9a\\u0bbe\\u0bae\\u0bbf, \\u0b9a\\u0bbe\\u0bb0\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0baa\\u0bbf\\u0bb0\\u0baa\\u0bc1, StartupTN \\u0b87\\u0ba3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b9c\\u0bc7\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd, StartupTN \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bb0\\u0bbe\\u0b95\\u0bc1\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bcb\\u0bb0\\u0bcd \\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba9\\u0bb0\\u0bcd", "\\u0ba8\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0bb4\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0b99\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0ba9\\u0bcd\\u0bb5\\u0bbf\\u0bb4\\u0bbe \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bcd\\u0b9f \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0baa\\u0bcb\\u0ba4\\u0bc1.", "\\u0b93\\u0bb0\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd!\\n\\n\\u0bb5\\u0bbf\\u0bb1\\u0bc1 \\u0bb5\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0bc6\\u0ba9 \\u0b87\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bc8 77,34,937 \\u0baa\\u0bc7\\u0bb0\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba9\\u0bb0\\u0bcd!\\n\\n\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1!\\n\\n#\\u0b93\\u0bb0\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd_\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1", "Happy to take part in the celebration of France\\u2019s National Day, hosted by Consul General Etienne Rolland-Piegue (franceinpondy). A joyous evening that reflected the enduring and ever-strengthening ties between Tamil Nadu and France.", "Designated by our Hon\'be Chief Minister Thiru mkstalin, I was honoured to speak at the 168th Birth Anniversary celebrations of the legendary Indian jurist and statesman, Sir Chettur Sankaran Nair. The event was graced by former National Security Adviser Mr M.K. Narayanan and former Principal Secretary to the Prime Minister Mr T.K.A. Nair.", "I shared my family\'s long-standing ties with Kerala, rooted in our proximity to the border and generations of cultural engagement. Most importantly, I highlighted Chettur Sankaran Nair\\u2019s pivotal contributions to India\'s social justice legacy: especially his role in shaping the 1919 Montagu-Chelmsford Reforms, which led to India\\u2019s first Dyarchy system and the historic Justice Party government of 1920. This marked a watershed moment in the Dravidian journey, and the electoral success of the Justice Party", "and the electoral success of the Justice Party paved the way for translating the ideals of social justice into political power and governance.", "An outspoken man of intellect and courage, Chettur Sankaran Nair helped create the constitutional foundations for a more just and inclusive society. We owe him a great debt of gratitude.", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0ba9\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0ba3\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b85\\u0b87\\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bae\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd!\\n\\n-\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd eps.tamilnadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf.\\n\\n#\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd_\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd\\n#\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8_\\u0bae\\u0bc0\\u0b9f\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd\\n#EPSfor2026\\n#\\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bbf\\u0ba9\\u0bcd_\\u0b8e\\u0bb4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd", "\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\
\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc7\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b87\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd!", "\\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd - \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0bae\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0ba8\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7 \\u0ba8\\u0bae\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0baf\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc2\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bc8 \\u0bae\\u0bc1\\u0bb1\\u0bbf\\u0baf\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95, \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b89\\u0bb0\\u0b95\\u0bcd\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb5\\u0bcb\\u0bae\\u0bcd!\\n\\n#ReservationIsOurRight", "On #InternationalTigerDay, Tamil Nadu roars with pride.\\n\\nWith 306 tigers as per NTCA, this success rests on the shoulders of our forest staff and anti-poaching teams who guard critical habitats across tough terrains.\\n\\nTo boost forest conservation, 1947 field posts have been filled, forces are being upgraded with modern gear, technology, and dedicated veterinarians.", "Habitats are being revived by removing invasives and improving forest health. The Tamil Nadu Forest and Wildlife Crime Control Bureau (#TNWFCCB), a specialised unit, has been formed to curb organised wildlife crime.\\n\\nIn saving our tigers, we are protecting the soul of our forests.", "\\u0b87\\u0b9f\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b87\\u0b9f\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bbf \\u0ba4\\u0bbe\\u0ba9\\u0bcd \\ud83d\\ude44\\n\\n#AdmkFails", "\\u0b9c\\u0bae\\u0bcd\\u0bae\\u0bc1 \\u0b95\\u0bbe\\u0bb7\\u0bcd\\u0bae\\u0bc0\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b85\\u0ba8\\u0bcd\\u0ba4\\u0bb8\\u0bcd\\u0ba4\\u0bc1 \\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bbf\\u0bb1\\u0b95\\u0bc1 \\u0b85\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b92\\u0bb4\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bc1, \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0bb4\\u0bc1 \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1.\\n\\n- \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bb5\\u0bc8 \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0b9a\\u0bbf\\u0bb5\\u0bbe \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n#MonsoonSession2025", "\\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0ba4\\u0ba9\\u0bbf \\u0bae\\u0bc6\\u0b9c\\u0bbe\\u0bb0\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8 \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0b89\\u0ba3\\u0bb0 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0ba8\\u0bc0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb0\\u0bc6\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b8a\\u0ba9\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcb\\u0bb2\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0ba8\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b92\\u0bb0\\u0bc1 \\u0b8a\\u0ba9\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcb\\u0bb2\\u0bcd \\u0b89\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0bae\\u0bc8 \\u0bae\\u0bcb\\u0b9a\\u0bae\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd. \\u0b8e\\u0ba9\\u0bb5\\u0bc7 \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0baa\\u0bb4\\u0b95\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd.\\n\\n- \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bb5\\u0bc8 \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0b9a\\u0bbf\\u0bb5\\u0bbe \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n#MonsoonSession2025", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe \\u0bae\\u0bc0\\u0ba4\\u0bc1 \\u0baa\\u0bbe\\u0b95\\u0bbf\\u0bb8\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bb5\\u0ba4\\u0bbe\\u0b95 \\u0b85\\u0bae\\u0bc6\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0b85\\u0ba4\\u0bbf\\u0baa\\u0bb0\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bb5\\u0bbf\\u0bb5\\u0b95\\u0bbe\\u0bb0\\u0bae\\u0bcd \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bc6\\u0b9f\\u0bcd\\u0b95\\u0bae\\u0bbe\\u0b95 \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bc8\\u0baf\\u0bbe? \\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bb5\\u0ba4\\u0bc8 \\u0b85\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bae\\u0bb2\\u0bcd \\u0bb0\\u0bbe \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b89\\u0bb3\\u0bb5\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bbe?\\n\\n- \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b86.\\u0b87\\u0bb0\\u0bbe\\u0b9a\\u0bbe \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n#MonsoonSession2025", "\\u0ba8\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8. \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bc8 \\u0b86\\u0ba4\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bc7\\u0bb0\\u0ba3\\u0bbf \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95\\u0bb4\\u0b95\\u0bae\\u0bcd, \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n- \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1.\\u0b95\\u0ba9\\u0bbf\\u0bae\\u0bca\\u0bb4\\u0bbf \\u0b95\\u0bb0\\u0bc1\\u0ba3\\u0bbe\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\n\\n#MonsoonSession2025", "We had to join these delegations because #peace had failed us and you had failed the people of #India!\\n\\nWe stood with the government and the Armed Forces. You didn\\u2019t see our #religion then. But back home, #BJP leaders continue to indulge in #hatespeech. What action has been taken against them?\\n\\nWhen #RAW and the #IB had already flagged suspicious activity, why was no action taken?", "Even the #Congress doesn\\u2019t remember #Nehru as much as the BJP does. Because of you, people in #TamilNadu are revisiting #Periyar and #Ambedkar and across India, they\\u2019re reading Nehru again.\\n\\nHas the Prime Minister even apologised to the victims families? To this day, there hasn\\u2019t been a single word of remorse!\\n\\n- Thirumigu kanimozhikarunanidhiofficial  M.P Avl", "\\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0b95\\u0b99\\u0bcd\\u0b95\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0b9a\\u0bcb\\u0bb4\\u0baa\\u0bc1\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bb0\\u0bcd. \\u0b95\\u0b99\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bb5\\u0ba9\\u0bcd \\u0b9a\\u0bcb\\u0bb4\\u0ba9\\u0bcd, \\u0b95\\u0b99\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0bb5\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bb5\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0ba9\\u0bcd. \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0ba9\\u0bcd \\u0b95\\u0b99\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0bb5\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0bb5\\u0bbe\\u0ba9\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0b95 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd!\\n\\n- \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0
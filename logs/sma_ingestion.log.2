a4\\u0bc1 \\u0bb5\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbf\\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0bcd \\u0b85\\u0bb2\\u0bcd\\u0bb2\\u2014\\u0b87\\u0ba4\\u0bc1 \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bcd.", "\\u0b92\\u0bb0\\u0bc1 \\u0bae\\u0ba9\\u0bc1\\u0bb5\\u0bbe\\u0ba4\\u0bbf \\u0bae\\u0ba9\\u0ba8\\u0bbf\\u0bb2\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0bbe\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb0 \\u0ba4\\u0bbf\\u0b9a\\u0bc8\\u0baf\\u0bc8 \\u0bb5\\u0b9f\\u0bbf\\u0bb5\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1, \\u200b\\u200b\\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0ba8\\u0bc0\\u0ba4\\u0bbf \\u0b92\\u0bb0\\u0bc1 \\u0baa\\u0bb2\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.\\n90% SC/ST/OBC \\u0b95\\u0bc1\\u0bb0\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8f\\u0ba9\\u0bcd \\u0baa\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd?\\n\\u0b8f\\u0ba9\\u0bcd \\u0b89\\u0b9a\\u0bcd\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0ba9\\u0bcd\\u0bae\\u0bc1\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bc8?\\n#SocialJusticeNow #RSSCasteAudit\\n\\nRSS \\u0b92\\u0bb0\\u0bc7 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe, \\u0b9a\\u0bae \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bc8 \\u0ba8\\u0bae\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bbe\\u0bb2\\u0bcd, \\n\\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd \\u0b9a\\u0bbe\\u0ba4\\u0bbf \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n\\u0b92\\u0bb5\\u0bcd\\u0bb5\\u0bca\\u0bb0\\u0bc1 \\u0baa\\u0bbf\\u0bb0\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb0\\u0b95\\u0bb0\\u0bcd, \\u0b95\\u0bbe\\u0bb0\\u0bbf\\u0baf\\u0bb5\\u0bbe\\u0b95\\u0b95\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbe\\u0ba4\\u0bbf \\u0b85\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n\\u0baa\\u0ba9\\u0bcd\\u0bae\\u0bc1\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b85\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb5\\u0bbe\\u0ba4\\u0bae\\u0bcd \\u0b85\\u0bb2\\u0bcd\\u0bb2 - \\u0b85\\u0ba4\\u0bc1 \\u0ba8\\u0bc0\\u0ba4\\u0bbf.\\n\\n\\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe? \\n\\n#ManuwadiRSS #RSSCasteTruth", "Attended the Standing Committee on Housing & Urban Affairs today in Parliament Annex.\\n\\nWe reviewed the Smart Cities Mission, which has now officially ended. Launched in 2015 to transform 100 cities\\u2014some progress was made, but many promises remain unfulfilled.\\nAs we move forward, we must focus on inclusive, people-first urban development.\\nLet\\u2019s learn from this mission, and make sure no one is left behind in our cities.\\n\\n#SmartCitiesMission \\n#UrbanDevelopment \\n#parliament", "\\u0b9f\\u0bbe\\u0bb8\\u0bcd\\u0bae\\u0bbe\\u0b95\\u0bcd \\u0bb5\\u0b9a\\u0bc2\\u0bb2\\u0bc8\\u0baa\\u0bcd \\u0b95\\u0bcb\\u0bb2 \\u0b95\\u0bc1\\u0bb5\\u0bbe\\u0bb0\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0b9a\\u0bc2\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf \\u0ba8\\u0bbe\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bcd \\u0b95\\u0bc7\\u0b99\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0b95\\u0bbf\\u0bb1 \\u0baa\\u0bcb\\u0bb2\\u0bbf \\u0b95\\u0ba9\\u0bbf\\u0bae\\u0bb5\\u0bb3 \\u0b85\\u0ba4\\u0bbf\\u0b9
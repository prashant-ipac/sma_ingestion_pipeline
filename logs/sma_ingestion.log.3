d\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bbe\\u0ba3\\u0bca\\u0bb3\\u0bbf \\u0bb5\\u0bbe\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0b95 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf, \\u0b87\\u0bb0\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bbe\\u0ba9\\u0bae\\u0bcd \\u0b85\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b89\\u0ba4\\u0bbf\\u0bb0\\u0b95\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc8 \\u0b85\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0b95\\u0bb4\\u0b95 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bbe\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0ba4\\u0bb4\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd.", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd, \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd, \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. #\\u0b8e\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bcd, aiadmkitwingofl \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f #\\u0b87\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd_\\u0b87\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bc7 \\u0b87\\u0bb0\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bbe\\u0ba9 \\u0bae\\u0bc1\\u0b95\\u0bbe\\u0bae\\u0bcd\\u0b95\\u0bb3\\u0bc8, #\\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0b95\\u0bc1\\u0ba9\\u0bbf\\u0baf\\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0bbe\\u0ba3\\u0bca\\u0bb3\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bb5\\u0bbe\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. eps.tamilnadu aiadmk.official #AIADMK #\\u0b85\\u0b87\\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95", "\\u0b95\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0bb0\\u0bb0\\u0b9a\\u0bc1 vairamuthuoffl \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbe\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0b85\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd\\u0bae\\u0bbe\\u0bb3\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0b8a\\u0bb0\\u0bcd\\u0bb5\\u0bb2\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0ba9\\u0bbf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0bb5\\u0b9f\\u0bc1\\u0b95\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc1. \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd i.periyasamy \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0b85\\u0bae\\u0bcd\\u0bae\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0b9f\\u0bb2\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bb2\\u0bb0\\u0bcd \\u0bb5\\u0bb3\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd.", "Glad to have had the opportunity to participate in JCI India Zone 17\\u2019s Midyear Conference 2025 in Perundurai today. Junior Chamber International (JCI) is a global organisation of young, active citizens aged 18 to 40 committed to creating positive change in their communities. India\\u2019s youth today possess critical thinking, resilience, and a growing appetite for risk, hallmarks of transformative leadership. With such qualities, we are confident they will play a pivotal role in realising the vision of Viksit", "a pivotal role in realising the vision of Viksit Bharat envisioned by our Hon PM Thiru Narendra Modi avl. \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 JCI (\\u0b9c\\u0bc2\\u0ba9\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0b9a\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bc7\\u0bb7\\u0ba9\\u0bb2\\u0bcd) \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe 17 \\u0b86\\u0bb5\\u0ba4\\u0bc1 \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd 2025 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bbe\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf. JCI \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1, 18 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd 40 \\u0bb5\\u0baf\\u0ba4\\u0bc1\\u0b9f\\u0bc8\\u0baf, \\u0b9a\\u0bc1\\u0bb1\\u0bc1\\u0b9a\\u0bc1\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9 \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f, \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0ba8\\u0bc7\\u0bb0\\u0bcd\\u0bae\\u0bb1\\u0bc8\\u0baf\\u0bbe\\u0ba9 \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0b9f\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb2\\u0b95\\u0bb3\\u0bbe\\u0bb5\\u0bbf\\u0baf \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd. \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0ba9\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f, \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd", "\\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0ba9\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f, \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bc7\\u0b9f\\u0bb2\\u0bc8 \\u0ba8\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0baa\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95, \\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0baa \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba9\\u0bb0\\u0bcd. \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0ba8\\u0bb0\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc6\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0b9f\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0bb2\\u0bc8\\u0ba8\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0ba9\\u0bc8\\u0baf\\u0bc8 \\u0ba8\\u0ba9\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0ba4\\u0bbf\\u0bb2\\u0bcd, \\u0b87\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bc8 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9 \\u0b95\\u0bc1\\u0ba3\\u0bbe\\u0ba4\\u0bbf\\u0b9a\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0b95\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0ba9 \\u0ba8\\u0bae\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b86\\u0bae\\u0bcd\\u0baa\\u0bc2\\u0bb0\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0bb6\\u0bcd\\u0bb0\\u0bc0\\u0b9a\\u0bae\\u0baf\\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0bbf \\u0ba4\\u0bbe\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1 \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bae\\u0bcd \\u0b85\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bb3\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd 15-\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bbf\\u0bb4\\u0bbe \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b9f\\u0bae\\u0bc1\\u0bae\\u0bcd, \\u0b89\\u0bb1\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bbf \\u0ba4\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bb0\\u0bcd \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bc1\\u0bb2\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95, \\u0bb6\\u0bcd\\u0bb0\\u0bc0\\u0b9a\\u0bae\\u0baf\\u0bb5\\u0bb2\\u0bcd\\u0bb2\\u0bbf \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1 \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bae\\u0bcd \\u0baa\\u0bcb\\u0ba9\\u0bcd\\u0bb1 \\u0b85\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bb3\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0ba4\\u0bb5\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0ba9. \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0b9a\\u0bc2\\u0bb4\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd, \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0b95\\u0bbe\\u0bb0\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95, \\u0b86\\u0ba4\\u0bb0\\u0bb5\\u0bb1\\u0bcd\\u0bb1\\u0bcb\\u0bb0\\u0bbe\\u0baf\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0bae\\u0bbe\\u0bb1\\u0bc1\\u0bb5\\u0bcb\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bbf\\u0bb4\\u0bb2\\u0bcd \\u0ba4\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0ba4\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b85\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bb3\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bbf\\u0bb4\\u0bbe \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba4\\u0bc1 \\u0bae\\u0bbf\\u0b95\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b87\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1", "\\u0b85\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b87\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bb0\\u0bbf\\u0b9a\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcb\\u0b9f\\u0bc1 \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b89\\u0ba3\\u0bb5\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0ba4\\u0bc1 \\u0bae\\u0ba9\\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc1 \\u0b85\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0bb6\\u0bcd\\u0bb0\\u0bc0\\u0bb0\\u0bbe\\u0bae\\u0b95\\u0bbf\\u0bb0\\u0bc1\\u0bb7\\u0bcd\\u0ba3 \\u0bae\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b9a\\u0bc1\\u0bb5\\u0bbe\\u0bae\\u0bbf \\u0b9a\\u0bae\\u0bbe\\u0bb9\\u0bbf\\u0ba4\\u0bbe\\u0ba9\\u0ba8\\u0bcd\\u0ba4\\u0b9c\\u0bbf \\u0bae\\u0bb9\\u0bb0\\u0bbe\\u0b9c\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b9a\\u0bc7\\u0bb5\\u0bbe\\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bbf \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0b85\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bb3\\u0bc8 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb2\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.", "\\u0ba4\\u0bbe\\u0baf\\u0bc8 \\u0b87\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0bb0\\u0bb0\\u0b9a\\u0bc1 \\u0b90\\u0baf\\u0bbe \\u0bb5\\u0bc8\\u0bb0\\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b86\\u0bb1\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b95\\u0bc2\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0b9a\\u0bc0\\u0bae\\u0bbe\\u0ba9\\u0bcd !", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd eps.tamilnadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb2\\u0bbf \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0b9f\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd aiadmkitwingofl \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd #\\u0b87\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd_\\u0b87\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bc7 \\u0bae\\u0bbe\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb0\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bbe\\u0ba9 \\u0bae\\u0bc1\\u0b95\\u0bbe\\u0bae\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba9.", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0ba
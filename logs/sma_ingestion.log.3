b2\\u0bc8\\u0b95\\u0bc1\\u0ba9\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc2\\u0bb4\\u0bb2\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1 \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0bae\\u0bbf\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba9\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0bae\\u0ba9\\u0bae\\u0bcd \\u0baa\\u0bc1\\u0ba3\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bbf\\u0b9f\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0baa\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0baa\\u0bc7\\u0b9a\\u0bcd\\u0b9a\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. ***", "When a CLOWN moves into a palace, he doesn\\u2019t become a king. The palace becomes a CIRCUS! #DMKFailsTN", "\\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0b9a\\u0bc2\\u0bb0\\u0bbf\\u0baf\\u0ba9\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bbe\\u0ba9 \\u0b8f\\u0baa\\u0bcd\\u0bb0\\u0bb2\\u0bcd -14 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0bae\\u0bca\\u0bb4\\u0bbf\\u0baf\\u0bc8 \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bc1, \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bc8 \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0ba8\\u0bbe\\u0bb3\\u0bbe\\u0b95 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bbf\\u0b9f \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc6\\u0ba9 \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd! #Ambedkar #DMK4TN", "\\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0baa\\u0bc2\\u0bb0\\u0bcd\\u0bb5\\u0bae\\u0bbe\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0b85\\u0bae\\u0bb2\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbe\\u0ba9\\u0ba4\\u0bc1, \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb5\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bc1\\u0bb5\\u0ba4\\u0bc1 \\u0b85\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0bb4\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb2\\u0bcd\\u0bb2! \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf \\u0b8f\\u0bb1\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb2\\u0bcd\\u0bb2! -\\u0b95\\u0bb4\\u0b95 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8e\\u0ba9\\u0bcd.\\u0b86\\u0bb0\\u0bcd.\\u0b87\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bcb \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf. \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd", "Very educative visits to some of our military establishments on behalf of the Parliamentary Standing Committee on Defence indiannavy", "#\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95_\\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bb2\\u0bcd_\\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bc1 \\ud83d\\udd25\\ud83c\\udf1f", "\\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0bb5\\u0bc8 \\u0bb5\\u0bb4\\u0bbf\\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.NainarBJP \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd!", "Yesterday, I had the opportunity to visit the Museum of Possibilities in Chennai, a truly inspiring space envisioned and opened by our Hon\\u2019ble Chief Minister Thiru M.K. Stalin. This museum showcases technologies that are helping differently abled people lead lives with greater independence, confidence, and dignity. Every corner of the space is filled with hope, innovation, and compassion. One of my favorite moments was sitting at the Museum Cafe, run by differently abled people, with a view of Marina Beach", "abled people, with a view of Marina Beach and the balcony lined with trees and plants. It made the visit even more enjoyable. The Museum of Possibilities on the Marina, is not just a place, it is a vision of the world we must all strive to create. I truly hope everyone visits this equitable space, to experience it, and to carry its message of hope, dignity, and inclusion into every part of our lives.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b9a\\u0bc1\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9, \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b95\\u0bbf\\u0bb7\\u0ba9\\u0bcd \\u0bb0\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0ba4\\u0bb0\\u0bc1\\u0ba3\\u0bcd \\u0b9a\\u0bc1\\u0b95\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b87\\u0ba3\\u0bc8\\u0baf\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 L \\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0bae\\u0bc2\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bbe\\u0b95, \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0ba8\\u0baf\\u0bbf\\u0ba9\
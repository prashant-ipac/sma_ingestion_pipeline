u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0b99\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b95\\u0bcb\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u00a0\\u0b95\\u0bbe\\u0bb2 \\u0ba4\\u0bbe\\u0b95\\u0bae\\u0bcd \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bcb\\u0bb0\\u0bcd \\u0baa\\u0ba8\\u0bcd\\u0ba4\\u0bb2\\u0bc8 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcb\\u0b9f\\u0bc1 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bcb\\u0bb0\\u0bcd,\\u0b87\\u0bb3\\u0ba8\\u0bc0\\u0bb0\\u0bcd,\\u0bb5\\u0bc6\\u0bb3\\u0bcd\\u0bb3\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0baf\\u0bcd, \\u0ba4\\u0bb0\\u0bcd\\u0baa\\u0bc2\\u0b9a\\u0ba3\\u0bbf \\u0baa\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd. \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bcb\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd\\u00a0\\u0b85\\u0ba4\\u0bbf\\u0b95 \\u0ba8\\u0bc0\\u0bb0\\u0bcd \\u0b85\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bbe\\u0bb1\\u0bc1 \\u0b89\\u0b9f\\u0bb2\\u0bcd \\u0bb5\\u0bb1\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba4\\u0bb5\\u0bbe\\u0bb1\\u0bc1 \\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd", "\\u0b85\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bbe\\u0bb1\\u0bc1 \\u0b89\\u0b9f\\u0bb2\\u0bcd \\u0bb5\\u0bb1\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba4\\u0bb5\\u0bbe\\u0bb1\\u0bc1 \\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bae\\u0bbe\\u0bb1\\u0bc1 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcb\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd!.. bjp4india bjp4tamilnadu", "What an eye opening visit !\\ud83d\\udc40 Visited the Hong Fu facility in Haiphong, #Vietnam, a leading footwear manufacturer from Taiwan. The factory floor was buzzing with activity and had a first hand experience of the various processes involved in making a shoe \\u2665\\ufe0f Urged them to speed up work to establish their unit in TN. They have confirmed that they have recieved all clearances and that the construction of their facility will commence very soon\\ud83d\\udc5e\\ud83e\\udd1d\\ud83c\\uddee\\ud83c\\uddf3 Requested them to expand further in TN \\ud83d\\ude4f\\ud83c\\udffe #InvestInTN #JobsForTN", "to expand further in TN \\ud83d\\ude4f\\ud83c\\udffe #InvestInTN #JobsForTN #TNInVietnam", "Met the Indian Ambassador to Vietnam, Thiru. Sandeep Arya in Hanoi to strengthen trade and investment ties between #TamilNadu and #Vietnam yesterday. The discussion focused on deepening industrial cooperation and unlocking new opportunities for Tamil Nadu. \\ud83c\\uddee\\ud83c\\uddf3\\ud83e\\udd1d\\ud83c\\uddfb\\ud83c\\uddf3 #InvestInTN #JobsForTN #TNInVietnam", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bb0\\u0b9a\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0b9a\\u0bcd\\u0b9a \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0baf \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bc8, \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0b9a\\u0bc1\\u0baf\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0b95\\u0bcd\\u0b95 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baa\\u0bc2\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\u0b95\\u0bc7\\u0bb0\\u0bb3\\u0bbe, \\u0ba4\\u0bc6\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0ba9\\u0bbe, \\u0baa\\u0b9e\\u0bcd\\u0b9a\\u0bbe\\u0baa\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f 8 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0b9f\\u0bbf\\u0ba4\\u0bae\\u0bcd", "The Union BJP Government is attempting to overturn the Supreme Court\\u2019s landmark verdict that upheld the rights of elected State Governments against obstructive Governors. I have urged all non-BJP States and regional parties to unite in this crucial legal battle to protect federalism and preserve the Constitution\\u2019s basic structure. \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bcd! \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bb5\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bc1\\u0bae\\u0bcd!", "\\u0b86\\u0bb3\\u0bc1\\u0ba8\\u0bb0\\u0bcd \\u0bb0\\u0bb5\\u0bbf \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0b9f\\u0bcd\\u0b95\\u0bbe\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0b9f\\u0bcd\\u0b9f\\u0bc2\\u0bb4\\u0bbf\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0b9a\\u0bcd\\u0b9a\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0bae\\u0bcd \\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bc1. \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bb0\\u0b9a\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bc2\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0b86\\u0bb4\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0bb4 \\u0b85\\u0b95\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. #\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "1958-\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0ba8\\u0bb5\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd, \\u0ba4\\u0b9e\\u0bcd\\u0b9a\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b8e\\u0bb8\\u0bcd.\\u0b8e\\u0bae\\u0bcd.\\u0b9f\\u0bbf. \\u0ba4\\u0ba9\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0baa\\u0bc7\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8a\\u0ba4\\u0bbf\\u0baf \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0bb5\\u0bc1 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b88\\u0b9f\\u0bc1\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd. \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0b95\\u0bb0\\u0bae\\u0bbe\\u0b95 \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd! #\\u0b95\\u0bb0\\u0bc1\\u0bb5\\u0bc2\\u0bb2\\u0bae\\u0bcd", "1996 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bb3\\u0baa\\u0ba4\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc7\\u0baf\\u0bb0\\u0bbe\\u0b95 \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0b95\\u0bb4\\u0b95 \\u0b89\\u0b9f\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1! #\\u0b83\\u0baa\\u0bcd\\u0bb3\\u0bbe\\u0bb7\\u0bcd\\u0baa\\u0bc7\\u0b95\\u0bcd", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 981 \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8: \\u0b86\\u0bb1\\u0bcd\\u0bb1 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0b95\\u0b9f\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b89\\u0ba3\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b85\\u0bb5\\u0bb1\\u0bcd\\u0bb1\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0baf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bb2\\u0bcd\\u0bb2 \\u0b95\\u0b9f\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc7 \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd. #\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "In a historic move, Chief Minister of Tamil Nadu Thiru mkstalin launches a bold initiative to bring our brightest minds back home! From top tier salaries to fast tracked visas, the #TamilTalentsPlan empowers global researchers to build the future from #TamilNadu not away from it. With visionary steps in #AI, #science, and global collaboration, TamilNadu proves it\'s not just keeping up with the world, it\\u2019s leading it. #DMK4TN \\ud83d\\udd17:", "up with the world, it\\u2019s leading it. #DMK4TN \\ud83d\\udd17: https://timesofindia.indiatimes.com/city/chennai/state-offers-grants-jobs-visas-to-bring-researchers-leaving-the-us/articleshow/121240743.cms", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bc7- 18. \\u0bae\\u0bc1\\u0bb3\\u0bcd\\u0bb5\\u0bc7\\u0bb2\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0bb5\\u0bbe\\u0baf\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0
5\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9f, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. #\\u0b8e\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0bb2 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd! eps.tamilnadu aiadmk.official aiadmkitwingofl #Coimbatore #AIADMK #\\u0b85\\u0b87\\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95", "\\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bae\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b87\\u0baf\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbe\\u0b9a\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd! \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bbe\\u0ba9 \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bc8 \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0ba8\\u0bbe\\u0bb3\\u0bbe\\u0b95 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bbf \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0bb5\\u0bcb\\u0bae\\u0bcd! #\\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5_\\u0ba8\\u0bbe\\u0bb3\\u0bcd", "\\"\\u0b95\\u0bb1\\u0bcd\\u0baa\\u0bbf \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bc1\\u0b9a\\u0bc7\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b9a\\u0bc6\\u0baf\\u0bcd\\" \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 ,\\u0baa\\u0bbf\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bbe\\u0ba4 ,\\u0baa\\u0bbe\\u0b9a\\u0bbf\\u0b9a \\u0b9a\\u0b95\\u0bcd\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0b9f\\u0bae\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b9a\\u0bbe\\u0b9a\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0b95\\u0bcd\\u0b95 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd. #AmbedkarJayanti2025", "Today, on the occasion of Ambedkar Jayanti, we honour the perseverance and resilience of Dr.B.R.Ambedkar, the architect of the Constitution of India. Known to the entire world for his commitment to uplifting the marginalised, Babasaheb spent his whole life promulgating values of equality and social justice. Today is a reminder of our responsibility to drive forward his principles and give back to society. Together, let\\u2019s fulfill his dream of making this world equitable for all! #AmbedkarJayanti", "\\u0b89\\u0bb2\\u0b95\\u0bae\\u0bc6\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd \\u0b9a\\u0bca\\u0ba8\\u0bcd\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0baa\\u0bcd \\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bb3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0b95\\u0bc1\\u0bb0\\u0bcb\\u0ba4\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0b9f\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb6\\u0bcd\\u0bb0\\u0bc0\\u0bb5\\u0bbf\\u0b9a\\u0bc1\\u0bb5\\u0bbe\\u0bb5\\u0b9a\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bbf\\u0bb1 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd, \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0ba9 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0b86\\u0bb0\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bae\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0b87\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bbe\\u0bb4, \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0bb5\\u0bb2\\u0bcd\\u0bb2 \\u0b87\\u0bb1\\u0bc8\\u0bb5\\u0ba9\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. #TamilNewYear", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd, \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0bb0\\u0ba4\\u0bcd\\u0ba9\\u0bbe - \\u0baa\\u0bbe\\u0baa\\u0bbe \\u0b9a\\u0bbe\\u0b95\\u0bc7\\u0baa\\u0bcd \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0baa\\u0bc0\\u0bae\\u0bcd\\u0bb0\\u0bbe\\u0bb5\\u0bcd \\u0bb0\\u0bbe\\u0bae\\u0bcd\\u0b9c\\u0bbf \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 134\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1. \\u0b92\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0bb0\\u0bb2\\u0bbe\\u0b95, \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0ba8\\u0bcd\\u0ba4 \\u0b87\\u0bae\\u0bcd\\u0bae\\u0bbe\\u0bae\\u0ba9\\u0bbf\\u0ba4\\u0bb0\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1\\u0b95\\u0bc2\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0bb5\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0bcb\\u0bae\\u0bcd. #babasahebambedkarjayanti #ManickamTagore #ambedkarjayanti", "\\u0bae\\u0bc7\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd, \\u0bae\\u0bc7\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0b90\\u0baf\\u0bbe \\u0b8e\\u0b9a\\u0bcd.\\u0bb5\\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 75\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1. \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1\\u0b95\\u0bc2\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0bb5\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0bcb\\u0bae\\u0bcd. #VasanthTV #vasanthandco", "\\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bb1\\u0bcd\\u0bb1 \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0b9a\\u0bae\\u0bc1\\u0ba4\\u0bbe\\u0baf\\u0bae\\u0bcd \\u0baa\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bbf\\u0baf \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0b9a\\u0bc0\\u0bb0\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bbe\\u0ba4\\u0bbf, \\u0b9a\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bbe\\u0bae\\u0bc7\\u0ba4\\u0bc8 \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bb2\\u0bcd #\\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd, \\u0b85\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0
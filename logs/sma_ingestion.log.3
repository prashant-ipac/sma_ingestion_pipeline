u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc6\\u0b9f\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0baf \\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bcd \\u0b85\\u0ba4\\u0bc1 \\u0b9a\\u0bbe\\u0ba4\\u0bbe\\u0bb0\\u0ba3\\u0bae\\u0bbe\\u0ba9 \\u0b92\\u0bb0\\u0bc1 \\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd \\u0b85\\u0bb2\\u0bcd\\u0bb2 \\u2014 \\u0ba8\\u0bc7\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0baa\\u0baf\\u0ba3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1\\u0baa\\u0bcb\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcb\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bb5\\u0bae\\u0bcd \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bc7\\u0b9a\\u0bae\\u0ba3\\u0bbf \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0b95\\u0bbf\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd #NammaNinaivugal", "\\u0b95\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bb0\\u0bbf \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb2\\u0bbf \\u0b86\\u0b95\\u0bbf\\u0baf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba9 \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0ba8\\u0bc0\\u0bb0\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0ba4 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95 \\u0ba4\\u0bbf\\u0bb1\\u0ba9\\u0bb1\\u0bcd\\u0bb1, arivalayam \\u0b85\\u0bb0\\u0b9a\\u0bc8 \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 BJP4Tamilnadu \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.NainarBJP \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8.!", "Attended the Grand Finale of the #CreateInIndiaChallenge at Creatosphere on Day 2 of WAVES 2025. It was heartening to witness 750 brilliant finalists competing across 32 categories\\u2014from film & music to gaming & AI\\u2014showcasing India\\u2019s boundless creative energy. Wishing all participants continued success in their innovative journeys! Dadasaheb Phalke Award winner Shri Mithun Chakraborty ji, Shri Anupam Kher ji, and Shri Prasoon Joshi ji also graced the event with their presence.", "\\u0b95\\u0bb4\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd! (\\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0bae\\u0bcd 1-4)", "\\u0b95\\u0bb4\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd! (\\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0bae\\u0bcd 5-8)", "\\u0b95\\u0bb4\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd! (\\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0bae\\u0bcd 9-12)", "\\u0b95\\u0bb4\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd! (\\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0bae\\u0bcd 13-16)", "At last, the Modi government relented and agreed to conduct a caste census. This is a significant victory for the Leader of the Opposition, Rahul Gandhi ji, the Congress party, and the millions of activists who have long championed the cause. BJP mocked him, opposed him, and even abused him in the Parliament. They went to the extent of asking his caste to humiliate him, but that did not deter him. He remained steadfast in his commitment. Rahul ji has strongly and consistently advocated for a caste census", "and consistently advocated for a caste census because it is essential for social justice, equitable distribution of resources, and data-driven policy making. Without accurate data, fair access to education, employment, welfare schemes, and constitutional rights cannot be ensured #ThankYouRahulGandhi", "\\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bbf\\u0baf \\u0b9c\\u0ba9\\u0ba4\\u0bbe \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc6\\u0ba9\\u0bcd\\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b95\\u0bbf\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0ba9\\u0bcd\\u0bae\\u0bbf\\u0baf\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bb3\\u0bcd\\u0bb3\\u0bc1\\u0bb5\\u0bb0\\u0bcd \\u0ba8\\u0b95\\u0bb0
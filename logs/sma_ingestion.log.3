1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd. #DMK4TN", "\\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0ba8\\u0bc0\\u0b9f\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bc8 \\u0b85\\u0bb1\\u0bbf\\u0bae\\u0bc1\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bc7 \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b87\\u0ba3\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b95\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0ba9\\u0bcd \\u0ba4\\u0bbe\\u0ba9\\u0bc7? \\u0b87\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1, \\u0b85\\u0b87\\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0baa\\u0bc7\\u0b9a \\u0b8e\\u0ba9\\u0bcd\\u0ba9 \\u0b85\\u0bb0\\u0bc1\\u0b95\\u0ba4\\u0bc8 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1? mkstalin -\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd eps.tamilnadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.", "Telangana Govt. Should Drop its Decision to Clear 400 Acres of Forest Land in Hyderabad! The Congress government in Telangana has started destroying a 400-acre forest area in Kancha Gachibowli village near the University of Hyderabad (UOH) for auctioning the land to develop IT infrastructure. It is outrageous to try to destroy massive green cover in the name of development. The land, the water, the forests, the rivers, the mountains, the sea, and the air are not just for human beings; they belong to other", "not just for human beings; they belong to other living organisms too. All other creatures can live without humans, but if other species go extinct, humans will not survive even for a second. So trying to destroy our environment is just the beginning of destroying ourselves. The Supreme Court has halted the Telangana government\'s move to voluntarily deforest the forests in the Kancha Gachibowli area amid a series of protests by students, teachers, and environmentalists. But that is not enough. Without", "But that is not enough. Without waiting for the final verdict of the Supreme Court, the Congress government in Telangana should stop suppressing the agitation by the students and realize that it is a moral battle to protect the well-being of future generations. Therefore, I urge the Telangana government to immediately abandon the 400-acre Kancha Gachibowli deforestation, which, in the name of development, is destroying the environment and causing great harm to the flora and fauna. - #Seeman | Chief", "harm to the flora and fauna. - #Seeman | Chief Coordinator | #NTK #Telangana | #KanchaGachibowli | #Deforestation", "\\"\\u0b95\\u0bc7\\u0bb7\\u0bc1\\u0bb5\\u0bb2\\u0bbe \\u0baa\\u0bc7\\u0b9a\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0bb8\\u0bcd\\u0bb2\\u0bbf\\u0baa\\u0bcd \\u0b86\\u0b95\\u0bbf \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd\\" -\\u0baa\\u0bca\\u0ba9\\u0bcd\\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0baa\\u0bbe\\u0b9a \\u0baa\\u0bc7\\u0b9a\\u0bcd\\u0b9a\\u0bc8 \\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bb0\\u0b95\\u0bc1\\u0baa\\u0ba4\\u0bbf. \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0b9f\\u0bbf\\u0baf\\u0bc7 \\u0bb0\\u0b95\\u0bc1\\u0baa\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bc6\\u0b9f\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0b9e\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0b95\\u0bc2\\u0b9f \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba4\\u0bbe? \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b86\\u0baa\\u0bbe\\u0b9a \\u0baa\\u0bc7\\u0b9a\\u0bcd\\u0b9a\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f \\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0bb2\\u0bcd, \\u0b87\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0ba9\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0ba3\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b8e\\u0bb5\\u0bcd\\u0bb5\\u0bb3\\u0bb5\\u0bc1 \\u0bb5\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bae\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd? \\u0b87\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b87\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1! \\u
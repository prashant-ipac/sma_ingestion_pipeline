\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc7 \\u0baa\\u0bbf\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bcb\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0baa\\u0bb0\\u0bbf\\u0b9a\\u0bbe\\u0b95 \\u0b85\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b85\\u0ba4\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bbf\\u0bb4\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bc0\\u0bb0\\u0bcd \\u0bb5\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0ba4\\u0bcd \\u0baa\\u0bcb\\u0b95\\u0bbf\\u0bb1\\u0bc0\\u0bb0\\u0bcd! #AdmkFails", "Today, I met Hon\\u2019ble Union Finance Minister nsitharaman and requested for reduction of GST on bricks, proposing 3% without ITC and 5% with ITC, and the introduction of a compounding tax based on burner usage, to protect over 1.5 lakh brick units and millions of rural livelihoods.", "\\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf \\u0b9f\\u0bbf\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0ba4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0b9a\\u0bc2\\u0b9f\\u0bc1 - \\u0bae\\u0bc7 22, 2018 (13 \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bb2\\u0bbf) #ThoothukudiMassacre", "\\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0ba4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9a\\u0bcd\\u0b9a\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd 7\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1. \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 \\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bb8\\u0bcd\\u0b9f\\u0bc6\\u0bb0\\u0bcd\\u0bb2\\u0bc8\\u0b9f\\u0bcd \\u0b86\\u0bb2\\u0bc8\\u0baf\\u0bc8 \\u0bae\\u0bc2\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0bb0\\u0bbf \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bbf\\u0baf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0ba9\\u0ba4\\u0bc1 \\u0b95\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bb0\\u0bc7\\u0b9f\\u0bcd \\u0ba8\\u0ba3\\u0bcd\\u0baa\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b9a\\u0bc1\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bc0\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd. \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bbf \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4 13 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0b95\\u0bc2\\u0bb0\\u0bcd\\u0bb5\\u0bcb\\u0bae\\u0bcd. \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bc0\\u0ba4\\u0bc1 \\u0ba4\\u0bc1\\u0bb3\\u0bc8\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0b95\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0b9f\\u0bc1 \\u0b87\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bae\\u0bcd \\u0bae\\u0ba9\\u0ba4\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb1\\u0bc8\\u0baf\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8, \\u0bae\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0bbe\\u0ba4\\u0bc1.", "\\u0b9a\\u0b9a\\u0bbf\\u0b95\\u0bb2\\u0bbe \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bbf\\u0ba4\\u0bcd \\u0bb7\\u0bbe \\u0bb5\\u0bb0\\u0bc8 \\u0b86\\u0bb3\\u0bcd \\u0bae\\u0bbe\\u0bb1\\u0bbf\\u0ba9\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b9f\\u0bc7\\u0baa\\u0bbf\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0bb1\\u0bbe\\u0ba4 \\u0b85\\u0b9f\\u0bbf\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bae\\u0bbf\\u0baf\\u0bc7 \\u0b89\\u0ba9\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b85\\u0bb5\\u0bae\\u0bbe\\u0ba9\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0baf\\u0bbe? \\u0b85\\u0ba4\\u0bc1 \\u0b9a\\u0bb0\\u0bbf \\u0b89\\u0ba9\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8f\\u0ba4\\u0bc1 \\u0bb5\\u0bc6\\u0b9f\\u0bcd\\u0b95\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0ba9\\u0bae\\u0bcd, \\u0b9a\\u0bc2\\u0b9f\\u0bc1, \\u0b9a\\u0bca\\u0bb0\\u0ba3\\u0bc8 \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd? #ADMKFails", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf\\u0bae\\u0bbe\\u0ba9 \\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bc8 #NITIAayog \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4 24-\\u0b86\\u0ba
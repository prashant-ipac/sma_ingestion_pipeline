b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. #\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "\\u0baa\\u0bbe\\u0bb5\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bb0\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bbf\\u0ba4\\u0bbe\\u0b9a\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 135-\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8, \\u0bae\\u0bc6\\u0bb0\\u0bbf\\u0ba9\\u0bbe \\u0b95\\u0b9f\\u0bb1\\u0bcd\\u0b95\\u0bb0\\u0bc8 \\u0b95\\u0bbe\\u0bae\\u0bb0\\u0bbe\\u0b9a\\u0bb0\\u0bcd \\u0b9a\\u0bbe\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb2\\u0bb0\\u0bcd \\u0ba4\\u0bc2\\u0bb5\\u0bbf \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd!", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0bae\\u0bca\\u0bb4\\u0bbf \\u0bae\\u0bc0\\u0ba4\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0b87\\u0bb2\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc0\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc0\\u0bb0\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bae\\u0bc1\\u0ba4\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0baa\\u0bc7\\u0bb0\\u0bcd - \\u0b85\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bc6\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bcd \\u0b8e\\u0ba9 \\u0bae\\u0bc1\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb5\\u0bbf\\u0b9e\\u0bb0\\u0bcd, \\u0baa\\u0bbe\\u0bb5\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bb0\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bbf\\u0ba4\\u0bbe\\u0b9a\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b85\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1\\u0b95\\u0bc2\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b85\\u0bb5\\u0bb0\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0bb5\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0bc7\\u0ba9\\u0bcd. eps.tamilnadu aiadmk.official", "\\u0bae\\u0bc7\\u0bb2\\u0bc7 \\u0baa\\u0bbe\\u0bae\\u0bcd\\u0baa\\u0bc1, \\u0b95\\u0bc0\\u0bb4\\u0bc7 \\u0ba8\\u0bb0\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0b85\\u0b95\\u0bb4\\u0bbf, \\u0b93\\u0b9f\\u0bbf\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0ba4\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc1\\u0bb5\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b92\\u0bb0\\u0bc1 \\u0baa\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc1, \\u0bae\\u0bb1\\u0bc1\\u0baa\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b86\\u0bb3\\u0bc1\\u0ba8\\u0bb0\\u0bcd, \\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0ba8\\u0bc6\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bbf \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe \\u0ba4\\u0b9f\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8 \\u0baa\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1! - \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd", "\\u0bae\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bc1 \\u0b92\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0bc1 \\u0b85\\u0bb5\\u0bb0 \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bb0\\u0bc1 \\ud83d\\ude02\\ud83d\\ude02\\ud83d\\ude02", "Chenn.AI\\u2019s GCC boom continues as another massive company checks into Chennai !!!\\u2728 Today Guidance Tamil Nadu signed an MoU with, yet another Fortune 500 company, Workday, a world-renowned provider of enterprise cloud applications, to establish a Global Capability Center in Chennai. Workday\\u2019s decision to set up their GCC in Chennai is yet another illustration of Tamil Nadu\\u2019s leadership as a global hub for digital innovation. With an investment of around Rs. 220 crores creating upto 3000 jobs, this facility", "220 crores creating upto 3000 jobs, this facility will be a strategic hub for product and technology development supporting Workday\\u2019s global operations, focusing on next-generation #AI technologies. Under the visionary leadership of Honourable Chief Minister of Tamil Nadu, Thiru. M. K. Stalin avargal, #TamilNadu continues to transform into a global powerhouse for technology, innovation while ensuring high-quality #JobsForTN ! #InvestInTN #BullishOnTN", "\\u0b86\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bae\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bc0\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0baf\\u0bc0\\u0b9f\\u0bbe\\u0b95\\u0bb5\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0bb1\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0bb2\\u0ba9\\u0bbf \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0b9a\\u0bca\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b86\\u0bb5\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bc0\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. - \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd #DMK4TN #TNAssembly", "\\u0b87\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bc8 \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd PART 1 \\u0ba4\\u0bbe\\u0ba9\\u0bcd; 2026\'\\u0bb2\\u0bcd VERSION 2.0 LOADING! - \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd #DMK4TN #DravidianModel", "\\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc0\\u0baf\\u0ba3\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0bb0\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd! #TNAssembly #DMK4TN", "\\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0baf\\u0ba9\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bbf\\u0baf \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bcb\\u0bae\\u0bcd. \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95, \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b8e\\u0ba9\\u0bcd \\u0baa\\u0baf\\u0ba3\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bc1\\u0bae\\u0bcd! - \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd #DMK4TN #TNAssembly", "2024 \\u0ba8\\u0bb5\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd 25 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba8\\u0bbe\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0bae\\u0bb2\\u0bcd\\u0bb2\\u0b9a\\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bae\\u0bcd \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bc1, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0
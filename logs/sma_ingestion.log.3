f.\\u0ba4\\u0bc7\\u0bb5\\u0ba4\\u0bbe\\u0b9a\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bc7\\u0bb0\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe\\u0bb5\\u0bc1\\u0b9f\\u0ba9\\u0bcd, \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bbf\\u0bb2\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bc7 \\u0bae\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0b8e\\u0bb4\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0bb5\\u0bb0\\u0bcd. #\\u0b89\\u0b9f\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc7", "1986 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b88\\u0bb0\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bc8 \\u0ba4\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0b95\\u0bb4\\u0b95 \\u0b89\\u0b9f\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bb2\\u0bc8\\u0b95\\u0bb3\\u0bcd! #\\u0b83\\u0baa\\u0bcd\\u0bb3\\u0bbe\\u0bb7\\u0bcd\\u0baa\\u0bc7\\u0b95\\u0bcd", "\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd \\u0b8e\\u0ba3\\u0bcd: 980 \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b89\\u0bb0\\u0bc8: \\u0baa\\u0bbf\\u0bb1\\u0bb0\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bb1\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd. \\u0baa\\u0bbf\\u0bb1\\u0bb0\\u0bc1\\u0b9f\\u0bc8\\u0baf \\u0b95\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc7 \\u0b95\\u0bc2\\u0bb1\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0bc1\\u0bae\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0ba3\\u0bae\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd. #\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "\\"Tall leaders of this country \\u2013 in their wisdom \\u2013 saw fit to freeze the delimitation and push it for 25 years in the hope that someday, there would be a more equitable outcome in terms of underlying things like population growth, economy, social development etc.\\" At The Hindu Huddle panel, \\"More than a Sum of Parts: Reimagining India\\u2019s Federalism\\", alongside Hon\\u2019ble Kerala Minister Thiru. P. Rajeeve, curated by Thiru. Narayan Lakshman, the Opinion Editor at The Hindu, I spoke on the need to safeguard the", "The Hindu, I spoke on the need to safeguard the principles of federalism in today\\u2019s India. I pointed out that the current approach to delimitation unfairly penalises the southern states, particularly Tamil Nadu, which has achieved success in population control, economic growth, and human development. I also underscored the broader implications of the Union government\'s growing encroachment into constitutionally mandated state subjects, including fiscal autonomy, gubernatorial overreach, and the imposition", "gubernatorial overreach, and the imposition of uniform \\"One Nation, One X\\" policies that fail to account for the country\\u2019s rich regional diversity.", "\\u201c\\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8 2020 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8\\u201d\\u0baf\\u0bc8 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1, \\u0b85\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bae\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcb\\u0bae\\u0bcd. \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bc1\\u0bb5\\u0bcb\\u0bae\\u0bcd. \\u0bae\\u0ba4\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0bb5\\u0b9f\\u0bbf\\u0bb5\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bc8 \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd. Presented the \'Elephant Goad\' to Hon\\u2019ble Chief Minister Thiru mkstalin, who has been fiercely resisting the Rogue Elephant called National Education Policy 2020. We will continue to fight on his path. We will safeguard our", "to fight on his path. We will safeguard our education system from the rogue elephant called NEP, crafted with a religious agenda. #MADHAYAANAI #\\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8", "\\u201c\\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8-2020 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8\\u201d \\u0ba8\\u0bc2\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bb5\\u0bc1\\u0bb3\\u0bcd\\u0bb3, #ISRO \\u0bb5\\u0bbf\\u0ba3\\u0bcd\\u0bb5\\u0bc6\\u0bb3\\u0bbf \\u0bae\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc7\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba8\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mylswamy_annadurai \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bb5\\u0bbf\\u0bae\\u0bbe\\u0ba9 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bcb\\u0bae\\u0bcd.", "\\u0b88\\u0b95\\u0bbe \\u0ba4\\u0bbf\\u0bb0\\u0bc8\\u0baf\\u0bb0\\u0b99\\u0bcd\\u0b95 \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b88\\u0b95\\u0bbe C.\\u0bb5\\u0bc6\\u0b99\\u0bcd\\u0b95\\u0b9f\\u0bbe\\u0b9a\\u0bcd\\u0b9a\\u0bb2\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bb1\\u0bc8\\u0bb5\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0baa\\u0bcb\\u0ba4\\u0bc1...", "Spoke at the IFA\\u2019s SRC International Taxation Conference in Chennai on the theme \\u201cTrumponomics and Its Aftershocks: Rewiring the Global Economic Order\\u201d, organised by the International Fiscal Association. This is not a temporary phase\\u2014it is the visible end of the post-WWII global order. The architecture built on open markets, global institutions, and interdependence is now being dismantled. We are witnessing a shift towards deglobalisation, fragmentation, and localisation. The core promise of democracy\\u2014to", "localisation. The core promise of democracy\\u2014to cushion the effects of free-market capitalism\\u2014has broken down. This failure is being exploited by disruptors and crony capitalism, weakening institutions and subverting public interest. Democratic states today face two core crises\\u2014declining capacity to raise revenue in a digital economy, and growing public spending skewed towards short-term subsidies at the cost of essential services and long-term investments. Globalisation is cyclical. The way forward lies in", "is cyclical. The way forward lies in reforming governance and taxation to rebuild democratic legitimacy and ensure equitable, sustainable growth.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b93\\u0b9a\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd, \\u0baa\\u0bc6\\u0b95\\u0bb2\\u0bcd\\u0b95\\u0bbe\\u0bae\\u0bcd \\u0ba4\\u0bc0\\u0bb5\\u0bbf\\u0bb0\\u0bb5\\u0bbe\\u0ba4\\u0ba4\\u0bcd \\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bb2\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1, \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0bb5\\u0bc0\\u0bb0\\u0bae\\u0bcd \\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bb0\\u0bbe\\u0ba3\\u0bc1\\u0bb5\\u0bae\\u0bcd \\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0b9f\\u0bbf \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4 \\u0b86\\u0baa\\u0bb0\\u0bc7\\u0bb7\\u0ba9\\u0bcd \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bcd \\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bb2\\u0bcd, \\u0ba4\\u0bc0\\u0bb5\\u0bbf\\u0bb0\\u0bb5\\u0bbe\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bbe\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0baf\\u0bae\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf, \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bcd\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4 \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0bb0\\u0bbe\\u0ba3\\u0bc1\\u0bb5 \\u0bb5\\u0bc0\\u0bb0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bc1 \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0ba8\\u0baf\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd \\u0ba8\\u0bbe\\u0b95\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0ba4\\u0bc1\\u0bb7\\u0bcd\\u0baf\\u0ba8\\u0bcd\\u0ba4\\u0bcd \\u0b95\\u0bc6\\u0bb3\\u0ba4\\u0bae\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0
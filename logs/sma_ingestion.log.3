bbf\\u0ba9\\u0bae\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf.\\n\\n#\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0b9a\\u0bc0\\u0bb2\\u0bb0\\u0bcd\\u0b95\\u0b95\\u0bcd\\u0b95\\u0ba9\\u0bcd", "\\u0b8e\\u0bb3\\u0bbf\\u0bae\\u0bc8, \\u0ba8\\u0bc7\\u0bb0\\u0bcd\\u0bae\\u0bc8, \\u0b89\\u0ba3\\u0bcd\\u0bae\\u0bc8 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc2\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0ba3\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bc6\\u0ba9 \\u0bae\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0ba4\\u0bcd\\u0ba4 \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bc8 \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bc0\\u0bb0\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95 \\u0b9a\\u0bc0\\u0bb2\\u0bb0\\u0bcd \\u0b95\\u0b95\\u0bcd\\u0b95\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0baf\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc7\\u0bb0\\u0bbf\\u0b9f\\u0bb0\\u0bcd \\u0bae\\u0bc7\\u0bb2\\u0bbe\\u0ba3\\u0bcd\\u0bae\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd 1275 \\u0baa\\u0baf\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bbe \\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0ba9\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbe \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0baf\\u0bcd \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bc7\\u0baf\\u0bb0\\u0bcd ,\\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd,\\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbf\\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd. \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1  \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bbf\\u0baf\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf.", "In the wake of the Pahalgam attack, Modi ji\\u2019s friend Donald Trump hosting a Pakistani military general despite Pakistan\\u2019s ongoing sponsorship of terrorism against India is a grave diplomatic failure. Under the Modi government, India is drifting into troubled waters, and the situation is deeply concerning. The government must be held accountable for this strategic misstep. We will raise this serious issue in Parliament.", "\\u0b9a\\u0bc1\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bbf, \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bcd\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd,\\u0b8e\\u0bb3\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb2\\u0b95\\u0bcd\\u0b95\\u0ba3\\u0bae\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd,\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b9a\\u0bbe\\u0b9a\\u0ba9 \\u0b9a\\u0baa\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0baa\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0b95\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd. \\u0b95\\u0bb1\\u0bc8\\u0baa\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba4 \\u0b95\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bca\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bb0\\u0bb0\\u0bcd. \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0b85\\u0baa\\u0bcd\\u0baa\\u0bb4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb1\\u0bcd\\u0bb1,\\u0b85\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0ba3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bae\\u0bbf\\u0b95\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bc8 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1\\u0b95\\u0bc2\\u0bb0\\u0bcd\\u0bb5\\u0bcb\\u0bae\\u0bcd.", "Grassroots voices matter. 170 Congress workers spoke today at Faridabad NIT Assembly\\u2014openly and honestly. With PCC Observers Virender Shah, Rohatas Bedi & Sudhir Chaudhary, we will rebuild stronger, with unity and purpose.\\n#Congress #Faridabad \\nincharyana \\n \\n\\n #\\u0938\\u0902\\u0917\\u0920\\u0928_\\u0938\\u0943\\u091c\\u0928_\\u0905\\u092d\\u093f\\u092f\\u093e\\u0928", "Shocking & shameful!\\nToday in Gannavaram\\u2019s Three Statues Center, the Nara Chandrababu Naidu -led Naidu Sarkar destroyed the statue of Pt. Nehru and damaged the statues of Smt. Indira Gandhi & Shri Rajiv Gandhi \\u2014 former Prime Ministers who shaped modern India.\\n\\nThis is not governance.\\nThis is political vandalism.\\nWe condemn it strongly.\\n\\n#AndhraPradesh #Gannavaram #Nehru #IndiraGandhi #RajivGandhi", "#WATCH | Delhi: On Union Minister Hardeep Singh Puri, Congress MP Manickam Tagore says, \\"We all know that Hardeep Puri is a failed diplomat, and now he is a failed minister. We all recognise that he is only fit to be the spokesperson for the BJP, who repeatedly parrots statements from the PMO. Hardeep Puri must understand that the Congress party has made sacrifices for this country, has governed this country, and knows what is good for the nation...\\"", "\\u0bae\\u0bc7\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u
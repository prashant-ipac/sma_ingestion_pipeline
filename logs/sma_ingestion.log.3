9a\\u0bb0\\u0bcd mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd - \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd udhay_stalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd, \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b9c\\u0bc6.\\u0b9c\\u0bc6\\u0baf\\u0bb0\\u0b9e\\u0bcd\\u0b9a\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bcb\\u0bae\\u0bcd. tnschoolsedu", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bcb\\u0bae\\u0bcd. tnschoolsedu tn.spc", "\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcb\\u0b9f\\u0bc1 \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0baa\\u0bc7\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd TRB \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd. #\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd_\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bc8 #MinnumMannai", "Delighted to have had the opportunity to attend the 18th Graduation Ceremony at Cape Institute of Technology, Levengipuram, today. It was a pleasure to interact with the graduating students and reflect on their vital role in shaping our nation\\u2019s future. Watching bright minds step into the future with hope and ambition was truly inspiring. Wishing all graduates great success and joy in their journeys ahead!", "2024-2025\\u0b86\\u0bae\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0bae\\u0bc7\\u0bb2\\u0bcd\\u0ba8\\u0bbf\\u0bb2\\u0bc8 \\u0b87\\u0bb0\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1 (+2) \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bc1 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba9. \\u0b85\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bb1\\u0bbf\\u0baf \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0b95 \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0baf\\u0bc8 \\u0baa\\u0bc7\\u0bb0\\u0bbe\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bb4\\u0b95\\u0ba9\\u0bbe\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0bb5\\u0bb3\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0bae\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd (14417) \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd. \\u0b85\\u0baa\\u0bcd\\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0ba4\\u0bcb\\u0b9f\\u0bc1, \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bcb\\u0bb0\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0bb2\\u0bc8\\u0baa\\u0bc7\\u0b9a\\u0bbf \\u0bae\\u0bc2\\u0bb2\\u0bae\\u0bcd \\u0b89\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bbf \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bbf\\u0ba9\\u0bc8 \\u0bae\\u0ba9 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bcb\\u0b9f\\u0bc1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc7 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd", "\\u0bae\\u0ba9 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bcb\\u0b9f\\u0bc1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0b87\\u0bb5\\u0bcd\\u0bb5\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc7 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bbe\\u0bb1\\u0bc1 \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bcb\\u0bae\\u0bcd. tnschoolsedu", "\\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0ba8\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0bae\\u0bcd #IndianArmy #DMK", "It was a pleasure to represent the Government of Tamil Nadu at the 65th Independence Day celebrations of Togo, hosted in Chennai by H.E. Mr. Yawo Edem Akpemado, High Commissioner of Togo to India. India and Togo share deep historical parallels \\u2014 from a colonial past to our shared values of cultural pride, linguistic diversity, and democratic governance. It was heartening to see these common threads reflected in the celebrations. As Tamil Nadu continues to strengthen its global engagement, I\'m especially", "strengthen its global engagement, I\'m especially glad that Chennai was chosen as the venue for Togo\\u2019s first official event outside Delhi. On behalf of Hon\\u2019ble CM Thiru.mkstalin and the people of Tamil Nadu, I extend warm wishes to the Republic of Togo on their Independence Day.", "#14417 tnschoolsedu", "\\u0ba8\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1 (09.05.2025) \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0baa\\u0b9e\\u0bcd\\u0b9a\\u0baa\\u0bcd\\u0baa\\u0bc2\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u200c.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd 55,000 \\u0baa\\u0baf\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd. \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0b92\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bbe\\u0baf\\u0bcd\\u0b95\\u0bb1\\u0bbf \\u0b85\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bb2\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf, \\u0baa\\u0bc7\\u0bb0\\u0bb1\\u0bbf\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe \\u0b95\\u0ba9\\u0bb0\\u0b95 \\u0b9a\\u0bb0\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0
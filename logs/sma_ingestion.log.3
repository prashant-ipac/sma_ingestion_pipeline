\u0bcd, \\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bcd \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bae\\u0bbe\\u0b95 \\u0bb5\\u0bb0\\u0bc1\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bcb\\u0bb2, \\u0ba8\\u0bc0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb0\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0baa\\u0bc1\\u0bb0\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bcd \\u0baa\\u0bcb\\u0b9f\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b86\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0b85\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0ba3\\u0bcd\\u0bae\\u0bc8 \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0ba3\\u0bcd\\u0ba3\\u0bc0\\u0bb0\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0ba4\\u0bc1\\u0bb3\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0ba4\\u0bc1 \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0b95\\u0bb5\\u0bc7 \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd. \\u0b8e\\u0ba9\\u0bb5\\u0bc7, \\u0b95\\u0bbe\\u0bb2\\u0bbf \\u0b95\\u0bc1\\u0b9f\\u0bae\\u0bcd \\u0baa\\u0bcb\\u0bb2 \\u0b89\\u0bb0\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7 \\u0b87\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd! #AdmkFails", "\\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf \\u0ba4\\u0ba9\\u0bbf \\u0b87\\u0b9f\\u0bae\\u0bcd, \\u0b9a\\u0bbf\\u0bb1\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0bcb\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95 \\u0b87\\u0b9f\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0b9a\\u0bbe\\u0bae\\u0bbe\\u0ba9\\u0bbf\\u0baf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bc2\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0bb0\\u0bcd \\u0baa\\u0b9f\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0b95\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0bb0\\u0bc8\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd! #MudhalvarPadaippagam #DMK4TN", "#\\u0ba8\\u0bbe\\u0ba9\\u0bcd_\\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd\\u0b95\\u0bc0\\u0bb4\\u0bcd \\u0baa\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1 2024-\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 IFoS \\u0baa\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc6\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd. #UPSC \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0bae\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0baf\\u0bbe\\u0bb0\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbf\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b8a\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bbe\\u0b95 naanmudhalvan_tnskill \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc8 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bbe\\u0ba9 \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0ba3\\u0bb0 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1. \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc1\\u0bb1\\u0bc8 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0baa\\u0bc6\\u0bb1 \\u0b87\\u0baf\\u0bb2\\u0bbe\\u0ba4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bcb\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bcb\\u0b95\\u0bbe\\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b87\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0baf\\u0bbe\\u0bb0\\u0bbe\\u0b95\\u0bbf, \\u0b8e\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bca\\u0bb2\\u0bc8\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd. udhay_stalin", "Today, as part of an all-party delegation, We met with H.E. Predrag Bakovi\\u0107, Chairperson of the Foreign Policy Committee of the National Assembly, and Mr. Miroslav Gregori\\u010d, member of the India-Slovenia Parliamentary Friendship Group. The delegation reaffirmed India\\u2019s unwavering and united commitment to a policy of zero tolerance towards terrorism. The Slovenian officials expressed solidarity with India and reiterated their firm condemnation of terrorism as an act of pure evil that cannot be justified under", "act of pure evil that cannot be justified under any circumstances. We stand together in our shared pursuit of peace, justice, and global cooperation.", "Honored to engage in dialogue with H.E. Vojko Volk, State Secretary/National Coordinator for National and International Security in the Office of the Prime Minister, during the all-Party delegation visit to Slovenia. Reiterated India\\u2019s unwavering zero tolerance policy on terrorism and appreciated Slovenia\\u2019s clear and firm condemnation of the Pahalgam terror attack.", "\\u0b95\\u0bcb\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 \\u0b9a\\u0bbf\\u0bb2 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95 \\u0baa\\u0bb0\\u0bc1\\u0bb5\\u0bae\\u0bb4\\u0bc8 \\u0baa\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bb5\\u0ba4\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd, #\\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0b9a\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0bbe\\u0ba3\\u0bbf \\u0ba8\\u0bc0\\u0bb0\\u0bcd \\u0baa\\u0bbf\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0ba9\\u0bae\\u0bb4\\u0bc8\\u0baf\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bca\\u0baf\\u0bcd\\u0baf\\u0bb2\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bc0\\u0bb0\\u0bcd \\u0bb5\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\u0b87\\u0ba4\\u0ba9\\u0bc8\\u0baf\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bae\\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0bc2\\u0bb0\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bca\\u0baf\\u0bcd\\u0baf\\u0bb2\\u0bcd \\u0b86\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0baf\\u0bcd\\u0baf\\u0bbe\\u0bb0\\u0bae\\u0bbe\\u0b95 \\u0baa\\u0bca\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0ba3\\u0bcd\\u0ba3\\u0bc0\\u0bb0\\u0bc8, \\u0b95\\u0bb4\\u0b95 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bae\\u0bb2\\u0bb0\\u0bcd\\u0ba4\\u0bc2\\u0bb5\\u0bbf \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bc7\\u0bb0\\u0bc2\\u0bb0\\u0bcd \\u0baa\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8, \\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc8 \\u0b9a\\u0bbe\\u0bb5\\u0b9f\\u0bbf \\u0ba4\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba9\\u0bc8, \\u0b95\\u0bbe\\u0bb3\\u0bb5\\u0bbe\\u0baf\\u0bcd \\u0ba4\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc0\\u0bb0\\u0bcd\\u0bb5\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc8\\u0baf\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0baa\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd. eps.tamilnadu", "\\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd. eps.tamilnadu aiadmk.official #AIADMK #\\u0b85\\u0b87\\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 #Coimbatore #NoyyalRiver", "Priorities of mkstalin ! \\u0baa\\u0bca\\u0bae\\u0bcd\\u0bae\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd\\u0bb5\\u0bb0\\u0bcd be like: \\u0ba4\\u0bc0 \\u0bb5\\u0bbf\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbe \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bae\\u0bcd? \\u0b95\\u0bb2\\u0bc8 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bae\\u0bcd! \\u0b86\\u0b95...", "\\u0bb5\\u0bbf\\u0baf\\u0bbe\\u0b9a\\u0bb0\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bbf \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0 \\u0bb5\\u0bbf\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd 20\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bc0\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bbe\\u0bae\\u0bcd\\u0baa\\u0bb2\\u0bbe\\u0ba9 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd eps.tamilnadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0b99\\u0bcd\\u0b95, \\u0bb5\\u0b9f\\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bb5\\u0
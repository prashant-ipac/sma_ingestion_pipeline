0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u2026", "\\u201c\\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8 2020 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8\\u201d \\u0ba8\\u0bc2\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bbf\\u0bb4\\u0bbe! \\u201c\\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8-2020 \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8\\u201d\\u0baf\\u0bc8 \\u0b86\\u0bb0\\u0bae\\u0bcd\\u0baa\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc7 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b85\\u0ba4\\u0ba9\\u0bcd \\u0ba4\\u0bc0\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b89\\u0ba3\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0baa\\u0bbe\\u0b95\\u0ba9\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0b8e\\u0bb4\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0ba8\\u0bc2\\u0bb2\\u0bc8 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbf\\u0b95\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0b9f\\u0bc8\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0b87\\u0bb3\\u0ba8\\u0bcd\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd udhay_stalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bc2\\u0bb2\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bc7\\u0b9a \\u0bae\\u0bc7\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd- \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf", "\\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bc7\\u0b9a \\u0bae\\u0bc7\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd- \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd digvijayasinghofficial \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0b89\\u0b9a\\u0bcd\\u0b9a \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0bae\\u0bc7\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0baa\\u0ba4\\u0bbf \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b95\\u0bcb\\u0baa\\u0bbe\\u0bb2 \\u0b95\\u0bb5\\u0bc1\\u0b9f\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, #ISRO \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bb5\\u0bbf\\u0ba3\\u0bcd\\u0bb5\\u0bc6\\u0bb3\\u0bbf \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0bae\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc7\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba8\\u0bb0\\u0bcd #mayilswamyannadurai \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc6\\u0b9e\\u0bcd\\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0b95\\u0bb3\\u0bcd. \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bb5\\u0bb2\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0b95 \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1-\\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbf\\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0b86\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd", "\\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0b86\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, \\u0baa\\u0bca\\u0ba4\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0b95\\u0bb3\\u0bcd. \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8\\u0baf\\u0bc8 \\u0bb5\\u0bbf\\u0bb0\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0bcb\\u0bae\\u0bcd. \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0bae\\u0bca\\u0bb4\\u0bbf\\u0baf\\u0bc8, \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bcb\\u0bae\\u0bcd.", "#MADHAYAANAI #\\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8", "Deeply honoured that our Dravidian mahout and Hon\\u2019ble Chief Minister of Tamil Nadu, Thiru mkstalin, who has opposed the #NEP2020 from the very beginning and consistently exposed its dangers, released my book titled \\u201cNational Education Policy 2020: The Rogue Elephant (Madhayaanai)\\u201d My sincere thanks to the ideologically committed young leader and Hon\\u2019ble Deputy Chief Minister Thiru. udhay_stalin for delivering the welcome address, to Hon\\u2019ble former Chief Minister of Madhya Pradesh and Chairperson of the", "Minister of Madhya Pradesh and Chairperson of the Parliamentary Standing Committee on Education Thiru. digvijayasinghofficial for receiving the book and delivering a special address, to former Supreme Court Judge Thiru. V. Gopala Gowda, and to former ISRO Director Dr. #MylswamyAnnadurai. I also extend my heartfelt gratitude to the Hon\\u2019ble Ministers, Members of Parliament, Members of the Legislative Assembly, people\\u2019s representatives, students, teachers, party workers, and the public who participated and", "workers, and the public who participated and lent strength to the stand taken by the Hon\\u2019ble Chief Minister. Let us unite to drive away the rogue elephant. Let us protect our language and our students. #MADHAYAANAI #\\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8", "\\u0b95\\u0bc1\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bca\\u0bb4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0bae\\u0bc1\\u0b9f\\u0bbf\\u0bb5\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0b95\\u0bbf\\u0bb1 \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bbe\\u0bb0\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0b9f\\u0bae\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd. \\ud83d\\udd25 #MADHAYAANAI #\\u0bae\\u0ba4\\u0baf\\u0bbe\\u0ba9\\u0bc8", "\\u2728Highlights from the Department of Information Technology & Digital Services: Post #13 itnthub : JIGSAW (Joint Innovation Gateway for Synergistic Startup \\u2013 Academic \\u2013 Industry \\u2013 Investor Work) \\u2728\\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bbf\\u0b9c\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bcd \\u0b9a\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bae\\u0bcd\\u0b9a\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd:\\u0baa\\u0ba4\\u0bbf\\u0bb5\\u0bc1 #13 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0bae\\u0bc8\\u0baf\\u0bae\\u0bcd: \\u0b92\\u0bb0\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bc1 - \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf - \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd - \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95 \\u0ba8\\u0bc1\\u0bb4\\u0bc8\\u0bb5\\u0bbe\\u0baf\\u0bbf\\u0bb2\\u0bcd", "\\u0baf\\u0bbe\\u0bb0\\u0bc6\\u0bb2\\u0bcd\\u00ad\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0baa\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b
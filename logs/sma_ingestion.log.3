\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0b86\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd, \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 2023 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b86\\u0b95\\u0bb8\\u0bcd\\u0b9f\\u0bcd \\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd \\u20b9200 \\u0bb5\\u0bbf\\u0bb2\\u0bc8 \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1. \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 2024 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bbe\\u0bb0\\u0bcd\\u0b9a\\u0bcd \\u0bae\\u0bbe\\u0ba4\\u0bae\\u0bcd, \\u0bae\\u0b95\\u0bb3\\u0bbf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u20b9100 \\u0bb5\\u0bbf\\u0bb2\\u0bc8 \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1. \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 2023 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b9a\\u0bb0\\u0bcd\\u0bb5\\u0ba4\\u0bc7\\u0b9a \\u0b85\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bbe\\u0ba9 \\u0b9a\\u0bae\\u0bc8\\u0baf\\u0bb2\\u0bcd", "2023 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1, \\u0b9a\\u0bb0\\u0bcd\\u0bb5\\u0ba4\\u0bc7\\u0b9a \\u0b85\\u0bb3\\u0bb5\\u0bbf\\u0bb2\\u0bbe\\u0ba9 \\u0b9a\\u0bae\\u0bc8\\u0baf\\u0bb2\\u0bcd \\u0b8e\\u0bb0\\u0bbf\\u0bb5\\u0bbe\\u0baf\\u0bc1 \\u0bb5\\u0bbf\\u0bb2\\u0bc8 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0bb5\\u0bc1, \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bbe\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0bae\\u0bb2\\u0bcd, \\u0bb5\\u0bbf\\u0bb2\\u0bc8 \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc7 \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc7 \\u0ba4\\u0bb5\\u0bbf\\u0bb0 \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8. \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 2024 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0bb4\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bc7, \\u0b9a\\u0bae\\u0bc8\\u0baf\\u0bb2\\u0bcd \\u0b8e\\u0bb0\\u0bbf\\u0bb5\\u0bbe\\u0baf\\u0bc1 \\u0bb5\\u0bbf\\u0bb2\\u0bc8, \\u0b9a\\u0bbf\\u0bb2\\u0bbf\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u20b9803 \\u0b86\\u0b95\\u0bb5\\u0bc7 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1. \\u0b89\\u0b9c\\u0bcd\\u0bb5\\u0bbe\\u0bb2\\u0bbe \\u0b9a\\u0bae\\u0bc8\\u0baf\\u0bb2\\u0bcd \\u0b8e\\u0bb0\\u0bbf\\u0bb5\\u0bbe\\u0baf\\u0bc1 \\u0baa\\u0baf\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u20b9300 \\u0bae\\u0bbe\\u0ba9\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0b9f\\u0bc1, \\u0b9a\\u0bbf\\u0bb2\\u0bbf\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0bb5\\u0bbf\\u0bb2\\u0bc8 \\u20b9503 \\u0b86\\u0b95\\u0bb5\\u0bc7 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0b89\\u0ba3\\u0bcd\\u0bae\\u0bc8 \\u0b87\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bbf \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95, \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0ba4\\u0ba9\\u0ba4\\u0bc1 \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0b8e\\u0ba3\\u0bcd 503 \\u0bb2\\u0bcd, \\u0b9a\\u0bbf\\u0bb2\\u0bbf\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u20b9100 \\u0bae\\u0bbe\\u0ba9\\u0bbf\\u0baf\\u0bae\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba9.", "\\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba9. \\u0b85\\u0ba4\\u0ba9\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b92\\u0bb0\\u0bc1 \\u0bae\\u0bc1\\u0bb1\\u0bc8 \\u0b95\\u0bc2\\u0b9f \\u0baa\\u0bc7\\u0b9a\\u0bbe\\u0bae\\u0bb2\\u0bcd, \\u0ba4\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bc0\\u0bb2\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0ba3\\u0bcd\\u0ba3\\u0bc0\\u0bb0\\u0bcd \\u0bb5\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bbe\\u0b9f\\u0b95\\u0bae\\u0bbe\\u0b9f\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0bae\\u0bc1\\u0b95 \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd.", "Delighted to inaugurate Vishukkani, the 10-day Library Festival of Knowledge, Reading, and Togetherness at Koodali Village, Kerala, presided over by former Kerala Health Minister Thirumigu K.K. Shailaja Teacher. The event also highlighted the initiative led by Dr. V. Sivadasan MP to establish a library in every ward across the panchayats of Kannur district. As part of this movement, libraries have already been set up in 1,300 wards across the district.", "\\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b8e\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd? - \\u0ba4.\\u0bb5\\u0bc6.\\u0b95 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bb5\\u0bbf\\u0b9c\\u0baf\\u0bcd @actorvijay \\n\\n#TVKforTN #TVKVijay #tvkitwing #TamilagaVettriKazhagam #thalapathy #vijay #ThalapathyVijay", "Thalapathy Vijay slams BJP and DMK in the recent statement. His voice is loud, clear and unstoppable\\n@actorvijay \\n\\n#TamilagaVettriKazhagam #Thalapathy #vijay #ThalapathyVijay #TVKforTN #TVKVijay #tvkitwing", "Announcemed official mail id -suggestions@tvkvijay.com\\n\\nIf you have any suggestions you can send them to the official email address\\n\\n \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0b8f\\u0ba4\\u0bc7\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0bb2\\u0bcb\\u0b9a\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bcd \\u0b85\\u0bb5\\u0bb1\\u0bcd\\u0bb1\\u0bc8 \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bbe\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0bc2\\u0bb0\\u0bcd\\u0bb5 \\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0b95\\u0bb5\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0ba9\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u2764\\ufe0f\\ud83d\\udc9b\\u2764\\ufe0f @actorvijay \\n\\n#TamilagaVettriKazhagam #Thalapathy #vijay #ThalapathyVijay #TVK #TVKVijay #tvkitwing", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0ba8\\u0bbe\\u0baf\\u0b95\\u0bb0\\u0bcd! \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0 \\u0bb5\\u0bb3\\u0bb0\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bbf\\u0baf\\u0ba4\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1. #TamilNaduLeads", "\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bc1\\u0bb0\\u0bcb\\u0b95\\u0bae\\u0bcd \\u0b87\\u0bb4\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b8e\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bc8 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b86\\u0bb0\\u0bae\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcb, \\u0b85\\u0ba4\\u0bc7 \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bca\\u0ba4\\u0bcd\\u0ba4\\u0b9f\\u0bbf\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0b95\\u0bbe\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b92\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba3\\u0bcd\\u0ba3\\u0bbf \\u0bb0\\u0b95\\u0bc1\\u0baa\\u0ba4\\u0bbf, \\u0ba8\\u0bae\\u0bcd\\u0bae\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bc1\\u0bb0\\u0bcb\\u0b95\\u0bbf \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bc8 \\u0b89\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0b95\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bb5\\u0bbe\\u0bb5\\u0ba4\\u0bc1 \\u0b85\\u0bb0\\u0bc1\\u0b95\\u0ba4\\u0bc8 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bbe? \\u0b85\\u0b83\\u0bb1\\u0bbf\\u0ba3\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc2\\u0b9a\\u0bc1\\u0bae\\u0bcd \\u0bb0\\u0b95\\u0bc1\\u0baa\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bbf\\u0bb4\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1! \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bcd 1 \\u0ba4\\u0bc1\\u0bb0\\u0bcb\\u0b95\\u0bbf \\u0baf\\u0bbe\\u0bb0\\u0bcd? \\u0b95\\u0b9a\\u0bcd\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bc0\\u0bb5\\u0bc8 \\u0ba4\\u0bbe\\u0bb0\\u0bc8\\u0bb5\\u0bbe\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4, \\u0b95\\u0bbe\\u0bb5\\u0bbf\\u0bb0\\u0bbf \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0b9f\\u0b95\\u0bc1 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4, \\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0b95\\u0bcd\\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc1\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0bae\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbf \\u0b9a\\u0baa\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0ba4\\u0bb5\\u0bbf \\u0baa\\u0bc7\\u0bb0\\u0bae\\u0bcd \\u0baa\\u0bc7\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4", "\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0bae\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbf \\u0b9a\\u0baa\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0ba4\\u0bb5\\u0bbf \\u0baa\\u0bc7\\u0bb0\\u0bae\\u0bcd \\u0baa\\u0bc7\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bb0\\u0bc1\\u0ba3\\u0bbe\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0
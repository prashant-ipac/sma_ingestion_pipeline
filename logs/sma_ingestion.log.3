\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bb5\\u0bbf\\u0b9f\\u0bae\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n#\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "Parliamentary Internship Program:\\n\\nThe Parliamentary Internship Program will equip bright minds interested in public policy and parliamentary proceedings to learn more about the intricacies of governance.", "This internship offers a comprehensive insight into India\'s parliamentary processes, policy development, and governance. You will work closely with my parliamentary team to:\\n\\u2022\\u2060 \\u2060Conduct Research and Policy Analysis: Focus on drafting private member bills, parliamentary questions, and zero-hour questions\\n\\u2022\\u2060 \\u2060Witness lawmaking firsthand\\n\\u2022\\u2060 \\u2060Develop Key Skills: Enhance communication, advocacy, and leadership abilities", "Eligibility\\nPostgraduate students, preferably with a degree in law, public policy, governance, or social sciences.\\n\\nApplication Process\\n\\nSubmit:\\n\\n\\u2022\\u2060 \\u2060Resume\\n\\u2022\\u2060 \\u2060Cover letter\\n\\u2022\\u2060 \\u2060Research work samples\\n\\nvia the Google Form: https://forms.gle/4WX3Awo6C3W8GVNx9\\n\\nApplication Deadline: June 30, 2025 \\n\\nInternship Details\\n\\n\\u2022\\u2060 \\u2060Duration: 3-6 months\\n\\u2022\\u2060 \\u2060Location: Office of Hon. MP, Delhi\\n\\u2022\\u2060 \\u2060This is a Paid internship.\\n\\nJoin us to shape your future and contribute to the nation\'s governance!", "\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0bae\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bc7\\u0ba9\\u0bbf \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0b8f\\u0bb4\\u0bc8 \\u0b8e\\u0bb3\\u0bbf\\u0baf \\u0ba8\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb5\\u0bb0\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0b95, 54 \\u0baa\\u0baf\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0bb2\\u0bb5\\u0b9a \\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0ba9\\u0bc8 \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd.TRB.\\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0baf\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd.\\n\\n#\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd_\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\n#MinnumMannai", "\\u0b8e\\u0bb3\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bb0\\u0bae\\u0bcd \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb5\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bcb\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bc1\\u0bae\\u0bbe\\u0ba9 #\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f_\\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0baa\\u0bca\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0bb2 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0b95\\u0bcb\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u0bb5\\u0bc6\\u0ba3\\u0bcd\\u0ba3\\u0bbf \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba3\\u0bb2\\u0bc2\\u0bb0\\u0bcd \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bc6\\u0b9f\\u0bc1\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0b95, 64 \\u0baa\\u0baf\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0bb2\\u0bb5\\u0b9a \\u0bb5\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0ba9\\u0bc8 \\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd. TRB.\\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0baf\\u0ba9\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd.\\n\\n#\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd_\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\n#MinnumMannai", "\\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0b95\\u0bb5\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bbe\\u0bb0\\u0bbf\\u0baf\\u0bae\\u0bcd\\u0bae\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bc8\\u0baf\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bbf, \\u0b8a\\u0bb0\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb4\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc8 \\u0b8f\\u0bb1\\u0bcd\\u0bb1\\u0bc1, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9a\\u0bc1\\u0bb5\\u0bbe\\u0bae\\u0bbf \\u0ba4\\u0bb0\\u0bbf\\u0b9a\\u0ba9\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd.", "In yet another major feat achieved as part of #OperationSindhu, 268 Indian nationals stranded in Israel have been brought back to safety in IAF C-17 flight from Sharm-El-Sheikh, Egypt, at 11 AM this morning.", "It was a deeply touching moment for me as I witnessed the nationals return to their homeland and express their gratitude for the government\\u2019s relentless support. As much as this is a win for the nation, it is our Hon\\u2019ble Prime Minister Shri. narendramodi ji\\u2019s farsighted vision and call for prompt action have made this operation successful throughout. \\n\\nJai Hind..!", "It is a moment of immense joy to welcome back our citizens evacuated from Israel under #OperationSindhu. With coordinated efforts under the effective leadership of Honourable Prime Minister Shri. narendramodi ji, we saw the safe return of 165 Indians in the IAF C-17 flight, which landed at 8:45 AM today. \\n\\nThis operation is a true testament of our government\\u2019s citizens-first policy. \\n\\nJai Hind..!", "\\u0b85\\u0baf\\u0bcd\\u0baf\\u0bbe \\u2764\\ufe0f", "\\u0ba4\\u0bc8\\u0bb2\\u0bbe\\u0baa\\u0bc1\\u0bb0\\u0bae\\u0bcd \\u0ba4\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bb0\\u0bcd \\u0bae\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bb0\\u0bcd \\u0b85\\u0baf\\u0bcd\\u0baf\\u0bbe \\n\\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0baf\\u0bcd \\u0b9a\\u0bb0\\u0b9a\\u0bc1\\u0bb5\\u0ba4\\u0bbf \\u0b85\\u0bae\\u0bcd\\u0bae\\u0bc8\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 60-\\u0bb5\\u0ba4\\u0bc1 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba3 \\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc1...!"], "model": "voyage-multilingual-2", "input_type": "document", "truncation": true, "output_dtype": "float", "output_dimension": 1024, "encoding_format": "base64"}' message='Post details'

bb5\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bcb \\u0b8e\\u0ba9\\u0bcd\\u0b95\\u0bbf\\u0bb1 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bc7\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b89\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1.mkstalin.!", "\\u0baa\\u0bb2 \\u0ba4\\u0bcb\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd ft. \\u0b95\\u0bbe\\u0bb0\\u0bbf\\u0baf\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0b95\\u0bcd\\u0b95\\u0ba3\\u0bc1\\u0bae\\u0bcd\\u0ba9\\u0bbe! \\u0b95\\u0bbe-\\u0bb2-\\u0baa\\u0bc1\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b99\\u0bcd\\u0b95!! \\ud83c\\udfb6 #AdmkFails", "India has plunged to 151 in the Global Press Freedom Index. Why? Because the BJP regime fears questions. It raids newsrooms, jails reporters, and silences those who expose corruption, rights violations, and its majoritarian agenda. On this #WorldPressFreedomDay, let us remind ourselves: without fearless journalism, democracy dies in darkness. That is why we must safeguard press freedom\\u2014not just for the media, but for every citizen\\u2019s right to know, question, and speak truth to power.", "#TouristFamily Where is Dubai Invesment ?", "\\u0baa\\u0bb9\\u0bb2\\u0bcd\\u0b95\\u0bbe\\u0bae\\u0bcd \\u0baa\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bb0\\u0bb5\\u0bbe\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b92\\u0bb4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0b89\\u0bb3\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.AmitShah \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc2\\u0bb3\\u0bc1\\u0bb0\\u0bc8.!", "\\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb1\\u0bc8\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd! #DMK", "Arise. Unite. Fight \\u2014 To Save the Constitution, To Save the Nation. Join us this Sunday @ 4 :00 PM \\u2014 Teynampet Congress Ground Chennai \\u2014 as we stand together to defend the Constitution and protect our nation. #SaveConstitutionSaveCountry", "\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0bae\\u0ba9\\u0bcd\\u0bb1\\u0bae\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 arivalayam \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0b8a\\u0bb4\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0ba4\\u0bb5\\u0bbf \\u0ba8\\u0bc0\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0bb2 \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0bae\\u0bb1\\u0bcd\\u0bb1 \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0baa\\u0bc7\\u0b9a \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0ba8\\u0bcd\\u0ba4 \\u0b85\\u0bb0\\u0bc1\\u0b95\\u0ba4\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0bc8 \\u0b8e\\u0ba9 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.nsitharaman \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd\\u00a0\\u0b95\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u00a0\\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b
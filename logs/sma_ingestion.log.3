b86\\u0ba3\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0bb0\\u0bbe \\u0bb5\\u0bbf\\u0b9c\\u0baf\\u0ba9\\u0bcd \\u0b87.\\u0b86.\\u0baa., \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b85\\u0bb0\\u0bc1\\u0bb3\\u0bcd\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc0\\u0ba9\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b9a\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bb0\\u0bc7\\u0bb8\\u0bcd\\u0bb5\\u0bb0\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb1\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0bae\\u0ba3\\u0bbf \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0bb5\\u0bc7\\u0bb2\\u0bcd\\u0bb0\\u0bbe\\u0b9c\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0b89\\u0b9f\\u0ba9\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd.", "Tamil Nadu and Its Legacy of Resistance! From Thanthai Periyar\\u2019s radical reforms to Perarignar Anna\\u2019s battle for state autonomy, from Thalaivar Kalaignar\\u2019s unwavering voice for social justice to Dravida Nayagar mkstalin\\u2019s relentless fight against fascism, the #DMK stands tall as the shield of #TamilNadu! This isn\\u2019t just a generational fight, it\\u2019s a revolution etched in history! #DMK4TN", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bbf\\u0bb0\\u0bc1\\u0bb7\\u0bcd\\u0ba3\\u0bb0\\u0bbe\\u0baf\\u0baa\\u0bc1\\u0bb0\\u0bae\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0b89\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b9f\\u0bae\\u0b99\\u0bcd\\u0b95\\u0bb2\\u0bae\\u0bcd, \\u0b85\\u0bb0\\u0bc1\\u0bb3\\u0bcd\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bbf\\u0bb3\\u0bbf\\u0b9a\\u0bc7\\u0bb0
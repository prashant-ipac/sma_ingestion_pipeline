u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bb0\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0ba4\\u0bb4\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bc0\\u0b9f\\u0bc1 \\u0ba4\\u0bca\\u0b95\\u0bc8\\u0baf\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb3\\u0bcd \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0ba4\\u0bb5\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1. \\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u2018\\u0ba4\\u0bbe\\u0ba9\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0baa\\u0baf\\u0ba3\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b8e\\u0bb0\\u0bbf\\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bcd \\u0bb5\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0baa \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0ba3\\u0baf\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u2019 \\u0b8e\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0baf\\u0bb0\\u0bcd \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0ba8\\u0b9f\\u0bc8\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u0bb2\\u0bc8 \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0ba4\\u0bbe\\u0ba9\\u0bbf \\u0b93\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba8\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0baf\\u0bbf\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0b9e\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0b95\\u0bc1\\u
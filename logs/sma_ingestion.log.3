bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. pmoorthy21 , \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bae\\u0baf\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0bb1\\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bbf.\\u0b95\\u0bc7. \\u0b9a\\u0bc7\\u0b95\\u0bb0\\u0bcd\\u0baa\\u0bbe\\u0baa\\u0bc1, \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc8 \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bb5\\u0bbf\\u0bb4\\u0bbe-2025 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0bae\\u0bbe.\\u0b9a\\u0bcc.\\u0b9a\\u0b99\\u0bcd\\u0b95\\u0bc0\\u0ba4\\u0bbe \\u0b87.\\u0b86.\\u0baa., \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0 \\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1", "\\u0b87.\\u0b86.\\u0baa., \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0 \\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0bb2\\u0bcb\\u0b95\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd \\u0b87.\\u0b95\\u0bbe.\\u0baa., \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b86\\u0ba3\\u0bc8\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0bb0\\u0bbe \\u0bb5\\u0bbf\\u0b9c\\u0baf\\u0ba9\\u0bcd \\u0b87.\\u0b86.\\u0baa., \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b85\\u0bb0\\u0bc1\\u0bb3\\u0bcd\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc0\\u0ba9\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b9a\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bb0\\u0bc7\\u0bb8\\u0bcd\\u0bb5\\u0bb0\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bb1\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0bae\\u0ba3\\u0bbf \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0bb5\\u0bc7\\u0bb2\\u0bcd\\u0bb0\\u0bbe\\u0b9c\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0b87\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd.", "Our own Dr. Sasikumar Gendham helped #TamilNadu reach new heights through decades of hard work in the #electronics manufacturing industry, and now he\\u2019s scaling ACTUAL heights - with his daughter, no less! Proud to share that Sasi, the President of ELCINA and a pioneer in Tamil Nadu\\u2019s electronics manufacturing industry, and his 15-year-old daughter Nisha climbed Mt. Elbrus, the highest peak in Europe! Congratulations to them for reaching the summit at 5,642 metres after a gruelling 12-hour trek! That Nisha", "metres after a gruelling 12-hour trek! That Nisha may well be the youngest from #TamilNadu to scale this peak makes the achievement even more inspiring ! What makes it truly special is that they sang both our Tamil Thai Vazhthu and the National Anthem after reaching the top. That\\u2019s the Tamil Nadu spirit - always grounded, always climbing higher ! Wishing them many more peaks to conquer, am told Carstensz Pyramid is next ! #MadeInTamilNadu\\u2665\\ufe0f", "\\u0b8e\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bc7\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b86\\u0bb4\\u0bae\\u0bbe\\u0b95 \\u0baa\\u0ba4\\u0bbf\\u0bb5\\u0bc1 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd", "She\\u2019s the President. Why is he still the one posing like the leader? #BJPGovt #Modi #Congress", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe\\u0bae\\u0bb2\\u0bc8\\u0baa\\u0bc1\\u0bb0\\u0bae\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1, \\u0b9f\\u0bbf\\u0b9f\\u0bbf \\u0ba4\\u0bca\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd 50-\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbe\\u0ba9 \\u2018\\u0baa\\u0bca\\u0ba9\\u0bcd \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u2019 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. 1975 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc1\\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bbf, \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0b9a\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9 \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1, \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0bae\\u0bbe\\u0ba9 \\u0b9f\\u0bbf\\u0b9f\\u0bbf \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0ba4\\u0bca\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf. \\u0b86\\u0bb0\\u0bae\\u0bcd\\u0baa \\u0b95\\u0bbe\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc7\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0b95\\u0bbf\\u0bb1 \\u0bae\\u0bbf\\u0b95 \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3 \\u0b95\\u0b9f\\u0bbf\\u0ba9\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bca\\u0bb4\\u0bc1\\u0ba4\\u0bc1, \\u0b85\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0baa\\u0bc2\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1 \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0bae\\u0bbe\\u0b95 \\u0bb5\\u0bbf\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0ba4\\u0bc1. 1982-\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0bb5\\u0ba3\\u0bcd\\u0ba3\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbe\\u0b95", "1982-\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0bb5\\u0ba3\\u0bcd\\u0ba3\\u0ba4\\u0bcd \\u0ba4\\u0
bae\\u0bcd \\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bbe\\u0ba4\\u0bc1; \\u0bb5\\u0bbf\\u0b9a\\u0bbe\\u0bb0\\u0ba3\\u0bc8\\u0baf\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0bb0\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0b95 \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf, \\u0ba4\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bc8 \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb0 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd!\\u201d. \\u0b95\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bbe\\u0bb0\\u0bae\\u0bbe\\u0b95 \\u0b85\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc8 \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf, \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb5\\u0ba4\\u0bc2\\u0bb1\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0b85\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0bae\\u0bb2\\u0bbf\\u0bb5\\u0bbe\\u0ba9 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4", "\\u0b85\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0bae\\u0bb2\\u0bbf\\u0bb5\\u0bbe\\u0ba9 \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b8e\\u0ba3\\u0bcd\\u0ba3\\u0ba4\\u0bcd\\u0ba4\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0baa\\u0bca\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bbf \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bcb\\u0bae\\u0bcd. \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0baf\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd - \\u0baa\\u0bc6\\u0ba3\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba8\\u0bcd\\u0ba8\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0bcb\\u0bae\\u0bcd!", "Our people are simple, dignified, and resilient. Even when all they have is half a rupee, they save it carefully, adding to it bit by bit, until they can buy a single gold bead. Not for show. Not for luxury. But for emergencies\\u2014moments when there is no one else to turn to. This is not ornamental gold. It is their shield against life\\u2019s uncertainties. Today, the RBI has proposed needless restrictions on gold loans, making it harder for poor and middle-class families to access credit with self-respect. This is", "to access credit with self-respect. This is not merely a regulation. It is a blow to their dignity and survival. At a time when many are already caught in the cruel grip of #LoanSharks and forced into #LoanApps during times of desperation, is it fair to push them further into those traps instead of protecting them? I respectfully urge Hon\\u2019ble nsitharaman and the reservebankofindia Governor to ease the rules on #GoldLoan. Let our people pledge their hard-earned gold with dignity. \\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b85\\u0bb0\\u0bc8\\u0baf\\u0ba3\\u0bbe", "gold with dignity. \\u0b95\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b85\\u0bb0\\u0bc8\\u0baf\\u0ba3\\u0bbe \\u0b95\\u0bbe\\u0b9a\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd, \\u0b85\\u0ba4\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0b95\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0ba3\\u0bbf \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bbe\\u0bb5\\u0ba4\\u0bc1 \\u0bb5\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0ba4\\u0bc1 \\u0ba8\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0bc1! \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bcd \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd \\u0b86\\u0b9f\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bb2\\u0bcd\\u0bb2; \\u0b86\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0b85\\u0bb5\\u0b9a\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd! \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0ba8\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0ba3\\u0bcd\\u0ba3\\u0bbf\\u0baf\\u0bae\\u0bbe\\u0ba9 \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0b9f\\u0bc8\\u0baf\\u0bc2\\u0bb1\\u0bbe\\u0b95, \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0baf\\u0bb1\\u0bcd\\u0bb1 \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0bb0\\u0bbf\\u0b9a\\u0bb0\\u0bcd\\u0bb5\\u0bcd \\u0bb5\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0bae\\u0bca\\u0bb4\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1, \\u0ba8\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0ba9\\u0bcd \\u0b8f\\u0bb4\\u0bc8 - \\u0b8e\\u0bb3\\u0bbf\\u0baf, \\u0ba8\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0ba3\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bb5\\u0bbe\\u0bb2\\u0bcd! \\u0b8f\\u0bb1\\u0bcd\\u0b95\\u0bc6\\u0ba9\\u0bb5\\u0bc7 \\u0b85\\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf #LoanSharks-\\u0b87\\u0b9f\\u0bae\\u0bcd", "\\u0b85\\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf #LoanSharks-\\u0b87\\u0b9f\\u0bae\\u0bcd \\u0b85\\u0bb5\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bc1\\u0bb5\\u0ba4\\u0bc1\\u0bae\\u0bcd - \\u0b85\\u0bb5\\u0b9a\\u0bb0\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 #LoanApps-\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bca\\u0bb2\\u0bcd\\u0bb2\\u0bca\\u0ba3\\u0bbe\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0baf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0bb3\\u0bbe\\u0b95\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0b85\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc2\\u0bb0 \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bb5\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0bb5\\u0ba4\\u0bc1 \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0bc1\\u0b9f\\u0bc8\\u0baf\\u0ba4\\u0bb2\\u0bcd\\u0bb2! \\u0b8e\\u0ba9\\u0bb5\\u0bc7, \\u0ba4\\u0b99\\u0bcd\\u0b95 \\u0ba8\\u0b95\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0bb5\\u0bbf\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bb3\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf, \\u0b8f\\u0bb4\\u0bc8 - \\u0b8e\\u0bb3\\u0bbf\\u0baf, \\u0ba8\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bb0 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0ba3\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4 \\u0b89\\u0b9f\\u0ba9\\u0bc7 \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 #NirmalaSitharaman \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd #RBI \\u0b86\\u0bb3\\u0bc1\\u0ba8\\u0bb0\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.", "\\u0baa\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0baa\\u0bbe\\u0bb2\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0baf\\u0bbe\\u0baf\\u0bae\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0b86\\u0bb1\\u0bb0\\u0bc8 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b86\\u0ba9\\u0ba4\\u0bc1. \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe \\u0baa\\u0bb2\\u0bcd\\u0b95\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bbf \\u0bb5\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd 157 \\u0ba8\\u0bbe\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd. - \\u0b95\\u0bb4\\u0b95 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1.\\u0b95\\u0ba9\\u0bbf\\u0bae\\u0bca\\u0bb4\\u0bbf \\u0b95\\u0bb0\\u0bc1\\u0ba3\\u0bbe\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf. \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd #DMK4Justice", "\\u0b89\\u0bb4\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc7\\u0baf\\u0bc7 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa \\u0b86\\u0bb2\\u0bcb\\u0b9a\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \'\\u0b89\\u0bb4\\u0bb5\\u0bb0\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc7\\u0b9f\\u0bbf \\u0bb5\\u0bc7\\u0bb3\\u0bbe\\u0ba3\\u0bcd\\u0bae\\u0bc8 \\u0b89\\u0bb4\\u0bb5\\u0bb0\\u0bcd \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\' \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd! #DMK4TN", "\\u0b95\\u0bc0\\u0bb4\\u0b9f\\u0bbf \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0b92\\u0ba4\\u0bc1\\u0b95\
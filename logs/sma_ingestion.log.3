\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd!", "So far, we\\u2019ve found #democracy, #secularism, #commerce, and #sindoor in Ji\\u2019s veins instead of blood. Let\\u2019s see what else surfaces before the next election! #BJPFails", "\\u0b95\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bb4\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bc7\\u0bb0\\u0bbf\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0ba3\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b89\\u0ba4\\u0baf\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0ba8\\u0bcd\\u0ba4\\u0bb0\\u0bcd\\u0bb5\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bb4\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bcd\\u0baa\\u0bc7\\u0ba4\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bc8 \\u0ba4\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u
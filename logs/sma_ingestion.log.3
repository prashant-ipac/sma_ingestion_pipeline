af\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b89\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b8e\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bbf\\u0bb0\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b88\\u0b9f\\u0bc1\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. \\u0b85\\u0ba4\\u0bc8 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1\\u0b95\\u0bc2\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0b95 \\u0ba8\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd (30.04.2025) \\u0bb5\\u0bc7\\u0ba4\\u0bbe\\u0bb0\\u0ba3\\u0bcd\\u0baf\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b8a\\u0bb0\\u0bcd\\u0bb5\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0b89\\u0baa\\u0bcd\\u0baa\\u0bb3\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bcb\\u0bae\\u0bcd.", "\\u0bb5\\u0bc7\\u0ba4\\u0bbe\\u0bb0\\u0ba3\\u0bcd\\u0baf\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b8a\\u0bb0\\u0bcd\\u0bb5\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0b89\\u0baa\\u0bcd\\u0baa\\u0bb3\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bcb\\u0bae\\u0bcd. \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b95\\u0bc7.\\u0bb5\\u0bc0.\\u0ba4\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bbe\\u0bb2\\u0bc1, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0ba8\\u0bc7\\u0bb0\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bb0\\u0bc2\\u0baa\\u0bbf \\u0b86\\u0bb0\\u0bcd.\\u0bae\\u0ba9\\u0bcb\\u0b95\\u0bb0\\u0ba9\\u0bcd, \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bbf.\\u0bb5\\u0bbf.\\u0bb0\\u0bbe\\u0b9c\\u0bc7\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0ba9\\u0bcd, \\u0bae\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0b9f\\u0bc1\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b86\\u0bb0\\u0bcd.\\u0b9a\\u0bc1\\u0ba4\\u0bbe, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1\\u0bb0\\u0bb3\\u0bbf\\u0ba4\\u0bb0\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b93\\u0bb5\\u0bbf\\u0baf\\u0bae\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bcb\\u0bb8\\u0bcd, \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc7\\u0ba4\\u0bbe\\u0bb0\\u0ba3\\u0bcd\\u0baf\\u0bae\\u0bcd \\u0ba8\\u0b95\\u0bb0 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd. Indian National Congress Mallikarjun Kharge -", "Indian National Congress Mallikarjun Kharge - President Rahul Gandhi Priyanka Gandhi Vadra K.C. Venugopal Suraj Hegde Girish Chodankar Congress Sandesh #SaltSatyagraha #vedaranyam", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 (1.5.2025) \\u0bae\\u0bc7 \\u0ba4\\u0bbf\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bc8 (\\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd) \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0b9a\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0ba4\\u0bbf\\u0bb0\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bb0\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0b85\\u0bb0\\u0bc1\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc7 \\u0ba4\\u0bbf\\u0ba9 \\u0baa\\u0bc2\\u0b99\\u0bcd\\u0b95\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba8\\u0bbf\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0b95\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bae\\u0bb2\\u0bb0\\u0bcd \\u0bb5\\u0bb3\\u0bc8\\u0baf\\u0bae\\u0bcd \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bc7\\u0ba9\\u0bcd. #MayDay2025 #maydaywishes", "\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc8 \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b9a\\u0bbe\\u0ba4\\u0bbf\\u0bb5\\u0bbe\\u0bb0\\u0bbf \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbf \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bae\\u0bc1\\u0b95 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 TTVDhinakaran \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd!", "\\u0b95\\u0bb0\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0bc1 \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0bb5\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bc8 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf, \\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0ba9\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9 \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bbe\\u0ba9 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bc1..!", "\\u0b9a\\u0bc1\\u0ba4\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb0 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0b9a\\u0bbe\\u0ba4\\u0bbf\\u0bb5\\u0bbe\\u0bb0\\u0bbf \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bc6\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bc8 \\u0ba8\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0ba4\\u0bbe\\u0b95 \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd, BJP4India \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd, \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd \\u0b87\\u0ba3\\u0bcd\\u0b9f\\u0bbf \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0b9f\\u0bae\\u0bcd\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0bae\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bb5\\u0bc8 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bb5\\u0bc8\\u0b95\\u0bcb\\u00a0\\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.!", "It is ridiculous to hear the statement made by Dharmendra Pradhan. As a minister, Pradhan ji should understand that the BJP government, led by Prime Minister Modi, has been in power for over ten years now. The caste census data, collected in 2011-12, has been available with the government and can be released at any time. Rahul Gandhi ji has now taken the lead on the caste census issue and even conducted the \'Bharat Jodo Yatra\' in 2023, bringing widespread attention to the cause. As a result, many people now", "to the cause. As a result, many people now support it. It is clear that you are under pressure, and that\\u2019s why you have now accepted it...", "\\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bbf\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b85\\u0ba3\\u0bbf\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0ba9\\u0bcd\\u0ba9 \\u0ba4\\u0b95\\u0bc1\\u0ba4\\u0bbf \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1!!", "No comments. Simply waste!", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd eps.tamilnadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0b99\\u0bcd\\u0b95, \\u0b95\\u0bca\\u0bb2\\u0bcd\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0b9f\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b8f\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0 \\u0bb5\\u0bbf\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bbf\\u0bb4\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, \\u0b89\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b9f\\u0bae\\u0b99\\u0bcd\\u0b95\\u0bb2\\u0bae\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc8 \\u0b9a\\u0bc7\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bbf\\u0bb0\\u0bc1\\u0bb7\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0bae\\u0bb4\\u0bb2\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0baf\\u0bbe, \\u0bb0\\u0bbf\\u0ba4\\u0ba9\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd, \\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0bb4\\u0b95 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0b8e\\u0bae\\u0bcd. \\u0b86\\u0bb0\\u0bcd. \\u0bb5\\u0bbf\\u0b9c\\u0baf\\u0baa\\u0bbe\\u0bb8\\u0bcd\\u0b95\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0bb2\\u0bcd\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0bc7\\u0bb0\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b89\\u0baf\\u0bbf\\u0bb0\\u0bbf\\u0bb4\\u0ba8\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bc1\\u0bae\\u0bcd\\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0bbe \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbe\\u0bb0\\u0bcd\\u0baa\\u0bbe\\u0b95 \\u0b86\\u0bb1\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd", "\\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.narendramodi \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bc0\\u0bb0\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bb5\\u0bbe\\u0ba9\\u0bb3\\u0bbe\\u0bb5 \\u0baa\\u0bc1\\u0b95\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0b9a\\u0bc2\\u0baa\\u0bcd\\u0baa\\u0bb0\\u0bcd \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.rajinikanth \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0bb9\\u0bb2\\u0bcd\\u0b95\\u0bbe\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0bb2\\u0bcd \\u0b88\\u0b9f\\u0bc1\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bc0\\u0bb5\\u0bbf\\u0bb0\\u0bb5\\u0bbe\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bcb\\u0b9f\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0b95\\u0bcd\\u0b95 \\u0baa\\u0ba4\\u0bbf\\u0bb2\\u0b9f\\u0bbf \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9 \\u0ba8\\u0bae\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0bb0\\u0bcd.!", "\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b8e\\u0ba4\\u0bbf\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0b95\\u0bb4\\u0b95 \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd, \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd \\u0b85\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. #\\u0b8e\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0ba3\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0ba3\\u0b99\\u0bcd\\u0b95, #\\u0b95\\u0bcb\\u0bb5\\u0bc8 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd, #\\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc2\\u0bb0\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0baa\\u0bc7\\u0bb0\\u0bc2\\u0bb0\\u0bcd \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0
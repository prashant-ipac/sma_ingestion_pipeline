8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bbe\\u0bb0\\u0bcd. \\u0b86\\u0ba9\\u0bbe\\u0bb2\\u0bcd mkstalin \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0bb0\\u0b9a\\u0bcb, \\u0b8f\\u0bb4\\u0bc8 \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0b9a\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bb0\\u0bbf\\u0baf\\u0bc8 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf, \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bc7\\u0ba4\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b86\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\u0b87\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd, \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8. -\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd eps.tamilnadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.", "\\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0b93\\u0bb2\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0b9a\\u0bc8\\u0b95\\u0bb3\\u0bcd, \\u0b93\\u0b9f\\u0bc1 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b86\\u0bb8\\u0bcd\\u0baa\\u0bc6\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb8\\u0bcd \\u0bb7\\u0bc0\\u0b9f\\u0bcd \\u0bb5\\u0bc0\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bc0\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb2 \\u0bae\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bc1 \\u0b9a\\u0bca\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bbf\\u0baf\\u0bc8 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b85\\u0bb2\\u0b99\\u0bcd\\u0b95\\u0bcb\\u0bb2 \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bae\\u0bcd ! -\\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b95\\u0bb4\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0baa\\u0bc1\\u0bb0\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb0\\u0bcd eps.tamilnadu \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.", "Today, I paid floral tributes to the Father of the Nation, Mahatma Gandhi, at the Embassy of India in Moscow, along with fellow members of the All-Party Parliamentary Delegation. The Mahatma\\u2019s message of peace and non-violence continues to inspire the world\\u2014and we carry it with us as representatives of India.", "During the #NITIAayog meeting, met our Hon\\u2019ble Prime Minister narendramodi and submitted a memorandum detailing key priorities for Tamil Nadu\\u2019s development and social justice: \\ud83d\\ude87 Approval for Coimbatore & Madurai #Metro \\ud83d\\ude89 Transfer of Chennai #MRTS to chennaimetrorail \\ud83d\\udee3\\ufe0f Upgrade NH32 (Chengalpattu\\u2013Tindivanam) to 6/8 lanes \\u2708\\ufe0f Expansion of Coimbatore & Madurai Airports \\ud83c\\udfe5 Establishment of an #AIIMS in Coimbatore \\ud83d\\udc69\\u200d\\ud83c\\udfeb Release of funds under #SSA \\ud83d\\udcdd Change in nomenclature of certain communities in SC/ST List", "nomenclature of certain communities in SC/ST List (\\u2018N\\u2019/\\u2018A\\u2019 to \\u2018R\\u2019) \\ud83d\\udd37 Inclusion of SC-converted Christians in SC list \\u2693 Safeguarding fishermen\\u2019s rights & expediting release of detainees We hope the Hon\\u2019ble Prime Minister will consider these proposals with due urgency, in the true spirit of cooperative federalism.", "ED-\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bb2\\u0bcd\\u0bb2, \\u0bae\\u0bcb\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0baf\\u0baa\\u0bcd\\u0baa\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bcb\\u0bae\\u0bcd. \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0b95\\u0bc1\\u0bb0\\u0bb2\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd. \\u0bae\\u0bbf\\u0bb0\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0b85\\u0b9f\\u0bbf\\u0baa\\u0ba3\\u0bbf\\u0baf \\u0bb5\\u0bc8\\u0b95\\u0bcd\\u0b95 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b85\\u0b9f\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0ba4\\u0bc1. \\u0b9a\\u0bc1\\u0baf\\u0bae\\u0bb0\\u0bbf\\u0baf\\u0bbe\\u0ba4\\u0bc8 \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0baf\\u0bbe\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0b9e\\u0bcd\\u0b9a\\u0bbe\\u0ba4\\u0bc1! \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b89\\u0ba4\\u0baf\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd #DyCMUdhay", "\\u0baa\\u0
u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bb5\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bc1\\u0ba4\\u0bc1\\u0b9f\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bb5\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b86\\u0bb2\\u0bcb\\u0b9a\\u0ba9\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0baa\\u0bcb\\u0ba4\\u0bc1\\u2026 drs.jaishankar mmabdulla_dmk", "\\u0b89\\u0bb2\\u0b95\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0b9a\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0b95\\u0bb2\\u0bcd\\u0bb5\\u0bbf \\u0ba8\\u0bbf\\u0bb1\\u0bc1\\u0bb5\\u0ba9\\u0bae\\u0bbe\\u0ba9 \\u0b9c\\u0bc6\\u0bb0\\u0bcd\\u0bae\\u0ba9\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbf\\u0baf\\u0bc2\\u0ba9\\u0bbf\\u0b95\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb1\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0baa\\u0bcd \\u0baa\\u0bb2\\u0bcd\\u0b95\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 (Technical University of Munich) \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1, \\u0baa\\u0bc7\\u0bb0\\u0bbe\\u0b9a\\u0bbf\\u0bb0\\u0bbf\\u0baf\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb0\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bbf\\u0ba9\\u0bb0\\u0bcd. \\u201c\\u0b93\\u0bae\\u0bcd\\u201d \\u0bb5\\u0bbf\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bc8 \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0baa\\u0bbf\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4 George Simon Ohm \\u0b9a\\u0bbf\\u0bb2\\u0bc8 \\u0b85\\u0bb5\\u0bcd\\u0bb5\\u0bb3\\u0bbe\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\u0b85\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0ba8\\u0bae\\u0ba4\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bb3\\u0bcd\\u0bb3\\u0bbf \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc1 \\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bc1 \\u0b95\\u0bc1\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.", "#DravidianModel #StalinBuildsTN tnschoolsedu", "\\u201cWarm birthday greetings to our respected Minister of Road Transport and Highways Shri gadkari.nitin Ji. Your commitment to infrastructure and development has transformed the nation\\u2019s path. Wishing you great success and health always!\\u201d (File Photo)", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0bb0\\u0ba4\\u0bcd\\u0ba9\\u0bbe \\u0baa\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0ba4 \\u0b9c\\u0bb5\\u0bb9\\u0bb0\\u0bcd\\u0bb2\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf.\\ud83d\\udc94 Video Credits : British Path\\u00e9 #RememberingNehru", "Dr Girish Shah SamastMahajan of the Animal Welfare Board of India has written to me, as a response to my \\u201cNo Dogs on Streets\\u201d policy which I mooted to the CM of TN. The AWB is reiterating the ABC rules. I strongly disagree with their position & have responded to them . #StreetDogs", "\\u0ba8\\u0bb5\\u0bc0\\u0ba9 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0b9f\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb3\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0ba4 \\u0b9c\\u0bb5\\u0bb9\\u0bb0\\u0bcd\\u0bb2\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8e\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf. #RememberingNehru", "\\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0baa\\u0bbe\\u0bb0\\u0ba4 \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bae\\u0bb0\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0ba4 \\u0b9c\\u0bb5\\u0bb9\\u0bb0\\u0bcd\\u0bb2\\u0bbe\\u0bb2\\u0bcd \\u0ba8\\u0bc7\\u0bb0\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbe\\u0ba4\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bbf\\u0bb2. \\u201c\\u0ba8\\
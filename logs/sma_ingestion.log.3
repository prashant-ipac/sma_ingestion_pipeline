 https://youtu.be/z1fZ7d9VCXI?si=J4nTlcniYQbsllCa", "\\u0b85\\u0baf\\u0bcd\\u0baf\\u0bbe \\u0bb5\\u0bc8\\u0b95\\u0bc1\\u0ba3\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0ba8\\u0bbf\\u0ba9\\u0bc8\\u0bb5\\u0bc1 \\u0bb5\\u0bbe\\u0bb2\\u0bbf\\u0baa\\u0bbe\\u0bb2\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bbf\\u0bb4\\u0bbe", "\\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bbf\\u0ba9\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0b95 (20, 21, 22, 23.05.2025) \\u0b8e\\u0bae\\u0ba4\\u0bc1 \\u0b95\\u0bb0\\u0bc2\\u0bb0\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bc1\\u0bb1\\u0bc8\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bb1\\u0bbf\\u0ba8\\u0bcd\\u0ba4\\u0bc1 , \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95\\u0baa\\u0bcd \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. #Karurmpjothimani", "\\u0ba8\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc1 (24.05.2025) \\u0baa\\u0bc1\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb0\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0ba4\\u0bc1\\u0ba3\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b89\\u0ba4\\u0baf\\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0baa\\u0bc1\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bbe\\u0ba9 \\u0b86\\u0baf\\u0bcd\\u0bb5\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0bc7\\u0ba9\\u0bcd. \\u0b85\\u0ba4\\u0ba9\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0b85\\u0bb0\\u0b9a\\u0bc1 \\u0ba8\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b89\\u0ba4\\u0bb5\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1. \\u0b87\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bb0\\u0b95\\u0bc1\\u0baa\\u0ba4\\u0bbf, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc6\\u0baf\\u0bcd\\u0baf\\u0ba8\\u0bbe\\u0ba4\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf \\u0b95\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba3\\u0bcd\\u0ba3\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b85\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0b95\\u0bc7\\u0bb7\\u0bcd \\u0baa\\u0bca\\u0baf\\u0bcd\\u0baf\\u0bbe\\u0bae\\u0bca\\u0bb4\\u0bbf, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1.\\u0b85\\u0bb0\\u0bc1\\u0ba3\\u0bbe \\u0b87\\u0b86\\u0baa, \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0bb5\\u0bc8\\u0b95\\u0bcb, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b85\\u0baa\\u0bcd\\u0ba4\\u0bc1\\u0bb2\\u0bcd\\u0bb2\\u0bbe, \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f", "\\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba4\\u0bc1\\u0bb0\\u0bc8 \\u0bb5\\u0bc8\\u0b95\\u0bcb, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b85\\u0baa\\u0bcd\\u0ba4\\u0bc1\\u0bb2\\u0bcd\\u0bb2\\u0bbe, \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b85\\u0baa\\u0bcd\\u0ba4\\u0bbe\\u0baa\\u0bcd \\u0bb0\\u0b9a\\u0bc2\\u0bb2\\u0bcd \\u0b87\\u0b86\\u0baa, \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb2 \\u0baa\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0ba9\\u0bcd, \\u0baa\\u0bc1\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0bc7\\u0b9a\\u0ba9\\u0bcd ,\\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbf\\u0ba8\\u0bbf\\u0ba4\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bb0\\u0bcd.", "Presenting the Eleventh Episode of Wonders of Kanniyakumari, featuring the captivating Mayapuri wax museum. Step into a world where legends come to life at Mayapuri Wax Museum, a unique blend of art, culture, and imagination in the heart of Kanniyakumari. From iconic leaders to beloved film stars, walk beside lifelike wax figures that celebrate history, cinema, and global icons. Capture unforgettable selfies, marvel at the artistry, and experience the magic of realism up close. Come, discover the charm of", "of realism up close. Come, discover the charm of Mayapuri \\u2014 where every sculpture tells a story. Share your favorite moments from Mayapuri Wax Museum. #Kanniyakumari #TamilNadu #MayapuriWaxMuseum", "\\u0b9a\\u0bc6\\u0bae\\u0bbf \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb1\\u0bcd\\u0b9a\\u0bbe\\u0bb2\\u0bc8 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0bb5\\u0ba4\\u0bc8 \\u0ba4\\u0bb5\\u0bb1\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0ba4\\u0bbf.\\u0bae\\u0bc1.\\u0b95. \\u0b85\\u0bb0\\u0b9a\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0ba9\\u0bae\\u0bcd.", "Delighted to speak at the \'Discover 2025: Toastmasters District Conference\' in Chennai, joining over 700 expert public speakers. Drawing from my journey\\u2014from Wall Street to the Tamil Nadu Legislative Assembly\\u2014I reflected on the power and responsibility of public speaking in today\\u2019s digital age, emphasizing on the need for thoughtful communication. I also shared two core principles at the heart of all meaningful communication. First, the importance of a common language and shared understanding\\u2014a shared", "common language and shared understanding\\u2014a shared culture, history, and values. Without this, connection is impossible. Second, I\\u2019ve come to believe that human relationships thrive on telling and listening to stories\\u2014and listening is as important as telling. Ultimately, the ability to speak at the right time, in the right place, with the right message is a skill we must all cultivate. Let us speak with purpose and empathy. Our ability to connect, persuade, and lead depends not just on the message, but on", "and lead depends not just on the message, but on the meaning behind it.", "\\u2728Highlights from the Department of Information Technology & Digital Services: Post #14 tnegaofficial : Tamil Nadu Geographical Information System (TNGIS) \\u2728\\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba8\\u0bc1\\u0b9f\\u0bcd\\u0baa\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b9f\\u0bbf\\u0b9c\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bb2\\u0bcd \\u0b9a\\u0bc7\\u0bb5\\u0bc8\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bae\\u0bcd\\u0b9a\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd: \\u0baa\\u0ba4\\u0bbf\\u0bb5\\u0bc1 #14 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bbf\\u0ba9\\u0bcd \\u0b86\\u0bb3\\u0bc1\\u0bae\\u0bc8 \\u0bae\\u0bc1\\u0b95\\u0bae\\u0bc8: \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0baa\\u0bc1\\u0bb5\\u0bbf\\u0baf\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0ba4\\u0b95\\u0bb5\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc1", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0baa\\u0bbe\\u0bb0\\u0ba4\\u0bbf\\u0baf \\u0b9c\\u0ba9\\u0ba4\\u0bbe \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc2\\u0ba4\\u0bcd\\u0ba4 \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba8\\u0bbe\\u0b95\\u0bbe\\u0bb2\\u0bbe\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0b86\\u0bb3\\u0bc1\\u0ba8\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b87\\u0bb2.\\u0b95\\u0ba3\\u0bc7\\u0b9a\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0ba4\\u0bbe\\u0baa\\u0bbf\\u0bb7\\u0bc7\\u0b95 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0ba4\\u0bc1 \\u0bae\\u0bbf\\u0b95\\u0bc1\\u0ba8\\u0bcd\\u0ba4 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0b85\\u0bb3\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. \\u0ba4\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba8\\u0bb2\\u0bcd\\u0bb2 \\u0b89\\u0b9f\\u0bb2\\u0bcd \\u0b86\\u0bb0\\u0bcb\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0bae\\u0bc1\\u0bae\\u0bcd, \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1, \\u0bae\\u0bc6\\u0ba9\\u0bcd\\u0bae\\u0bc7\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0baa\\u0bc1\\u0bb1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0b9f \\u0b8e\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bcd \\u0bb5\\u0bb2\\u0bcd\\u0bb2 \\u0b87\\u0bb1\\u0bc8\\u0bb5\\u0ba9\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf \\u0ba4\\u0bbf\\u0ba9\\u0bae\\u0bcd, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0bb2\\u0bcb\\u0b9a\\u0b95\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bbe\\u0ba9 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0ba9\\u0bcd. \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd
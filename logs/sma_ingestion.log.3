\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bb0\\u0bb5\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbe\\u0ba9 \\u0b9a\\u0bc1\\u0ba9\\u0bbf\\u0bb2\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0bb5\\u0ba9\\u0bcd, \\u0baa\\u0bbf.\\u0b9c\\u0bc7.\\u0baa\\u0bbf., \\u0b8e\\u0bae\\u0bcd.\\u0baa\\u0bbf.\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0ba9 \\u0ba4\\u0bc7\\u0b9c\\u0bb8\\u0bcd\\u0bb5\\u0bbf \\u0b9a\\u0bc2\\u0bb0\\u0bcd\\u0baf\\u0bbe \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbf.\\u0b9a\\u0bbf.\\u0bae\\u0bcb\\u0b95\\u0ba9\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0bb5\\u0bb0\\u0bcb\\u0b9f\\u0bc1 \\u0b87\\u0ba3\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb2\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3\\u0bbe\\u0ba9\\u0bcd. \\u0b87\\u0ba4\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0baa\\u0bbe\\u0b9c\\u0b95. \\u0b95\\u0bbe\\u0bb7\\u0bcd\\u0bae\\u0bc0\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b95\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bc1\\u0bae\\u0bb0\\u0bbf \\u0bb5\\u0bb0\\u0bc8 \\u0bb0\\u0bb5\\u0bc1\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bc8 \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bc7 \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf\\u0baa\\u0bcd\\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b92\\u0bb4\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1", "\\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b92\\u0bb4\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0bc6\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb5\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1 \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0baa\\u0bc7\\u0b9a\\u0bc1\\u0bb5\\u0ba4\\u0bc1 \\u0b89\\u0b9a\\u0bcd\\u0b9a\\u0baa\\u0b9f\\u0bcd\\u0b9a \\u0b95\\u0bbe\\u0bae\\u0bc6\\u0b9f\\u0bbf. \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0b92\\u0bb4\\u0bc1\\u0b99\\u0bcd\\u0b95\\u0bc1 \\u0ba8\\u0ba9\\u0bcd\\u0bb1\\u0bbe\\u0b95\\u0bb5\\u0bc7 \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. \\u0b85\\u0ba4\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc6\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0bc1\\u0baf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bb0\\u0bb5\\u0bc1\\u0b9f\\u0bbf\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bbe\\u0bb0\\u0bae\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1 \\u0baa\\u0bbe\\u0b9c\\u0b95. #BJPFails", "Israel\\u2019s strikes on Iran is a reckless act of aggression that risks igniting a wider war. Coupled with the continued bombardment of #Gaza and suffering of Palestinian civilians, this violent path must be condemned. The world must push for restraint, justice, and meaningful diplomacy. #NoMoreWars", "Tamil Nadu stands as India\\u2019s benchmark for development, driven by the grit of the Dravidian movement. It was this movement that chose #education over empty evangelism, economists over godmen, and #equity over exclusion. From #Periyar to #Anna, from #Kalaignar to Hon\'ble mkstalin Tamil Nadu\\u2019s progress has been rooted in reason, reform, and an unyielding commitment to #SocialJustice. In an age where jingoism drowns out #employment and propaganda supplants policy, #TamilNadu serves as a powerful reminder of", "#TamilNadu serves as a powerful reminder of what true patriotism looks like. #DMK4TN", "\\u0baa\\u0bca\\u0bb0\\u0bc1\\u0ba8\\u0bc8 \\u0ba8\\u0bbe\\u0b95\\u0bb0\\u0bbf\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bca\\u0ba9\\u0bcd\\u0bae\\u0bc8 \\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0ba9 \\u0ba4\\u0bc2\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b95\\u0bb2\\u0bc8 - \\u0b95\\u0bb2\\u0bbe\\u0b9a\\u0bcd\\u0b9a\\u0bbe\\u0bb0\\u0bae\\u0bcd - \\u0b89\\u0ba3\\u0bb5\\u0bc1 \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bbe\\u0bb0\\u0bae\\u0bcd\\u0baa\\u0bb0\\u0bbf\\u0baf\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0bb1\\u0bc1\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0ba3\\u0bcd\\u0ba3\\u0bae\\u0bcd, \\u0ba8\\u0bbe\\u0ba9\\u0bcd\\u0b95\\u0bbe\\u0bb5\\u0ba4\\u0bc1 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b95 \\u0b85\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc6\\u0baf\\u0bcd\\u0ba4\\u0bb2\\u0bcd \\u0b95\\u0bb2\\u0bc8 \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bbf\\u0bb4\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bc8 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0ba4\\u0bca\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bbf \\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0ba9\\u0bcd. \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1. \\u0b95\\u0bc0\\u0ba4\\u0bbe \\u0b9c\\u0bc0\\u0bb5\\u0ba9\\u0bcd, \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0ba3\\u0bcd\\u0bae\\u0bc1\\u0b95\\u0bc8\\u0baf\\u0bbe, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0ba3\\u0bcd\\u0b9f\\u0bc7\\u0baf\\u0ba9\\u0bcd, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b87\\u0bb3\\u0bae\\u0bcd\\u0baa\\u0b95\\u0bb5\\u0ba4\\u0bcd, \\u0bae\\u0bc7\\u0baf\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9c\\u0bc6\\u0b95\\u0ba9\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0b9a\\u0bbe\\u0bae\\u0bbf, \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bcd \\u0b95\\u0ba3\\u0bcd\\u0b95\\u0bbe\\u0ba3\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b86\\u0bb2\\u0bcd\\u0baa\\u0bb0\\u0bcd\\u0b9f\\u0bcd \\u0b9c\\u0bbe\\u0ba9\\u0bcd, \\u0b95\\u0bbf\\u0bb0\\u0bc0\\u0ba9\\u0bcd \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba8\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0bc6\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbe\\u0baf\\u0b95\\u0bae\\u0bcd,", "\\u0b95\\u0bbf\\u0bb0\\u0bc0\\u0ba9\\u0bcd \\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba8\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0bc6\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0bbe\\u0baf\\u0b95\\u0bae\\u0bcd, \\u0bb8\\u0bcd\\u0baa\\u0bbf\\u0b95\\u0bcd \\u0bae\\u0bc7\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9c\\u0bc6\\u0baf\\u200c\\u0baa\\u0bbf\\u0bb0\\u0b95\\u0bbe\\u0bb7\\u0bcd, \\u0ba8\\u0bb5\\u0b95\\u0bbf\\u0b9a\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8 \\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b87\\u0bae\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0bc1\\u0bb5\\u0bc7\\u0bb2\\u0bcd \\u0b95\\u0ba3\\u0bc7\\u0b9a\\u0ba9\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f
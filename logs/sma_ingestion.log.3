ba9\\u0bcd, \\u0b95\\u0bbf\\u0bb0\\u0bbe\\u0bae \\u0b9a\\u0baa\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b86\\u0bb0\\u0bcd\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bbe\\u0b95 \\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bc1\\u0baf\\u0bb1\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0ba4\\u0bc8 \\u0b95\\u0bc7\\u0bb3\\u0bcd\\u0bb5\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bc6\\u0bb1\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b93\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.KKSSR_DMK !", "Tamil Nadu roared with pride last night! Pure joy to witness the #BrazilLegends take on the #IndiaAllStars in Chennai. It was more than a match; it was a moment to remember, one that will inspire dreams for generations to come. Kids, study hard, play brave, win fair!", "\\u0baa\\u0bc1\\u0ba9\\u0bbf\\u0ba4 \\u0bb0\\u0bae\\u0bb2\\u0bbe\\u0ba9\\u0bcd \\u0baa\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b87\\u0bb8\\u0bcd\\u0bb2\\u0bbe\\u0bae\\u0bbf\\u0baf \\u0b9a\\u0b95\\u0bcb\\u0ba4\\u0bb0 \\u0b9a\\u0b95\\u0bcb\\u0ba4\\u0bb0\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba9\\u0bae\\u0bbe\\u0bb0\\u0bcd\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc8 \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd. #EidUlFitr #EidMubarak", "\\u0b92\\u0bb5\\u0bcd\\u0bb5\\u0bca\\u0bb0\\u0bc1 \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0bb4\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0baa\\u0bc8 \\u0bb5\\u0bbf\\u0b9f \\u0bb5\\u0bc0\\u0bb0\\u0bbf\\u0baf\\u0bae\\u0bbe\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0bae\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b85\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0b89\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0b9f\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd! - \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd #DMK4TN", "\\u0b95\\u0b9f\\u0ba8\\u0bcd\\u0ba4 4 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd 3 \\u0bae\\u0bc1\\u0bb1\\u0bc8 \\u0bae\\u0bc2\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bc1 \\u0b89\\u0bb4\\u0bc8\\u0baa\\u0bcd\\u0baa\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0b88\\u0bb0\\u0bcb\\u0b9f\\u0bc1 \\u0b95\\u0bbf\\u0bb4\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0b9f\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0ba4\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0bb2\\u0bcd \\u0ba4\\u0bca\\u0b9f\\u0bb0\\u0bcd \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0bc8 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf \\u0b9a\\u0bc6\\u0baf\\u0bcd\\u0ba4 \\u0b89\\u0b9f\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b9a\\u0bcd \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0ba9 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bb3\\u0bcd, \\u0baa\\u0bbe\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bb3\\u0bcd! - \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd #DMK4TN", "The National Education Policy 2020 hides the reality of the 3Cs that haunt Indian education today. Centralisation of power with the union government; Commercialisation and outsourcing of educational investments to the private sector; Communalisation of textbooks, curriculums and institutions. CPP Chairperson Smt. Sonia Gandhi ji writes in The Hindu", "\\u0baa\\u0bbe\\u0b9c\\u0b95\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0b9f\\u0bc8\\u0baf\\u0bbe\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0bae\\u0bc1\\u0bae\\u0bcd\\u0ba4\\u0bbe\\u0ba9\\u0bcd. \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0ba9 \\u0ba4\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b85\\u0ba4\\u0bc8 \\u0bae\\u0bc1\\u0bb1\\u0bbf\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0bb5\\u0bb2\\u0bbf\\u0bae\\u0bc8 \\u0ba8\\u0bae\\u0bcd\\u0bae\\u0bbf\\u0b9f\\u0bae\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0ba4\\u0bc1. - \\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd #DMK4TN", "\\u0b95\\u0bb4\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0bbe\\u0bb2\\u0bbf\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0bbf\\u0b95\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0ba4\\u0bb2\\u0bbf\\u0ba9\\u0bcd\\u0baa\\u0b9f\\u0bbf, \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0b87\\u0bb0\\u0bbe\\u0baf\\u0baa\\u0bcd\\u0baa\\u0bc7\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\u0b90\\u0bb8\\u0bcd \\u0bb5\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0bb8\\u0bcd\\u0baa\\u0bcb\\u0bb0\\u0bcd\\u0b9f\\u0bcd\\u0bb8\\u0bcd \\u0b85\\u0bb0\\u0bc7\\u0ba9\\u0bbe\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0baa\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd\\u0baa\\u0bbe\\u0bb2\\u0bcd (Pickleball) \\u0baa\\u0bcb\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0b87\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0b9a\\u0bcd\\u0b9a\\u0bc1\\u0bb1\\u0bcd\\u0bb1\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc1\\u0bb5\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0bb5\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0bbf \\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1 \\u0bb5\\u0bc0\\u0bb0\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bc0\\u0bb0\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0ba9\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0baa\\u0bb0\\u0bbf\\u0b9a\\u0bc1\\u0b95\\u0bb3\\u0bc8 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0b95\\u0bb0 \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8 \\u0bae\\u0bbe\\u0ba8\\u0b95\\u0bb0\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0baa\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0ba8\\u0bc7.\\u0b9a\\u0bbf\\u0bb1\\u0bcd\\u0bb1\\u0bb0\\u0b9a\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0b87\\u0ba9\\u0bbf\\u0baf \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u2026 \\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd", "\\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0baa\\u0b95\\u0bc1\\u0ba4\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0ba3\\u0bcd\\u0b9f\\u0bb2\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb4\\u0bc1\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b8e\\u0bb8\\u0bcd.\\u0bae\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bcb\\u0b95\\u0ba9\\u0bcd, \\u0bae\\u0bbe\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bae\\u0ba4\\u0bbf.\\u0b88\\u0bb8\\u0bcd\\u0bb5\\u0bb0\\u0bbf \\u0bb5\\u0bc6\\u0b99\\u0bcd\\u0b95\\u0b9f\\u0bc7\\u0b9a\\u0ba9\\u0bcd, \\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0b9c\\u0bbf.\\u0bb5\\u0bc6\\u0b99\\u0bcd\\u0b95\\u0b9f\\u0bc7\\u0b9a\\u0ba9\\u0bcd, \\u0b95\\u0bb4\\u0b95 \\u0bb5\\u0bbf\\u0bb3\\u0bc8\\u0baf\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0b85\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2 \\u0ba4\\u0bc1\\u0ba3\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0bbf.\\u0ba8\\u0bbf\\u0bb5\\u0bc7\\u0ba4\\u0bbe \\u0b9c\\u0bc6\\u0b9a\\u0bbf\\u0b95\\u0bbe, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bb5\\u0bc7.\\u0b95\\u0bcc\\u0ba4\\u0bae\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1\\u0b95\\u0bae\\u0ba4\\u0bc1 \\u0b87\\u0bb8\\u0bcd\\u0bb0\\u0ba4\\u0bcd, \\u0b9f\\u0bbe\\u0b95\\u0bcd\\u0b9f\\u0bb0\\u0bcd \\u0b9a\\u0ba4\\u0bcd\\u0baf\\u0bbe \\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u2026", "\\u0baa\\u0bc1\\u0ba9\\u0bbf\\u0ba4 \\u0bb0\\u0bae\\u0bb2\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bbe\\u0bb3\\u0bc8\\u0baf\\u0bca\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf(\\u0ba4\\u0bc6) \\u0bae\\u0bbe\\u0bb5\\u0b9f\\u0bcd\\u0b9f\\u0b95\\u0bcd \\u0b95\\u0bb4\\u0b95 \\u0b85\\u0bb2\\u0bc1\\u0bb5\\u0bb2\\u0b95\\u0ba4\\u0bcd\
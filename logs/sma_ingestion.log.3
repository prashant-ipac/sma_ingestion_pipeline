\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9f\\u0bbf.\\u0bae\\u0ba4\\u0bbf\\u0baf\\u0bb4\\u0b95\\u0ba9\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b92\\u0baf\\u0bcd.\\u0baa\\u0bbf\\u0bb0\\u0b95\\u0bbe\\u0bb7\\u0bcd, \\u0bb5\\u0bc7\\u0bb3\\u0bbe\\u0ba3\\u0bcd\\u0bae\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba4\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba3\\u0bbe\\u0bae\\u0bc2\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf, \\u0baa\\u0bca\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0ba8\\u0bbf\\u0baf\\u0bcb\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0bae\\u0bc7\\u0bb2\\u0bbe\\u0ba3\\u0bcd\\u0bae\\u0bc8 \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0ba8\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0baa\\u0bbe. \\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0bc7\\u0bb7\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bcb\\u0bb0\\u0bcd \\u0b89\\u0b9f\\u0ba9\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0ba9\\u0bb0\\u0bcd.", "Tamil Nadu Food Minister Thiru R. Sakkarapani, MP Thiru Tiruchi Siva, Principal Secretary Thiru Satyabrata Sahoo IAS, Mohan IAS, Murugesh IAS and I met Union Minister Thiru Prahlad Joshi in New Delhi today, and submitted a memorandum urging the immediate release of \\u20b92670.64 Cr pending subsidy. We pressed for increasing the state\\u2019s rice procurement target for 2024-25, revision of economic cost for earlier KMS years, supply of Grade A parboiled rice under OMSS(D), and extension till March 2026 for", "under OMSS(D), and extension till March 2026 for ePoS-weighing scale integration.", "\\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b9f\\u0bc6\\u0bb2\\u0bcd\\u0bb2\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0ba8\\u0bc1\\u0b95\\u0bb0\\u0bcd\\u0bb5\\u0bcb\\u0bb0\\u0bcd \\u0ba8\\u0bb2\\u0ba9\\u0bcd, \\u0b89\\u0ba3\\u0bb5\\u0bc1 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0ba8\\u0bbf\\u0baf\\u0bcb\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0baa\\u0bbf\\u0bb0\\u0bb9\\u0bb2\\u0bbe\\u0ba4\\u0bcd \\u0b9c\\u0bcb\\u0bb7\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc8, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b89\\u0ba3\\u0bb5\\u0bc1 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1 \\u0bb5\\u0bbf\\u0ba8\\u0bbf\\u0baf\\u0bcb\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b86\\u0bb0\\u0bcd.\\u0b9a\\u0b95\\u0bcd\\u0b95\\u0bb0\\u0baa\\u0bbe\\u0ba3\\u0bbf \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0b9a\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1, \\u0bb0\\u0bc2.2,670.64 \\u0b95\\u0bcb\\u0b9f\\u0bbf \\u0ba8\\u0bbf\\u0bb2\\u0bc1\\u0bb5\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3 \\u0b89\\u0ba3\\u0bb5\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bcd \\u0bae\\u0bbe\\u0ba9\\u0bbf\\u0baf\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0b95\\u0bc8\\u0baf\\u0bc8 \\u0bb5\\u0bb4\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bb5\\u0ba4\\u0bc1, \\u0baa\\u0bca\\u0bb0\\u0bc1\\u0bb3\\u0bbe\\u0ba4\\u0bbe\\u0bb0\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0bb2\\u0bb5\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bb3 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bae\\u0bcd \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd KMS 2024\\u201325 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba8\\u0bc6\\u0bb2\\u0bcd \\u0b95\\u0bca\\u0bb3\\u0bcd\\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b87\\u0bb2\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0b89\\u0baf\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0baf \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bc8 \\u0bb5\\u0bb2\\u0bbf\\u0baf\\u0bc1\\u0bb1\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0b95\\u0bcb\\u0bb0\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0bae\\u0ba9\\u0bc1 \\u0b85\\u0bb3\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bcb\\u0bae\\u0bcd.", "\\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b9a\\u0bcd\\u0b9a\\u0bbf \\u0b9a\\u0bbf\\u0bb5\\u0bbe, \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb1\\u0bb5\\u0bc1, \\u0b89\\u0ba3\\u0bb5\\u0bc1 \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bc1\\u0b95\\u0bb0\\u0bcd\\u0bb5\\u0bcb\\u0bb0\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0bae\\u0bc1\\u0ba4\\u0ba9\\u0bcd\\u0bae\\u0bc8\\u0b9a\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0ba4\\u0bcd\\u0baf\\u0baa\\u0bbf\\u0bb0\\u0ba4\\u0bbe \\u0b9a\\u0bbe\\u0b95\\u0bc1, \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bcb\\u0b95\\u0ba9\\u0bcd \\u0b87\\u0b86\\u0baa \\u0bae\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0bae\\u0bc1\\u0bb0\\u0bc1\\u0b95\\u0bc7\\u0bb7\\u0bcd \\u0b87\\u0b86\\u0baa \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bcb\\u0bb0\\u0bcd  \\u0b89\\u0b9f\\u0ba9\\u0bbf\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0ba9\\u0bb0\\u0bcd.", "\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bbf\\u0ba9\\u0bcd \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bb0\\u0bcd, \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0b9e\\u0bb0\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb1\\u0bcd\\u0bb1 \\u0ba4\\u0bcb\\u0bb4\\u0bb0\\u0bcd, \\u0baa\\u0bbf\\u0bb1\\u0bcd\\u0baa\\u0b9f\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0b89\\u0bb0\\u0bbf\\u0bae\\u0bc8\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0ba4\\u0bc7\\u0b9a\\u0bbf\\u0baf\\u0b95\\u0bcd \\u0b95\\u0bc1\\u0bb0\\u0bb2\\u0bbe\\u0baf\\u0bcd \\u0b92\\u0bb2\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u200c. \\u0bb5\\u0bbf.\\u0baa\\u0bbf.\\u0b9a\\u0bbf\\u0b99\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd.\\n\\n\\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bbe\\u0ba9 \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b85\\u0bb5\\u0bb0\\u0bcd \\u0b95\\u0ba9\\u0bb5\\u0bc1 \\u0b95\\u0ba3\\u0bcd\\u0b9f \\u0b9a\\u0bae\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0bb5 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bbe\\u0bb5\\u0bc8 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95 \\u0b89\\u0bb1\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bcb\\u0bae\\u0bcd.", "\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bc1\\u0b9f\\u0bbf \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf, \\u0b95\\u0bcb\\u0bb5\\u0bbf\\u0bb2\\u0bcd\\u0bb5\\u0bc6\\u0ba3\\u0bcd\\u0ba3\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd, \\u0ba4\\u0ba9\\u0ba4\\u0bc1 \\u0ba4\\u0bca\\u0b95\\u0bc1\\u0ba4\\u0bbf \\u0bae\\u0bc7\\u0bae\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc1 \\u0ba8\\u0bbf\\u0ba4\\u0bbf \\u0bb0\\u0bc2.10 \\u0b87\\u0bb2\\u0b9f\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0bae\\u0ba4\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bc0\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9f\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0baa\\u0bc1\\u0ba4\\u0bbf\\u0baf \\u0baa\\u0bc7\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0ba8\\u0bbf\\u0bb4\\u0bb2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bcd\\u0ba4\\u0bc1\\u0bb1\\u0bc8 \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bcd.TRB \\u0bb0\\u0bbe\\u0b9c\\u0bbe \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0baa\\u0baf\\u0ba9\\u0bcd\\u0baa\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0bc1\\u0bb5\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0bbe\\u0bb0\\u0bcd.\\n\\n#\\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc1\\u0bae\\u0bcd_\\u0bae\\u0ba9\\u0bcd\\u0ba9\\u0bc8\\n#MinnumMannai", "Continuing on our green warrior Honourable Chief Minister ofTamilNadu Thiru. MK Stalin\\u2019s environmental roadmap for Tamil Nadu, we are building infra to induce growth with environmental responsibility.\\n\\nAlong with our dear friend and #Singapore\\u2019s Consul-General in Chennai Thiru. Edgar Pang, today we had the privilege of launching the #NetZeroIndustrialPark (NZIP) Framework, a collaborative effort between the SIPCOT and Singapore\\u2019s Ministry of Trade and Industry.", "This framework - developed with contributions from the Singapore University of Technology and Design (SUTD), Enterprise Singapore, and the Centre of Liveable Cities - combines our countries\\u2019 respective expertise in sustainability for Tamil Nadu\\u2019s ambitious net-zero goals. \\n\\nTogether, we are reimagining the industrial parks of the future, where sustainable design and decarbonisation are embedded right from inception.", "This new initiative will help industries reduce emissions by 50% by 2030 and aim to reach net-zero by 2050, thus aligning us with the world\\u2019s most forward-looking climate goals.\\n\\nTamil Nadu is already India\\u2019s manufacturing leader. With this framework, we aim to become its most sustainable one too ! \\n\\n#InvestInTN  #BullishOnTN", "@actorvijay", "\\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b87\\u0bb3\\u0bc8\\u0b9e\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bbe\\u0baf\\u0bcd\\u0bae\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bae\\u0bbe\\u0ba3\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0bb5\\u0bbf\\u0bb5\\u0b9a\\u0bbe\\u0baf\\u0bbf\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bca\\u0bb4\\u0bbf\\u0bb2\\u0bbe\\u0bb3\\u0bbf\\u0b95\\u0bb3\\u0bcd \\u0b8e\\u0ba9 \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0bc7\\u0bb1\\u0bc1 \\u0ba4\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0ba8\\u0bcd\\u0ba4 \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0baa\\u0bc8 \\u0baa\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0ba9\\u0bcd\\u0bb1\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0ba8\\u0bbe\\u0ba9\\u0bcd \\u0b95\\u0bca\\u0b9e\\u0bcd\\u0b9a\\u0bae\\u0bcd \\u0b87\\u0bb1\\u0bc1\\u0bae\\u0bbe\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0b9f\\u0bc1, \\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0bae\\u0bc8\\u0baf\\u0bcb\\u0b9f\\u0bc1 \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd 2026 \\u0bae\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bb2\\u0bcd\\u0bb2, \\u0b85\\u0ba4\\u0bc1 2031 \\u0b86\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd, 2036 \\u0b86\\u0b95 \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0bbe\\u0bb2\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba8\\u0bbe\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bc8 \\u0b86\\u0bb3\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0b95\\u0bbf\\u0bb1\\u0bcb\\u0bae\\u0bcd.\\n\\n- \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1.\\u0bae\\u0bc1.\\u0b95.\\u0bb8\\u0bcd\\u0b9f\\u0b
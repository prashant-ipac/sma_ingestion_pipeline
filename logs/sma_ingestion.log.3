bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bbe\\u0ba4\\u0bc1\\u0b95\\u0bbe\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bbf\\u0baf \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0bb5\\u0bc2\\u0bb2\\u0bae\\u0bbe\\u0b95 \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0bbf \\u0b87\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba8\\u0bc2\\u0bb2\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0bae\\u0bbf\\u0ba9\\u0bcd\\u0ba9\\u0bc2\\u0bb2\\u0b95\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0baa\\u0b9f\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bbf\\u0b9f\\u0bc8\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0ba4\\u0bc1. #\\u0baa\\u0bbe\\u0b9a\\u0bb1\\u0bc8_\\u0baa\\u0b9f\\u0bbf\\u0baa\\u0bcd\\u0baa\\u0bb1\\u0bc8", "\\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b95\\u0bc1. \\u0b9a\\u0bc6\\u0bb2\\u0bcd\\u0bb5\\u0baa\\u0bcd\\u0baa\\u0bc6\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0b95\\u0bc8, \\u0b8e\\u0bae\\u0bcd.\\u0b8e\\u0bb2\\u0bcd.\\u0b8f. \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bae\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0ba9\\u0bcd\\u0ba9\\u0bc8, \\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0baf\\u0bae\\u0bc2\\u0bb0\\u0bcd\\u0ba4\\u0bcd\\u0ba4\\u0bbf \\u0baa\\u0bb5\\u0ba9\\u0bbf\\u0bb2\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0bcd \\u0ba8\\u0b9f\\u0bc8\\u0baa\\u0bc6\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bc1. \\u0b87\\u0b95\\u0bcd\\u0b95\\u0bc2\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b85\\u0b95\\u0bbf\\u0bb2 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0b95 \\u0baa\\u0bca\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b95\\u0bbf\\u0bb0\\u0bbf\\u0bb7\\u0bcd \\u0b9a\\u0bcb\\u0b9f\\u0b99\\u0bcd\\u0b95\\u0bb0\\u0bcd, \\u0b85\\u0b95\\u0bbf\\u0bb2 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1. \\u0b9a\\u0bc2\\u0bb0\\u0b9c\\u0bcd \\u0b8e\\u0bae\\u0bcd.\\u0b8e\\u0ba9\\u0bcd. \\u0bb9\\u0bc6\\u0b95\\u0bcd\\u0b9f\\u0bc7, \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0ba4\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b8e\\u0bb8\\u0bcd. \\u0bb0\\u0bbe\\u0b9c\\u0bc7\\u0bb7\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bbe\\u0bb0\\u0bcd, \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf\\u0baf\\u0bbf\\u0ba9\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b9a\\u0bc6\\u0baf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bb4\\u0bc1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0b85\\u0b95\\u0bbf\\u0bb2 \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd, \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1, \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd", "\\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b86\\u0b95\\u0bbf\\u0baf\\u0bcb\\u0bb0\\u0bcd \\u0baa\\u0b99\\u0bcd\\u0b95\\u0bc7\\u0bb1\\u0bcd\\u0bb1\\u0ba9\\u0bb0\\u0bcd.. \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0ba4\\u0bbe\\u0b95 \\u0bae\\u0bb1\\u0bc8\\u0ba8\\u0bcd\\u0ba4 \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd\\u0ba8\\u0bbe\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb0\\u0bb8\\u0bcd \\u0b95\\u0bae\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bbf \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba4\\u0bb2\\u0bc8\\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbe\\u0bb3\\u0bcd \\u0ba8\\u0bbe\\u0b9f\\u0bbe\\u0bb3\\u0bc1\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b9a\\u0b9f\\u0bcd\\u0b9f\\u0bae\\u0ba9\\u0bcd\\u0bb1 \\u0b89\\u0bb1\\u0bc1\\u0baa\\u0bcd\\u0baa\\u0bbf\\u0ba9\\u0bb0\\u0bc1\\u0bae\\u0bbe\\u0ba9 \\u0ba4\\u0bbf\\u0bb0\\u0bc1 \\u0b95\\u0bc1\\u0bae\\u0bb0\\u0bbf \\u0b85\\u0ba9\\u0ba8\\u0bcd\\u0ba4\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0bb5\\u0bc1\\u0bb0\\u0bc1\\u0bb5 \\u0baa\\u0b9f\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0bae\\u0bb2\\u0bb0\\u0b9e\\u0bcd\\u0b9a\\u0bb2\\u0bbf \\u0b9a\\u0bc6\\u0bb2\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0ba4\\u0bc1.", "\\u2018\\u0ba8\\u0bc0\\u0b9f\\u0bcd\\u2019 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bcd \\u0ba4\\u0bc7\\u0bb0\\u0bcd\\u0bb5\\u0bc1 2016 \\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0baa\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0b95\\u0bc1\\u0ba4\\u0bbe\\u0ba9\\u0bcd \\u0bb5\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1. \\u0b85\\u0baa\\u0bcd\\u0baa\\u0bcb\\u0ba4\\u0bc1 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0b87\\u0bb0\\u0bc1\\u0ba8\\u0bcd\\u0ba4\\u0ba4\\u0bc1. \\u0baa\\u0bbe\\u0b9c\\u0b95 \\u0bae\\u0bbe\\u0ba8\\u0bbf\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bc8 \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0ba4\\u0bc1 \\u0b85\\u0ba4\\u0bbf\\u0bae\\u0bc1\\u0b95 \\u0b87\\u0ba4\\u0bc1\\u0bb5\\u0bbe\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bb4\\u0ba9\\u0bbf\\u0b9a\\u0bbe\\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0baf\\u0bc1\\u0bae\\u0bbe? #\\u0ba4\\u0bb2\\u0bc8\\u0baf\\u0b99\\u0bcd\\u0b95\\u0bae\\u0bcd", "I strongly condemn the barbaric terrorist attack in Pahalgam, Jammu & Kashmir, which killed innocent civilians and tourists from across India, including from my home state Tamil Nadu. Attacking innocent people is not just cowardly, it\'s an unforgivable crime against humanity. Our prayers are with the victims, but we must ask: How long will this cycle continue? The Central Government had made grand promises that demonetisation would end terrorism. Eight years later, not only does terrorism remain, but it has", "later, not only does terrorism remain, but it has spread to target even peaceful tourists. What exactly is the Centre doing to protect its citizens? Beyond speeches, beyond headlines, beyond photo-ops, where is the real action? Where is the strategy? Why do terror networks still strike with impunity in a region under direct Central control? National security is being reduced to a political slogan, while lives are lost and families are destroyed. The people of India are not asking for sympathy. They are", "of India are not asking for sympathy. They are demanding safety, sincerity, and accountability. The Centre must wake up. Empty rhetoric cannot protect the lives of our people. Thiru selvaperunthagai.k", "\\u0b95\\u0bbe\\u0bb2\\u0ba8\\u0bbf\\u0bb2\\u0bc8 \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0ba9\\u0bcd \\u0baa\\u0bb2\\u0bcd\\u0bb5\\u0b95\\u0bc8 \\u0ba4\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bc6\\u0baa\\u0bcd\\u0baa \\u0b85\\u0bb2\\u0bc8\\u0baf\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0ba3\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc1\\u0bb1\\u0bc8\\u0baf\\u0bbf\\u0bb2\\u0bcd \\u0bae\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bb0 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0b92\\u0ba9\\u0bcd\\u0bb1\\u0bbf\\u0baf \\u0baa\\u0bc1\\u0bb5\\u0bbf \\u0b85\\u0bb1\\u0bbf\\u0bb5\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b85\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1 \\u0b95\\u0b9f\\u0bbf\\u0ba4\\u0bae\\u0bcd \\u0b8e\\u0bb4\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd\\u200c. \\u0bb5\\u0bc6\\u0baa\\u0bcd\\u0baa\\u0ba8\\u0bbf\\u0bb2\\u0bc8\\u0baf\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bbf, \\u0b85\\u0ba4\\u0bbf\\u0b95\\u0bb0\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1 \\u0bb5\\u0bb0\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0ba9\\u0bcd \\u0b88\\u0bb0\\u0baa\\u0bcd\\u0baa\\u0ba4\\u0bae\\u0bcd(Humidity) \\u0b89\\u0bb3\\u0bcd\\u0bb3\\u0bbf\\u0b9f\\u0bcd\\u0b9f \\u0b87\\u0ba4\\u0bb0 \\u0b95\\u0bbe\\u0bb0\\u0ba3\\u0bbf\\u0b95\\u0bb3\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb2\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0bb5\\u0bc6\\u0baa\\u0bcd\\u0baa \\u0b85\\u0bb2\\u0bc8\\u0baf\\u0bc8\\u0ba4\\u0bcd \\u0ba4\\u0bc0\\u0bb0\\u0bcd\\u0bae\\u0bbe\\u0ba9\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bb5\\u0bc7\\u0ba3\\u0bcd\\u0b9f\\u0bc1\\u0bae\\u0bcd \\u0b8e\\u0ba9\\u0bb5\\u0bc1\\u0bae\\u0bcd, \\u0b87\\u0ba4\\u0ba9\\u0bbe\\u0bb2\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b8f
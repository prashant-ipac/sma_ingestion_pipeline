d \\u0b9a\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bc6\\u0b9f\\u0bc1\\u0bb5\\u0ba4\\u0bb1\\u0bcd\\u0b95\\u0bbe\\u0ba9 \\u0b9a\\u0bc6\\u0baf\\u0bb2\\u0bcd\\u0b95\\u0bb3\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0b87\\u0b9f\\u0bae\\u0bcd \\u0ba4\\u0bb0\\u0bae\\u0bbe\\u0b9f\\u0bcd\\u0b9f\\u0bbe\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd. #\\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0bb1\\u0bb3\\u0bcd", "1991-\\u0b86\\u0bae\\u0bcd \\u0b86\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0b95\\u0bb4\\u0b95 \\u0b86\\u0b9f\\u0bcd\\u0b9a\\u0bbf\\u0baf\\u0bc8\\u0b95\\u0bcd \\u0b95\\u0bb2\\u0bc8\\u0ba4\\u0bcd\\u0ba4\\u0baa\\u0bcb\\u0ba4\\u0bc1, \\u0baa\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb0\\u0bbf\\u0b95\\u0bc8\\u0b95\\u0bb3\\u0bcd \'\\u0b9c\\u0ba9\\u0ba8\\u0bbe\\u0baf\\u0b95\\u0baa\\u0bcd \\u0baa\\u0b9f\\u0bc1\\u0b95\\u0bca\\u0bb2\\u0bc8\' \\u0b8e\\u0ba9 \\u0b8e\\u0bb4\\u0bc1\\u0ba4\\u0bbf\\u0ba9. \\u0baa\\u0bbf\\u0baa\\u0bcd\\u0bb0\\u0bb5\\u0bb0\\u0bbf 1-\\u0b86\\u0bae\\u0bcd \\u0ba4\\u0bc7\\u0ba4\\u0bbf, \\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bc1 \\u0b86\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb2 \\u0b87\\u0ba4\\u0bb4\\u0bcd, \\u2018\\u0b87\\u0ba8\\u0bcd\\u0ba4\\u0bbf\\u0baf \\u0b85\\u0bb0\\u0b9a\\u0bbf\\u0baf\\u0bb2\\u0bcd \\u0b9a\\u0b9f\\u0bcd\\u0b9f \\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bcd\\u0bb1\\u0bbf\\u0bb2\\u0bcd \\u0b88\\u0b9f\\u0bc1 \\u0b87\\u0ba3\\u0bc8\\u0baf\\u0bb1\\u0bcd\\u0bb1 \\u0b85\\u0b9f\\u0bcd\\u0b9f\\u0bc2\\u0bb4\\u0bbf\\u0baf\\u0bae\\u0bcd\' \\u0b8e\\u0ba9 \\u0b8e\\u0bb4\\u0bc1\\u0ba4\\u0bbf\\u0baf\\u0ba4\\u0bc1. #\\u0b95\\u0bb0\\u0bc1\\u0bb5\\u0bc2\\u0bb2\\u0bae\\u0bcd", "On the occasion of the 133rd birth anniversary of my grandfather, Thamizhavel P.T. Rajan\\u2014who devoted his life to Tamil service, religious reform, and social upliftment\\u2014we are deeply honoured that the Hon\\u2019ble Chief Minister of Tamil Nadu, Thiru. mkstalin , will launch the commemorative anthology \\u201cDravida Araneriyaalar Thamizhavel P.T. Rajan \\u2013 Vazhve Varalaaru.\\u201d This tribute to his unwavering commitment to social justice will be launched today at 6:00 PM at Kalaivanar Arangam, Chennai, by the Hon\\u2019ble Chief", "Kalaivanar Arangam, Chennai, by the Hon\\u2019ble Chief Minister, whose leadership continues to embody the spirit of the Dravidian model and the values that the Justice Party and Thamizhavel P.T. Rajan held dear. We invite all party comrades, followers of the Dravidian ideology, and the General public to join us in honouring the enduring legacy of a remarkable Dravidian statesman. \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bcd \\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0ba4\\u0bbf\\u0bb0\\u0bc1\\u0ba4\\u0bcd\\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0b9a\\u0bae\\u0bc2\\u0b95\\u0ba4\\u0bcd \\u0ba4\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b86\\u0b95\\u0bbf\\u0baf \\u0bae\\u0bc2\\u0ba9\\u0bcd\\u0bb1\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bae\\u0ba4\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0b95\\u0bcd\\u0b95\\u0bc8 \\u0ba8\\u0bc6\\u0bb1\\u0bbf\\u0baf\\u0bbe\\u0b95\\u0b95\\u0bcd \\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bbf \\u0b85\\u0bb0\\u0bc8 \\u0ba8\\u0bc2\\u0bb1\\u0bcd\\u0bb1\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc7\\u0bb2\\u0bbe\\u0b95\\u0baa\\u0bcd", "\\u0b95\\u0bb0\\u0bc1\\u0ba4\\u0bbf \\u0b85\\u0bb0\\u0bc8 \\u0ba8\\u0bc2\\u0bb1\\u0bcd\\u0bb1\\u0bbe\\u0ba3\\u0bcd\\u0b9f\\u0bc1 \\u0b95\\u0bbe\\u0bb2\\u0ba4\\u0bcd\\u0ba4\\u0bbf\\u0bb1\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0bae\\u0bc7\\u0bb2\\u0bbe\\u0b95\\u0baa\\u0bcd \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bbf\\u0bb2\\u0bcd \\u0b88\\u0b9f\\u0bc1\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b8e\\u0ba9\\u0ba4\\u0bc1 \\u0ba4\\u0bbe\\u0ba4\\u0bcd\\u0ba4\\u0bbe \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb5\\u0bc7\\u0bb3\\u0bcd \\u0baa\\u0bbf.\\u0b9f\\u0bbf. \\u0bb0\\u0bbe\\u0b9c\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd 133\\u0bb5\\u0ba4\\u0bc1 \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbe\\u0bb3\\u0bc8 \\u0bae\\u0bc1\\u0ba9\\u0bcd\\u0ba9\\u0bbf\\u0b9f\\u0bcd\\u0b9f\\u0bc1 , \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bbe\\u0b95 \\u0baa\\u0bbe\\u0b9f\\u0bc1\\u0baa\\u0b9f\\u0bcd\\u0b9f \\u0b85\\u0bb5\\u0bb0\\u0ba4\\u0bc1 \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bc8\\u0baa\\u0bcd \\u0baa\\u0bcb\\u0bb1\\u0bcd\\u0bb1\\u0bc1\\u0bae\\u0bcd \\u0bb5\\u0bbf\\u0ba4\\u0bae\\u0bbe\\u0b95 \\u0b89\\u0bb0\\u0bc1\\u0bb5\\u0bbe\\u0b95\\u0bcd\\u0b95\\u0baa\\u0bcd\\u0baa\\u0b9f\\u0bcd\\u0b9f\\u0bc1\\u0bb3\\u0bcd\\u0bb3 \\"\\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0b85\\u0bb1\\u0ba8\\u0bc6\\u0bb1\\u0bbf\\u0baf\\u0bbe\\u0bb3\\u0bb0\\u0bcd \\u0ba4\\u0bae\\u0bbf\\u0bb4\\u0bb5\\u0bc7\\u0bb3\\u0bcd \\u0baa\\u0bbf.\\u0b9f\\u0bbf. \\u0bb0\\u0bbe\\u0b9c\\u0ba9\\u0bcd \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bbf\\u0ba9\\u0bcd \\u0bb5\\u0bbe\\u0bb4\\u0bcd\\u0bb5\\u0bc7 \\u0bb5\\u0bb0\\u0bb2\\u0bbe\\u0bb1\\u0bc1\\" \\u0b8e\\u0ba9\\u0bc1\\u0bae\\u0bcd \\u0baa\\u0bbf\\u0bb1\\u0ba8\\u0bcd\\u0ba4\\u0ba8\\u0bbe\\u0bb3\\u0bcd \\u0bae\\u0bb2\\u0bb0\\u0bc8 \\u0b9a\\u0bae\\u0bc2\\u0b95 \\u0ba8\\u0bc0\\u0ba4\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bbe\\u0bb5\\u0bb2\\u0bcd \\u0b85\\u0bb0\\u0ba3\\u0bbe\\u0b95 \\u0bb5\\u0bbf\\u0bb3\\u0b99\\u0bcd\\u0b95\\u0bc1\\u0bae\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0bae\\u0bbe\\u0b9f\\u0bb2\\u0bcd \\u0ba8\\u0bb2\\u0bcd\\u0bb2\\u0bbe\\u0b9f\\u0bcd\\u0b9a\\u0bbf \\u0ba8\\u0bbe\\u0baf\\u0b95\\u0bb0\\u0bcd \\u0bae\\u0bbe\\u0ba3\\u0bcd\\u0baa\\u0bc1\\u0bae\\u0bbf\\u0b95\\u0bc1 \\u0bae\\u0bc1\\u0ba4\\u0bb2\\u0bae\\u0bc8\\u0b9a\\u0bcd\\u0b9a\\u0bb0\\u0bcd \\u0ba4\\u0bbf\\u0bb0\\u0bc1 mkstalin \\u0b85\\u0bb5\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0ba4\\u0bae\\u0ba4\\u0bc1 \\u0baa\\u0bca\\u0bb1\\u0bcd\\u0b95\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bb3\\u0bbe\\u0bb2\\u0bcd \\u0b87\\u0ba9\\u0bcd\\u0bb1\\u0bc1 \\u0bae\\u0bbe\\u0bb2\\u0bc8 \\u0b95\\u0bb2\\u0bc8\\u0bb5\\u0bbe\\u0ba3\\u0bb0\\u0bcd \\u0b85\\u0bb0\\u0b99\\u0bcd\\u0b95\\u0bbf\\u0bb2\\u0bcd \\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0bb5\\u0bc1\\u0b9f\\u0ba9\\u0bcd", "\\u0bb5\\u0bc6\\u0bb3\\u0bbf\\u0baf\\u0bbf\\u0b9f\\u0bb5\\u0bbf\\u0bb0\\u0bc1\\u0b95\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bbe\\u0bb0\\u0bcd \\u0b8e\\u0ba9\\u0bcd\\u0baa\\u0ba4\\u0bc8 \\u0bae\\u0bbf\\u0b95\\u0bcd\\u0b95 \\u0bae\\u0b95\\u0bbf\\u0bb4\\u0bcd\\u0bb5\\u0bc1\\u0b9f\\u0ba9\\u0bcd \\u0ba4\\u0bc6\\u0bb0\\u0bbf\\u0bb5\\u0bbf\\u0ba4\\u0bcd\\u0ba4\\u0bc1\\u0b95\\u0bcd \\u0b95\\u0bca\\u0ba3\\u0bcd\\u0b9f\\u0bc1, \\u0b95\\u0bb4\\u0b95 \\u0b89\\u0b9f\\u0ba9\\u0bcd\\u0baa\\u0bbf\\u0bb1\\u0baa\\u0bcd\\u0baa\\u0bc1\\u0b95\\u0bb3\\u0bcd, \\u0ba4\\u0bbf\\u0bb0\\u0bbe\\u0bb5\\u0bbf\\u0b9f \\u0b87\\u0baf\\u0b95\\u0bcd\\u0b95 \\u0b89\\u0ba3\\u0bb0\\u0bcd\\u0bb5\\u0bbe\\u0bb3\\u0bb0\\u0bcd\\u0b95\\u0bb3\\u0bcd , \\u0baa\\u0bca\\u0ba4\\u0bc1\\u0bae\\u0b95\\u0bcd\\u0b95\\u0bb3\\u0bcd \\u0b85\\u0ba9\\u0bc8\\u0bb5\\u0bb0\\u0bc8\\u0baf\\u0bc1\\u0bae\\u0bcd \\u0b87\\u0ba8\\u0bcd\\u0ba4 \\u0ba8\\u0bbf\\u0b95\\u0bb4\\u0bcd\\u0b9a\\u0bcd\\u0b9a\\u0bbf\\u0b95\\u0bcd\\u0b95\\u0bc1 \\u0bb5\\u0bb0\\u0bb5\\u0bc7\\u0bb1\\u0bcd\\u0b95\\u0bbf\\u0bb1\\u0bc7\\u0ba9\\u0bcd.", "Telangana Govt is hosting the 1st Bharat Summit in Hyderabad on April 25\\u201326 \\u2014 amid global challenges to democracy, equity, and peace. Over 400 delegates from 100 progressive parties \\u2014 including global ministers, MPs, and thinkers \\u2014 will join under the leadership of the Congress Party. The theme, Delivering Global Justice, echoes Rahul ji\\u2019s NYAY vision \\u2014 focusing on economic, social, gender, youth, and ecological justice. We\'ll also showcase CM Reddy\\u2019s Telangana Risi